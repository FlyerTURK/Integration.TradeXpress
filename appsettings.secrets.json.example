// GERÇEK secret şablonu. Her host'un yanına `appsettings.secrets.json` olarak kopyalayıp GERÇEK (rotate edilmiş)
// değerleri gir. Bu dosya (.example) izlenir; appsettings.secrets.json .gitignore'da → ASLA commit'lenmez.
// ABP `AddAppSettingsSecretsJson()` bunu appsettings.json ÜZERİNE merge eder → buradaki değerler kazanır.
// Kapsam: HttpApi.Host + Blazor (3 anahtar) · DbMigrator (yalnız ConnectionStrings).
{
  "ConnectionStrings": {
    // sa YERİNE sınırlı yetkili uygulama login'i kullan. Parolayı rotate et.
    "Default": "Server=.\\SQLEXPRESS;Database=TradeXpress;User Id=<APP_DB_USER>;Password=<ROTATE_ME>;TrustServerCertificate=True;"
  },
  "AuthServer": {
    // openiddict.pfx'i açan parola — rotate et (yeni cert üretince yeni parola).
    "CertificatePassPhrase": "<ROTATE_ME>"
  },
  "StringEncryption": {
    // ABP setting/secret şifreleme anahtarı — rotate et (16 karakter).
    "DefaultPassPhrase": "<ROTATE_ME_16CHARS>"
  }
}
