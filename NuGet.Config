<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- DevExpress.Blazor 25.2.5 kapanışı repo-içi vendored (nuget-packages/) — makineye özel
         'C:\Program Files\DevExpress 25.2' kurulumuna bağımlılığı kaldırır; 5-10 yıl sonra temiz makinede restore garantili.
         Yeni paket eklerken etc/scripts/vendor-devexpress.ps1 ile güncelle. -->
    <add key="local-devexpress" value="./nuget-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.*" />
      <package pattern="Volo.*" />
    </packageSource>
    <packageSource key="local-devexpress">
      <package pattern="DevExpress.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
