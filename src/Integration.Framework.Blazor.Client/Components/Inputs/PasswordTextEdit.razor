@using DevExpress.Blazor

@*
   Şifre girişi — göz ikonu textbox'ın İÇİNDE (DxTextBox Buttons şablonu). Harici buton/flex satırı
   yok (mobilde taşma yapmaz). @bind-Text ile iki yönlü. EditForm içinde TextExpression olmadığından
   ValidationEnabled=false; model doğrulaması yine DataAnnotationsValidator + ValidationSummary'den gelir.
*@
<DxTextBox Text="@Text"
           TextChanged="OnTextChangedAsync"
           Password="@(!_show)"
           NullText="@NullText"
           CssClass="@CssClass"
           ValidationEnabled="false">
    <Buttons>
        <DxEditorButton IconCssClass="@(_show ? "custom-icon-eye-slash" : "custom-icon-eye")"
                        Tooltip="@Tooltip"
                        Click="@(() => _show = !_show)" />
    </Buttons>
</DxTextBox>

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TextChanged { get; set; }
    [Parameter] public string? NullText { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Tooltip { get; set; }

    private bool _show;

    private Task OnTextChangedAsync(string value)
    {
        Text = value;
        return TextChanged.InvokeAsync(value);
    }
}

