@using DevExpress.Blazor
@using Integration.Framework.Blazor.Client.Services.Base
@inject IPopupService PopupService
@implements IDisposable

<DxPopup Visible="@PopupService.IsVisible"
         Closing="OnClosing"
         Closed="OnClosed"
         HeaderText="@PopupService.Options?.Title"
         ShowCloseButton="true"
         ShowFooter="false"
         Width="95%"
         MaxWidth="@(PopupService.Options?.Width ?? "800px")"
         MaxHeight="90vh"
         Scrollable="true"
         CloseOnEscape="@(PopupService.Options?.CloseOnEscape ?? false)"
         CloseOnOutsideClick="@(PopupService.Options?.CloseOnOutsideClick ?? false)">
    <BodyTemplate>
        @if (PopupService.ComponentType != null)
        {
            <DynamicComponent Type="@PopupService.ComponentType" Parameters="@PopupService.ComponentParameters" />
        }
    </BodyTemplate>
</DxPopup>

@code {
    protected override void OnInitialized()
    {
        PopupService.OnShow += StateHasChanged;
        PopupService.OnHide += StateHasChanged;
    }

    // Kapanma ÖNCESİ (Closing): kullanıcı kapanışında (X/Escape/dış tık) kirli guard'ı çalıştır; reddedilirse
    // args.Cancel=true → popup HİÇ kapanmaz (görsel kapanıp sonra sorma derdi yok; "OnClosing" mantığı).
    private async Task OnClosing(PopupClosingEventArgs args)
    {
        // Programmatik kapanış = PopupService.Close() çağrıldı (kod zaten karar verdi/guard'ladı) → tekrar sorma.
        if (args.CloseReason == PopupCloseReason.Programmatically) return;

        var guard = PopupService.CloseGuard;
        if (guard != null && !await guard())
            args.Cancel = true;
    }

    // Kapanış kesinleşti → servis state'ini senkronla (kullanıcı kapanışında IsVisible hâlâ true'ydu).
    private void OnClosed(PopupClosedEventArgs args)
    {
        if (PopupService.IsVisible)
            PopupService.Close();
    }

    public void Dispose()
    {
        PopupService.OnShow -= StateHasChanged;
        PopupService.OnHide -= StateHasChanged;
    }
}
