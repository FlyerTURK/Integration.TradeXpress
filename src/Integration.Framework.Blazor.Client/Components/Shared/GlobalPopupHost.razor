@using System.Collections.Generic
@using System.Linq
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Integration.Framework.Blazor.Client.Services.Base
@inject IPopupService PopupService
@inject IJSRuntime JS
@implements IDisposable
@implements IPopupChrome

@* NATIVE close X korunur (ShowCloseButton). Boş chrome bandı yerine: hosted edit form, başlığını
   IPopupChrome.SetHeader ile buraya verir → HeaderContentTemplate'i DOLDURUR (band boş kalmaz, çift
   başlık olmaz). HeaderContentTemplate yalnız content alanını etkiler; native X bağımsız (DevExpress).
   IPopupChrome cascade ile ChildContent'e verilir; form vermezse Title'a düşer (eski davranış). *@
@* Popup chrome ARTIK TEK KAYNAK: EditShell (3 kabuk kopyası yerine). Başlık/butonlar/pencere-durumu EditShell'de;
   IPopupChrome cascade'i, DockToTab, RenderParameters (_TabUrl filtresi), OnShow/OnHide GlobalPopupHost'ta KALIR. *@
<EditShell Mode="EditShellMode.Popup"
           Buttons="EditShellButtons.Minimize | EditShellButtons.Fullscreen | EditShellButtons.Modal | EditShellButtons.Dock"
           Visible="@PopupService.IsVisible"
           ChromeHeader="@_chromeHeader"
           TitleText="@PopupService.Options?.Title"
           MaxWidth="@(PopupService.Options?.Width ?? "800px")"
           DefaultModal="false"
           CloseOnEscape="@(PopupService.Options?.CloseOnEscape ?? false)"
           CloseOnOutsideClick="@(PopupService.Options?.CloseOnOutsideClick ?? false)"
           OnClosingRequested="OnClosing"
           OnClosedConfirmed="OnClosed"
           OnShownRequested="OnShown"
           OnDockRequested="DockToTab">
    @* Body: form başlığını IPopupChrome.SetHeader ile iter (ChromeHeader); EntityEditForm kendi flex+scroll'unu taşır. *@
    <CascadingValue Value="@((IPopupChrome)this)" IsFixed="true">
        @if (PopupService.ComponentType != null)
        {
            <DynamicComponent Type="@PopupService.ComponentType" Parameters="@RenderParameters" />
        }
    </CascadingValue>
</EditShell>

@code {
    private RenderFragment? _chromeHeader;
    private Func<Task<bool>>? _chromeGuard;   // form'un kapanış guard'ı (CanLeaveAsync) — IPopupChrome ile gelir
    // Pencere durumu (fullscreen/minimize/modal) + toggle'lar EditShell'de (tek kabuk).

    [Inject] private Integration.Framework.Blazor.Client.Services.Mdi.IMdiTabOpener TabOpener { get; set; } = default!;

    private async Task DockToTab()
    {
        if (PopupService.ComponentType == null) return;

        // Warn the user about state loss if there are unsaved changes
        var guard = _chromeGuard ?? PopupService.CloseGuard;
        if (guard != null)
        {
            var canLeave = await guard();
            if (!canLeave) return; // User cancelled due to dirty state
        }

        var parameters = PopupService.ComponentParameters;
        var title = PopupService.Options?.Title ?? "Sekme";
        
        string? url = null;
        if (parameters != null && parameters.TryGetValue("_TabUrl", out var tabUrlObj) && tabUrlObj is string tabUrl)
        {
            url = tabUrl;
        }

        if (string.IsNullOrEmpty(url)) 
        {
            // If we can't resolve URL, don't allow docking.
            return;
        }

        // Kapat, State'i temizle
        PopupService.Close();

        // Yeni Sekme olarak aç
        await TabOpener.OpenOrActivateAsync(url, title);
    }

    // _TabUrl popup METADATA'sıdır (PopOutActiveTab → DockToTab geri-dönüş URL'i); sayfa BİLEŞENİNE parametre
    // olarak GEÇMEZ — CrudPageBase list sayfalarında tanımsız → "does not have a property _TabUrl" exception.
    // Kaynak referansı değişince (yeni popup) BİR kez filtrele → render başına yeni dict üretip DynamicComponent'i
    // gereksiz re-init etmeyiz. DockToTab _TabUrl'i orijinal ComponentParameters'tan okumaya devam eder.
    private Dictionary<string, object>? _renderParamsSource;
    private Dictionary<string, object>? _renderParams;
    private Dictionary<string, object>? RenderParameters
    {
        get
        {
            var src = PopupService.ComponentParameters;
            if (!ReferenceEquals(src, _renderParamsSource))
            {
                _renderParamsSource = src;
                _renderParams = src?.Where(kv => kv.Key != "_TabUrl").ToDictionary(kv => kv.Key, kv => kv.Value);
            }
            return _renderParams;
        }
    }

    protected override void OnInitialized()
    {
        PopupService.OnShow += HandleShow;
        PopupService.OnHide += HandleHide;
    }

    // Edit form (popup modunda) başlığını buraya verir → chrome header dolar, native X kalır.
    // Reaktif: form dirty/başlık değişince yeniden çağrılır (form tarafı sig-guard'lı → döngü yok).
    public void SetHeader(RenderFragment? header)
    {
        _chromeHeader = header;
        InvokeAsync(StateHasChanged);
    }

    public void SetCloseGuard(Func<Task<bool>>? guard) => _chromeGuard = guard;

    private void HandleShow() { _chromeHeader = null; _chromeGuard = null; StateHasChanged(); }   // yeni popup → temizle (pencere durumu EditShell'de)
    private void HandleHide() { _chromeHeader = null; _chromeGuard = null; StateHasChanged(); }

    private async Task OnShown()
    {
        try
        {
            await JS.InvokeVoidAsync("erpUx.focusFirstPopupInput");
        }
        catch { }
    }

    // Kapanma ÖNCESİ (Closing): kullanıcı kapanışında (X/Escape/dış tık) kirli guard'ı çalıştır; reddedilirse
    // args.Cancel=true → popup HİÇ kapanmaz.
    private async Task OnClosing(PopupClosingEventArgs args)
    {
        if (args.CloseReason == PopupCloseReason.Programmatically) return;   // kod zaten karar verdi/guard'ladı

        // Form'un kendi guard'ı (IPopupChrome ile gelen CanLeaveAsync) önceliklidir; yoksa eski PopupService.CloseGuard.
        var guard = _chromeGuard ?? PopupService.CloseGuard;
        if (guard != null && !await guard())
            args.Cancel = true;
    }

    private void OnClosed()
    {
        if (PopupService.IsVisible)
            PopupService.Close();
    }

    public void Dispose()
    {
        PopupService.OnShow -= HandleShow;
        PopupService.OnHide -= HandleHide;
    }
}



























