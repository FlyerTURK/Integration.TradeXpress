@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Integration.Framework.Blazor.Client.Services.Base
@inject IPopupService PopupService
@inject IJSRuntime JS
@implements IDisposable
@implements IPopupChrome

@* NATIVE close X korunur (ShowCloseButton). Boş chrome bandı yerine: hosted edit form, başlığını
   IPopupChrome.SetHeader ile buraya verir → HeaderContentTemplate'i DOLDURUR (band boş kalmaz, çift
   başlık olmaz). HeaderContentTemplate yalnız content alanını etkiler; native X bağımsız (DevExpress).
   IPopupChrome cascade ile gövdeye verilir; form vermezse Title'a düşer (eski davranış). *@
<DxPopup Visible="@PopupService.IsVisible"
         CssClass="@((_isFullscreen ? "fullscreen-popup " : "") + (_isMinimized ? "minimized-popup " : ""))"
         Closing="OnClosing"
         Closed="OnClosed"
         Shown="OnShown"
         ShowCloseButton="@(!_isMinimized)"
         ShowFooter="false"
         Width="@(_isFullscreen ? "100%" : (_isMinimized ? "350px" : "95%"))"
         MaxWidth="@(_isFullscreen ? "100vw" : (_isMinimized ? "350px" : (PopupService.Options?.Width ?? "800px")))"
         MinHeight="@(_isMinimized ? "0" : "150px")"
         MaxHeight="@(_isFullscreen ? "100vh" : "90vh")"
         Height="@(_isFullscreen ? "100%" : null)"
         HorizontalAlignment="@(_isMinimized ? HorizontalAlignment.Left : HorizontalAlignment.Center)"
         VerticalAlignment="@(_isMinimized ? VerticalAlignment.Bottom : VerticalAlignment.Center)"
         Scrollable="true" ShowBackdrop="@(_isModal && !_isMinimized)"
         CloseOnEscape="@(PopupService.Options?.CloseOnEscape ?? false)"
         CloseOnOutsideClick="@(PopupService.Options?.CloseOnOutsideClick ?? false)">
    <HeaderContentTemplate Context="popup">
        <div class="flex-grow-1 w-100 h-100 position-relative d-flex align-items-center" style="user-select: none;" @ondblclick="@(() => { if (_isMinimized) ToggleMinimize(); else ToggleFullscreen(); })">
            <div class="flex-grow-1" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; padding-right: 120px;">
                @if (_chromeHeader is not null)
                {
                    @_chromeHeader
                }
                else if (!string.IsNullOrEmpty(PopupService.Options?.Title))
                {
                    <span>@PopupService.Options!.Title</span>
                }
            </div>
            <div class="position-absolute d-flex align-items-center" style="right: 8px; top: 50%; transform: translateY(-50%); gap: 4px;">
                <DxButton RenderStyle="ButtonRenderStyle.None" CssClass="@($"d-none {(_isMinimized ? "" : "d-md-flex")} align-items-center justify-content-center p-0")" Click="ToggleModal" tabindex="-1" title="@(_isModal ? "Arka Planı Kilitleme (Modeless)" : "Arka Planı Kilitle (Modal)")"><i class="erp-icon @(_isModal ? "erp-icon-pin" : "erp-icon-unpin")" style="width: 18px; height: 18px;"></i></DxButton>
                <DxButton RenderStyle="ButtonRenderStyle.None" CssClass="@($"d-none {(_isMinimized ? "" : "d-md-flex")} align-items-center justify-content-center p-0")" Click="DockToTab" tabindex="-1" title="Sekmeye Sabitle"><i class="erp-icon erp-icon-dock" style="width: 18px; height: 18px;"></i></DxButton>
                <DxButton RenderStyle="ButtonRenderStyle.None" CssClass="d-flex flex-shrink-0 align-items-center justify-content-center p-0" Click="ToggleMinimize" tabindex="-1"><i class="@(_isMinimized ? "custom-icon-restore-min" : "custom-icon-minimize-corner")" style="width: 20px; height: 20px;"></i></DxButton>
                <DxButton RenderStyle="ButtonRenderStyle.None" CssClass="@($"d-none {(_isMinimized ? "" : "d-md-flex")} align-items-center justify-content-center p-0")" Click="ToggleFullscreen" tabindex="-1"><i class="@(_isFullscreen ? "custom-icon-minimize" : "custom-icon-maximize")" style="width: 20px; height: 20px;"></i></DxButton>
            </div>
        </div>
    </HeaderContentTemplate>
    <BodyTemplate>
        <div style="@(_isMinimized ? "display: none !important;" : "")" class="h-100 d-flex flex-column">            <CascadingValue Value="@((IPopupChrome)this)" IsFixed="true">
            @if (PopupService.ComponentType != null)
            {
                <DynamicComponent Type="@PopupService.ComponentType" Parameters="@PopupService.ComponentParameters" />
            }
        </CascadingValue>
        </div>
    </BodyTemplate>
</DxPopup>

@code {
    private RenderFragment? _chromeHeader;
    private Func<Task<bool>>? _chromeGuard;   // form'un kapanış guard'ı (CanLeaveAsync) — IPopupChrome ile gelir
    private bool _isFullscreen;
    private bool _isMinimized;
    private bool _isModal = false; // Modeless by default

    private void ToggleModal()
    {
        _isModal = !_isModal;
    }

    [Inject] private Integration.Framework.Blazor.Client.Services.Mdi.IMdiTabOpener TabOpener { get; set; } = default!;

    private async Task DockToTab()
    {
        if (PopupService.ComponentType == null) return;

        // Warn the user about state loss if there are unsaved changes
        var guard = _chromeGuard ?? PopupService.CloseGuard;
        if (guard != null)
        {
            var canLeave = await guard();
            if (!canLeave) return; // User cancelled due to dirty state
        }

        var parameters = PopupService.ComponentParameters;
        var title = PopupService.Options?.Title ?? "Sekme";
        
        string url = null;
        if (parameters != null && parameters.TryGetValue("_TabUrl", out var tabUrlObj) && tabUrlObj is string tabUrl)
        {
            url = tabUrl;
        }

        if (string.IsNullOrEmpty(url)) 
        {
            // If we can't resolve URL, don't allow docking.
            return;
        }

        // Kapat, State'i temizle
        PopupService.Close();

        // Yeni Sekme olarak aç
        await TabOpener.OpenOrActivateAsync(url, title);
    }

    private void ToggleFullscreen()
    {
        _isMinimized = false;
        _isFullscreen = !_isFullscreen;
    }

    private void ToggleMinimize()
    {
        _isFullscreen = false;
        _isMinimized = !_isMinimized;
    }

    protected override void OnInitialized()
    {
        PopupService.OnShow += HandleShow;
        PopupService.OnHide += HandleHide;
    }

    // Edit form (popup modunda) başlığını buraya verir → chrome header dolar, native X kalır.
    // Reaktif: form dirty/başlık değişince yeniden çağrılır (form tarafı sig-guard'lı → döngü yok).
    public void SetHeader(RenderFragment? header)
    {
        _chromeHeader = header;
        InvokeAsync(StateHasChanged);
    }

    public void SetCloseGuard(Func<Task<bool>>? guard) => _chromeGuard = guard;

    private void HandleShow() { _chromeHeader = null; _chromeGuard = null; _isFullscreen = false; _isMinimized = false; StateHasChanged(); }   // yeni popup → temizle
    private void HandleHide() { _chromeHeader = null; _chromeGuard = null; _isFullscreen = false; _isMinimized = false; StateHasChanged(); }

    private async Task OnShown()
    {
        try
        {
            await JS.InvokeVoidAsync("erpUx.focusFirstPopupInput");
        }
        catch { }
    }

    // Kapanma ÖNCESİ (Closing): kullanıcı kapanışında (X/Escape/dış tık) kirli guard'ı çalıştır; reddedilirse
    // args.Cancel=true → popup HİÇ kapanmaz.
    private async Task OnClosing(PopupClosingEventArgs args)
    {
        if (args.CloseReason == PopupCloseReason.Programmatically) return;   // kod zaten karar verdi/guard'ladı

        // Form'un kendi guard'ı (IPopupChrome ile gelen CanLeaveAsync) önceliklidir; yoksa eski PopupService.CloseGuard.
        var guard = _chromeGuard ?? PopupService.CloseGuard;
        if (guard != null && !await guard())
            args.Cancel = true;
    }

    private void OnClosed(PopupClosedEventArgs args)
    {
        if (PopupService.IsVisible)
            PopupService.Close();
    }

    public void Dispose()
    {
        PopupService.OnShow -= HandleShow;
        PopupService.OnHide -= HandleHide;
    }
}



























