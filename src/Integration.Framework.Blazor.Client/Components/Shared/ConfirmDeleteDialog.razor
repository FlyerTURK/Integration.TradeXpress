@using Integration.Framework.Blazor.Client.Services.Base
@using DevExpress.Blazor
@inherits Volo.Abp.AspNetCore.Components.AbpComponentBase
@implements IDisposable
@inject ITradeXpressUiService UiService

<DxWindow @bind-Visible="@IsVisible"
          CloseOnEscape="true"
          ShowCloseButton="true"
          ShowFooter="true"
          HeaderTitle="@UiService.DialogTitle"
          Width="92vw"
          MaxWidth="450px"
          MinHeight="180px"
          MaxHeight="90vh"
          CssClass="confirm-delete-dialog-window shadow"
          HorizontalAlignment="HorizontalAlignment.Center"
          VerticalAlignment="VerticalAlignment.Center"
          CloseButtonClick="OnCloseButtonClick">
    @* Bootstrap utility (d-flex/p-3/w-100/justify-content-end) bu app'te ETKİSİZ → inline stil.
       Footer'da adaptif DxToolbar YOK: dar ekranda butonları "..." taşma menüsüne atıyordu; düz flex
       sarmalı kullanıyoruz. Genişlik vw-tabanlı (Width="92vw") — "%" container'a göre çözülüp daralıyordu. *@
    <BodyTextTemplate>
        <div style="display:flex; align-items:flex-start; gap:0.75rem; padding:1rem;">
            <i class="custom-icon-warning custom-2x" style="color:#ffc107; flex:0 0 auto;"></i>
            <p style="margin:0; font-weight:600; font-size:1.05rem;">@UiService.DialogMessage</p>
        </div>
    </BodyTextTemplate>
    <FooterTemplate>
        <div style="display:flex; flex-wrap:wrap; justify-content:flex-end; gap:0.5rem; width:100%; padding:0.5rem 0.75rem; border-top:1px solid var(--bs-border-color, #dee2e6);">
            <DxButton Text="@(UiService.DialogYesText ?? L["Yes"])"
                      RenderStyle="@(UiService.DialogDefaultYes ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                      FocusOnInit="@UiService.DialogDefaultYes"
                      Click="@(() => UiService.CloseDialog(ConfirmDialogResult.Yes))" />
            @if (UiService.DialogShowNo)
            {
                <DxButton Text="@(UiService.DialogNoText ?? L["No"])"
                          RenderStyle="@(UiService.DialogDefaultYes ? ButtonRenderStyle.Secondary : ButtonRenderStyle.Primary)"
                          FocusOnInit="@(!UiService.DialogDefaultYes)"
                          Click="@(() => UiService.CloseDialog(ConfirmDialogResult.No))" />
            }
            @if (UiService.DialogShowCancel)
            {
                @* No gizliyken güvenli varsayılan (primary + odak) Vazgeç'tir — silme onayı deseni. *@
                <DxButton Text="@L["Cancel"]"
                          RenderStyle="@(!UiService.DialogShowNo && !UiService.DialogDefaultYes ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                          FocusOnInit="@(!UiService.DialogShowNo && !UiService.DialogDefaultYes)"
                          Click="@(() => UiService.CloseDialog(ConfirmDialogResult.Cancel))" />
            }
        </div>
    </FooterTemplate>
</DxWindow>

@code {
    private bool IsVisible
    {
        get => UiService.IsDialogVisible;
        set
        {
            if (!value)
            {
                UiService.CloseDialog(ConfirmDialogResult.Cancel);
            }
        }
    }

    protected override void OnInitialized()
    {
        UiService.OnDialogChanged += StateHasChanged;
    }

    private void OnCloseButtonClick()
    {
        UiService.CloseDialog(ConfirmDialogResult.Cancel);
    }

    public void Dispose()
    {
        UiService.OnDialogChanged -= StateHasChanged;
    }
}

