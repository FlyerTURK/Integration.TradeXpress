@typeparam TValue
@using System.Linq.Expressions
@using DevExpress.Blazor

@* ValidationEnabled: ValueExpression yoksa (Value=+ValueChanged= tek-yön kullanım) DevExpress alan-kimliği
   üretemez ve EditContext İÇİNDE "requires ValueExpression" fırlatır → o durumda validation KAPALI.
   @bind-Value'da ValueExpression otomatik dolar → validation açık. (Yorum tag DIŞINDA — ui-blazor gotcha.) *@
<DxSpinEdit Value="@Value"
            ValueChanged="@(async (TValue v) => await OnValueChanged(v))"
            ValueExpression="@ValueExpression"
            ValidationEnabled="@(ValueExpression != null)"
            BindValueMode="@BindValueMode"
            ClearButtonDisplayMode="@ClearButtonDisplayMode"
            ShowSpinButtons="@ShowSpinButtons"
            Enabled="@Enabled"
            ReadOnly="@ReadOnly"
            DisplayFormat="@DisplayFormat"
            Mask="@Mask"
            InputCssClass="@InputCssClass"
            CssClass="numeric-spin-edit w-100"
            @attributes="_boundaryAttributes" />

<style>
    .numeric-spin-edit input {
        text-align: right !important;
        padding-right: 10px !important;
    }
</style>

@code {
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public Expression<Func<TValue>>? ValueExpression { get; set; }

    /// <summary>Değerin ne zaman yansıyacağı. Sürücü (girdi) alanlarda OnInput (anlık ileri hesap),
    /// ters-hesap tetikleyen alanlarda OnChange (odak çıkışı) verilir. Varsayılan OnChange.</summary>
    [Parameter] public BindValueMode BindValueMode { get; set; } = BindValueMode.OnLostFocus;

    [Parameter] public DataEditorClearButtonDisplayMode ClearButtonDisplayMode { get; set; } = DataEditorClearButtonDisplayMode.Never;
    [Parameter] public bool ShowSpinButtons { get; set; } = true;
    [Parameter] public bool Enabled { get; set; } = true;

    /// <summary>Salt-okunur kip: değer GÖRÜNÜR ama değiştirilemez. <c>Enabled=false</c>'tan farkı görsel —
    /// devre dışı alan "kullanılamaz" der, salt-okunur alan "bilgi burada, ama sahibi başka yerde" der
    /// (ör. üst kategoriden devralınan alanlar). DxSpinEdit bunu DxDataEditor'dan miras alır.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Alt/üst sınır (iç DxSpinEdit'e passthrough). DİKKAT: DxSpinEdit&lt;T&gt;.MinValue tipi düz T'dir
    /// (nullable object değil) → default(decimal)=0 gibi bir değeri GERÇEK sınır sayar. Bu yüzden yalnızca
    /// kullanım yerinde AÇIKÇA verilirse iç editöre geçilir (SetParametersAsync + TryGetValue); verilmezse
    /// hiç geçmez → DxSpinEdit'in sınırsız varsayılanı korunur (decimal/int alanlarda 0-tabanı regresyonu önlenir).</summary>
    [Parameter] public TValue? MinValue { get; set; }
    [Parameter] public TValue? MaxValue { get; set; }

    /// <summary>Değer null iken gösterilen placeholder (nullable TValue'da anlamlı). null = varsayılan.</summary>
    [Parameter] public string? NullText { get; set; }

    // Yalnız açıkça verilen sınır/placeholder parametrelerini içeren splat sözlüğü (koşullu passthrough).
    private readonly Dictionary<string, object> _boundaryAttributes = new();

    public override Task SetParametersAsync(ParameterView parameters)
    {
        _boundaryAttributes.Clear();
        if (parameters.TryGetValue<TValue>(nameof(MinValue), out var min) && min is not null)
        {
            _boundaryAttributes[nameof(MinValue)] = min;
        }
        if (parameters.TryGetValue<TValue>(nameof(MaxValue), out var max) && max is not null)
        {
            _boundaryAttributes[nameof(MaxValue)] = max;
        }
        if (parameters.TryGetValue<string>(nameof(NullText), out var nullText) && !string.IsNullOrEmpty(nullText))
        {
            _boundaryAttributes[nameof(NullText)] = nullText;
        }
        return base.SetParametersAsync(parameters);
    }

    /// <summary>Focus dışındaki gösterim formatı (ör. "N5"). null = varsayılan. Girişi kısıtlamaz (mask değil).</summary>
    [Parameter] public string? DisplayFormat { get; set; }
    /// <summary>Giriş maskesi (ör. "N2"). null = masksiz.</summary>
    [Parameter] public string? Mask { get; set; }

    // New parameter to apply CSS class to inner input for right alignment and padding
    [Parameter] public string? InputCssClass { get; set; } = "text-end pe-2";

    private async Task OnValueChanged(TValue newValue)
    {
        Value = newValue;
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(newValue);
        }
    }
}
