@*
   Edit formunun yapısal başlığını (L1/L2/L3 + ikon + dirty "*") çizen TEK görsel.
   Üç tüketici: MDI tab caption (Compact), top-panel aktif-tab başlığı, popup header.
   Kod-arkası: EditHeaderView.razor.cs · stiller: EditHeaderView.razor.css.
*@

@if (Header is not null)
{
    var h = Header;
    var l1 = string.IsNullOrEmpty(h.NewPrefix) ? h.FormCaption : $"{h.NewPrefix} {h.FormCaption}";
    var hasL2 = !string.IsNullOrEmpty(h.EntityValue);
    var showStar = ShowDirty && IsDirty;
    var rootClass = "eh-root" + (Compact ? " eh-compact" : "") + (hasL2 ? " has-l2" : "");

    <div class="@rootClass">
        @if (!string.IsNullOrEmpty(h.IconCssClass))
        {
            <i class="eh-icon @h.IconCssClass" aria-hidden="true"></i>
        }
        <div class="eh-text">
            <span class="eh-l1">
                @l1
                @if (!hasL2 && showStar)
                {
                    <span class="eh-dirty" aria-label="@DirtyLabel">*</span>
                }
            </span>
            @if (hasL2)
            {
                <span class="eh-l2">
                    @h.EntityValue
                    @if (showStar)
                    {
                        <span class="eh-dirty" aria-label="@DirtyLabel">*</span>
                    }
                </span>
            }
            @if (h.HasParent)
            {
                <span class="eh-l3">@h.ParentLabel : @h.ParentValue</span>
            }
        </div>
    </div>
}
