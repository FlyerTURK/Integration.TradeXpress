@typeparam TGetDto where TGetDto : class, Integration.Framework.Base.Dtos.Interfaces.IGetDto<TKey>, new()
@typeparam TListDto where TListDto : class, Integration.Framework.Base.Dtos.Interfaces.IListDto<TKey>, new()
@typeparam TKey
@typeparam TListRequestDto where TListRequestDto : class, new()
@using System
@using System.Collections.Generic
@using DevExpress.Blazor
@using Integration.Framework.Blazor.Client.Services.Base
@using Integration.Framework.Blazor.Client.Services.Mdi
@inherits CrudComponentBase
@inject IUiInteractionService UiService
@inject IEntityChangeNotifier EntityChanges
@inject IMdiTabOpener TabOpener
@inject IServiceProvider ServiceProvider

@*
   GENERIC edit host — persistence sahibi (ICommitCoordinator) + agnostic EntityEditForm sunumu.
   Entity-spesifik her şey PARAMETRE: coordinator (sarmal kurar), Layout (ChildContent), defaults, ref'ler
   sarmalda, header/değer/validasyon/readonly/silme callback'leri. Böylece entity başına yalnız İNCE bir
   sarmal (AppService inject + coordinator + Layout + config) + Layout kalır. commit/save/delete/close TEK yerde.
*@

@if (_loadFailedMessage is { } failMessage)
{
    @* Kayıt yüklenemedi (tipik: silinmiş kayıt + sekme kalıcılığı). Toast/sekme-kapatma bazı yaşam-döngüsü
       anlarında (prerender) kendisi patlayabildiğinden bu satır içi panel SON GÜVENCEDİR — hiçbir koşulda
       hata sayfasına düşülmez, kullanıcı sekmeyi butonla kapatır. *@
    <div style="padding:1rem; display:flex; flex-direction:column; gap:0.75rem; align-items:flex-start;">
        <span>@failMessage</span>
        <DxButton Text="@L["Close"].Value" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(async () => await CloseAsync())" />
    </div>
}
else
{
@* DÜZEN ÖNCE ÇİZİLİR, VERİ SONRA İŞLENİR (2026-08-13 Hakan kararı: "Layout yüklenmiş olsun ve loading
   panel gösterilsin. Sonrasında dto bilgisi form elemanlarına işlensin").

   Eskiden model gelene kadar HİÇBİR ŞEY çizilmiyordu: popup boş bir çerçeve olarak açılıyor, sonra form
   birden beliriyordu. Artık düzen boş bir modelle hemen çizilir, üzerine gölgeli + tıklamayı engelleyen
   yükleme paneli biner; kayıt gelince model referansı DEĞİŞİR ve EntityEditForm kendini yeniden bağlar
   (OnParametersSet'te EditContext + temiz snapshot yenilenir), yani alanlar gerçek veriyle dolar ve form
   "kirli" görünmez.

   Boş modelle çizim güvenlidir çünkü aynı düzen YENİ KAYIT akışında da tam olarak böyle çiziliyor —
   layout'lar boş DTO'yu zaten desteklemek zorunda.

   ⚠ Bu dal DxPopup'ın içeriği gizliyken render ETMEMESİ gerçeğiyle uyumludur: popup açılır (içerik render
   olur), yükleme onun İÇİNDE görünür. "Popup'ı yüklenene kadar hiç açma" yolu bu yüzden seçilmedi. *@
    <div id="@_formAreaId" style="width:100%; height:100%; display:flex; flex-direction:column; min-height:0;">
    <EntityEditForm TGetDto="TGetDto" TListDto="TListDto" TKey="TKey"
                    Model="@EffectiveModel" IsNew="@_isNew"
                    FormCaption="@FormCaption"
                    FormCaptionKey="@FormCaptionKey"
                    EntityValue="@(EntityValue?.Invoke(EffectiveModel))"
                    ParentLabel="@ParentLabel"
                    ParentLabelKey="@ParentLabelKey"
                    ParentValue="@(ParentValue?.Invoke(EffectiveModel))"
                    IconCssClass="@IconCssClass"
                    CanDeleteRecord="@((CanDelete?.Invoke(EffectiveModel) ?? true) && !_isNew && _model is not null)"
                    IsReadOnly="@(IsReadOnly?.Invoke(EffectiveModel) ?? false)"
                    ReadOnlyNoticeText="@ReadOnlyNotice"
                    SupportsSaveAndNew="@SupportsSaveAndNew"
                    SupportsDelete="@SupportsDelete"
                    BuildCustomActions="@BuildCustomActions"
                    Placement="@Placement"
                    ValidateContext="@ValidateContext"
                    HasExtraChanges="@HasExtraChanges"
                    OnCommit="CommitAsync"
                    OnSaveAndNew="SaveAndNewAsync"
                    OnSaveAndClose="SaveAndCloseAsync"
                    OnClose="CloseAsync"
                    OnDelete="DeleteAsync">
        @ChildContent(context)
    </EntityEditForm>
    </div>

    @* Kayıt gelene kadar formun ÜZERİNDE gölgeli katman: yarı dolu bir forma yazılmasını engeller.
       Veri gelince kapanır — ayrı bir "hazır" sinyali gerekmez, model referansının dolması yeterlidir. *@
    <FormLoadingPanel Visible="@(_model is null)" PositionTargetSelector="@($"#{_formAreaId}")" />
}

@code {
    // ── Sarmaldan gelen ──
    /// <summary>Persistence sınırı — sarmal concrete AppService ile kurar (kapalı generic DI'dan çözülmez).</summary>
    [Parameter, EditorRequired] public ICommitCoordinator<TGetDto, TListDto, TKey, TListRequestDto> Coordinator { get; set; } = default!;
    /// <summary>Dumb Layout (GetDto'yu forma yansıtır).</summary>
    [Parameter, EditorRequired] public RenderFragment<TGetDto> ChildContent { get; set; } = default!;

    /// <summary>Düzenlenecek kayıt; boş/default → yeni kayıt. (Unconstrained TKey'de nullable kullanılamaz —
    /// sarmal Guid?'yi <c>?? Guid.Empty</c> ile unwrap edip verir.)</summary>
    [Parameter] public TKey Id { get; set; } = default!;
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    /// <summary>Cross-tab liste tazeleme anahtarı. Boşsa typeof(TListDto).FullName → CrudPageBase'in default'uyla
    /// otomatik eşleşir (özel key'li listelerde — Roles/Users — sarmal verir).</summary>
    [Parameter] public string? EntityChangeKey { get; set; }

    // MDI tab bağlamı (routable host tab'da açılınca cascade gelir). Popup'ta null → tab-close yerine OnClosed.
    [CascadingParameter(Name = "CurrentMdiTab")] public IMdiTab? CurrentMdiTab { get; set; }

    private string ResolvedKey => EntityChangeKey ?? typeof(TListDto).FullName ?? typeof(TListDto).Name;

    // Header (yapısal 3-satır)
    [Parameter] public string? FormCaption { get; set; }
    [Parameter] public string? IconCssClass { get; set; }
    [Parameter] public string? ParentLabel { get; set; }

    // Opsiyonel lokalizasyon anahtarları — EntityEditForm'a aktarılır (sekme restore'unda başlık
    // güncel kültürle çözülsün; bkz. TabHeaderData.FormCaptionKey).
    [Parameter] public string? FormCaptionKey { get; set; }
    [Parameter] public string? ParentLabelKey { get; set; }
    [Parameter] public Func<TGetDto, string?>? EntityValue { get; set; }
    [Parameter] public Func<TGetDto, string?>? ParentValue { get; set; }

    /// <summary>Yeni kayıt fabrikası: NewModel sonrası bağlam default'larını uygula (IsActive=true, parent FK vb.).</summary>
    [Parameter] public Action<TGetDto>? ApplyNewDefaults { get; set; }
    /// <summary>Model HAZIR olunca (yeni VEYA yüklenmiş; snapshot ÖNCESİ) çalışır — fetch'e bağlı default'lar için
    /// (ör. CurrencyUnit EnsureFollowingDefault). Burada yapılan değişiklik temiz baz'a girer (dirty saymaz).</summary>
    [Parameter] public Func<TGetDto, Task>? OnModelReady { get; set; }
    /// <summary>Silinebilir mi (model'e göre; ör. !IsDefault). Yeni kayıtta zaten kapalı.</summary>
    [Parameter] public Func<TGetDto, bool>? CanDelete { get; set; }
    /// <summary>Salt-okunur mu (ör. tenant'ta global kayıt).</summary>
    [Parameter] public Func<TGetDto, bool>? IsReadOnly { get; set; }
    [Parameter] public string? ReadOnlyNotice { get; set; }
    /// <summary>Bu edit "Kaydet ve Yeni"yi destekliyor mu? false ise toolbar butonu gizlenir (EntityEditForm'a pas).
    /// Default true (mevcut TÜM edit host'ları değişmez). Create'i olmayan edit-only entity'ler false verir.</summary>
    [Parameter] public bool SupportsSaveAndNew { get; set; } = true;
    /// <summary>Bu edit Sil'i destekliyor mu? false ise toolbar Sil'i gizler (EntityEditForm'a pas). Default true.</summary>
    [Parameter] public bool SupportsDelete { get; set; } = true;
    /// <summary>Edite özel ek toolbar aksiyonları (EntityEditForm'a pas — bkz. orada). Default null.</summary>
    [Parameter] public Func<TGetDto, IReadOnlyList<CrudToolbarAction>>? BuildCustomActions { get; set; }
    /// <summary>Bağlamsal validasyon (model attribute'larına EK; ör. Guid FK boş değil).</summary>
    [Parameter] public Func<TGetDto, IReadOnlyList<KeyValuePair<string, string>>>? ValidateContext { get; set; }
    [Parameter] public ToolbarPlacement Placement { get; set; } = ToolbarPlacement.Top;

    /// <summary>Model'e YANSIMAYAN harici dirty (ör. izin paneli) → CanSave / "*" / kapanış-onayı buna da bakar.</summary>
    [Parameter] public Func<bool>? HasExtraChanges { get; set; }
    /// <summary>Ana commit'ten SONRA çalışır (taze model ile) — AYRI servise yazan paneller için. Role/User:
    /// izin paneli, rol/kullanıcı kaydedildikten (ProviderKey artık geçerli) sonra izinlerini kendi servisine yazar.</summary>
    [Parameter] public Func<TGetDto, Task>? OnAfterCommit { get; set; }
    /// <summary>Yalnız YENİ kaydın commit'inden SONRA çalışır (taze model ile; OnAfterCommit'in ardından) —
    /// create-anı orkestrasyonları için (ör. Trendyol kanalı oluşturulunca ürün importunun otomatik tetiklenmesi).
    /// Update commit'lerinde ÇALIŞMAZ.</summary>
    [Parameter] public Func<TGetDto, Task>? OnAfterCreate { get; set; }

    private TGetDto? _model;
    private bool _isNew = true;

    // Yükleme panelinin üzerine bineceği form alanının DOM id'si — kalıcı kimlik DEĞİL, yalnız CSS seçicisi.
    private readonly string _formAreaId = $"crud-edit-area-{Guid.NewGuid():N}";

    // Kayıt gelmeden ÖNCE düzenin çizilebilmesi için kullanılan boş model. Yalnız BİR kez üretilir:
    // her render'da yenisi üretilseydi referans sürekli değişir, EntityEditForm her seferinde kendini
    // yeniden bağlar (yeni EditContext + yeni snapshot) ve form kullanılamaz hâle gelirdi.
    private TGetDto? _placeholder;

    /// <summary>Forma bağlanan model — kayıt geldiyse O, gelmediyse boş yer tutucu. Yer tutucudan gerçek
    /// modele geçiş bir REFERANS değişimidir; <c>EntityEditForm.OnParametersSet</c> bunu görüp EditContext'i
    /// ve temiz snapshot'ı yeniler, böylece alanlar dolar ama form "değiştirilmiş" sayılmaz.</summary>
    private TGetDto EffectiveModel
    {
        get { return _model ?? (_placeholder ??= Coordinator.NewModel()); }
    }

    // Sekme "/entity/new" rotasıyla açıldıysa orijinal URL — kaydet sonrası "/entity/{id}" retarget'i
    // ve Kaydet&Yeni'de geri dönüş için saklanır (aynı kayda ikinci sekme açılmasın).
    private string? _newTabUrl;

    /// <summary>Sekmenin "yükleniyor" bileti — kayıt çekilene kadar açık (bkz. TabContentLoad).</summary>
    private TabLoadTicket? _loadTicket;

    // Yükleme hatası mesajı — dolu ise form yerine satır içi hata paneli çizilir (hata sayfası ASLA).
    private string? _loadFailedMessage;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentMdiTab is { } tab && tab.Url.EndsWith("/new", StringComparison.OrdinalIgnoreCase))
            _newTabUrl = tab.Url;

        // Edit sekmesi ilk açıldığında kayıt gelene kadar yükleniyor paneli. Bilet finally'de kapanır:
        // fetch patlarsa da panel asılı kalmasın.
        _loadTicket = CurrentMdiTab?.Load.Begin();
        try
        {
            await LoadAsync();
        }
        finally
        {
            _loadTicket?.Dispose();
            _loadTicket = null;
        }
    }

    private async Task LoadAsync()
    {
        if (!IsEmptyKey(Id))
        {
            try
            {
                _model = await Coordinator.GetForEditAsync(Id);
            }
            catch (Exception ex)
            {
                // Kayıt YÜKLENEMEDİ — en sık sebep: silinmiş kayıt, sekme kalıcılığı eski URL'i geri getirdi
                // (2026-07-28 Hakan: ürünü silip geri dönünce hata sayfası). Circuit'i düşürmek yerine dostane
                // bildir + sekmeyi kapat: hata sayfası "uygulama bozuldu" dedirtiyordu, oysa formun içinde
                // kurtarılacak hiçbir kullanıcı verisi yok (henüz hiçbir şey yüklenmedi) — kapanması kayıpsız.
                // Yakalama BİLEREK GENİŞ: özel tip filtresi (EntityNotFoundException adı) sahada ıskaladı;
                // hangi sebeple yüklenemezse yüklenemesin doğru davranış aynı. Silinmiş-kayıt dışındaki
                // sebepler mesajda ayrışır (aşağıda) ki gerçek hatalar sessizce "silinmiş" sanılmasın.
                var notFound = ex.ToString().Contains("EntityNotFoundException", StringComparison.Ordinal)
                    || ex.ToString().Contains("no such an entity", StringComparison.OrdinalIgnoreCase);
                _loadFailedMessage = notFound ? L["EntityNoLongerExists"].Value : ex.Message;

                // Toast YOK (2026-07-28 Hakan): mesaj zaten satır içi panelde duruyor, toast onu tekrarlıyordu.
                // Otomatik kapatma DENENİR ama zorunlu değildir: bazı yaşam-döngüsü anlarında (prerender) JS
                // interop atar — o durumda panel + Kapat butonu devreye girer, circuit asla düşmez.
                try
                {
                    await CloseAsync();
                }
                catch
                {
                    // panel gösterilecek — sekme açık kalır, kullanıcı butonla kapatır
                }

                return;
            }

            _isNew = false;
        }
        else
        {
            _model = NewModel();
            _isNew = true;
        }

        if (OnModelReady != null)
            await OnModelReady(_model);   // fetch'e bağlı default'lar (snapshot öncesi → dirty saymaz)
    }

    private TGetDto NewModel()
    {
        var m = Coordinator.NewModel();
        ApplyNewDefaults?.Invoke(m);
        return m;
    }

    private async Task CommitAsync(TGetDto m)
    {
        var wasNew = _isNew;
        try
        {
            _model = await Coordinator.CommitAsync(m);   // taze model → rebind (* gider)
            _isNew = false;

            // Yeni kayıt sekmede kaydedildi ve sekme açık kaldı → sekme artık BU KAYDI temsil eder:
            // URL "/entity/new" → "/entity/{id}". Listeden Düzelt aynı URL'i bulup bu sekmeyi aktive
            // eder (ikinci sekme açılmaz); form zaten update moduna geçti (_isNew=false).
            if (wasNew && _newTabUrl != null && CurrentMdiTab is { } savedTab)
                TabOpener.UpdateTabUrl(savedTab.Id, _newTabUrl[..^3] + _model.Id);
            // Extra-commit: ana kayıt SONRASI ayrı servise yazan paneller (ör. izinler → artık var olan rol/kullanıcı adına).
            if (OnAfterCommit != null) await OnAfterCommit(_model);
            // Create-anı orkestrasyonu: yalnız YENİ kaydın commit'inde (update'te asla).
            if (wasNew && OnAfterCreate != null) await OnAfterCreate(_model);
            UiService.ShowSuccessToast(L["SuccessfullySaved"].Value);
            EntityChanges.Notify(ResolvedKey, wasNew ? EntityChangeKind.Created : EntityChangeKind.Updated, _model.Id);  // cross-tab liste tazele
            await OnSaved.InvokeAsync();                 // popup açan listeyi de tazele (varsa)
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowError(ex);        // lokalize dostu mesaj; form açık + dirty kalır
        }
    }

    private Task SaveAndNewAsync()   // commit zaten OnCommit'te oldu → yeni boş forma geç
    {
        _model = NewModel();
        _isNew = true;

        // Form yeniden "yeni" moduna döndü → sekme URL'i de "new" rotasına dönsün (retarget geri alınır);
        // aksi hâlde sekme az önce kaydedilen kaydın URL'ini taşımaya devam ederdi.
        if (_newTabUrl != null && CurrentMdiTab is { } tab)
            TabOpener.UpdateTabUrl(tab.Id, _newTabUrl);

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task SaveAndCloseAsync() => CloseAsync();   // commit zaten oldu

    private async Task DeleteAsync()
    {
        if (_isNew || _model == null) return;   // onay EntityEditForm'da soruldu
        try
        {
            var deletedId = _model.Id;
            await Coordinator.DeleteAsync(deletedId);
            UiService.ShowSuccessToast(L["SuccessfullyDeleted"].Value);
            EntityChanges.Notify(ResolvedKey, EntityChangeKind.Deleted, deletedId);   // cross-tab liste tazele
            await OnSaved.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
    }

    // In-process (Blazor Server) BusinessException.Message ham kod/generic metindir → önce kodu MapCodeNamespace
    // kaynağıyla lokalize et (CrudErrorPresenter); dostu mesaj yoksa genel metin + teknik detayı panele raporla.
    // Çok satırlı (validation) mesaj → satır başına ayrı toast (XAF tarzı).
    private void ShowError(Exception ex)
    {
        var friendly = CrudErrorPresenter.ToFriendlyMessage(ex, ServiceProvider);
        if (friendly is null)
            (ServiceProvider.GetService(typeof(IClientErrorReporter)) as IClientErrorReporter)?.Report(ex.Message, ex.ToString());

        var text = friendly ?? L["UnexpectedError"].Value;
        var lines = text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length == 0) { UiService.ShowErrorToast(text); return; }
        foreach (var line in lines) UiService.ShowErrorToast(line);
    }

    // Tab modunda (CurrentMdiTab var) sekmeyi kapat (CanCloseAsync guard'ı EntityEditForm'da kuruldu);
    // popup modunda OnClosed (açan host/PopupService kapatır).
    private async Task CloseAsync()
    {
        if (CurrentMdiTab is { } tab)
            await TabOpener.TryCloseAsync(tab.Id);
        else
            await OnClosed.InvokeAsync();
    }

    private static bool IsEmptyKey(TKey key) => EqualityComparer<TKey>.Default.Equals(key, default!);
}
