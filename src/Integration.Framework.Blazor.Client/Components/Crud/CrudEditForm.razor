@using System.Linq
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components.Forms
@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@implements System.IDisposable

@*
   Edit formu KOORDİNATÖRÜ (kompozisyon — base sınıf değil). Yere göre sayfa/popup gösteren
   CrudEditView kabuğunu sarar; içine Blazor EditForm + validation özeti koyar. Save/Cancel artık
   CrudEditView'in FooterTemplate'inde (DevExpress footer'ı — kayan gövdenin DIŞINDA, sabit) bir
   DxToolbar olarak render edilir. StateService'ten habersizdir; her şeyi parametreyle alır.
*@

<CrudEditView Mode="Mode" Visible="Visible" VisibleChanged="VisibleChanged" Title="@Title"
              HeaderIconCssClass="@HeaderIconCssClass">
    <ChildContent>
        @if (EditContext != null)
        {
            <EditForm EditContext="EditContext" OnValidSubmit="OnValidSubmitAsync" Context="editForm">
                <LocalizedDataAnnotationsValidator />

                @* Inline stiller: bu app'te Bootstrap utility/component class'ları (alert, d-flex,
                   border-top, spinner-border) etkisiz; bağımlılık bırakmadan kendi içinde duran sunum. *@
                @if (EditContext.GetValidationMessages().Any())
                {
                    <div style="background:#f8d7da; color:#842029; border:1px solid #f5c2c7; border-radius:0.375rem; padding:0.5rem 0.75rem; margin-bottom:1rem;">
                        <ValidationSummary />
                    </div>
                }

                @ChildContent
            </EditForm>
        }
    </ChildContent>

    <Footer>
        @* Footer EditForm'un DIŞINDA (DevExpress footer'ı). Save bu yüzden form submit'ini elle
           tetikler: EditContext.Validate() → geçerliyse mevcut kaydet yolu (OnValidSubmitAsync).
           Padding/üst-çizgi FooterContentTemplate tarafından (tema) verilir; burada yalnız toolbar. *@
        @if (EditContext != null)
        {
            @* Ortak standart footer (tek kaynak) — DrillList ile aynı bileşen. *@
            <CrudFooterToolbar OnSave="HandleSaveClick" OnSaveAndNew="HandleSaveAndNewClick" OnCancel="CancelAsync"
                               ShowSaveAndNew="@ShowSaveAndNew" CanSave="@CanSave" IsBusy="@IsBusy" />
        }
    </Footer>
</CrudEditView>

@code {
    /// <summary>Sayfa mı popup mu — yerine göre.</summary>
    [Parameter] public EditViewMode Mode { get; set; } = EditViewMode.Popup;

    /// <summary>Popup modunda görünürlük (iki yönlü). "false" = kapat/iptal sinyali.</summary>
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public string? Title { get; set; }

    /// <summary>Header'da opsiyonel ikon. Varsayılan: generic "düzenle" ikonu (entity'ye özel geçilebilir).</summary>
    [Parameter] public string? HeaderIconCssClass { get; set; } = "fas fa-pen-to-square";

    /// <summary>Düzenlenen modelin EditContext'i (sahibi çağırandır; burada yalnız kullanılır).</summary>
    [Parameter] public EditContext? EditContext { get; set; }

    /// <summary>Form içeriği — layout (ör. CompanyEditFormLayout).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool CanSave { get; set; } = true;

    /// <summary>Geçerli submit'te tetiklenir (kaydet).</summary>
    [Parameter] public EventCallback OnSave { get; set; }

    /// <summary>Kaydet ve Yeni — kaydedip yeni kayıt moduna geçer.</summary>
    [Parameter] public EventCallback OnSaveAndNew { get; set; }

    /// <summary>"Kaydet ve Yeni" butonu gösterilsin mi (page bu akışı bağladıysa true).</summary>
    [Parameter] public bool ShowSaveAndNew { get; set; }

    private EditContext? _subscribed;

    protected override void OnParametersSet()
    {
        // Dokunulmamış alanlarla submit denemesi validation-state değiştirir (field değil) → koşullu
        // özetin görünmesi için yeniden render et.
        if (!ReferenceEquals(_subscribed, EditContext))
        {
            if (_subscribed != null) _subscribed.OnValidationStateChanged -= OnValidationStateChanged;
            _subscribed = EditContext;
            if (_subscribed != null) _subscribed.OnValidationStateChanged += OnValidationStateChanged;
        }
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    // Footer EditForm DIŞINDA olduğundan submit'i elle tetikleriz: önce doğrula, geçerliyse kaydet.
    // Validate() koşullu ValidationSummary'i de günceller (OnValidationStateChanged → re-render).
    private async Task HandleSaveClick()
    {
        if (EditContext != null && EditContext.Validate())
            await OnValidSubmitAsync();
    }

    private async Task HandleSaveAndNewClick()
    {
        if (EditContext != null && EditContext.Validate() && OnSaveAndNew.HasDelegate)
            await OnSaveAndNew.InvokeAsync();
    }

    private async Task OnValidSubmitAsync()
    {
        if (OnSave.HasDelegate) await OnSave.InvokeAsync();
    }

    private async Task CancelAsync() => await VisibleChanged.InvokeAsync(false);

    public void Dispose()
    {
        if (_subscribed != null) _subscribed.OnValidationStateChanged -= OnValidationStateChanged;
    }
}
