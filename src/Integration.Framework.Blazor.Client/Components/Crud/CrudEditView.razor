@using DevExpress.Blazor

@*
   Edit formunun kabuğu — içeriği (form layout'u) ya SAYFA içinde ya da POPUP içinde gösterir.
   Popup modunda: header'da opsiyonel ikon + başlık (sola yaslı), kayan body (BodyContentTemplate) + DevExpress'in
   kendi footer'ı (FooterTemplate) → Save/Cancel toolbar'ı içerikle KAYMAZ, hep altta sabit.
*@

@if (Mode == EditViewMode.Popup)
{
    @* Göreceli genişlik (standart DevExpress): masaüstü = min(95vw, 720px); mobilde yerleşik
       EnableAdaptivity göreceli genişlikle birlikte popup'ı tam ekrana yayar. Mutlak px (720px)
       adaptivity'nin mobil yeniden-boyutlandırmasını bastırdığından kullanılmaz. *@
    <DxPopup Visible="@Visible"
             VisibleChanged="VisibleChanged"
             Width="@(_isFullscreen ? "100%" : (_isMinimized ? "350px" : "95%"))"
             MaxWidth="@(_isFullscreen ? "100vw" : (_isMinimized ? "350px" : "720px"))"             MinHeight="@(_isMinimized ? "0" : "150px")"
             MaxHeight="@(_isFullscreen ? "100vh" : "90vh")"
             Height="@(_isFullscreen ? "100%" : null)"
             Scrollable="true"
             ShowBackdrop="@(!_isMinimized)"
             AllowDrag="@(!_isFullscreen && !_isMinimized)"
             AllowResize="@(!_isFullscreen)"
             HorizontalAlignment="@(_isMinimized ? HorizontalAlignment.Left : HorizontalAlignment.Center)"
             VerticalAlignment="@(_isMinimized ? VerticalAlignment.Bottom : VerticalAlignment.Center)"
             ShowFooter="@(Footer != null)"
             ShowCloseButton="@(!_isMinimized)"
             CloseOnEscape="true"
             CloseOnOutsideClick="false"
             CssClass="@($"crud-edit-popup {(_isFullscreen ? "fullscreen-popup " : "")} {(_isMinimized ? "minimized-popup " : "")}")">
        <HeaderContentTemplate Context="popup">
            @* Layout INLINE (utility class'a güvenme): Fluent teması Bootstrap CSS getirmediğinden
               position-absolute/d-flex/flex-grow-1 etkisiz kalıp butonlar başlığın altına kayıyordu. *@
            <div class="flex-grow-1 w-100 h-100 position-relative d-flex align-items-center" style="user-select: none; position: relative; display: flex; align-items: center; flex-grow: 1; width: 100%; height: 100%;" @ondblclick="@(() => { if (_isMinimized) ToggleMinimize(); else ToggleFullscreen(); })">
                <div class="flex-grow-1" style="flex-grow: 1; display:flex; align-items:center; gap:0.5rem; justify-content:flex-start; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; padding-right: 60px;">
                    @if (!string.IsNullOrEmpty(HeaderIconCssClass))
                    {
                        <span class="@HeaderIconCssClass" aria-hidden="true" style="color:var(--dxbl-primary, #2563eb);"></span>
                    }
                    <span>@Title</span>
                </div>
                <div class="position-absolute d-flex align-items-center" style="position: absolute; display: flex; align-items: center; right: 8px; top: 50%; transform: translateY(-50%); gap: 4px;">
                    <DxButton RenderStyle="ButtonRenderStyle.None" CssClass="d-flex flex-shrink-0 align-items-center justify-content-center p-0" Click="ToggleMinimize" tabindex="-1"><i class="@(_isMinimized ? "custom-icon-restore-min" : "custom-icon-minimize-corner")" style="width: 20px; height: 20px;"></i></DxButton>
                    <DxButton RenderStyle="ButtonRenderStyle.None" CssClass="@($"d-none {(_isMinimized ? "" : "d-md-flex")} align-items-center justify-content-center p-0")" Click="ToggleFullscreen" tabindex="-1"><i class="@(_isFullscreen ? "custom-icon-minimize" : "custom-icon-maximize")" style="width: 20px; height: 20px;"></i></DxButton>
                </div>
            </div>
        </HeaderContentTemplate>
        <BodyContentTemplate Context="popup">
            <div style="@(_isMinimized ? "display: none !important;" : "")">
                @ChildContent
            </div>
        </BodyContentTemplate>
        @* FooterContentTemplate (FooterTemplate değil): BodyContentTemplate ile AYNI tema padding'i + üst ayraç
           çizgisini otomatik uygular → footer içeriği her temada body ile hizalı kalır. *@
        <FooterContentTemplate Context="popup">
            <div style="@(_isMinimized ? "display: none !important;" : "")">
                @Footer
            </div>
        </FooterContentTemplate>
    </DxPopup>
}
else
{
    @ChildContent
    @Footer
}

@code {
    private bool _isFullscreen;
    private bool _isMinimized;

    private void ToggleFullscreen()
    {
        _isMinimized = false;
        _isFullscreen = !_isFullscreen;
    }

    private void ToggleMinimize()
    {
        _isFullscreen = false;
        _isMinimized = !_isMinimized;
    }

    /// <summary>Sayfa mı, popup mu — yerine göre çağıran belirler.</summary>
    [Parameter] public EditViewMode Mode { get; set; } = EditViewMode.Page;

    /// <summary>Popup modunda görünürlük (iki yönlü).</summary>
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>Popup başlığı.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Header'da başlığın solunda gösterilecek opsiyonel ikon (CSS class). Boşsa ikon yok.</summary>
    [Parameter] public string? HeaderIconCssClass { get; set; }

    /// <summary>Gösterilecek form içeriği (ör. CompanyEditFormLayout).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Footer içeriği (Save/Cancel toolbar'ı). Popup'ta DevExpress footer'ında (sabit),
    /// sayfa modunda içeriğin altında render edilir.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }
}























