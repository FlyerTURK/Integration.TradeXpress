@typeparam TGetDto where TGetDto : class, Integration.Framework.Base.Dtos.Interfaces.IGetDto<TKey>, new()
@typeparam TListDto where TListDto : class, Integration.Framework.Base.Dtos.Interfaces.IListDto<TKey>, new()
@typeparam TKey

@using Integration.Framework.Blazor.Client.Services.Base
@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Tek MERKEZİ toolbar (ERPPROV3 kalıbı) — Liste / Split / Edit üç bağlamı yönetir.
   BuildActions() tüm stock + custom aksiyonları TEK descriptor listesinde toplar; SortedActions
   Alignment + SortIndex'e göre sıralar; aşağıdaki tek foreach DxToolbar'a basar.
   ÖNEMLİ: foreach içinde @@if/else ile FARKLI element üretmek (ya da <Template>/<Items>'ı @@if'e
   sarmak) Blazor render-tree sequence'ini bozup DevExpress item sırasını karıştırır → HER item için
   TEK DxToolbarItem; Template ve Items RenderFragment ATTRIBUTE olarak (null olabilir) verilir.
   Böylece sıra yalnız SortIndex'ten gelir. *@
@* Çizim paylaşılan ToolbarRenderer'da — EditToolbar + DrillList liste toolbar'ı ile AYNI render (ikiz değil). *@
<ToolbarRenderer Actions="@SortedActions.ToList()" RenderMode="@RenderMode"
                 NarrowSearchTemplate="@SearchBoxTemplate" NarrowSearchVisible="@(ShowSearchIcon && NarrowSearchOpen)" />

@code {
    // Arama kutusu (masaüstü) — SortIndex=400 descriptor'ının Template'i (tipli; context kullanılmaz).
    private RenderFragment<IToolbarItemInfo> SearchBoxTemplate => context => @<text>
        @* [validation-expr] — DrillList'in arama kutusundaki ile AYNI koruma (orada zaten vardı, burada
           eksikti). Arama metni model alanı değildir; manuel bağlı editör EditContext altına düşerse
           TextExpression istenir ve circuit kopar. *@
        <DxTextBox Text="@_localSearchText"
                   TextChanged="OnLocalTextChanged"
                   ValidationEnabled="false"
                   NullText="@L["Search"]"
                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                   CssClass="grid-search-box">
            <Buttons>
                <DxEditorButton IconCssClass="xaf-search-icon" Tooltip="@L["Search"]" Click="OnSearchButtonClick" />
            </Buttons>
        </DxTextBox>
    </text>;

    // IsActive switch (Right, SortIndex=1000) — descriptor'ının Template'i (tipli; context kullanılmaz).
    private RenderFragment<IToolbarItemInfo> ActiveFilterTemplate => context => @<text>
        <div style="display:flex; align-items:center; gap:0.4rem; padding:0 0.25rem; white-space:nowrap;">
            @* [validation-expr] — DrillList'in aynı anahtarında CANLI çökme olarak yakalandı (2026-08-10).
               Burada bugün tetikleyici yok (liste toolbar'ı EditContext altında çizilmiyor) ama switch bir
               model alanı DEĞİL salt UI filtresidir; manuel bağlı Dx editörüne ValidationEnabled=false
               vermek kuralın kendisidir ve bu kabuk yarın bir formun içine girerse sessizce çökmesin. *@
            <DxCheckBox Checked="ActiveSwitchValue"
                        CheckedChanged="@((bool v) => OnActiveSwitchChanged(v))"
                        CheckType="CheckType.Switch"
                        ValidationEnabled="false" />
            @if (!IsMobile)
            {
                <span>@(ActiveSwitchValue ? L["ActiveRecords"] : L["PassiveRecords"])</span>
            }
        </div>
    </text>;
}
