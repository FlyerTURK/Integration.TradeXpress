@namespace Integration.Framework.Blazor.Client.Components.Crud
@using System.Collections.Generic
@using DevExpress.Blazor
@inject Integration.Framework.Blazor.Client.Services.Base.IUiStateService UiState
@*
   TxGrid — uygulamanın STANDART grid kabuğu. DxGrid'i ORTAK UX ile sarar (tek kaynak):
     • context menu (Header + DataRow), sütun yeniden boyutlandırma + yeniden sıralama,
     • kolon-düzeni KALICILIĞI: StateKey verilirse genişlik/sıra/sıralama kullanıcı başına saklanır
       (IUiStateService → her grid'de tekrarlanan LayoutLoading/Saving boilerplate'i SİLİNİR).
   Her grid yalnız Data + <Columns> verir; "burada context menu var, şurada yok" tutarsızlığı biter.

   DxGrid'in TÜM API'si erişilebilir: yaygın param'lar açık (selection/edit/RowClick/...), gerisi @attributes.
   İç DxGrid <see cref="InnerGrid"/> ile dışarı açılır (export vb.). Kolonlar cascade ile kaydolur → <Columns>
   forward GÜVENLİ. Açık verilmeyen param'lar null/default = zararsız (mevcut basit grid'ler etkilenmez).
*@
<DxGrid @ref="_innerGrid"
        @key="_layoutEpoch"
        Data="@Data"
        KeyFieldName="@KeyFieldName"
        ShowFilterRow="@ShowFilterRow"
        ShowGroupPanel="@ShowGroupPanel"
        SearchText="@SearchText"
        SelectedDataItems="@SelectedDataItems"
        SelectedDataItemsChanged="@SelectedDataItemsChanged"
        RowClick="@RowClick"
        CustomizeElement="@CustomizeElement"
        EditModelSaving="@EditModelSaving"
        DataItemDeleting="@DataItemDeleting"
        CustomizeEditModel="@CustomizeEditModel"
        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
        ContextMenus="GridContextMenus.Header | GridContextMenus.DataRow"
        CustomizeContextMenu="OnCustomizeContextMenu"
        AllowColumnReordering="true"
        AllowColumnResizing="true"
        CssClass="@CssClass"
        LayoutAutoLoading="OnLayoutLoading"
        LayoutAutoSaving="OnLayoutSaving"
        @attributes="MergedAttributes">
    <Columns>
        @if (ShowSelectionColumn)
        {
            @* STANDART seçim kolonu — her grid'de sola SABİT + VisibleIndex=0 + tümünü-seç; çağıran elle yazmaz. *@
            <DxGridSelectionColumn Width="40px" AllowSelectAll="true" FixedPosition="GridColumnFixedPosition.Left" AllowReorder="false" VisibleIndex="0" />
        }
        @Columns
    </Columns>
    <TotalSummary>
        @TotalSummary
    </TotalSummary>
</DxGrid>

@code {
    /// <summary>Grid verisi (DxGrid.Data).</summary>
    [Parameter] public object? Data { get; set; }

    /// <summary>Kolon tanımları — doğrudan DxGrid'in &lt;Columns&gt;'una forward edilir (cascade kaydı).</summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>Toplam-özet (footer) öğeleri — DxGrid'in &lt;TotalSummary&gt;'sine forward edilir. Boşsa özet satırı çizilmez.</summary>
    [Parameter] public RenderFragment? TotalSummary { get; set; }

    /// <summary>Verilirse kolon düzeni (genişlik/sıra/sıralama) kullanıcı başına KALICI olur (IUiStateService).
    /// Boşsa kalıcılık yok (her açılış varsayılan). Grid'e özgü benzersiz anahtar ver (ör. "report:position").</summary>
    [Parameter] public string? StateKey { get; set; }

    [Parameter] public string? CssClass { get; set; }

    // ── Açık tipli DxGrid parametreleri ────────────────────────────────────────────────────────
    // NEDEN: @attributes ile geçen LİTERAL değerler STRING yakalanır (tip dönüşümü yalnız DECLARED
    // parametrelerde olur) → bool/enum/int param literal verilince cast hatası. String/callback'ler açık tanımlı.
    [Parameter] public string? KeyFieldName { get; set; }
    [Parameter] public bool ShowFilterRow { get; set; }

    /// <summary>Gruplama paneli — kullanıcı kolon başlığını buraya sürükleyip satırları o kolona göre
    /// gruplayabilir. VARSAYILAN KAPALI: panel grid'in üstünde bir şerit yer kaplar ve çoğu drill birkaç
    /// satırlık alt listedir; oralarda gruplama gürültüdür.
    /// <para><b>Gruplanabilmenin ŞARTI kolonun bir VERİ ALANI (FieldName) taşımasıdır</b> — yalnız şablondan
    /// çizilen kolon gruplanamaz. 2026-08-10'da "Satışa Hazırlık" kolonunda tam bu yaşandı: hücre doluydu ama
    /// arkasında alan olmadığı için grid o kolonu tanımıyordu; çözüm kolonu değil MODELİ düzeltmekti.</para></summary>
    [Parameter] public bool ShowGroupPanel { get; set; }

    /// <summary>Grup satırının şablonu — verilmezse DevExpress kendi varsayılanını çizer.
    /// <para>Enum/bool kolonlarında GEREKLİDİR: varsayılan görünüm HAM değeri yazar ("NoRecipe", "True") ve
    /// kullanıcı o kelimeleri arayüzün hiçbir yerinde görmemiştir. Gruplamayı açmak, kolonun hücresini
    /// çizen şablonu grup satırında da düşünmeyi gerektirir.</para></summary>
    [Parameter] public RenderFragment<GridDataColumnGroupRowTemplateContext>? DataColumnGroupRowTemplate { get; set; }

    [Parameter] public string? SearchText { get; set; }

    /// <summary>true → grid'in başına STANDART seçim kolonu (sola SABİT, VisibleIndex=0, tümünü-seç) OTOMATİK eklenir.
    /// Çağıran &lt;Columns&gt;'a elle DxGridSelectionColumn YAZMAZ — her grid'de tek-tip seçim kolonu.</summary>
    [Parameter] public bool ShowSelectionColumn { get; set; }

    // Selection (iki-yönlü) + satır olayları + satır boyama (DrillList vb. zengin grid'ler için).
    [Parameter] public IReadOnlyList<object>? SelectedDataItems { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<object>> SelectedDataItemsChanged { get; set; }
    [Parameter] public EventCallback<GridRowClickEventArgs> RowClick { get; set; }
    [Parameter] public Action<GridCustomizeElementEventArgs>? CustomizeElement { get; set; }

    // Satır-içi (inline) düzenleme — DxGrid native EditRow akışı.
    [Parameter] public EventCallback<GridEditModelSavingEventArgs> EditModelSaving { get; set; }
    [Parameter] public EventCallback<GridDataItemDeletingEventArgs> DataItemDeleting { get; set; }
    [Parameter] public EventCallback<GridCustomizeEditModelEventArgs> CustomizeEditModel { get; set; }

    // Nullable non-string param'lar — SET edilince MergedAttributes ile TİPLİ değer olarak DxGrid'e enjekte edilir
    // (literal-string tuzağı yok; null = DxGrid default → mevcut grid'ler etkilenmez). GridSelectionMode'da 'None' YOK.
    [Parameter] public GridSelectionMode? SelectionMode { get; set; }
    [Parameter] public int? PageSize { get; set; }
    [Parameter] public bool? AllowSelectRowByClick { get; set; }
    [Parameter] public bool? PagerVisible { get; set; }
    [Parameter] public GridEditMode? EditMode { get; set; }
    [Parameter] public bool? VirtualScrollingEnabled { get; set; }

    /// <summary>false → kullanıcı kolon sort'u KAPALI (analitik/ön-sıralı tablolar için). StateKey varsa daha önce
    /// KAYDEDİLMİŞ sort da restore edilmez (DxGrid layout restore sort'u AllowSort'tan bağımsız programatik uygular
    /// — bayat sort ön-sıralı dizilimi ezmesin); genişlik/sıra kalıcılığı aynen sürer. null = DxGrid default (true).</summary>
    [Parameter] public bool? AllowSort { get; set; }

    /// <summary>DxGrid'in GÖMÜLÜ arama kutusu. Dar ekranda toolbar'daki arama kutusu ikona dönüşür ve ikon
    /// bunu açar (liste toolbar'ındaki davranışın aynısı) — kutu toolbar'da yer kaplamak yerine grid'in
    /// içinde açılır. null = DxGrid varsayılanı (kapalı).</summary>
    [Parameter] public bool? ShowSearchBox { get; set; }

    /// <summary>Sayfa boyutu seçici (pager yanında). Uzun listelerde kullanıcı sayfa başına kaç satır
    /// göreceğini kendisi seçer; kısa alt listelerde gürültü olduğu için varsayılan KAPALI.</summary>
    [Parameter] public bool? PageSizeSelectorVisible { get; set; }

    /// <summary>Yukarıda tanımlı OLMAYAN DxGrid parametreleri (style/class + ileride eklenecekler).
    /// Non-string bir param LİTERAL verilecekse önce yukarıya tipli [Parameter] olarak ekle (literal=string → cast hatası).</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private DxGrid? _innerGrid;

    /// <summary>İç DxGrid — export/scroll/API erişimi için (ör. DrillList ExportToXlsx/PdfSafeAsync). Render sonrası dolar.</summary>
    public IGrid? InnerGrid => _innerGrid;

    /// <summary>@attributes splat'ı: dış Attributes + tipli nullable param'lar (set edilenler). Tipli değer enjekte
    /// edildiği için cast sorunu yok; null param'lar eklenmez → DxGrid default'u korunur.</summary>
    private Dictionary<string, object>? MergedAttributes
    {
        get
        {
            if (DataColumnGroupRowTemplate is null && SelectionMode is null && PageSize is null && AllowSelectRowByClick is null && PagerVisible is null && EditMode is null && VirtualScrollingEnabled is null && AllowSort is null && ShowSearchBox is null && PageSizeSelectorVisible is null)
                return Attributes;
            var d = Attributes is null ? new() : new Dictionary<string, object>(Attributes);
            if (SelectionMode.HasValue) d["SelectionMode"] = SelectionMode.Value;
            if (PageSize.HasValue) d["PageSize"] = PageSize.Value;
            if (AllowSelectRowByClick.HasValue) d["AllowSelectRowByClick"] = AllowSelectRowByClick.Value;
            if (PagerVisible.HasValue) d["PagerVisible"] = PagerVisible.Value;
            if (EditMode.HasValue) d["EditMode"] = EditMode.Value;
            if (VirtualScrollingEnabled.HasValue) d["VirtualScrollingEnabled"] = VirtualScrollingEnabled.Value;
            if (AllowSort.HasValue) d["AllowSort"] = AllowSort.Value;
            if (ShowSearchBox.HasValue) d["ShowSearchBox"] = ShowSearchBox.Value;
            if (PageSizeSelectorVisible.HasValue) d["PageSizeSelectorVisible"] = PageSizeSelectorVisible.Value;
            // Sablon  ile gecer: DxGrid alt ogeleri kosullu YAZILAMAZ (RZ9996) ve kosulsuz bos
            // sablon vermek varsayilan grup satirini SILERDI. null = DxGrid kendi varsayilanini cizer.
            if (DataColumnGroupRowTemplate is not null) d["DataColumnGroupRowTemplate"] = DataColumnGroupRowTemplate;
            return d;
        }
    }

    // Header context-menü: Sola/Sağa Sabitle + Sabitlemeyi Kaldır (seçim kolonu hariç) — ortak helper, tüm grid'lerde aynı.
    // Bağlam menüsü: kolon sabitleme + GÖRÜNÜMÜ SIFIRLA (kaydedilmiş düzeni siler). Tek kaynak — her grid aynı.
    private void OnCustomizeContextMenu(GridCustomizeContextMenuEventArgs args) => GridColumnFixMenu.Add(args, ResetLayoutAsync);

    /// <summary>Kolon düzeni kalıcılığını SIFIRLAR: saklanan kayıt temizlenir ve DxGrid @key değişimiyle
    /// YENİDEN KURULUR — LayoutAutoLoading bu kez boş bulur, grid markup'taki varsayılana döner.
    /// <para>Yalnız state temizlemek yetmezdi: canlı grid düzeni bellekte durduğundan ekran ancak sayfa
    /// yenilenince düzelirdi. @key ile bileşen atılıp yeniden kurulur, etki ANINDA görünür.</para></summary>
    private async Task ResetLayoutAsync()
    {
        if (!string.IsNullOrEmpty(StateKey))
        {
            // Silme ucu yok; BOŞ kayıt "düzen yok" demektir (OnLayoutLoading boş/whitespace'i zaten atlar).
            try { await UiState.SaveGridStateAsync(StateKey, string.Empty); } catch { }
        }

        _layoutEpoch++;
        StateHasChanged();
    }

    // DxGrid'in @key'i — artınca bileşen yeniden kurulur (görünüm sıfırlama).
    private int _layoutEpoch;

    private async Task OnLayoutLoading(GridPersistentLayoutEventArgs e)
    {
        if (string.IsNullOrEmpty(StateKey)) return;
        var json = await UiState.GetGridStateAsync(StateKey);
        if (!string.IsNullOrWhiteSpace(json))
            try { e.Layout = System.Text.Json.JsonSerializer.Deserialize<GridPersistentLayout>(json); } catch { }

        // Sort kapalıyken (AllowSort=false) DAHA ÖNCE kaydedilmiş sort restore edilmez: layout restore
        // SortIndex'i AllowSort'tan bağımsız programatik uygular → bayat sort ön-sıralı veriyi ezerdi
        // (üstelik sort UI'ı kapalı olduğundan kullanıcı temizleyemezdi). Genişlik/sıra aynen yüklenir.
        // Layout tipleri record (init-only) → kolonlar SortIndex=-1 kopyalarıyla yeniden kurulur.
        if (AllowSort == false && e.Layout is { Columns: { } columns })
        {
            e.Layout = e.Layout with
            {
                Columns = new GridPersistentLayoutCollection<GridPersistentLayoutColumn>(
                    columns.Select(c => c with { SortIndex = -1 })),
            };
        }
    }

    private async Task OnLayoutSaving(GridPersistentLayoutEventArgs e)
    {
        if (string.IsNullOrEmpty(StateKey) || e.Layout == null) return;
        try { await UiState.SaveGridStateAsync(StateKey, System.Text.Json.JsonSerializer.Serialize(e.Layout)); } catch { }
    }
}
