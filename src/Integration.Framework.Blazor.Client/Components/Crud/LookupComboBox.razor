@typeparam TItem
@typeparam TValue
@using System
@using System.Collections.Generic
@using System.Linq.Expressions
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Integration.Framework.Blazor.Client.Services.Mdi
@using Integration.Framework.Blazor.Client.Services.Base
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IEntityChangeNotifier EntityChanges
@inject IViewOpener ViewOpener
@inject IPopupService PopupService
@inject IServiceProvider Services
@implements IDisposable

@*
   Generic referans lookup combo (ERPPROV3 deseni): DxComboBox + tıkla-aç dropdown (DropDownTriggerMode.Click) +
   native clear (ClearButtonDisplayMode) + arama + opsiyonel Edit(✎)/Add(+). Edit/Add = host delege (popup/navigate;
   Add → oluşan değeri auto-select). Dirty: custom ValueChanged Blazor hook'unu bypass eder → ValueExpression +
   EditContext.NotifyFieldChanged. ValidationEnabled=false: Value/ValueChanged ValueExpression taşımaz.
*@
<DxComboBox TData="TItem" TValue="TValue"
            Data="@Data"
            ValueFieldName="@ValueFieldName"
            TextFieldName="@TextFieldName"
            Value="@Value"
            ValueChanged="@OnInternalValueChanged"
            DropDownVisibleChanged="@OnDropDownVisibleChanged"
            @onblur="@OnBlurInternal"
            Enabled="@_effectiveEnabled"
            ReadOnly="@_effectiveReadOnly"
            NullText="@NullText"
            SearchMode="ListSearchMode.AutoSearch"
            SearchFilterCondition="@SearchFilterCondition"
            DropDownTriggerMode="DropDownTriggerMode.Click"
            ClearButtonDisplayMode="@_clearMode"
            ShowDropDownButton="@(!_effectiveReadOnly)"
            ValidationEnabled="false"
            CssClass="w-100"
            Columns="@Columns">
    <Buttons>
        <DxEditorButton IconCssClass="@EditIconCssClass" Visible="@ShowEditButton" Click="@OnEditButtonClick" Tooltip="@L["Edit"].Value" />
        <DxEditorButton IconCssClass="@AddIconCssClass" Visible="@ShowAddButton" Click="@OnAddButtonClick" Tooltip="@L["New"].Value" />
    </Buttons>
</DxComboBox>

@code {
    /// <summary>Bileşen tamamen odağı kaybettiğinde (dropdown kapalıyken) tetiklenir.</summary>
    [Parameter] public EventCallback LostFocus { get; set; }
    [Parameter, EditorRequired] public IEnumerable<TItem> Data { get; set; } = Array.Empty<TItem>();
    [Parameter, EditorRequired] public string ValueFieldName { get; set; } = "";
    [Parameter, EditorRequired] public string TextFieldName { get; set; } = "";

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    /// <summary>@bind-Value direktifinden gelir; EditContext'e dirty bildirmek için FieldIdentifier kaynağı.</summary>
    [Parameter] public Expression<Func<TValue?>>? ValueExpression { get; set; }

    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    /// <summary>Arama koşulu (default Contains; kod baştan yazılacaksa çağıran StartsWith verir).</summary>
    [Parameter] public ListSearchFilterCondition SearchFilterCondition { get; set; } = ListSearchFilterCondition.Contains;
    /// <summary>Nullable değerde native clear (×) gösterimi. Required (Guid) alanlarda false.</summary>
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public string? NullText { get; set; }

    /// <summary>Düzelt(✎)/Ekle(+) buton ikonları — DEFAULT standart (FrameworkIcons, tek-kaynak/DRY);
    /// gerekirse kullanım yerinde override edilir.</summary>
    [Parameter] public string EditIconCssClass { get; set; } = FrameworkIcons.LookupEdit;
    [Parameter] public string AddIconCssClass { get; set; } = FrameworkIcons.LookupAdd;

    /// <summary>Edit(✎) — seçili referansı düzenle (host popup/navigate açar; geçerli değer verilir). Boşsa gizli.</summary>
    [Parameter] public Func<TValue, Task>? OnEditRequested { get; set; }
    /// <summary>Add(+) — quick-add; host yeni referansı açar ve OLUŞAN değeri döndürür → combo auto-select. Boşsa gizli.</summary>
    [Parameter] public Func<Task<TValue?>>? OnAddRequested { get; set; }
    /// <summary>Dropdown kolonları — <c>DxListEditorColumn</c> elemanları buraya verilir.</summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>İlgili entity'nin edit host tipi (ör. <c>typeof(CurrencyUnitEditHost)</c>). Verilirse Add(+)/Edit(✎)
    /// butonları MERKEZÎ popup yolu (<see cref="IViewOpener"/>) ile o host'u açar — liste sayfasının "New/Edit"
    /// akışıyla AYNI mekanizma (ham DxPopup YOK). Override (OnAdd/OnEditRequested) verilmişse o öncelikli kalır.</summary>
    [Parameter] public Type? EditComponentType { get; set; }

    /// <summary>Add(+) butonunun YETKİ kapısı — host, ilgili Create iznini kontrol edip verir (UI gate;
    /// gerçek denetim server-side policy'de). Varsayılan true (izin kavramı olmayan lookuplar etkilenmez).</summary>
    [Parameter] public bool CanAdd { get; set; } = true;

    /// <summary>Edit(✎) butonunun YETKİ kapısı — host, ilgili Update iznini kontrol edip verir.</summary>
    [Parameter] public bool CanEdit { get; set; } = true;

    /// <summary>Add(+) için izin adı (ör. <c>TradeXpressPermissions.CurrencyUnits.Create</c>) — verilirse
    /// bileşen kendisi kontrol eder (host'ta elle IsGranted kodu gerekmez). null → kısıt yok.</summary>
    [Parameter] public string? CreatePolicy { get; set; }

    /// <summary>Edit(✎) için izin adı (ör. <c>...CurrencyUnits.Update</c>). null → kısıt yok.</summary>
    [Parameter] public string? UpdatePolicy { get; set; }

    // Policy sonuçları cache'lenir (OnParametersSetAsync her render'da koşar; izin adı değişmedikçe sorgulanmaz).
    private bool _createPolicyGranted = true;
    private bool _updatePolicyGranted = true;
    private string? _checkedCreatePolicy;
    private string? _checkedUpdatePolicy;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (!string.Equals(CreatePolicy, _checkedCreatePolicy, StringComparison.Ordinal))
        {
            _checkedCreatePolicy = CreatePolicy;
            _createPolicyGranted = CreatePolicy is null || await AuthorizationService.IsGrantedAsync(CreatePolicy);
        }

        if (!string.Equals(UpdatePolicy, _checkedUpdatePolicy, StringComparison.Ordinal))
        {
            _checkedUpdatePolicy = UpdatePolicy;
            _updatePolicyGranted = UpdatePolicy is null || await AuthorizationService.IsGrantedAsync(UpdatePolicy);
        }
    }

    /// <summary>Inline edit veya dış-sekme değişimi sonrası host'tan <see cref="Data"/>'yı yeniden yüklemesini ister
    /// (EntityChange tetikler). Auto-select için reload önce beklenir.</summary>
    [Parameter] public EventCallback OnLookupReloadRequested { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        EntityChanges.Changed += OnEntityChanged;   // inline/dış edit sonrası tazeleme + auto-select
    }

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }
    /// <summary>EntityEditForm salt-okunur (fieldset disabled) iken true → ✎/+ ve clear gizlenir (native disable görünür bırakırdı).</summary>
    [CascadingParameter(Name = "FormIsReadOnly")] private bool FormIsReadOnly { get; set; }

    // "Değer var mı": null / Guid.Empty / 0 → yok. AYRICA boş string de "yok" (string DTO alanının "" default'u
    // EqualityComparer'da null'a eşit DEĞİL → Edit/Clear yanlış görünürdü). Kalıcı fix burada → tüm kullanımlarda doğru.
    private bool _hasValue
    {
        get
        {
            if (EqualityComparer<TValue>.Default.Equals(Value, default!)) return false;
            return Value is not string s || s.Length > 0;
        }
    }
    private bool _isNullable => !typeof(TValue).IsValueType || Nullable.GetUnderlyingType(typeof(TValue)) is not null;

    // Form salt-okunur (fieldset disabled) → component'i de pasif/okunur say: native disable input'u kapatır ama
    // ✎/+ ve clear'ı görünür bırakırdı; efektif bayrakları her yerde kullan → disabled combo'da hiçbir buton çıkmaz.
    private bool _effectiveReadOnly => ReadOnly || FormIsReadOnly;
    private bool _effectiveEnabled => Enabled && !FormIsReadOnly;

    // Görünürlük (kural): handler override VEYA düzenleme bileşeni ÇÖZÜLEBİLİYORSA buton aktiftir.
    //   Add  → readonly/disabled değilse VE CanAdd (yetki kapısı) iken.
    //   Edit → readonly/disabled değil VE değer (EditValue) dolu VE CanEdit iken.
    //
    // ⚠ HEDEF TİPTEN DE ÇÖZÜLÜR (2026-08-07 Hakan kuralı): bu bileşenin varlık sebebi ekle/düzelt düğmeleridir
    // — "yoksa standart combo zaten işimizi görüyor". Eskiden düğmeler YALNIZ çağıran EditComponentType
    // verdiğinde çiziliyordu ve 69 kullanımın ancak 15'i veriyordu: geri kalanı sessizce düz combo'ya iniyordu.
    // Kayıt defteri VARSAYILANI sağlar; açık EditComponentType hâlâ önceliklidir (opt-out: CanAdd/CanEdit=false).
    private Type? _resolvedEditComponentType =>
        EditComponentType ?? Services.GetService<ILookupEditComponentRegistry>()?.Resolve(typeof(TItem));

    private bool _hasEditCapability => _resolvedEditComponentType is not null;
    private bool ShowEditButton => (OnEditRequested is not null || _hasEditCapability) && CanEdit && _updatePolicyGranted && !_effectiveReadOnly && _effectiveEnabled && _hasValue;
    private bool ShowAddButton => (OnAddRequested is not null || _hasEditCapability) && CanAdd && _createPolicyGranted && !_effectiveReadOnly && _effectiveEnabled;

    // Native clear (DevExpress) — nullable + AllowClear iken Auto (değer varken × görünür), aksi halde Never.
    private DataEditorClearButtonDisplayMode _clearMode =>
        (!_effectiveReadOnly && _effectiveEnabled && _isNullable && AllowClear)
            ? DataEditorClearButtonDisplayMode.Auto
            : DataEditorClearButtonDisplayMode.Never;

    // Dropdown açık/kapalı durumu — @onblur dropdown toggle sırasında da tetiklenir; bunu ayırt etmek için.
    private bool _dropDownVisible;

    private void OnDropDownVisibleChanged(bool visible) => _dropDownVisible = visible;

    private async Task OnBlurInternal(FocusEventArgs e)
    {
        // Dropdown açıkken tetiklenen blur → false positive (dropdown toggle). Yok say.
        if (_dropDownVisible) return;
        await LostFocus.InvokeAsync();
    }

    // DxComboBox custom ValueChanged Blazor'ın @bind dirty hook'unu bypass eder → caller'a forward + EditContext'e elle bildir.
    private async Task OnInternalValueChanged(TValue? value)
    {
        await ValueChanged.InvokeAsync(value);
        if (CascadedEditContext is not null && ValueExpression is not null)
            CascadedEditContext.NotifyFieldChanged(FieldIdentifier.Create(ValueExpression));
    }

    // ✎ → host override'ı varsa onu çağır; yoksa MERKEZÎ popup yolu (ViewOpener) ile seçili değeri düzenle.
    private Task OnEditButtonClick(MouseEventArgs _)
    {
        if (!_hasValue) return Task.CompletedTask;
        if (OnEditRequested is not null) return OnEditRequested(Value!);
        return OpenEditAsync(Value);
    }

    // + → host override'ı varsa quick-add (oluşan değeri auto-select); yoksa MERKEZÎ popup yolu ile yeni kayıt aç.
    private async Task OnAddButtonClick(MouseEventArgs _)
    {
        if (OnAddRequested is not null)
        {
            var created = await OnAddRequested();
            if (!EqualityComparer<TValue>.Default.Equals(created!, default!))
                await OnInternalValueChanged(created);
            return;
        }
        await OpenEditAsync(default);
    }

    // Liste sayfasının "New/Edit" akışıyla AYNI merkezî yol: edit host'u popup/MDI'de açar (ham DxPopup YOK).
    // Kayıt sonrası tazeleme + auto-select EntityChange üzerinden olur (OnEntityChanged).
    private Task OpenEditAsync(TValue? id)
    {
        var editComponentType = _resolvedEditComponentType;
        if (editComponentType is null) return Task.CompletedTask;
        var extra = new Dictionary<string, object>
        {
            { "OnClosed", EventCallback.Factory.Create(this, () => PopupService.Close()) },
        };
        // Add → id null (yeni kayıt); Edit → seçili değer. Required (Guid) alanda default = Guid.Empty → host "yeni" sayar.
        object? editId = (id is null || EqualityComparer<TValue>.Default.Equals(id, default!)) ? null : id;
        return ViewOpener.OpenAsync(editComponentType, editId, string.Empty, null, extra);
    }

    // Bu entity türü değişince (inline popup VEYA başka sekme): listeyi tazele + Created'da yeni kaydı auto-select.
    private async void OnEntityChanged(EntityChange change)
    {
        if (change.EntityKey != typeof(TItem).FullName) return;
        await OnLookupReloadRequested.InvokeAsync();   // host Data'yı yeniden yükler
        if (change.Kind == EntityChangeKind.Created && change.Id is TValue newId)
            await OnInternalValueChanged(newId);       // yeni kaydı combo'da seç
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => EntityChanges.Changed -= OnEntityChanged;
}
