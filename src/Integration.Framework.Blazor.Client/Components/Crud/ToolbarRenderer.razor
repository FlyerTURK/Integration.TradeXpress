@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Toolbar ÇİZİMİ — TEK kaynak (ikiz değil). CrudToolbar (liste/split/edit), EditToolbar ve DrillList liste
   toolbar'ı AYNI bunu kullanır: CrudToolbarAction descriptor listesini DxToolbar'a basar. Görünür aksiyon +
   sıra çağırana ait (BuildActions); burada yalnız çizim (descriptor → DxToolbarItem + alt menü + Template).
*@
<DxToolbar ItemRenderStyleMode="@RenderMode"
           AdaptivityAutoCollapseItemsToIcons="true"
           AdaptivityAutoHideRootItems="true">
    @foreach (var a in Actions)
    {
        <DxToolbarItem Text="@a.Text" AdaptiveText="@a.AdaptiveText" Tooltip="@a.Tooltip"
                       IconUrl="@a.IconUrl" IconCssClass="@a.IconCssClass"
                       BeginGroup="@a.BeginGroup" Alignment="@a.Alignment"
                       RenderStyle="@(a.Primary ? ButtonRenderStyle.Primary : ButtonRenderStyle.None)"
                       RenderStyleMode="@(a.Primary ? ToolbarItemRenderStyleMode.Contained : ToolbarItemRenderStyleMode.Auto)"
                       CssClass="@(a.Primary ? "xaf-primary-toolbar-btn" : null)"
                       SplitDropDownButton="@a.SplitDropDownButton"
                       Enabled="@a.Enabled"
                       Template="@a.Template"
                       Items="@SubItems(a)"
                       Click="@((ToolbarItemClickEventArgs e) => InvokeAction(a))" />
    }
</DxToolbar>

@* DAR EKRAN ARAMA SATIRI — arama ikonuna basınca açılan kutu. Aynı kutunun MASAÜSTÜNDEKİ hâliyle
   birebir aynı şablonu kullanır (host geçer), yani iki ekran boyutunda iki farklı arama davranışı olmaz. *@
@if (NarrowSearchVisible && NarrowSearchTemplate is not null)
{
    @* Inline stil: yeni CSS sınıfı açmak onay ister (CLAUDE.md §1) ve bu tek kullanımlık bir satır.
       Kutu tam genişlik kaplar — dar ekranda aranacak alan zaten dardır. *@
    <div style="padding:0.25rem 0.25rem 0.5rem; width:100%;">
        @NarrowSearchTemplate(default!)
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CrudToolbarAction> Actions { get; set; } = System.Array.Empty<CrudToolbarAction>();
    [Parameter] public ToolbarRenderStyleMode RenderMode { get; set; } = ToolbarRenderStyleMode.Plain;

    /// <summary>
    /// Dar ekranda arama ikonuyla açılan kutunun şablonu — host'un MASAÜSTÜNDE kullandığı şablonun AYNISI.
    ///
    /// <para><b>Neden burada:</b> dar ekranda arama, DevExpress'in grid'e GÖMÜLÜ arama kutusuyla yapılıyordu.
    /// O kutu bizim arama yolumuza bağlı değildi — yazılan metin host'un <c>SearchText</c> alanına geri
    /// dönmediği için sunucu-taraflı listelerde arama sunucuya HİÇ ulaşmıyor, yalnız o an yüklü satırlarda
    /// filtreliyordu. Yani aynı listede masaüstü "tüm kayıtlarda", mobil "ekrandakilerde" arıyordu ve fark
    /// hiçbir yerde görünmüyordu. Kendi kutumuzu göstermek bu ayrımı ortadan kaldırır.</para>
    ///
    /// <para>Çizim TEK yerde (bu bileşen) çünkü kural iki toolbar için de aynı: liste/split <c>CrudToolbar</c>
    /// ve <c>DrillList</c>. Şablon host'tan gelir — metin alanı ve olay bağları oraya aittir.</para>
    /// </summary>
    [Parameter] public RenderFragment<IToolbarItemInfo>? NarrowSearchTemplate { get; set; }

    /// <summary>Dar ekran arama satırı açık mı (arama ikonu aç/kapat eder).</summary>
    [Parameter] public bool NarrowSearchVisible { get; set; }

    /// <summary>Bir aksiyon (kök veya alt-item) çalıştıktan SONRA tetiklenir → host kendini render eder.
    /// Click EventCallback'i bu bileşende üretildiğinden Blazor yalnız ToolbarRenderer'ı otomatik render eder;
    /// durum sahibi host'un (DrillList/EditToolbar host'u) tazelenmesi için bu callback'i bağlar.</summary>
    [Parameter] public EventCallback OnActionInvoked { get; set; }

    private async Task InvokeAction(CrudToolbarAction a)
    {
        if (a.OnClick != null) await a.OnClick.Invoke();
        await OnActionInvoked.InvokeAsync();
    }

    // Alt menü item'ları (Export → Excel/PDF, Kaydet&Yeni → Kaydet&Kapat) — RenderFragment attribute, null=yok.
    // Visible=false alt öğe çizilmez (kök item'larla aynı sözleşme; çağıran koşullu tip menüsü kurabilsin).
    private RenderFragment? SubItems(CrudToolbarAction a)
    {
        if (a.Items == null || a.Items.Count == 0) return null;
        return @<text>
            @foreach (var sub in a.Items.Where(s => s.Visible))
            {
                <DxToolbarItem Text="@sub.Text" Tooltip="@sub.Tooltip"
                               IconUrl="@sub.IconUrl" IconCssClass="@sub.IconCssClass"
                               Enabled="@sub.Enabled"
                               Click="@((ToolbarItemClickEventArgs e) => InvokeAction(sub))" />
            }
        </text>;
    }
}
