@typeparam TGetDto where TGetDto : class, Integration.Framework.Base.Dtos.Interfaces.IGetDto<TKey>, new()
@typeparam TListDto where TListDto : class, Integration.Framework.Base.Dtos.Interfaces.IListDto<TKey>, new()
@typeparam TKey

@using Integration.Framework.Blazor.Client.Services.Base
@using DevExpress.Blazor
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Sayfa başlığı artık MDI sekme caption'ında gösterilir; global PageHeaderTitle SectionOutlet
   çoklu canlı sayfada çakıştığı için kaldırıldı. PageTitle parametresi geriye uyumluluk için kalır. *@

<div class="crud-layout-container h-100 position-relative d-flex flex-column">
    @if (StateService.IsBusy)
    {
        <div class="crud-loading-overlay">
            <div class="d-flex flex-column align-items-center">
                <div class="int-loader-wrapper">
                    <div class="int-loader-circle">
                        <span class="int-loader-initials">TX</span>
                    </div>
                    <div class="int-loader-spinner"></div>
                </div>
            </div>
        </div>
    }
    @* Toolbar üstü/altı boşluk — Bootstrap p-* bu projede etkisiz, inline padding.
       SplitHost doluysa (SplitCrudView birleşik toolbar) yerel toolbar çizilmez. *@
    @if (SplitHost == null)
    {
    <div style="padding-top:0.25rem; padding-bottom:0.25rem;">
        <CrudToolbar TGetDto="TGetDto" TListDto="TListDto" TKey="TKey"
                     StateService="StateService"
                     SearchText="@SearchText"
                     SearchTextChanged="OnToolbarSearch"
                     OnNewClick="HandleNewClick"
                     OnDeleteClick="OnDeleteClick"
                     OnRefreshClick="OnRefreshClick"
                     OnExportToExcelClick="ExportToExcel"
                     OnPrintPdfClick="PrintGrid"
                     ActiveFilter="_activeFilter"
                     ActiveFilterChanged="OnActiveFilterChanged"
                     OnToggleGridSearch="ToggleGridSearch"
                     CustomActions="CustomActions" />
    </div>
    }

    <DxGrid Data="@(DataSource ?? (object)StateService.ListDataSource)"
            KeyFieldName="Id"
            LayoutAutoLoading="OnGridLayoutAutoLoading"
            LayoutAutoSaving="OnGridLayoutAutoSaving"
            @bind-SelectedDataItems="StateService.SelectedDataItems"
            SelectionMode="GridSelectionMode.Multiple"
            AllowSelectRowByClick="false"
            FocusedRowEnabled="true"
            FocusedRowChanged="@OnGridFocusedRowChanged"
            ShowSearchBox="@_showGridSearch"
            PagerVisible="true"
            PageSizeSelectorVisible="true"
            PageSizeSelectorItems="@(new int[] { 10, 20, 50, 100 })"
            PageSizeSelectorAllRowsItemVisible="true"
            @bind-PageSize="_gridPageSize"
            @bind-PageIndex="_gridPageIndex"
            ShowFilterRow="@ShowColumnFilter"
            @ref="Grid"
            RowClick="OnRowClick"
            CssClass="flex-grow-1 overflow-hidden"
            @attributes="GridAttributes"
            AllowColumnResizing="true">
        
        <Columns>
            <DxGridSelectionColumn Width="48px" AllowSelectAll="true" />
            @if (GridColumns != null)
            {
                @GridColumns
            }
            else if (Columns != null)
            {
                foreach (var col in Columns)
                {
                    <DxGridDataColumn FieldName="@col.FieldName" Caption="@col.Caption" Width="@col.Width" DisplayFormat="@col.DisplayFormat" Visible="@col.Visible" />
                }
            }
        </Columns>
    </DxGrid>
</div>




