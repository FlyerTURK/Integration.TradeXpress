@typeparam TItem where TItem : class
@typeparam TValue
@using System
@using System.Collections.Generic
@using System.Linq
@using System.Linq.Expressions
@using System.Reflection
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components.Forms
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IPopupService PopupService

@*
   LookupComboBox'un "büyük kardeşi" (XAF SearchLookupComboBox paritesi): salt-okunur display alanı +
   ✎ (seçili düzenle) + ✕ (clear) + ▼ (picker) → KENDİ DxPopup'ı içinde DxGrid (built-in arama, çok-kolon,
   paging, single-select, çift-tık=seç) + Seç/İptal/Yeni. Büyük/yapısal referans listeleri için (binlerce satır).
   Veri = host'tan (genelde LookupCache); Edit/Add = host delege. Dirty: ValueExpression + EditContext.NotifyFieldChanged.
   DevExpress-native (ERPPROV3 pure-HTML/GridCore yerine DxTextBox + DxGrid + DxPopup).
*@
@* ÇİFT TIK ile de picker açılır (VARSAYILAN davranış, 2026-07-28 Hakan): alan salt-okunur olduğundan
   kullanıcının ilk refleksi üzerine tıklamak oluyor; küçük ▼ düğmesini aramak zorunda kalmasın.
   Sarmalayıcı div ŞART — DxTextBox @@ondblclick'i kendi input'una taşımıyor. *@
<div @ondblclick="@OnDisplayDoubleClick" style="width:100%;">
<DxTextBox Text="@DisplayText"
           ReadOnly="true"
           Enabled="@_effectiveEnabled"
           NullText="@NullText"
           ValidationEnabled="false"
           CssClass="w-100">
    <Buttons>
        <DxEditorButton IconCssClass="custom-icon-edit" Visible="@ShowEditButton" Click="@OnEditButtonClick" Tooltip="@L["Edit"].Value" />
        <DxEditorButton IconCssClass="custom-icon-close" Visible="@ShowClearButton" Click="@OnClearButtonClick" Tooltip="@L["Clear"].Value" />
        <DxEditorButton IconCssClass="custom-icon-more" Visible="@(!_effectiveReadOnly && _effectiveEnabled)" Click="@OnPickerButtonClick" Tooltip="@L["SelectAction"].Value" />
    </Buttons>
</DxTextBox>
</div>

<DxPopup @bind-Visible="_pickerVisible"
         HeaderText="@(Title ?? L["Select"].Value)"
         ShowCloseButton="true"
         Width="min(820px, 95vw)"
         MaxHeight="90vh"
         CloseOnOutsideClick="false">
    <BodyTemplate>
        @* Mobil: popup MaxHeight'e sığ → grid SCROLL alanı, arama+footer SABİT (Seç/İptal her zaman görünür). *@
        <div style="display:flex; flex-direction:column; gap:0.6rem; min-height:0; max-height:78vh;">
            @* TOOLBAR ÜSTTE (normal grid standardı): arama + eylemler tek satırda, grid'in üzerinde.
               Arama kutusu HER İKİ MODDA da bizim: grid'in yerleşik araması harfi harfine eşleştiriyor ve
               "cicek" yazan kullanıcı "Çiçek"i bulamıyordu — client modda da AKSANSIZ süzeriz. *@
            @* Toolbar LİSTE FORMLARIYLA AYNI DİL (2026-07-28 Hakan): aynı xaf ikonları, aynı sıra
               (Seç → Yeni → Sil → Ara → Aktar → Yenile). CrudToolbar bileşeni DOĞRUDAN kullanılamıyor:
               generic kısıtları TGetDto/TListDto istiyor, LookupEdit'in TItem'ı bunları garanti etmiyor —
               o yüzden descriptor'lar değil, aynı görünüm DxToolbar'a birebir kuruluyor. *@
            <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Contained"
                       AdaptivityAutoHideRootItems="false" CssClass="flex-shrink-0">
                <DxToolbarItem Text="@L["SelectAction"].Value" RenderStyle="ButtonRenderStyle.Primary"
                               IconCssClass="@(FrameworkIcons.Confirm + " xaf-toolbar-item-icon")"
                               Enabled="@(_pending is not null)" Click="@ConfirmAsync" />
                <DxToolbarItem Text="@L["New"].Value" Visible="@(OnAddRequested is not null)"
                               IconUrl="/images/xaf/action_new.svg" IconCssClass="xaf-toolbar-item-icon"
                               Click="@OnPickerAddClick" />
                <DxToolbarItem Text="@L["Delete"].Value" Visible="@(OnDeleteRequested is not null)"
                               IconUrl="/images/xaf/action_delete.svg" IconCssClass="xaf-toolbar-item-icon"
                               Enabled="@(_pending is not null)" Click="@OnPickerDeleteClick" />
                <DxToolbarItem Text="@L["Refresh"].Value" Visible="@(OnRefreshRequested is not null)"
                               IconUrl="/images/xaf/action_refresh.svg" IconCssClass="xaf-toolbar-item-icon"
                               Click="@OnPickerRefreshClick" />
                <DxToolbarItem Text="@L["ExportToExcel"].Value" Alignment="ToolbarItemAlignment.Right"
                               IconUrl="/images/xaf/action_export_toxlsx.svg" IconCssClass="xaf-toolbar-item-icon"
                               Click="@ExportPickerAsync" />
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right">
                    <Template Context="searchItem">
                        <DxTextBox Text="@_searchText"
                                   TextChanged="@OnSearchTextChangedAsync"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="@(SearchPlaceholder ?? L["Search"].Value)"
                                   ValidationEnabled="false" />
                    </Template>
                </DxToolbarItem>
            </DxToolbar>
            @* Grid kendi scroll alanında (flex:1 + min-height:0) — uzasa da footer'ı ekran dışına itmez. *@
            <div style="flex:1 1 auto; min-height:0; overflow-y:auto;">
                <DxGrid @ref="_grid"
                        Data="@FilteredData"
                        KeyFieldName="@ValueFieldName"
                        ShowSearchBox="false"
                        SelectionMode="GridSelectionMode.Single"
                        AllowSelectRowByClick="true"
                        SelectedDataItem="@_pending"
                        SelectedDataItemChanged="@OnSelectedItemChanged"
                        RowDoubleClick="@OnRowDoubleClick"
                        PageSize="12"
                        CssClass="w-100">
                    <Columns>
                        @if (Columns is not null)
                        {
                            @Columns
                        }
                        else
                        {
                            <DxGridDataColumn FieldName="@TextFieldName" />
                        }
                    </Columns>
                </DxGrid>
            </div>

        </div>
    </BodyTemplate>
</DxPopup>

@code {
    [Parameter, EditorRequired] public IEnumerable<TItem> Data { get; set; } = Array.Empty<TItem>();
    [Parameter, EditorRequired] public string ValueFieldName { get; set; } = "";
    [Parameter, EditorRequired] public string TextFieldName { get; set; } = "";

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    /// <summary>@bind-Value direktifinden gelir; EditContext'e dirty bildirmek için FieldIdentifier kaynağı.</summary>
    [Parameter] public Expression<Func<TValue?>>? ValueExpression { get; set; }

    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public string? NullText { get; set; }

    /// <summary>Picker popup başlığı (null → "Seç").</summary>
    [Parameter] public string? Title { get; set; }

    // ── Server-side arama modu (opt-in): OnSearch verilirse picker'da DIŞ arama kutusu çıkar; kullanıcı yazınca
    //    host sunucudan (min-harf koşuluyla) çeker + Data'yı tazeler. Data ÖN-YÜKLENMEZ (binlerce satır istemciye inmez). ──

    /// <summary>Kullanıcı arama metnini değiştirince (min <see cref="SearchMinLength"/> harf) çağrılır — host
    /// sunucudan sonuçları çekip <see cref="Data"/>'yı tazeler. Verilmezse client-modu (Data ön-yüklü) korunur.</summary>
    [Parameter] public EventCallback<string> OnSearch { get; set; }

    /// <summary>Aramanın başlaması için en az harf sayısı (altında OnSearch tetiklenmez). Varsayılan 0.</summary>
    [Parameter] public int SearchMinLength { get; set; }

    /// <summary>Arama kutusu placeholder'ı (null → "Ara").</summary>
    [Parameter] public string? SearchPlaceholder { get; set; }

    /// <summary>Seçili değerin GÖRÜNEN metni — server-modda seçili öğe <see cref="Data"/>'da bulunmayabilir
    /// (yalnız arama sonuçları yüklü); salt-okunur alan bunu gösterir. Client-modda null bırakılır (Data'dan bulunur).</summary>
    [Parameter] public string? SelectedDisplayText { get; set; }
    /// <summary>Grid kolonları (çok-kolon). null → TextFieldName tek kolon fallback. Plain DxGridDataColumn'lar.</summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>Edit(✎) — seçili referansı düzenle (host popup/navigate). Boşsa gizli.</summary>
    [Parameter] public Func<TValue, Task>? OnEditRequested { get; set; }

    /// <summary>Popup'ta seçili kaydı SİLME isteği — verilmezse Sil butonu görünmez (liste formlarındaki
    /// davranışın aynısı: yetkisi/karşılığı olmayan eylem gösterilmez).</summary>
    [Parameter] public Func<TValue, Task>? OnDeleteRequested { get; set; }

    /// <summary>Listeyi TAZELEME isteği — host katalogu yeniden çeker; verilmezse Yenile butonu görünmez.</summary>
    [Parameter] public Func<Task>? OnRefreshRequested { get; set; }

    /// <summary>
    /// Seçim için açılacak GERÇEK LİSTELEME FORMU (ör. <c>ProductCategoryListPage</c>).
    ///
    /// <para>Verilirse ▼/çift tık bu formu popup'ta açar — kendi toolbar'ı, kolonları, arama/filtre/export'u
    /// ve izinleriyle. "Bir listeleme formu ister sekmede ister popup'ta açılabilir" (2026-07-28 Hakan);
    /// seçici için ikinci bir grid yazmak bakımı ikiye katlar ve iki yüzey zamanla ayrışır.</para>
    ///
    /// <para>Verilmezse bileşenin KENDİ basit grid'i açılır (mevcut davranış) — diğer lookup'lar etkilenmez.</para>
    /// </summary>
    [Parameter] public Type? ListComponentType { get; set; }

    /// <summary>Liste formundan dönen satırdan DEĞERİ çıkarır. <see cref="ListComponentType"/> ile birlikte
    /// zorunludur: dönen nesnenin tipini yalnız çağıran bilir.</summary>
    [Parameter] public Func<object, TValue?>? ListItemValueSelector { get; set; }
    /// <summary>Add(+) — quick-add; host yeni referansı açar ve OLUŞAN değeri döndürür → seçilir + picker kapanır. Boşsa gizli.</summary>
    [Parameter] public Func<Task<TValue?>>? OnAddRequested { get; set; }

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }
    /// <summary>EntityEditForm salt-okunur (fieldset disabled) iken true → ✎/✕/▼ gizlenir (native disable görünür bırakırdı).</summary>
    [CascadingParameter(Name = "FormIsReadOnly")] private bool FormIsReadOnly { get; set; }

    private bool _pickerVisible;
    private object? _pending;     // grid'de seçili (henüz onaylanmamış) satır
    private DxGrid? _grid;
    private string? _searchText;  // server-modu dış arama kutusunun metni

    private bool ServerSearchMode => OnSearch.HasDelegate;

    /// <summary>
    /// Grid'e verilen satırlar. SERVER modda süzme SUNUCUDA yapıldı → Data olduğu gibi. CLIENT modda arama
    /// terimi AKSANSIZ uygulanır: "cicek" yazan kullanıcı "Çiçek"i bulur (grid'in yerleşik araması harfi
    /// harfine eşleştirdiği için bulamıyordu — 2026-07-28 Hakan).
    ///
    /// <para>Eşleşme metin alanına bakar; ayrı kolonlar tanımlıysa bile arama YOL/ad alanı üzerinden yürür —
    /// kullanıcı gördüğü metni yazar.</para>
    /// </summary>
    private IEnumerable<TItem> FilteredData
    {
        get
        {
            if (ServerSearchMode || string.IsNullOrWhiteSpace(_searchText))
            {
                return Data;
            }

            return Data.Where(item => SearchTextNormalizer.Matches(GetItemText(item), _searchText));
        }
    }

    // Kullanıcı yazdı: SERVER modda min-harf koşulu sağlanınca host'a bildir; CLIENT modda yalnız
    // FilteredData'nın yeniden hesaplanması yeter (bildirim yok).
    private async Task OnSearchTextChangedAsync(string text)
    {
        _searchText = text;
        if (!ServerSearchMode)
        {
            return;
        }

        var trimmed = (text ?? string.Empty).Trim();
        if (trimmed.Length >= SearchMinLength || trimmed.Length == 0)
        {
            await OnSearch.InvokeAsync(trimmed);
        }
    }

    /// <summary>Seçili satırı sil — host siler, ardından liste tazelenir ve bekleyen seçim düşer
    /// (silinen kayda "Seç" demek anlamsız).</summary>
    private async Task OnPickerDeleteClick()
    {
        if (OnDeleteRequested is null || _pending is not TItem item)
        {
            return;
        }

        var value = GetItemValue(item);
        if (value is null)
        {
            return;
        }

        await OnDeleteRequested(value);
        _pending = null;

        if (OnRefreshRequested is not null)
        {
            await OnRefreshRequested();
        }
    }

    private async Task OnPickerRefreshClick()
    {
        if (OnRefreshRequested is not null)
        {
            await OnRefreshRequested();
        }
    }

    /// <summary>Popup grid'ini Excel'e aktarır — liste formlarındaki "Excel'e Aktar" ile aynı yol.</summary>
    private async Task ExportPickerAsync()
    {
        if (_grid is not null)
        {
            await _grid.ExportToXlsxAsync("Export");
        }
    }

    private PropertyInfo? _valueProp;
    private PropertyInfo? _textProp;
    private PropertyInfo ValueProp => _valueProp ??= typeof(TItem).GetProperty(ValueFieldName)!;
    private PropertyInfo? TextPropOrNull => _textProp ??= typeof(TItem).GetProperty(TextFieldName);

    private TValue? GetItemValue(TItem item) => ValueProp?.GetValue(item) is TValue v ? v : default;
    private string GetItemText(TItem item) => TextPropOrNull?.GetValue(item)?.ToString() ?? "";

    // "Değer var mı": null / Guid.Empty / 0 → yok. Boş string de "yok" (string "" default'u EqualityComparer'da
    // null'a eşit değil → Edit/Clear yanlış görünürdü). Kalıcı fix → tüm kullanımlarda doğru.
    private bool _hasValue
    {
        get
        {
            if (EqualityComparer<TValue>.Default.Equals(Value, default!)) return false;
            return Value is not string s || s.Length > 0;
        }
    }
    private bool _isNullable => !typeof(TValue).IsValueType || Nullable.GetUnderlyingType(typeof(TValue)) is not null;

    // Form salt-okunur (fieldset disabled) → component'i de okunur/pasif say: native disable input'u kapatır ama
    // gömülü ✎/✕/▼ butonlarını görünür bırakırdı → efektif bayraklarla hepsini gizle.
    private bool _effectiveReadOnly => ReadOnly || FormIsReadOnly;
    private bool _effectiveEnabled => Enabled && !FormIsReadOnly;

    private bool ShowEditButton => OnEditRequested is not null && !_effectiveReadOnly && _effectiveEnabled && _hasValue;
    private bool ShowClearButton => !_effectiveReadOnly && _effectiveEnabled && _isNullable && AllowClear && _hasValue;

    private TItem? SelectedItem => _hasValue
        ? Data.FirstOrDefault(i => i is not null && EqualityComparer<TValue>.Default.Equals(GetItemValue(i), Value))
        : null;

    private string? DisplayText
    {
        get
        {
            if (!_hasValue) return null;
            var item = SelectedItem;
            // Önce Data'da bulunan öğe; yoksa server-modda dışarıdan verilen görünen metin; son çare değerin kendisi.
            return item is not null
                ? GetItemText(item)
                : (!string.IsNullOrEmpty(SelectedDisplayText) ? SelectedDisplayText : Value?.ToString());
        }
    }

    private Task OnEditButtonClick(MouseEventArgs _)
        => (OnEditRequested is not null && _hasValue) ? OnEditRequested(Value!) : Task.CompletedTask;

    private Task OnClearButtonClick(MouseEventArgs _) => CommitValueAsync(default);

    /// <summary>Alanın üzerine çift tık — picker'ı açar (salt-okunur alanda tıklamak doğal refleks).
    /// Salt-okunur/pasif formda AÇILMAZ.</summary>
    private void OnDisplayDoubleClick()
    {
        if (!_effectiveReadOnly && _effectiveEnabled)
        {
            OpenPicker();
        }
    }

    // ▼ → picker'ı aç; mevcut değeri pre-highlight et.
    private Task OnPickerButtonClick(MouseEventArgs _)
    {
        OpenPicker();
        return Task.CompletedTask;
    }

    /// <summary>Picker'ı açar ve mevcut değeri ön-seçili yapar (▼ ve çift tık AYNI yolu kullanır).</summary>
    private void OpenPicker()
    {
        // Gerçek liste formu verilmişse ONU aç (kendi toolbar'ı/kolonları/izinleriyle); yoksa yerleşik grid.
        if (ListComponentType is not null)
        {
            _ = OpenListPickerAsync();
            return;
        }

        _pending = SelectedItem;
        _pickerVisible = true;
    }

    /// <summary>Listeleme formunu popup'ta açar; kullanıcı bir satır seçince değeri işler. Popup kapatılırsa
    /// (seçim yapılmadan) null döner ve mevcut değer KORUNUR.</summary>
    private async Task OpenListPickerAsync()
    {
        var selected = await PopupService.ShowAsync(
            ListComponentType!,
            new Dictionary<string, object> { ["IsPickerMode"] = true },
            new PopupOptions { Title = Title ?? L["Select"].Value, Width = "min(1100px, 96vw)" });

        if (selected is null || ListItemValueSelector is null)
        {
            return;
        }

        if (ListItemValueSelector(selected) is { } value)
        {
            await CommitValueAsync(value);
        }
    }

    private void OnSelectedItemChanged(object? item) => _pending = item;

    private async Task OnRowDoubleClick(GridRowClickEventArgs e)
    {
        if (e.Grid.GetDataItem(e.VisibleIndex) is TItem item)
            await CommitValueAsync(GetItemValue(item));
    }

    private async Task ConfirmAsync()
    {
        if (_pending is TItem item)
            await CommitValueAsync(GetItemValue(item));
    }

    // + → host quick-add; oluşan değer dönerse onu seç + picker'ı kapat.
    private async Task OnPickerAddClick()
    {
        if (OnAddRequested is null) return;
        var created = await OnAddRequested();
        if (!EqualityComparer<TValue>.Default.Equals(created!, default!))
            await CommitValueAsync(created);
    }

    private async Task CommitValueAsync(TValue? value)
    {
        _pickerVisible = false;
        await ValueChanged.InvokeAsync(value);
        if (CascadedEditContext is not null && ValueExpression is not null)
            CascadedEditContext.NotifyFieldChanged(FieldIdentifier.Create(ValueExpression));

        await EnsureSelectedValueResolvableAsync(value);
    }

    /// <summary>
    /// Seçilen değer <see cref="Data"/>'da YOKSA listeyi bir kez tazeler.
    ///
    /// <para><b>Neden gerekli:</b> <see cref="ListComponentType"/> ile açılan liste popup'ı kendi verisini
    /// SUNUCUDAN taze çeker; bizim <see cref="Data"/>'mız ise formun açılışında alınmış bir anlık görüntüdür.
    /// Kullanıcı popup'ta yeni oluşturduğu (ya da başka bir sekmede eklenmiş) bir kaydı seçtiğinde değer doğru
    /// yazılır ama metni çözülemez ve alan <b>ham GUID</b> gösterir — 2026-08-03'te "Ürün Kategorisi" alanında
    /// tam olarak bu yaşandı. Tazeleme yalnız ÇÖZÜLEMEYEN değerde yapılır: her seçimde sunucuya gitmek
    /// gereksiz yüktür ve zaten çözülebilen seçimde görünen bir fayda yok.</para>
    ///
    /// <para>Server-modda (<see cref="SelectedDisplayText"/> host tarafından besleniyorsa) dokunulmaz —
    /// orada öğenin <see cref="Data"/>'da olmaması NORMALDİR, metin dışarıdan gelir.</para>
    /// </summary>
    private async Task EnsureSelectedValueResolvableAsync(TValue? value)
    {
        if (OnRefreshRequested is null || !string.IsNullOrEmpty(SelectedDisplayText))
        {
            return;
        }

        if (value is null || EqualityComparer<TValue>.Default.Equals(value, default!))
        {
            return;
        }

        var resolvable = Data.Any(i => i is not null && EqualityComparer<TValue>.Default.Equals(GetItemValue(i), value));
        if (resolvable)
        {
            return;
        }

        await OnRefreshRequested();
        StateHasChanged();
    }
}

