@typeparam TItem where TItem : class
@using System.Linq
@using Microsoft.AspNetCore.Components.Forms
@using DevExpress.Blazor
@using Integration.Framework.Blazor.Client.Services.Base
@using Integration.Framework.Blazor.Client.Services.Mdi
@using Integration.Framework.Blazor.Client.Components.Shared
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@implements Integration.Framework.Blazor.Client.Services.Base.ISplitEditActions

@*
   Yeniden kullanılabilir master-detail "drill list" — listeleme formlarımızla aynı yerleşim
   (başlık + toolbar + grid + popup edit form). İki modda çalışır:
   • In-memory: yalnız Items koleksiyonunu mutasyona uğratır (parent kaydında commit edilir).
   • Persistent: PersistCreate/Update/Delete callback'leri verilirse her işlem anında kalıcı yazar.
   Farklı entity'ler için Columns + EditContent + NewItemFactory parametreleriyle özelleştirilir.

   C# mantığı DrillList.razor.cs code-behind'ında (ui-blazor: @@code yasak). Markup içeren üç
   şablon (arama kutusu / aktif filtre / edit gövdesi) Razor inline template olduğundan C#
   dosyasına taşınamaz → aşağıdaki kod bloğunda her render başında alanlara atanır (kullanımları
   markup'ta daha aşağıda; davranış eski @@code property'leriyle birebir aynı).
*@
@{
    // Arama kutusu — genel liste toolbar'ı (CrudToolbar.SearchBoxTemplate) ile AYNI görünüm. InGrid modda metin
    // grid'in yüklü verisinde filtreler (DxGrid.SearchText); ServerSide modda OnServerSearch ile parent'a gider.
    SearchBoxTemplate = _ => @<text>
        @* Arama kutusu model alanı DEĞİL; drill, parent edit formunun EditContext'i içinde render olabildiğinden
           (ör. Şirket edit → Şubeler drill) DevExpress TextExpression ister → ValidationEnabled=false ŞART. *@
        <DxTextBox Text="@_searchText"
                   TextChanged="OnDrillSearch"
                   ValidationEnabled="false"
                   NullText="@L["Search"]"
                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                   CssClass="grid-search-box">
            <Buttons>
                <DxEditorButton IconCssClass="xaf-search-icon" Tooltip="@L["Search"]"
                                Click="@(() => OnDrillSearch(_searchText ?? string.Empty))" />
            </Buttons>
        </DxTextBox>
    </text>;

    ActiveFilterTemplate = _ => @<text>
        <div style="display:flex; align-items:center; gap:0.4rem; padding:0 0.25rem; white-space:nowrap;">
            @* Arama kutusuyla AYNI gerekçe [validation-expr]: drill parent edit formunun EditContext'i içinde
               render olabilir ve manuel bağlı (Checked + CheckedChanged, @@bind DEĞİL) DevExpress editörü
               CheckedExpression ister → ValidationEnabled=false ŞART. Bu switch model alanı değil, salt UI
               filtresidir. 2026-08-10'da CANLI ÇÖKME olarak yakalandı: anahtar yalnız TItem IIsActive iken
               çizildiğinden (ilk IIsActive drill öğesine kadar) yıllarca gizli kalmıştı. *@
            <DxCheckBox Checked="_showActiveOnly" CheckedChanged="@((bool v) => OnActiveFilterChanged(v))" CheckType="CheckType.Switch" ValidationEnabled="false" />
            <span>@(_showActiveOnly ? L["ActiveRecords"] : L["PassiveRecords"])</span>
        </div>
    </text>;

    // Popup modunun (AllowInlineEdit=false) düzenleme gövdesi (form + Save/Cancel).
    // EditForm YOK — CascadingValue<EditContext> ile kendi EditContext'imizi cascade ediyoruz.
    // EditForm bir <form> HTML elementi oluşturup EditContext cascade eder; iç içe gelince
    // (nested DrillList → nested EditForm → nested EditContext) DxGrid'in ambient EditContext'e
    // bağlanması NRE üretir. CascadingValue yaklaşımında her DrillList kendi EditContext'ini cascade
    // eder; iç DrillList dış olanı shadow'lar — doğru izolasyon, NRE yok. Save manuel: Validate()+SaveAsync().
    EditFormBody = @<text>
        @if (_editItem != null && _editContext != null)
        {
            @* Bağlam-zinciri (2026-08-01): bu popup'ın kimliği ("Şube HQ") alta cascade edilir — iç içe
               drill/VO popup'larının toast'ları "Şirket FMS → Şube HQ → ..." önekini böyle kurar. *@
            <CascadingValue Name="ValidationPathPrefix" Value="@BuildValidationPath()">
            <CascadingValue Value="_editContext">
                <LocalizedDataAnnotationsValidator />

                @if (_editContext.GetValidationMessages().Any())
                {
                    <div class="alert alert-danger py-2 px-3 mb-3">
                        <ValidationSummary />
                    </div>
                }

                @EditContent(_editItem)
            </CascadingValue>
            </CascadingValue>

            @* Edit EditForm'unun (CascadingValue<EditContext>) DIŞINDA — iç içe DrillList kendi
               context'ini cascade eder, parent'ınki sızmaz (nested EditContext render NRE'si önlenir). *@
            @if (AfterEditForm != null)
            {
                <CascadingValue Name="ValidationPathPrefix" Value="@BuildValidationPath()">
                    @AfterEditForm(_editItem)
                </CascadingValue>
            }
        }
    </text>;
}

@* Responsive yükseklik: mobilde SABİT (min/max), masaüstünde vh-BAĞLI (içeriğe göre DesktopMin..DesktopMax
   arasında büyür, taşınca grid kendi içinde kayar). vh-bağlı yaklaşım parent'ın bounded-flex olmasına BAĞIMLI
   DEĞİL → popup/sekme/sayfa her bağlamda çalışır (eski "flex:1 fill" parent bounded değilse 180px'e çöküyordu). *@
<DxLayoutBreakpoint MaxWidth="768" @bind-IsActive="@_isMobile" />
<div class="drill-list">
    @* Drill başlığı (Title) kaldırıldı — toolbar üstü gereksiz başlık; bölüm bağlamı parent form/grid'den belli. *@
    <div style="padding: 0.5rem;">
        @* Liste toolbar — genel CrudToolbar/EditToolbar ile AYNI ToolbarRenderer (ikiz değil). Aksiyonlar descriptor. *@
        <ToolbarRenderer Actions="@ListToolbarActions" RenderMode="ToolbarRenderStyleMode.Plain" OnActionInvoked="OnToolbarActionInvoked"
                         NarrowSearchTemplate="@SearchBoxTemplate" NarrowSearchVisible="@_showGridSearch" />
    </div>

    @* Mobil: SABİT (min/max). Masaüstü: min-height TABAN + max-height vh TAVAN → içerikle büyür, taşınca iç scroll. *@
    <div style="@(_isMobile
            ? $"min-height:{MinHeight}; max-height:{MaxHeight}; display:flex; flex-direction:column;"
            : $"min-height:{DesktopMinHeight}; max-height:{DesktopMaxHeight}; display:flex; flex-direction:column;")">
        @if (AllowInlineEdit)
        {
            @* Satır-içi (hücre editörü) mod: cell'ler DevExpress'in native EditRow editörlerine döner.
               New/Edit/Delete command column'dan; kaydetme EditModelSaving/DataItemDeleting üzerinden
               aynı persist/in-memory mantığına bağlanır. NOT: sadece grid'de GÖRÜNEN kolonlar düzenlenir. *@
            <TxGrid Data="@FilteredItems"
                    @ref="_txGrid"
                    SearchText="@_searchText"
                    KeyFieldName="@KeyFieldName"
                    EditMode="GridEditMode.EditRow"
                    EditModelSaving="OnEditModelSaving"
                    DataItemDeleting="OnDataItemDeleting"
                    CustomizeEditModel="OnCustomizeEditModel"
                    StateKey="@GridStateKey"
                    PageSize="@PageSize"
                    PagerVisible="@PagerVisible"
                    PageSizeSelectorVisible="@PageSizeSelectorVisible"
                    ShowGroupPanel="@ShowGroupPanel"
                    DataColumnGroupRowTemplate="@DataColumnGroupRowTemplate"
                    VirtualScrollingEnabled="@VirtualScrollingEnabled"
                    CssClass="tx-grid-fill">
                <Columns>
                    @if (!ReadOnly)
                    {
                        <DxGridCommandColumn Width="100px" />
                    }
                    @GridColumns
                </Columns>
            </TxGrid>
        }
        else
        {
            <TxGrid Data="@FilteredItems"
                    @ref="_txGrid"
                    SearchText="@_searchText"
                    KeyFieldName="@KeyFieldName"
                    SelectionMode="GridSelectionMode.Multiple"
                    ShowSelectionColumn="true"
                    AllowSelectRowByClick="false"
                    SelectedDataItems="@_selectedItems"
                    SelectedDataItemsChanged="OnGridSelectionChanged"
                    RowClick="OnRowClick"
                    CustomizeElement="OnCustomizeRow"
                    StateKey="@GridStateKey"
                    PageSize="@PageSize"
                    PagerVisible="@PagerVisible"
                    PageSizeSelectorVisible="@PageSizeSelectorVisible"
                    ShowGroupPanel="@ShowGroupPanel"
                    DataColumnGroupRowTemplate="@DataColumnGroupRowTemplate"
                    VirtualScrollingEnabled="@VirtualScrollingEnabled"
                    CssClass="tx-grid-fill">
                <Columns>
                    @GridColumns
                </Columns>
            </TxGrid>
        }
    </div>
</div>

@if (!AllowInlineEdit)
{
    @* Popup chrome ARTIK TEK KAYNAK: EditShell (3 kabuk kopyası yerine). Header zaten TabHeaderData
       (BuildDrillHeader → EditHeaderView); guard OnPopupClosing'de; gövde EditForm'suz CascadingValue<EditContext>
       — kabuğun DIŞINDA, ChildContent olarak girer → nested EditContext NRE'si yapısal olarak imkânsız.
       Pencere durumu (fullscreen/minimize) + butonlar EditShell'de. *@
    <EditShell Mode="EditShellMode.Popup"
               Buttons="EditShellButtons.Minimize | EditShellButtons.Fullscreen"
               Visible="@_popupVisible"
               Header="@BuildDrillHeader()"
               IsDirty="@IsEditDirty"
               MaxWidth="@EditPopupMaxWidth"
               OnClosingRequested="OnPopupClosing"
               OnClosedConfirmed="OnPopupClosed">
        @if (_popupVisible)
        {
            @* EntityEditForm ile AYNI desen: flex-column + EXPLICIT max-height (popup'ta h-100 çözülmez) →
               toolbar flex-shrink:0 SABİT, gövde flex:1 overflow-y:auto KAYAR. Sticky hack YOK; dx-modal-body
               kaymadığı için toolbar üstünde sızıntı da yok. Toolbar yalnız alt padding; gövde edge-to-edge. *@
            <div style="display:flex; flex-direction:column; max-height:calc(90vh - 84px); max-height:calc(90dvh - 84px); min-height:0; overflow-x:hidden; max-width:100%;">
                <div style="flex-shrink:0; padding-bottom:0.5rem;">
                    @* Genel edit ile AYNI bileşen (ikiz değil): EditToolbar. Drill: yalnız Kaydet + Kaydet&Yeni. *@
                    <EditToolbar EditController="@this" IsPopup="true" OnActionInvoked="OnToolbarActionInvoked" />
                </div>
                <div style="flex:1 1 auto; overflow-y:auto; overflow-x:hidden; min-height:0;">
                    @EditFormBody
                </div>
            </div>
        }
    </EditShell>
}
