{
  // ORTAM: Production. WebApplication.CreateBuilder appsettings.json ÜZERİNE bunu merge eder;
  // appsettings.secrets.json en SON yüklenip KAZANIR → burada secret (parola/passphrase/connstring)
  // TUTMA. Bu dosya yalnız PROD sıkılaştırma delta'larını içerir. Dev'i etkilemez (yalnız
  // ASPNETCORE_ENVIRONMENT=Production iken yüklenir).
  "App": {
    // PROD CORS: TAM/açık origin listesi — wildcard (*.domain) YOK. Wildcard alt-alan eşleşmesi
    // kodda yalnız Development'ta açık; prod'da eşleşmez, bu yüzden origin'ler tam yazılmalı.
    // ############################################################################################
    // # TODO(PROD DEPLOY ÖNCESİ — ZORUNLU): Aşağıdaki değerler PLACEHOLDER'dır (app/www.tradexpress.com). #
    // # Prod'a çıkmadan ÖNCE GERÇEK prod origin'leri ile DEĞİŞTİR. Yanlış/eksik kalırsa CORS       #
    // # reddeder (fail-safe) — dev etkilenmez ama prod istekleri bloklanır.                         #
    // ############################################################################################
    "CorsOrigins": "https://app.tradexpress.com,https://www.tradexpress.com",
    // Prod'da PII kapalı — kimlik token/claim detayları loglara yazılmaz. (Kod ayrıca prod'da
    // ShowPII'yi zorla kapalı tutar; bu satır niyeti belgeler ve ikinci savunma katmanıdır.)
    "DisablePII": true
  },
  "AuthServer": {
    // Prod'da HTTPS metadata zorunlu (token endpoint'leri düz-HTTP kabul etmez).
    "RequireHttpsMetadata": true
  }
}
