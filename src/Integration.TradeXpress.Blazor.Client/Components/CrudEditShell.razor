@typeparam TGetDto where TGetDto : class, Integration.Framework.Base.Dtos.Interfaces.IGetDto<TKey>, new()
@typeparam TListDto where TListDto : class, Integration.Framework.Base.Dtos.Interfaces.IListDto<TKey>, new()
@typeparam TKey

@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components.Forms
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Mode-agnostik edit form kabuğu. Toolbar artık MERKEZİ CrudToolbar (Edit modunda):
   EditController = bu edit (ISplitEditActions) → Kaydet/Kaydet&Yeni/Kaydet&Kapat/Sil/Undo/Redo/Reset.
   SplitHost doluysa (split panel) toolbar SplitCrudView'ın birleşik şeridinde olur; burada çizilmez.
*@

@if (!IsPopupMode)
{
    <div class="crud-layout-container h-100 d-flex flex-column">
        @if (SplitHost == null)
        {
            <div style="padding-top:0.25rem; padding-bottom:0.25rem;">
                <CrudToolbar TGetDto="TGetDto" TListDto="TListDto" TKey="TKey" EditController="@EditController" />
            </div>
        }
        <div style="flex:1 1 auto; overflow-y:auto; overflow-x:hidden; padding:0.5rem 0.25rem;">
            @if (EditContext != null)
            {
                <EditForm EditContext="@EditContext">
                    <div @onchange="OnFormChange">@ChildContent</div>
                </EditForm>
            }
        </div>
    </div>
}
else
{
    @* Popup modu — toolbar popup header'ının altında, kenarlıkla ayrılmış *@
    <div style="padding-top:0.5rem; border-bottom:1px solid #dee2e6; padding-bottom:0.5rem; margin-bottom:0.5rem;">
        <CrudToolbar TGetDto="TGetDto" TListDto="TListDto" TKey="TKey" EditController="@EditController" />
    </div>
    @if (EditContext != null)
    {
        <EditForm EditContext="@EditContext">
            <div @onchange="OnFormChange">@ChildContent</div>
        </EditForm>
    }
}

@code {
    [Parameter] public bool IsPopupMode { get; set; }

    /// <summary>Edit page'in kendisi (CrudEditComponentBase, ISplitEditActions). CrudToolbar Edit modu buradan beslenir.</summary>
    [Parameter] public ISplitEditActions? EditController { get; set; }

    /// <summary>SplitCrudView birleşik toolbar host'u; doluysa yerel edit toolbar çizilmez.</summary>
    [CascadingParameter] public ISplitHost? SplitHost { get; set; }

    [Parameter] public EditContext? EditContext { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // DevExpress editörleri @bind ile EditModel'i değiştiriyor ama EditContext.OnFieldChanged'i
    // tetiklemiyor. Bu yüzden formu saran div'in DOM oninput/onchange event'lerini yakalayıp
    // merkezi edit controller'a (CrudEditComponentBase) iletiyoruz — editör tipinden bağımsız.
    // DevExpress @bind editör değişince RenderForm'u barındıran BU component (form owner) re-render
    // olur — edit page değil. O yüzden değişiklik sinyalini buradan, render sonrası alıyoruz.
    protected override void OnAfterRender(bool firstRender) => EditController?.NotifyInput();
    private void OnFormChange() { EditController?.CommitUndoStep(); EditController?.NotifyInput(); }  // commit (blur) → undo adımı
}
