@using System
@using System.Linq
@using Integration.TradeXpress.Companies
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.TradeXpress.Blazor.Client.Pages.Vaults
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Components.Shared
@using DevExpress.Blazor
@using Microsoft.Extensions.Localization
@inherits CrudComponentBase

@* Paylaşılan şube+kasa drill'i (Model.Branches grafı). Şirket EditForm'unun DIŞINDA kullanılır
   (CompanyEditPage'de form kardeşi; tenant'ta company-drill AfterEditForm'unda) — iç içe DrillList'i
   EditContent'e gömmek NRE verir. Tüm tekil-bayrak (HQ/varsayılan) transfer/switch/sil mantığı burada. *@

<div class="mt-3">
    <DrillList TItem="BranchGraphDto"
               @ref="_drill"
               Title="@L["Menu:Branches"]"
               EntityName="@L["Entity:Branch"]"
               Items="Model.Branches"
               KeyFieldName="ClientKey"
               PrimaryTextSelector="@(b => b.Code)"
               ParentEntityName="@L["Entity:Company"]"
               ParentText="@Model.Code"
               NewItemFactory="@NewBranch"
               CloneFactory="@CloneBranch"
               MinItems="1"
               SoftDelete="true"
               IsNewItem="@(b => b.Id == Guid.Empty)"
               MarkDeleted="@(b => b.IsDeleted = true)"
               FilterPredicate="@(b => !b.IsDeleted)"
               DeleteGuard="@BranchDeleteGuard"
               OnSelectionChanged="OnBranchSelected"
               OnItemSaved="OnBranchSaved"
               OnChanged="NotifyChangedAsync"
               CustomActions="@BranchActions">
        <GridColumns>
            <GridLinkColumn FieldName="Code" Caption="@L["Code"]" Width="120px" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1" OnClick="@(item => _drill?.EditItem((BranchGraphDto)item))" />
            <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" />
            <DxGridDataColumn FieldName="BaseCurrencyUnitId" Caption="@L["BalanceCurrency"]" Width="110px" TextAlignment="GridTextAlignment.Left">
                <CellDisplayTemplate Context="cell">@(Units.FirstOrDefault(u => u.Id == ((BranchGraphDto)cell.DataItem).BaseCurrencyUnitId)?.Code ?? "")</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="IsHeadquarters" Caption="@L["IsHeadquarters"]" Width="90px" TextAlignment="GridTextAlignment.Left">
                <CellDisplayTemplate Context="cell">@(((BranchGraphDto)cell.DataItem).IsHeadquarters ? L["Yes"].Value : "")</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="IsActive" Caption="@L["Status"]" Width="110px" TextAlignment="GridTextAlignment.Left">
                <CellDisplayTemplate Context="cell"><StatusCell Active="@(((BranchGraphDto)cell.DataItem).IsActive)" /></CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="90px" />
        </GridColumns>
        <EditContent Context="b">
            @* DRY: standalone Branch ile AYNI BranchEditFields (alanlar + validasyon tek kaynak). Tek HQ kapatılamaz. *@
            <BranchEditFields Model="b" Units="@Units" HeadquartersEnabled="@(!IsBranchSoleHq(b))" CodeEnabled="true"
                              OnReferenceDataReload="@OnReferenceDataReload" />
        </EditContent>
        <AfterEditForm Context="b">
            <DxTabs CssClass="mt-3">
                <DxTabPage Text="@L["Menu:Vaults"].Value" TabIconCssClass="@TradeXpressIcons.Vault">
                    <VaultDrill Vaults="b.Vaults" OnChanged="NotifyChangedAsync"
                                ParentEntityName="@L["Entity:Branch"]" ParentText="@b.Code" />
                </DxTabPage>
            </DxTabs>
        </AfterEditForm>
    </DrillList>
</div>

@code {
    [Parameter, EditorRequired] public ICompanyGraph Model { get; set; } = default!;
    [Parameter] public List<CurrencyUnitListDto> Units { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Şube combo'sundan birim eklenince/güncellenince host'un birim listesini tazelemesi için yukarı sinyal.</summary>
    [Parameter] public EventCallback OnReferenceDataReload { get; set; }

    private BranchGraphDto? _selectedBranch;
    private DrillList<BranchGraphDto>? _drill;

    // Toolbar custom action — liste sayfalarıyla AYNI descriptor sözleşmesi (SortIndex 300: Sil ile Arama arası).
    private IReadOnlyList<CrudToolbarAction> BranchActions => new[]
    {
        new CrudToolbarAction
        {
            SortIndex = 300,
            Text = L["MakeHeadquarters"],
            Tooltip = L["MakeHeadquarters"],
            IconCssClass = "custom-icon-company",
            Enabled = _selectedBranch is { IsDeleted: false, IsHeadquarters: false },
            OnClick = MakeBranchHeadquarters,
        },
    };

    private async Task NotifyChangedAsync()
    {
        await OnChanged.InvokeAsync();
        StateHasChanged();
    }

    // Yeni şube: bilanço birimi DEFAULT = parent şirketin base'i (boş gelmesin, combo preset olsun; server de aynı default'u uygular).
    private BranchGraphDto NewBranch() => new()
    {
        IsActive = true,
        DisplayOrder = 1,
        BaseCurrencyUnitId = Model.BaseCurrencyUnitId,
        Vaults = { new VaultGraphDto { Code = VaultConsts.DefaultCode, Name = VaultConsts.DefaultName, IsDefault = true, IsActive = true, DisplayOrder = 1 } },
    };

    private static BranchGraphDto CloneBranch(BranchGraphDto b) => new()
    {
        Id = b.Id, ClientKey = b.ClientKey, IsDeleted = b.IsDeleted,
        Code = b.Code, Name = b.Name, IsHeadquarters = b.IsHeadquarters,
        BaseCurrencyUnitId = b.BaseCurrencyUnitId,
        IsActive = b.IsActive, DisplayOrder = b.DisplayOrder, Description = b.Description,
        Vaults = b.Vaults.Select(CloneVault).ToList(),
    };

    private static VaultGraphDto CloneVault(VaultGraphDto v) => new()
    {
        Id = v.Id, ClientKey = v.ClientKey, IsDeleted = v.IsDeleted,
        Code = v.Code, Name = v.Name, IsDefault = v.IsDefault,
        IsActive = v.IsActive, DisplayOrder = v.DisplayOrder, Description = v.Description,
    };

    private void OnBranchSelected(BranchGraphDto? b) => _selectedBranch = b;

    // Tekil-bayrak: KENDİSİ (ClientKey) hariç başka HQ yoksa tektir → silinemez + switch kapalı.
    private bool IsBranchSoleHq(BranchGraphDto b)
        => b.IsHeadquarters && !Model.Branches.Any(x => x.ClientKey != b.ClientKey && !x.IsDeleted && x.IsHeadquarters);

    private string? BranchDeleteGuard(BranchGraphDto b)
        => IsBranchSoleHq(b) ? L["CannotDeleteHeadquartersBranch"].Value : null;

    // Devir: kaydedilen şube HQ ise diğerlerinin bayrağını düşür.
    private void OnBranchSaved(BranchGraphDto saved)
    {
        if (!saved.IsHeadquarters) return;
        foreach (var b in Model.Branches)
            if (!ReferenceEquals(b, saved) && !b.IsDeleted)
                b.IsHeadquarters = false;
    }

    private async Task MakeBranchHeadquarters()
    {
        if (_selectedBranch is null || _selectedBranch.IsDeleted) return;
        foreach (var b in Model.Branches)
            b.IsHeadquarters = false;
        _selectedBranch.IsHeadquarters = true;
        await NotifyChangedAsync();
    }
}

