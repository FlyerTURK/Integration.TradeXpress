@using System
@using System.Linq
@using Integration.TradeXpress.Variants
@using Integration.TradeXpress.Attachments
@using Integration.Framework.Blazor.Client.Components.Crud
@using DevExpress.Blazor
@typeparam TVariant
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* JENERİK varyant paneli — nitelik×değer kartezyeninden ÜRETİLEN varyantlar. "Varyantları Oluştur" butonu (nitelik
   varsa) sahibin OnGenerate'ini çağırır (sunucu üretir → Variants). Drill ekleme/silmeye KAPALI (synchronizer üretir);
   yalnız panelin kendi alanları (Barkod/Stok/Açıklama/Aktif) düzenlenir. Entity-özel alanlar ExtraFields slot'unda. *@

@* Varyantlar nitelik/değer değişiminde OTOMATİK senkronlanır (buton yok) — sahip layout EntityAttributesPanel.OnAttributesChanged'i host regen'ine bağlar. *@
@* Aşağıdaki DrillList'te sayfalama YOK (DrillList varsayılanı) ve SANAL KAYDIRMA açık: kartezyen varyant
   listesi (nitelik×değer) uzayabildiğinden DOM şişmeden tek akışta gösterilir. *@
@* VARYANT KAPSAMI BANDI — bu panelin araç çubuğunun ÜSTÜNDE (2026-08-20 kuralı: issue hangi kapsamdaysa bandı
   da orada durur). "variants" kapsamı fiyatsız varyant · reçetesiz varyant · sıfır miktarlı emtia satırı gibi
   issue'ları kapsar. Endeks yoksa (Good/Jewelry/Metal formları — satışa hazırlık paneli yok) hiç çizilmez. *@
<ReadinessNotice Scope="@SaleReadinessScope.Variants" />

@if (Attributes.Any(a => !a.IsDeleted))
{
    <div style="padding:0.5rem 0.5rem 0; color:#6c757d; font-size:0.85rem;">
        @L["VariantsAutoSyncInfo"]
    </div>
}

<DrillList TItem="TVariant"
           @ref="_variantDrill"
           Title="@L["Variants"]"
           EntityName="@L["Variant"]"
           EntityIcon="@TradeXpressIcons.ProductVariant"
           Items="Variants"
           KeyFieldName="ClientKey"
           PrimaryTextSelector="@(v => v.Code)"
           NewItemFactory="@(() => new TVariant())"
           AllowAdd="false"
           AllowDelete="false"
           VirtualScrollingEnabled="true"
           CustomActions="@AttributeActions"
           FilterPredicate="@(v => !v.IsDeleted)"
           OnChanged="@(() => EditChanged?.Invoke())">
    <GridColumns>
        @* SATIŞA-HAZIRLIK İŞARETİ — satırın kendi kapsamındaki (variants/{id} ve altı) en yüksek ağırlık.
           Kullanıcı hangi varyantın engelli olduğunu formu tek tek açmadan görür.
           Kolon @if ile SARILMAZ, Visible ile gizlenir: "nested settings" öğeleri toplayıcıya kayıt sırasında
           girer; sonradan eklenen kolon listenin sonuna düşer ve kolon sırası bozulur (ui-blazor kuralı).
           Endeks cascade EDİLMEMİŞSE (Good/Jewelry/Metal formlarında satışa hazırlık paneli yok) kolon hiç görünmez. *@
        @* VisibleIndex VERİLMEZ: Kod kolonu açıkça 1'i tutuyor, indeks veren/vermeyen kolonları karıştırmak
           sırayı öngörülemez kılıyor. Kolon markup'ta ilk sırada durur, bu yeterlidir. *@
        <DxGridDataColumn Caption="" Width="44px" Visible="@ShowReadinessColumn"
                          TextAlignment="GridTextAlignment.Center">
            <CellDisplayTemplate Context="readinessCell">
                @{
                    var readinessVariant = (TVariant)readinessCell.DataItem;
                }
                @* İŞARETİ ORTAK BİLEŞEN ÇİZER (ReadinessMark): renk · ikon · ipucu · "Info çizmez" kuralı tek
                   yerdedir. Aynı üç satırı burada elle yazmak, kanal grid'iyle bu grid'in aynı ağırlığı farklı
                   ikonla göstermesine yol açmıştı. *@
                <ReadinessMark Index="@ReadinessIndex" Scope="@ReadinessScopeOf(readinessVariant)" />
            </CellDisplayTemplate>
        </DxGridDataColumn>
        @if (ShowImages)
        {
            <DxGridDataColumn Caption="@L["Preview"]" Width="70px" TextAlignment="GridTextAlignment.Center">
                <CellDisplayTemplate Context="cell">
                    @{ var vv = (TVariant)cell.DataItem; var src = VariantPreviewSrc(vv); }
                    @if (!string.IsNullOrEmpty(src))
                    {
                        @* ham img: Dx görsel bileşeni yok — küçük, sınırlı önizleme (liste deseniyle aynı) *@
                        <img src="@src" alt="" style="max-height:36px; max-width:64px; object-fit:contain;" />
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
        }
        @* Kod kolonu SOLA SABİTLENMİŞ DEĞİL (2026-07-28 Hakan): varyant grid'i kendi kolonlarıyla ekrana
           sığıyor, sabitleme yatay kaydırma olmayan bir grid'de yalnız görsel bir ayraç bırakıyordu.
           Kolon yine ilk sırada (VisibleIndex=1) ve tıklanabilir kalıyor. *@
        <GridLinkColumn Caption="@L["Code"]" TextSelector="@(item => CodeTextOf((TVariant)item))" Width="140px" VisibleIndex="1"
                        OnClick="@(item => _variantDrill?.EditItem((TVariant)item))" />
        <DxGridDataColumn FieldName="AttributeSummary" Caption="@L["AttributeSummary"]" />
        <DxGridDataColumn FieldName="Barcode" Caption="@L["Barcode"]" Width="140px" />
        <DxGridDataColumn FieldName="Gtin" Caption="@L["Gtin"]" Width="130px" />
        @if (ShowStockQuantity)
        {
            <DxGridDataColumn FieldName="StockQuantity" Caption="@L["StockQuantity"]" Width="110px" />
        }
        @* Maliyet OPT-IN: alan yalnız ürün varyantında var (NetCost), jenerik varyantta yok — bayrak
           kapalıyken kolon hiç çizilmez ki diğer emtia aileleri boş kolon görmesin. *@
        @if (ShowNetCost)
        {
            <DxGridDataColumn FieldName="NetCost" Caption="@L["NetCost"]" Width="130px"
                              TextAlignment="GridTextAlignment.Right" DisplayFormat="n2" />
        }
        <DxGridDataColumn FieldName="IsMain" Caption="@L["Main"]" Width="90px">
            <CellDisplayTemplate Context="cell">
                @if (cell.Value is bool b && b)
                {
                    <span style="display:flex; align-items:center; gap:0.35rem;">
                        <i class="custom-icon-check-circle" aria-hidden="true" style="color:#16a34a;"></i>@L["Main"]
                    </span>
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <StatusColumn />
    </GridColumns>
    <EditContent Context="v">
        <DxFormLayout CssClass="w-100">
            @* Kod + kombinasyon özeti — ikisi de SALT-OKUNUR. Tek varyantlı üründe gizlenir (ShowIdentity):
               kombinasyon yok, kod otomatik → boş yere yer kaplıyorlardı. *@
            @if (ShowIdentity)
            {
                <DxFormLayoutItem Caption="@L["Code"]" ColSpanMd="6">
                    <DxTextBox Text="@CodeTextOf(v)" ReadOnly="true" ValidationEnabled="false" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["AttributeSummary"]" ColSpanMd="12" BeginRow="true">
                    <DxTextBox Text="@v.AttributeSummary" ReadOnly="true" ValidationEnabled="false" />
                </DxFormLayoutItem>
            }
            @* Tanımlama değerleri (per-SKU ticari kimlikler) — TAM SATIR grup, içinde yarımşar (2×2). *@
            <DxFormLayoutGroup Caption="@L["IdentificationValues"]" ColSpanMd="12">
                <DxFormLayoutItem Caption="@L["Barcode"]" ColSpanMd="6">
                    <DxTextBox @bind-Text="@v.Barcode" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Gtin"]" ColSpanMd="6">
                    <DxTextBox @bind-Text="@v.Gtin" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Mpn"]" ColSpanMd="6">
                    <DxTextBox @bind-Text="@v.Mpn" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Oem"]" ColSpanMd="6">
                    <DxTextBox @bind-Text="@v.Oem" />
                </DxFormLayoutItem>
            </DxFormLayoutGroup>
            @if (ShowStockQuantity)
            {
                <DxFormLayoutItem Caption="@L["StockQuantity"]" ColSpanMd="6" BeginRow="true">
                    <NumericSpinEdit @bind-Value="@v.StockQuantity" />
                </DxFormLayoutItem>
            }
            @* Uzantı slot'u — entity-özel alanlar (Good: fiyat/stok). *@
            @ExtraFields?.Invoke(v)
            @* Durum — yarım satır. *@
            <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6" BeginRow="true">
                <DxCheckBox @bind-Checked="@v.IsActive" CheckType="CheckType.Switch">
                    @(v.IsActive ? L["Active"] : L["Passive"])
                </DxCheckBox>
            </DxFormLayoutItem>
        </DxFormLayout>
        @* Varyant-özel ekler (agnostik EntityImage/Document/Note; ShowImages) — Resimler + Dokümanlar + Notlar sekmeleri (altta). *@
        @if (ShowImages)
        {
            <DrillTabs CssClass="mt-2">
                <DxTabPage Text="@L["Media"]" TabIconCssClass="@TradeXpressIcons.Product">
                    <EntityMediaPanel Media="@v.Media" />
                </DxTabPage>
                <DxTabPage Text="@L["Documents"]" TabIconCssClass="@TradeXpressIcons.Report">
                    <EntityDocumentsPanel Documents="@v.Documents" />
                </DxTabPage>
                <DxTabPage Text="@L["Notes"]" TabIconCssClass="@TradeXpressIcons.Comments">
                    <EntityNotesPanel Notes="@v.Notes" />
                </DxTabPage>
            </DrillTabs>
        }
    </EditContent>
</DrillList>

@* Nitelik editörü — varyant gridinin "Özellikleri Düzenle" toolbar butonu bunu açar (ayrı sekme YOK). Nitelik/değer
   değişimi DERHAL regen ETMEZ — kullanıcı tam düzenler, "Uygula" ile varyantlar yeniden üretilir. Üretim
   VariantGraphMerge kullanır → mevcut varyant düzenlemeleri (fiyat/reçete/barkod) CombinationKey ile KORUNUR
   (ör. "Kırmızı 45" tanımları, "Siyah" eklenince silinmez). *@
@if (OnAttributesChanged.HasDelegate)
{
    <DxPopup @bind-Visible="@_attributesPopupVisible" HeaderText="@L["EditAttributes"]" Width="min(95vw, 720px)"
             ShowFooter="true" CloseOnOutsideClick="false">
        <BodyContentTemplate Context="__attrBody">
            @* Uyarı — Uygula varyantları yeniden üretir; artık kullanılmayan varyant/reçeteler silinir (Dx karşılığı yok → MarginSetDialog uyarı-kutusu deseni). *@
            <div style="background:#fff3cd; color:#664d03; border:1px solid #ffe69c; border-radius:0.375rem; padding:0.5rem 0.75rem; margin-bottom:0.75rem; font-size:0.8rem; display:flex; align-items:flex-start; gap:0.5rem;">
                <i class="custom-icon-warning" aria-hidden="true" style="margin-top:0.15rem;"></i>
                <span>@L["VariantRegenWarning"]</span>
            </div>
            <EntityAttributesPanel Attributes="Attributes" />
        </BodyContentTemplate>
        <FooterContentTemplate Context="__attrFtr">
            <DxButton Text="@L["Apply"].Value"
                      RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Click="@OnApplyAttributes" />
            <DxButton Text="@L["Close"].Value"
                      RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Click="@(() => _attributesPopupVisible = false)" />
        </FooterContentTemplate>
    </DxPopup>
}
