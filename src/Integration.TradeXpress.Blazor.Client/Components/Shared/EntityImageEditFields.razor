@using Integration.TradeXpress.Attachments
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Entity-agnostik görsel edit alanları — TEK-görsel çekirdeği (kaynak/URL/dosya/önizleme) paylaşılan
   SingleImageEditFields'te; burada yalnız sıra + varsayılan alanları ve entity-agnostik
   IEntityImageAppService upload bağlaması. Herhangi bir entity'nin (Good, GoodVariant, Metal...)
   çok-görselli drill'i bunu tüketir → görsel altyapısı TEK yerde (DRY). Çağıran DxFormLayout'u sağlar. *@

<SingleImageEditFields Model="@Model"
                       UploadAsync="@UploadCoreAsync"
                       MaxImageSizeBytes="@EntityImageConsts.MaxImageSizeBytes"
                       TooLargeErrorKey="TradeXpress:Image:ImageTooLarge"
                       DuplicateErrorKey="TradeXpress:Image:ImageDuplicate"
                       IsDuplicateFileName="@IsDuplicateFileName">
    <AfterSourceContent>
        <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
            <NumericSpinEdit @bind-Value="@Model.DisplayOrder" />
        </DxFormLayoutItem>
        @* Varsayılan (ana) görsel — liste grid thumbnail'i; tekil garanti sunucuda (ReplaceFor normalize). *@
        <DxFormLayoutItem Caption="@L["Default"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsDefault" CheckType="CheckType.Switch">
                @(Model.IsDefault ? L["Yes"] : L["No"])
            </DxCheckBox>
        </DxFormLayoutItem>
    </AfterSourceContent>
</SingleImageEditFields>
