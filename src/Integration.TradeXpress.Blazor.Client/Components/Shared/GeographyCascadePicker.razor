@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Yeniden kullanılabilir coğrafya cascade seçici — Ülke → İl/Eyalet → İlçe. Ülke seçilince o ülkenin idari
   alanları IGeographyAppService'ten çekilir (DB'de yoksa ilk seferde LAZY IMPORT tetiklenir → birkaç sn; combolar
   pasif + hint). Ülke UsesAdministrativeArea=false ise (ya da yalnız sembolik ana alan dönerse) il/eyalet combo'su
   GİZLENİR, tek alan otomatik seçilip doğrudan ilçe combo'su gösterilir. Üst seviye seçilince alt seviyeler
   otomatik İLK değerine iner (auto-select cascade). Seçim SelectionChanged callback'i ile çağırana (ör.
   AddressFields) bildirilir; picker adres modelini DOLDURUR ama alanlar düzenlenebilir kalır.
   EMBEDDED modu: Embedded=true iken kendi DxFormLayout/DxFormLayoutGroup WRAPPER'ını RENDER ETMEZ, yalnız
   DxFormLayoutItem combo'larını render eder → parent'ın grubuna inerler (AddressFields tek grupta birleştirir).
   DUMB-layout istisnası: reusable picker kendi servislerini INJECT eder (LookupComboBox gibi). EditContext altındaki
   manuel-bağlı combolar salt UI durumu → ValidationEnabled="false" ([validation-expr]). *@

@{
    // Combo item'ları TEK yerde — Embedded moduna göre sarmalanır (WRAPPER: kendi grubu vs parent grubu). DRY.
    RenderFragment pickerItems =@<text>
        @* Ülke combo'su yalnız SERBEST modda görünür. Sabit-ülke modunda (FixedCountryId dolu — ör. şube
           company ülkesine kilitli) ülke gizlenir, o ülke otomatik seçilir, cascade İl'den başlar. *@
        @if (FixedCountryId is null)
        {
            <DxFormLayoutItem Caption="@L["Country"]" ColSpanMd="6">
                <DxComboBox TData="CountryListDto" TValue="Guid?"
                            Data="@_countries"
                            ValueFieldName="@nameof(CountryListDto.Id)"
                            TextFieldName="@nameof(CountryListDto.Name)"
                            Value="@_selectedCountryId"
                            ValueChanged="@(async (Guid? id) => await OnCountrySelectedAsync(id))"
                            NullText="@L["Select"].Value"
                            Enabled="@(!IsBusy)"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.Contains"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                            ValidationEnabled="false"
                            CssClass="w-100" />
            </DxFormLayoutItem>
        }

        @* İl/Eyalet — yalnız ülke idari-alan seviyesi kullanıyorsa görünür (sembolik ana alanlı ülkede gizli). *@
        @if (_usesAreaLevel)
        {
            <DxFormLayoutItem Caption="@AreaCaption" ColSpanMd="6">
                <DxComboBox TData="AdministrativeAreaDto" TValue="Guid?"
                            Data="@_areas"
                            ValueFieldName="@nameof(AdministrativeAreaDto.Id)"
                            TextFieldName="@nameof(AdministrativeAreaDto.Name)"
                            Value="@_selectedAreaId"
                            ValueChanged="@(async (Guid? id) => await OnAreaSelectedAsync(id))"
                            AllowUserInput="true"
                            DropDownTriggerMode="DropDownTriggerMode.Click"
                            Text="@_areaText"
                            TextChanged="@(async (string? t) => await OnAreaTextChangedAsync(t))"
                            NullText="@L["Select"].Value"
                            Enabled="@(!IsBusy && _selectedCountryId != null)"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.Contains"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                            ValidationEnabled="false"
                            CssClass="w-100" />
            </DxFormLayoutItem>
        }

        <DxFormLayoutItem Caption="@LocalityCaption" ColSpanMd="6">
            <DxComboBox TData="LocalityDto" TValue="Guid?"
                        Data="@_localities"
                        ValueFieldName="@nameof(LocalityDto.Id)"
                        TextFieldName="@nameof(LocalityDto.Name)"
                        Value="@_selectedLocalityId"
                        ValueChanged="@(async (Guid? id) => await OnLocalitySelectedAsync(id))"
                        AllowUserInput="true"
                        DropDownTriggerMode="DropDownTriggerMode.Click"
                        Text="@_localityText"
                        TextChanged="@(async (string? t) => await OnLocalityTextChangedAsync(t))"
                        NullText="@L["Select"].Value"
                        Enabled="@(!IsBusy && HasAreaContext)"
                        SearchMode="ListSearchMode.AutoSearch"
                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                        ValidationEnabled="false"
                        CssClass="w-100" />
        </DxFormLayoutItem>

        @* Mahalle — yalnız ülke mahalle seviyesi kullanıyorsa görünür (ör. TR; ABD/diğerlerinde gizli). CANLI N11 çekimi
           (saklanmaz; her ilçe seçiminde taze). Değer N11 mahalle id'si (string) — kalıcı çekirdek id değil. *@
        @if (_usesSubLocalityLevel)
        {
            <DxFormLayoutItem Caption="@NeighborhoodCaption" ColSpanMd="6">
                <DxComboBox TData="NeighborhoodDto" TValue="string"
                            Data="@_neighborhoods"
                            ValueFieldName="@nameof(NeighborhoodDto.Id)"
                            TextFieldName="@nameof(NeighborhoodDto.Name)"
                            Value="@_selectedNeighborhoodId"
                            ValueChanged="@(async (string? id) => await OnNeighborhoodSelectedAsync(id))"
                            AllowUserInput="true"
                            DropDownTriggerMode="DropDownTriggerMode.Click"
                            Text="@_neighborhoodText"
                            TextChanged="@(async (string? t) => await OnNeighborhoodTextChangedAsync(t))"
                            NullText="@L["Select"].Value"
                            Enabled="@(!IsBusy && HasLocalityContext)"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.Contains"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                            ValidationEnabled="false"
                            CssClass="w-100" />
            </DxFormLayoutItem>
        }

        @* Busy göstergesi — il/eyalet dataset'i indirilirken, seçilen eyaletin şehirleri per-state inerken ya da
           mahalle CANLI N11'den çekilirken (birkaç sn). Auto-select cascade sırasında da görünür (yükleme bitene dek). *@
        @if (_importing)
        {
            <DxFormLayoutItem ColSpanMd="12">
                <span style="color:#6c757d; font-size:0.85rem;">@L["Geography:Picker:Importing"]</span>
            </DxFormLayoutItem>
        }
        else if (_loadingLocalities)
        {
            <DxFormLayoutItem ColSpanMd="12">
                <span style="color:#6c757d; font-size:0.85rem;">@L["Geography:Picker:LoadingLocalities"]</span>
            </DxFormLayoutItem>
        }
        else if (_loadingNeighborhoods)
        {
            <DxFormLayoutItem ColSpanMd="12">
                <span style="color:#6c757d; font-size:0.85rem;">@L["Geography:Picker:LoadingNeighborhoods"]</span>
            </DxFormLayoutItem>
        }
    </text>;
}

@* Embedded → wrapper YOK (parent'ın grubuna in); aksi halde kendi DxFormLayout+Group'unu taşır (standalone). *@
@if (Embedded)
{
    @pickerItems
}
else
{
    <DxFormLayout CssClass="w-100">
        <DxFormLayoutGroup Caption="@L["Geography:Picker:Section"]" ColSpanMd="12">
            @pickerItems
        </DxFormLayoutGroup>
    </DxFormLayout>
}
