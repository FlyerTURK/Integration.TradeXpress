@using DevExpress.Blazor
@using Integration.Framework.Base.Dtos
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@*
   Yeniden kullanılabilir "Status" (IsActive) grid kolonu — DTO-AGNOSTİK (cell.Value = IsActive değeri →
   per-DTO cast YOK). GridLinkColumn deseni: WRAPPER bileşen; iç DxGridDataColumn cascade ile grid'e normal
   kaydolur (DxGrid kolonları CollectionFiller'la DEĞİL cascade ile toplanır → DxTabs'in aksine wrapper
   güvenli). Caption her yerde "Status" (memory: isactive-kolon-filtre-kurali). IsActive toolbar filtresi
   olan grid'e KONMAZ (aynı kural).

   DÜZENLENEBİLİR (2026-07-27 Hakan): satırı açmadan doğrudan hücreden aktif/pasif yapılabilir — tek bir
   kaydı pasifleştirmek için edit formunu açıp kapatmak gereksiz yüktü. Yazma yolu TİP-GÜVENLİ: satır DTO'su
   IHasIsActive uyguluyorsa switch çizilir, uygulamıyorsa (salt-okunur projeksiyon) eski ikonlu görünüm
   korunur. Hangi listelerin düzenlenebilir olduğu böylece DERLEME ZAMANINDA görünür.
*@
<DxGridDataColumn FieldName="@FieldName"
                  Caption="@(Caption ?? L["Status"].Value)"
                  Width="@Width"
                  TextAlignment="GridTextAlignment.Left"
                  VisibleIndex="@VisibleIndex"
                  Visible="@Visible">
    <CellDisplayTemplate Context="cell">
        @if (Editable && cell.DataItem is IHasIsActive target)
        {
            @* ValidationEnabled=false: bu bir MODEL alanı değil, hücre içi hızlı toggle — EditContext
               altında ValueExpression aranmasın ([validation-expr]).
               Olay işleyici SENKRON: DevExpress'in kolon/ayar (nested settings) render'ı ASENKRON render'a
               izin vermez — async yapılırsa "Async rendering is not allowed here" ile çöker. *@
            <DxCheckBox Checked="@target.IsActive"
                        CheckedChanged="@((bool v) => Toggle(target, v))"
                        CheckType="CheckType.Switch"
                        ValidationEnabled="false">
                @(target.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        }
        else
        {
            <StatusCell Active="@(cell.Value is bool b && b)" />
        }
    </CellDisplayTemplate>
</DxGridDataColumn>
