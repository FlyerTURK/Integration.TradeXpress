@using System
@using Integration.TradeXpress.Attachments
@using Integration.Framework.Blazor.Client.Services.Base
@using DevExpress.Blazor
@using Microsoft.JSInterop
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IMediaAppService MediaService
@inject IUiInteractionService Ui
@inject IJSRuntime JS
@inject IServiceProvider ServiceProvider

@* Entity MEDYA paneli — kayıt'ın merkezi kütüphane medyalarına LİNK'lerini yönetir (görsel + video birlikte). Yükle /
   URL-import → self-contained blob (dedup) → link. Poster thumbnail + video ▶; varsayılan/aktif (varsayılan pasif olamaz);
   sırala; sil; video → istediğin kareden poster. URL alanı GÖSTERİLMEZ. Sahip AppService save'de link setini persist eder. *@

@* Ekleme yolları TEK "+ Yeni" dropdown'ında (reçete/işlem toolbar deseniyle aynı), Sil seçime bağlı toolbar'da. *@
<DxToolbar AdaptivityAutoHideRootItems="false" AdaptivityAutoCollapseItemsToIcons="false">
    <DxToolbarItem Text="@L["New"]" IconCssClass="@TradeXpressIcons.Add">
        <Items>
            @* Ayrı bir "yükle" ikonu setimizde yok; ad-hoc sembol yasak (ui-blazor kuralı) → ekleme ikonu kullanılır. *@
            <DxToolbarItem Text="@L["MediaUploadFile"]" IconCssClass="@TradeXpressIcons.Add" Click="@(() => _uploadPopupVisible = true)" />
            <DxToolbarItem Text="@L["MediaImportUrl"]" IconCssClass="@TradeXpressIcons.Download" Click="@(() => _importPopupVisible = true)" />
            <DxToolbarItem Text="@L["MediaPickFromLibrary"]" IconCssClass="@TradeXpressIcons.Copy" Click="@OpenPickerAsync" />
        </Items>
    </DxToolbarItem>
    <DxToolbarItem BeginGroup="true" Text="@L["Delete"]" IconCssClass="@TradeXpressIcons.Delete"
                   Click="@RemoveSelected" Enabled="@(_selected.Count > 0)" />
</DxToolbar>

<DxGrid Data="@Media" CssClass="w-100" ShowFilterRow="false" PagerVisible="false"
        SelectionMode="GridSelectionMode.Multiple" @bind-SelectedDataItems="@_selected">
    <Columns>
        <DxGridSelectionColumn Width="44px" />
        <DxGridDataColumn Caption="@L["Preview"]" Width="110px" TextAlignment="GridTextAlignment.Center" AllowSort="false">
            <CellDisplayTemplate Context="cell">
                @{ var link = (EntityMediaLinkEditDto)cell.DataItem; var m = link.Media; }
                <div style="position:relative; display:inline-block; width:88px; height:58px; background:#20242c; border-radius:6px; overflow:hidden;">
                    @if (m is not null && !string.IsNullOrEmpty(m.PosterUrl))
                    {
                        <img src="@m.PosterUrl" alt="" style="width:88px; height:58px; object-fit:cover;" />
                    }
                    @if (m is not null && m.MediaType == MediaType.Video)
                    {
                        <span style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center;">
                            <svg width="24" height="24" viewBox="0 0 24 24" style="filter:drop-shadow(0 0 2px rgba(0,0,0,.6));">
                                <circle cx="12" cy="12" r="11" fill="rgba(0,0,0,.45)"/>
                                <path d="M9.5 7.5v9l7-4.5z" fill="#fff"/>
                            </svg>
                        </span>
                    }
                </div>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn Caption="@L["Name"]" MinWidth="160" AllowSort="false">
            <CellDisplayTemplate Context="cell">
                @(((EntityMediaLinkEditDto)cell.DataItem).Media?.FileName)
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn Caption="@L["Default"]" Width="90px" AllowSort="false" TextAlignment="GridTextAlignment.Center">
            <CellDisplayTemplate Context="cell">
                @{ var link = (EntityMediaLinkEditDto)cell.DataItem; }
                <DxCheckBox Checked="@link.IsDefault" CheckedExpression="@(() => link.IsDefault)"
                            CheckedChanged="@((bool v) => OnDefaultChanged(link, v))" CheckType="CheckType.Switch" />
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn Caption="@L["Status"]" Width="90px" AllowSort="false" TextAlignment="GridTextAlignment.Center">
            <CellDisplayTemplate Context="cell">
                @{ var link = (EntityMediaLinkEditDto)cell.DataItem; }
                <DxCheckBox Checked="@link.IsActive" CheckedExpression="@(() => link.IsActive)"
                            CheckedChanged="@((bool v) => OnActiveChanged(link, v))" CheckType="CheckType.Switch" />
            </CellDisplayTemplate>
        </DxGridDataColumn>
        @* Sıralama. YUKARI oku ayrı bir ikon değil, chevron-down'ın 180° döndürülmüş hâlidir: ikon setinde
           chevron-up YOK ve yeni CSS sınıfı açmak onay ister (CLAUDE.md §1). Önceden burada "geri" (sola) oku
           duruyordu — yön anlatmıyordu. Sil buraya DEĞİL toolbar'a taşındı (seçime bağlı). *@
        <DxGridDataColumn Caption="" Width="150px" AllowSort="false" TextAlignment="GridTextAlignment.Center">
            <CellDisplayTemplate Context="cell">
                @{ var link = (EntityMediaLinkEditDto)cell.DataItem; }
                <span title="@L["MoveUp"]" style="display:inline-block; transform:rotate(180deg);">
                    <DxButton IconCssClass="@TradeXpressIcons.ChevronDown" RenderStyle="ButtonRenderStyle.Link"
                              Click="@(() => Move(link, -1))" Enabled="@(!IsFirst(link))" />
                </span>
                <span title="@L["MoveDown"]">
                    <DxButton IconCssClass="@TradeXpressIcons.ChevronDown" RenderStyle="ButtonRenderStyle.Link"
                              Click="@(() => Move(link, 1))" Enabled="@(!IsLast(link))" />
                </span>
                @if (link.Media?.MediaType == MediaType.Video)
                {
                    <DxButton Text="@L["MediaSetPoster"]" RenderStyle="ButtonRenderStyle.Link" Click="@(() => OpenCapture(link))" />
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</DxGrid>

@* Dosya yükle — DxFileInput popup'a taşındı ki üç ekleme yolu tek "+ Yeni" menüsünde toplansın. *@
<DxPopup @bind-Visible="@_uploadPopupVisible" HeaderText="@L["MediaUploadFile"]" Width="min(95vw, 560px)" ShowFooter="true">
    <BodyContentTemplate Context="__uploadBody">
        @* SelectButtonText/DropZoneText VERİLMEZSE DevExpress kendi İngilizce metnini ("Select File") basar —
           uygulamanın geri kalanı Türkçeyken orada kalıyordu. *@
        <DxFileInput FilesUploading="OnFilesUploadingAsync" AllowedFileExtensions="@_allowedExtensions" CssClass="media-upload"
                     SelectButtonText="@L["MediaSelectFile"]" DropZoneText="@L["MediaDropZone"]" />
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="@L["Close"]" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _uploadPopupVisible = false)" />
    </FooterContentTemplate>
</DxPopup>

@* URL'den içe aktar *@
<DxPopup @bind-Visible="@_importPopupVisible" HeaderText="@L["MediaImportUrl"]" Width="min(95vw, 560px)" ShowFooter="true">
    <BodyContentTemplate Context="__importBody">
        <DxFormLayout CssClass="w-100">
            <DxFormLayoutItem Caption="@L["MediaUrl"]" ColSpanMd="12">
                <DxTextBox @bind-Text="@_importUrl" NullText="https://..." />
            </DxFormLayoutItem>
        </DxFormLayout>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="@L["Import"]" RenderStyle="ButtonRenderStyle.Primary" Click="@ImportUrlAsync" Enabled="@(!_busy)" />
        <DxButton Text="@L["Cancel"]" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _importPopupVisible = false)" />
    </FooterContentTemplate>
</DxPopup>

@* Video → kareyi poster yap *@
<DxPopup @bind-Visible="@_capturePopupVisible" HeaderText="@L["MediaSetPoster"]" Width="min(95vw, 720px)" ShowFooter="true">
    <BodyContentTemplate Context="__captureBody">
        @if (_captureLink?.Media is not null)
        {
            <div style="display:flex; flex-direction:column; gap:0.5rem;">
                <span style="color:#6c757d; font-size:0.85rem;">@L["MediaCaptureHint"]</span>
                <video id="@_captureVideoId" src="@_captureLink.Media.ContentUrl" controls playsinline webkit-playsinline
                       style="width:100%; max-height:400px; background:#000; border-radius:6px;"></video>
            </div>
        }
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="@L["MediaCaptureFrame"]" RenderStyle="ButtonRenderStyle.Primary" Click="@CaptureFrameAsync" Enabled="@(!_busy)" />
        <DxButton Text="@L["Close"]" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _capturePopupVisible = false)" />
    </FooterContentTemplate>
</DxPopup>

@* Kütüphaneden seç — mevcut medyayı link'le (reuse) *@
<DxPopup @bind-Visible="@_pickerVisible" HeaderText="@L["MediaPickFromLibrary"]" Width="min(95vw, 760px)">
    <BodyContentTemplate Context="__pickerBody">
        <DxGrid Data="@_libraryItems" PageSize="12" PagerVisible="true">
            <Columns>
                <DxGridDataColumn Caption="@L["Preview"]" Width="100px" TextAlignment="GridTextAlignment.Center" AllowSort="false">
                    <CellDisplayTemplate Context="pcell">
                        @{ var pm = (MediaDto)pcell.DataItem; }
                        @if (!string.IsNullOrEmpty(pm.PosterUrl))
                        {
                            <img src="@pm.PosterUrl" alt="" style="width:80px; height:52px; object-fit:cover; border-radius:4px;" />
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="FileName" Caption="@L["Name"]" />
                <DxGridDataColumn Caption="@L["MediaTypeCaption"]" Width="90px">
                    <CellDisplayTemplate Context="pcell">
                        @L[$"Enum:MediaType:{((MediaDto)pcell.DataItem).MediaType}"]
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn Caption="" Width="90px" AllowSort="false" TextAlignment="GridTextAlignment.Center">
                    <CellDisplayTemplate Context="pcell">
                        <DxButton Text="@L["SelectAction"]" RenderStyle="ButtonRenderStyle.Link" Click="@(() => Pick((MediaDto)pcell.DataItem))" />
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </DxGrid>
    </BodyContentTemplate>
</DxPopup>
