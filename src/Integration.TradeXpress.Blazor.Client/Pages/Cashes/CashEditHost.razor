@page "/cashes/new"
@page "/cashes/{Id:guid}"
@using System
@using System.Linq
@using System.Collections.Generic
@using Integration.TradeXpress.Cashes
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.TradeXpress.Blazor.Client.Pages.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject ICashAppService CashAppService
@inject ICurrencyUnitAppService CurrencyUnitAppService
@inject IObjectMapper Mapper
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenant
@inject Integration.TradeXpress.Blazor.Client.Services.Mdi.ITabManager TabManager

@*
   Cash edit host = İNCE SARMAL: coordinator + takip adayları (Type=Cash para birimleri) + config.
   Global Cash tenant'ta salt-okunur (IsReadOnly). commit/save/delete/close generic CrudEditHost'ta.
   FollowingUnit ZORUNLU → kullanıcı seçer (Required validasyonu modelde).
*@

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="CashGetDto" TListDto="CashListDto" TKey="Guid" TListRequestDto="CashListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["Cash"].Value" IconCssClass="@TradeXpressIcons.Cash"
                  EntityValue="@(m => m.Code)"
                  IsReadOnly="@(m => m.IsGlobal && CurrentTenant?.Id != null)"
                  ApplyNewDefaults="@(m => { m.IsActive = true; })">
        <CashLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" CurrencyUnits="@_cashUnits"
                    OnEditFollowingUnit="@OnEditFollowingUnitAsync" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private List<CurrencyUnitListDto> _cashUnits = new();
    private ICommitCoordinator<CashGetDto, CashListDto, Guid, CashListRequestDto>? _coordinator;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<CashGetDto, CashListDto, Guid, CashListRequestDto, CashCreateDto, CashUpdateDto>(
            CashAppService, Mapper);

        // Aday cins = Type=Cash para birimleri (nakit kaydının cinsi madde değil, nakit dövizdir).
        var result = await CurrencyUnitAppService.GetListAsync(new CurrencyUnitListRequestDto { MaxResultCount = 1000 });
        _cashUnits = result.Items.Where(u => u.Type == CurrencyUnitType.Cash).ToList();

        _ready = true;
    }

    // Takip birimi combo'sundaki ✎ → o birimin edit'ini MDI sekmesinde aç (grid linkleriyle tutarlı).
    private async Task OnEditFollowingUnitAsync(Guid? followingId)
    {
        if (followingId is not { } id || id == Guid.Empty) return;
        var code = _cashUnits.FirstOrDefault(u => u.Id == id)?.Code;
        await TabManager.OpenOrActivateAsync(
            $"/currencies/currency-units/{id}",
            $"{L["CurrencyUnit"]}: {code}",
            TradeXpressIcons.CurrencyUnit);
    }
}
