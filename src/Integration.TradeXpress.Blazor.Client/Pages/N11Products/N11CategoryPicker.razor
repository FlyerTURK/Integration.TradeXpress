@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* N11 kategori seçici — TEK arama-destekli lookup (tüm yapraklar, TAM YOL adıyla). Yaz-ara-seç; kademeli drill yok.
   LookupComboBox EditContext-güvenli (ValueExpression'sız → ValidationEnabled=false); ~3700 yaprak client-side filtre. *@

<LookupComboBox TItem="N11LeafCategoryDto" TValue="string"
                Data="@_leaves"
                ValueFieldName="@nameof(N11LeafCategoryDto.ExternalId)"
                TextFieldName="@nameof(N11LeafCategoryDto.Path)"
                Value="@SelectedExternalId"
                ValueChanged="@OnCategoryChangedAsync"
                NullText="@L["N11Product:SelectCategory"].Value"
                AllowClear="false" />
