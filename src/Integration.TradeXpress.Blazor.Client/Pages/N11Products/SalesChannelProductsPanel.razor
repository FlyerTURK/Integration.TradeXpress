@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Ürünün SATIŞ KANALI ÜRÜNLERİ drill'i — PERSISTENT (her işlem anında AppService'e yazılır). Product edit formunun
   İÇİNDE (ürün kaydedildikten sonra) açılır. "Yeni" SPLIT buton (built-in kapalı): tip alt menüden (şimdilik N11);
   kanal otomatik atanır (şirkette tek N11 kanalı) + SET-ONCE. Satır başına "N11'e Gönder" (SaveProduct push). *@

<div class="mt-3">
    <DrillList TItem="SalesChannelTrN11ProductDto"
               @ref="_drill"
               Title="@L["SalesChannelProducts"]"
               EntityName="@L["SalesChannelTrN11Product"]"
               EntityIcon="@TradeXpressIcons.SalesChannel"
               Items="_channelProducts"
               KeyFieldName="Id"
               SoftDelete="false"
               PrimaryTextSelector="@(l => l.SellerCode)"
               NewItemFactory="@NewChannelProduct"
               CloneFactory="@CloneChannelProduct"
               AllowAdd="false"
               CustomActions="@PanelActions"
               PersistCreate="@PersistCreate"
               PersistUpdate="@PersistUpdate"
               PersistDelete="@PersistDelete"
               OnChanged="StateHasChanged">
        <GridColumns>
            <DxGridDataColumn FieldName="SalesChannelId" Caption="@L["SalesChannel"]" Width="120px">
                <CellDisplayTemplate>@ChannelCodeOf((SalesChannelTrN11ProductDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <GridLinkColumn FieldName="SellerCode" Caption="@L["N11Product:SellerCode"]" Width="150px"
                            OnClick="@(item => _drill?.EditItem((SalesChannelTrN11ProductDto)item))" />
            <DxGridDataColumn FieldName="CategoryName" Caption="@L["N11Product:Category"]" />
            <DxGridDataColumn FieldName="Condition" Caption="@L["N11ProductCondition"]" Width="110px">
                <CellDisplayTemplate>@EnumText(nameof(N11ProductCondition), ((SalesChannelTrN11ProductDto)context.DataItem).Condition)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="N11ProductId" Caption="@L["N11Product:SyncStatus"]" Width="160px">
                <CellDisplayTemplate>@StatusTextOf((SalesChannelTrN11ProductDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn Caption="@L["N11Product:Push"]" Width="150px" TextAlignment="GridTextAlignment.Center">
                <CellDisplayTemplate>
                    @{
                        var row = (SalesChannelTrN11ProductDto)context.DataItem;
                    }
                    <DxButton Text="@L["N11Product:Push"]" RenderStyle="ButtonRenderStyle.Primary"
                              IconCssClass="@TradeXpressIcons.SalesChannel"
                              Click="@(() => PushAsync(row))" />
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </GridColumns>
        <EditContent Context="l">
            <SalesChannelTrN11ProductEditFields Model="@l" Channels="@_channels" />
        </EditContent>
    </DrillList>
</div>
