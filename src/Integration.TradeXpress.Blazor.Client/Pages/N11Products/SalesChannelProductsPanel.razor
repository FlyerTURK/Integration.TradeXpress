@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Ürünün SATIŞ KANALI ÜRÜNLERİ drill'i — IN-MEMORY GRAF (ürün 'Kaydet'inde birlikte kaydedilir; ürün önceden
   kaydedilmese de eklenebilir). "Yeni" SPLIT buton (built-in kapalı): tip alt menüden (şimdilik N11); kanal otomatik
   (şirkette tek N11 kanalı) + SET-ONCE. Push/Stok-Fiyat yalnız KAYDEDİLMİŞ (Id'li) satırda. *@

<div class="mt-3">
    <DrillList TItem="SalesChannelTrN11ProductDto"
               @ref="_drill"
               Title="@L["SalesChannelProducts"]"
               EntityName="@L["SalesChannelTrN11Product"]"
               EntityIcon="@TradeXpressIcons.SalesChannel"
               Items="Items"
               KeyFieldName="ClientKey"
               SoftDelete="true"
               IsNewItem="@(l => l.Id == Guid.Empty)"
               MarkDeleted="@(l => l.IsDeleted = true)"
               FilterPredicate="@(l => !l.IsDeleted)"
               PrimaryTextSelector="@(l => string.IsNullOrEmpty(l.SellerCode) ? ChannelCodeOf(l) : l.SellerCode)"
               NewItemFactory="@NewChannelProduct"
               CloneFactory="@CloneChannelProduct"
               AllowAdd="false"
               CustomActions="@PanelActions"
               OnChanged="@(() => OnChanged.InvokeAsync())">
        <GridColumns>
            <DxGridDataColumn FieldName="SalesChannelId" Caption="@L["SalesChannel"]" Width="120px">
                <CellDisplayTemplate>@ChannelCodeOf((SalesChannelTrN11ProductDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <GridLinkColumn Caption="@L["N11Product:SellerCode"]" Width="150px"
                            TextSelector="@(item => ((SalesChannelTrN11ProductDto)item).SellerCode)"
                            OnClick="@(item => _drill?.EditItem((SalesChannelTrN11ProductDto)item))" />
            <DxGridDataColumn FieldName="CategoryName" Caption="@L["N11Product:Category"]" />
            <DxGridDataColumn FieldName="Condition" Caption="@L["N11ProductCondition"]" Width="110px">
                <CellDisplayTemplate>@EnumText(nameof(N11ProductCondition), ((SalesChannelTrN11ProductDto)context.DataItem).Condition)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="N11ProductId" Caption="@L["N11Product:SyncStatus"]" Width="160px">
                <CellDisplayTemplate>@StatusTextOf((SalesChannelTrN11ProductDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn Caption="@L["N11Product:Push"]" Width="290px" TextAlignment="GridTextAlignment.Center">
                <CellDisplayTemplate>
                    @{
                        var row = (SalesChannelTrN11ProductDto)context.DataItem;
                    }
                    @* Push/Sync yalnız KAYDEDİLMİŞ (Id'li) satırda — yeni satır önce ürünle kaydedilir. *@
                    @if (row.Id == Guid.Empty)
                    {
                        <span style="color:#6c757d; font-size:0.85rem;">@L["N11Product:SaveToPush"]</span>
                    }
                    else
                    {
                        <DxButton Text="@L["N11Product:Push"]" RenderStyle="ButtonRenderStyle.Primary"
                                  IconCssClass="@TradeXpressIcons.SalesChannel"
                                  Click="@(() => PushAsync(row))" />
                        @* REST push kuyruğa alındıysa akıbeti henüz belli değil — sonucu kapatan eylem
                           YALNIZ bu durumda görünür (aksi hâlde tıklanacak bir şey yok). *@
                        @if (!string.IsNullOrEmpty(row.PendingPushTaskId))
                        {
                            <DxButton Text="@L["N11Product:ResolvePendingPush"]" RenderStyle="ButtonRenderStyle.Warning"
                                      CssClass="ms-1"
                                      Click="@(() => ResolvePendingPushAsync(row))" />
                        }
                        @if (row.N11ProductId.HasValue)
                        {
                            <DxButton Text="@L["N11Product:SyncStockPrice"]" RenderStyle="ButtonRenderStyle.Secondary"
                                      CssClass="ms-1"
                                      Click="@(() => SyncStockPriceAsync(row))" />
                        }
                    }
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </GridColumns>
        <EditContent Context="l">
            <SalesChannelTrN11ProductEditFields Model="@l" Channels="@_channels" />
        </EditContent>
    </DrillList>
</div>
