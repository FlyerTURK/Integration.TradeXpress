@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Bir N11 kanalına AİT ürün listelemeleri — PERSISTENT drill (kanal edit formunun içinde). Satır tıkla → düzenle;
   satır başına "N11'e Gönder". Yeni listeleme ürün tarafından yapılır → AllowAdd kapalı. *@

<div class="mt-3">
    <DrillList TItem="SalesChannelTrN11ProductDto"
               @ref="_drill"
               Title="@L["N11Products"]"
               EntityName="@L["SalesChannelTrN11Product"]"
               EntityIcon="@TradeXpressIcons.Product"
               Items="_channelProducts"
               KeyFieldName="Id"
               SoftDelete="false"
               PrimaryTextSelector="@(l => ProductCodeOf(l))"
               ParentEntityName="@L["SalesChannelType:TrN11"]"
               ParentText="@Channel.Code"
               NewItemFactory="@NewChannelProduct"
               CloneFactory="@CloneChannelProduct"
               AllowAdd="false"
               PersistUpdate="@PersistUpdate"
               PersistDelete="@PersistDelete"
               OnChanged="StateHasChanged">
        <GridColumns>
            <DxGridDataColumn FieldName="ProductId" Caption="@L["Product"]">
                <CellDisplayTemplate>@ProductLabelOf((SalesChannelTrN11ProductDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="SellerCode" Caption="@L["N11Product:SellerCode"]" Width="150px" />
            <DxGridDataColumn FieldName="CategoryName" Caption="@L["N11Product:Category"]" />
            <DxGridDataColumn FieldName="N11ProductId" Caption="@L["N11Product:SyncStatus"]" Width="160px">
                <CellDisplayTemplate>@StatusTextOf((SalesChannelTrN11ProductDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn Caption="@L["N11Product:Push"]" Width="150px" TextAlignment="GridTextAlignment.Center">
                <CellDisplayTemplate>
                    @{
                        var row = (SalesChannelTrN11ProductDto)context.DataItem;
                    }
                    <DxButton Text="@L["N11Product:Push"]" RenderStyle="ButtonRenderStyle.Primary"
                              IconCssClass="@TradeXpressIcons.SalesChannel"
                              Click="@(() => PushAsync(row))" />
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </GridColumns>
        <EditContent Context="l">
            <SalesChannelTrN11ProductEditFields Model="@l" Channels="@_channelAsList" />
        </EditContent>
    </DrillList>
</div>
