@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@using Integration.TradeXpress.Blazor.Client.Pages.Financials.CurrencyUnits
@using Integration.TradeXpress.Blazor.Client.Pages.Products
@using Integration.TradeXpress.Permissions

@* N11 ürün listeleme edit formu. Form GENELİ tanımlar (kategori + genel alanlar) üstte; ekranda yer kaplayan
   listeler (nitelikler, varyant eksenleri, görseller, SKU'lar, durum) DrillTabs sekmelerine ayrılır. *@

<DxFormLayout CssClass="w-100">
    @* Kategori EN BAŞTA — birincil karar (attribute'ları + Seyahat'i o belirler); kullanıcı önce kategoriyi seçer. *@
    <DxFormLayoutGroup Caption="@L["N11Product:Category"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
        <DxFormLayoutItem ColSpanMd="12">
            <N11CategoryPicker SelectedExternalId="@Model.CategoryExternalId"
                               SelectedName="@Model.CategoryName"
                               OnLeafSelected="OnCategorySelectedAsync" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    <DxFormLayoutGroup Caption="@L["N11Product:General"]" ColSpanMd="12">
        @* Kanal — HER ZAMAN salt-okunur: create'te otomatik atanır (şirkette tek N11 kanalı), SET-ONCE. *@
        <DxFormLayoutItem Caption="@L["SalesChannel"]" ColSpanMd="6">
            <span>@ChannelName</span>
        </DxFormLayoutItem>
        @if (!string.IsNullOrEmpty(Model.SellerCode))
        {
            <DxFormLayoutItem Caption="@L["N11Product:SellerCode"]" ColSpanMd="6">
                <span>@Model.SellerCode</span>
            </DxFormLayoutItem>
        }
        <DxFormLayoutItem Caption="@L["N11ShipmentTemplate"]" ColSpanMd="6">
            <LookupComboBox TItem="N11ShipmentTemplateDto" TValue="string"
                            Data="@_templates"
                            ValueFieldName="@nameof(N11ShipmentTemplateDto.TemplateName)"
                            TextFieldName="@nameof(N11ShipmentTemplateDto.TemplateName)"
                            Value="@Model.ShipmentTemplateName"
                            ValueChanged="@OnShipmentTemplateChanged"
                            AllowClear="false" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11ProductCondition"]" ColSpanMd="6">
            <ComboBoxEnumEdit TEnum="N11ProductCondition" L="@L" @bind-Value="@Model.Condition" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:Domestic"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.Domestic" CheckType="CheckType.Switch">
                @(Model.Domestic ? L["Yes"] : L["No"])
            </DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:PreparingDay"]" ColSpanMd="6">
            <NumericSpinEdit TValue="int" @bind-Value="@Model.PreparingDay" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:MaxPurchaseQuantity"]" ColSpanMd="6">
            <NumericSpinEdit TValue="int?" @bind-Value="@Model.MaxPurchaseQuantity"
                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        @* N11 para birimi — opsiyonel; boşsa push'ta varyant para birimi devralınır. Inline ekle/düzelt (popup + refresh standardı). *@
        <DxFormLayoutItem Caption="@L["N11Product:CurrencyUnit"]" ColSpanMd="6">
            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?"
                            Data="@_units"
                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)"
                            TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                            @bind-Value="@Model.CurrencyUnitId"
                            EditComponentType="typeof(CurrencyUnitEditHost)"
                            OnLookupReloadRequested="@ReloadCurrencyUnitsAsync"
                            CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                            UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update"
                            AllowClear="true" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
                @(Model.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:SellerNote"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.SellerNote" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100"
                    NullText="@L["Optional"]" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    @* İsteğe bağlı alanlar — varsayılan KAPALI (Expanded=false); tıklayınca açılır. Üretim/son kullanma tarihi,
       birim tipi/ağırlığı, grup ürün alanları — hiçbiri zorunlu değil, formu kalabalıklaştırmasın diye ayrı grupta. *@
    <DxFormLayoutGroup Caption="@L["N11Product:OptionalFields"]" ColSpanMd="12"
                        Expanded="false" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">
        <DxFormLayoutItem Caption="@L["N11Product:ProductionDate"]" ColSpanMd="6">
            <DxDateEdit @bind-Date="@Model.ProductionDate" NullText="@L["Optional"]"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:ExpirationDate"]" ColSpanMd="6">
            <DxDateEdit @bind-Date="@Model.ExpirationDate" NullText="@L["Optional"]"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:UnitType"]" ColSpanMd="6">
            <NumericSpinEdit TValue="int?" @bind-Value="@Model.UnitType"
                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:UnitWeight"]" ColSpanMd="6">
            <NumericSpinEdit TValue="int?" @bind-Value="@Model.UnitWeight"
                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        @* Grup ürün (opsiyonel; N11-only) — aynı grup üyeleri groupItemCode'da eşleşir. *@
        <DxFormLayoutItem ColSpanMd="12">
            <span style="color:#6c757d; font-size:0.85rem;">@L["N11Product:GroupProductHint"]</span>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:GroupItemCode"]" ColSpanMd="4">
            <DxTextBox @bind-Text="@Model.GroupItemCode" NullText="@L["Optional"]"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:GroupAttribute"]" ColSpanMd="4">
            <DxTextBox @bind-Text="@Model.GroupAttribute" NullText="@L["Optional"]"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:ItemName"]" ColSpanMd="4">
            <DxTextBox @bind-Text="@Model.ItemName" NullText="@L["Optional"]"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@* ── Büyük listeler sekmelerde (form geneli dışındaki her şey) ── *@
<DrillTabs CssClass="mt-3">
    @* Kanal-özel açıklama — zengin metin (DxHtmlEditor). Boşsa push'ta ürün açıklaması devralınır. *@
    <DxTabPage Text="@L["Description"]" TabIconCssClass="@TradeXpressIcons.Product">
        <span style="color:#6c757d; font-size:0.85rem;">@L["N11Product:DescriptionHint"]</span>
        <DxHtmlEditor @bind-Markup="@Model.Description" CssClass="w-100" Height="360px" />
    </DxTabPage>

    @* Kategori attribute'ları — HÜCRE-İÇİ düzenleme (Trendyol EditCell deseniyle AYNI): tek satır = bir attribute
       tanımı (kategoriden gelir, sabit); değer hücresine tıklanınca ANINDA düzenlenebilir, ayrı düzenle/kaydet
       tuşu ya da popup form YOK. Değer-listeli attribute'larda DxTagBox (ÇOKLU seçim — N11 WSDL'in "aynı isim,
       ayrı eleman" temsiliyle birebir uyumlu push edilir, N11ProductPushValidator + N11ProductClient DEĞİŞMEDİ);
       serbest-metin attribute'larda tek değerli DxTextBox. Paging YOK (tüm satırlar tek sayfada). Sekme HER ZAMAN
       görünür (b9e5066 dersi — koşul içeride, konteynerde değil). *@
    <DxTabPage Text="@L["N11Product:Attributes"]" TabIconCssClass="@TradeXpressIcons.Sliders">
        @if (string.IsNullOrEmpty(Model.CategoryExternalId))
        {
            <span style="color:#6c757d; font-size:0.85rem;">@L["N11Product:SelectCategoryFirst"]</span>
        }
        else if (_attributeRows.Count == 0)
        {
            <span style="color:#6c757d; font-size:0.85rem;">@L["N11Product:NoAttributesForCategory"]</span>
        }
        else
        {
            <DxGrid Data="@_attributeRows" KeyFieldName="AttributeId"
                    EditMode="GridEditMode.EditCell"
                    EditModelSaving="OnAttributeRowSaving"
                    PageSize="200" PagerVisible="false"
                    CssClass="w-100">
                <Columns>
                    <DxGridDataColumn FieldName="Name" Caption="@L["ProductAttribute"]" Width="35%" ReadOnly="true">
                        <CellDisplayTemplate Context="cell">
                            @{ var r = (N11AttributeCellRow)cell.DataItem; }
                            <span>@(r.IsMandatory ? $"{r.Name} *" : r.Name)</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn Caption="@L["AttributeValues"]">
                        <CellDisplayTemplate Context="cell">
                            @{ var r = (N11AttributeCellRow)cell.DataItem; }
                            <span>@(r.HasValueList
                                ? (r.SelectedValues.Count > 0 ? string.Join(", ", r.SelectedValues) : "-")
                                : (string.IsNullOrEmpty(r.CustomValue) ? "-" : r.CustomValue))</span>
                        </CellDisplayTemplate>
                        <CellEditTemplate Context="cell">
                            @{ var row = (N11AttributeCellRow)cell.EditModel; }
                            @if (row.HasValueList)
                            {
                                <DxTagBox Data="@row.DefinitionValues"
                                          TData="N11CategoryAttributeValueDto"
                                          TValue="string"
                                          Values="@row.SelectedValues"
                                          ValuesChanged="@((IEnumerable<string> v) => row.SelectedValues = v.ToList())"
                                          ValueFieldName="@nameof(N11CategoryAttributeValueDto.Value)"
                                          TextFieldName="@nameof(N11CategoryAttributeValueDto.Value)"
                                          ValidationEnabled="false"
                                          CssClass="w-100" />
                            }
                            else
                            {
                                <DxTextBox Text="@row.CustomValue"
                                           TextChanged="@((string v) => row.CustomValue = v)"
                                           TextExpression="@(() => row.CustomValue)" />
                            }
                        </CellEditTemplate>
                    </DxGridDataColumn>
                </Columns>
            </DxGrid>
        }
    </DxTabPage>


    @* Nitelik Eksenleri — VARYANT ÜRETİMİ amaçlı (kategori-attribute-push seçimi DEĞİL, o "Attributes" sekmesi ayrı).
       İlk açılışta ERP ürününün varyant eksenlerinden bir kez KLONLANIR (backend BuildDraftAxesFromErpAsync); sonrası
       tamamen bağımsız — kullanıcı burada serbestçe ekseni/değeri ekler-siler, ERP'ye dokunmaz. Kaydet'te sunucu
       kartezyen kombinasyonu YENİDEN ÜRETİR ("Varyantlar" sekmesindeki liste). Desen "Attributes" sekmesiyle AYNI
       (üst = eksen, alt = değerler) — tek fark burada üst satır da serbestçe ekle/silinebilir (klon-sonra-ayrış).
       Sekme HER ZAMAN görünür (b9e5066 dersi: koşul içeride, konteynerde değil). *@
    <DxTabPage Text="@L["N11Product:AttributeAxes"]" TabIconCssClass="@TradeXpressIcons.Sliders">
        <span style="color:#6c757d; font-size:0.85rem;">@L["N11Product:AttributeAxesHint"]</span>
        <DrillList TItem="SalesChannelTrN11ProductAttributeAxisDto"
                   @ref="_axisDrill"
                   Title="@L["N11Product:AttributeAxes"]"
                   EntityName="@L["N11Product:AttributeAxis"]"
                   EntityIcon="@TradeXpressIcons.Sliders"
                   Items="@Model.AttributeAxes"
                   KeyFieldName="ClientKey"
                   PrimaryTextSelector="@(a => a.Name)"
                   NewItemFactory="@(() => new SalesChannelTrN11ProductAttributeAxisDto { DisplayOrder = NextAxisOrder(Model.AttributeAxes) })"
                   SoftDelete="true"
                   IsNewItem="@(a => a.Id == Guid.Empty)"
                   MarkDeleted="@(a => a.IsDeleted = true)"
                   FilterPredicate="@(a => !a.IsDeleted)"
                   SaveGuard="@AxisSaveGuard"
                   ShowActiveFilter="false"
                   OnChanged="@(() => MarkDirty(nameof(Model.AttributeAxes)))">
            <GridColumns>
                <GridLinkColumn FieldName="Name" Caption="@L["N11Product:AttributeAxisName"]" Width="35%"
                                FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                                OnClick="@(item => _axisDrill?.EditItem((SalesChannelTrN11ProductAttributeAxisDto)item))" />
                <DxGridDataColumn Caption="@L["N11Product:AxisValues"]">
                    <CellDisplayTemplate Context="cell">
                        @{ var ax = (SalesChannelTrN11ProductAttributeAxisDto)cell.DataItem; }
                        <span>@(ax.Values.Any(v => !v.IsDeleted) ? string.Join(", ", ax.Values.Where(v => !v.IsDeleted).Select(v => v.Value)) : "-")</span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </GridColumns>
            <EditContent Context="ax">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem Caption="@($"{L["N11Product:AttributeAxisName"]} *")" ColSpanMd="6" BeginRow="true">
                        <DxTextBox @bind-Text="@ax.Name" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
                        <NumericSpinEdit @bind-Value="@ax.DisplayOrder" />
                    </DxFormLayoutItem>
                    <DxFormLayoutGroup Caption="@L["N11Product:AxisValues"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                        @* İç içe DrillList DOĞRUDAN parent EditContent'te (ui-blazor: EditForm yok,
                           CascadingValue<EditContext> doğal izolasyon — nested EditForm NRE'ye girer). *@
                        <DrillList TItem="SalesChannelTrN11ProductAttributeAxisValueDto"
                                   @ref="_axisValueDrill"
                                   Title="@L["N11Product:AxisValues"]"
                                   EntityName="@L["N11Product:AxisValue"]"
                                   EntityIcon="@TradeXpressIcons.Sliders"
                                   ParentEntityName="@L["N11Product:AttributeAxis"]"
                                   ParentText="@ax.Name"
                                   Items="@ax.Values"
                                   KeyFieldName="ClientKey"
                                   PrimaryTextSelector="@(v => v.Value)"
                                   NewItemFactory="@(() => new SalesChannelTrN11ProductAttributeAxisValueDto { DisplayOrder = NextAxisValueOrder(ax.Values) })"
                                   SoftDelete="true"
                                   IsNewItem="@(v => v.Id == Guid.Empty)"
                                   MarkDeleted="@(v => v.IsDeleted = true)"
                                   FilterPredicate="@(v => !v.IsDeleted)"
                                   SaveGuard="@AxisValueSaveGuard"
                                   ShowActiveFilter="false"
                                   OnChanged="@(() => MarkDirty(nameof(Model.AttributeAxes)))">
                            <GridColumns>
                                <GridLinkColumn FieldName="Value" Caption="@L["Value"]"
                                                FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                                                OnClick="@(item => _axisValueDrill?.EditItem((SalesChannelTrN11ProductAttributeAxisValueDto)item))" />
                                <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="90px" />
                            </GridColumns>
                            <EditContent Context="v">
                                <DxFormLayout CssClass="w-100">
                                    <DxFormLayoutItem Caption="@($"{L["Value"]} *")" ColSpanMd="12">
                                        <DxTextBox @bind-Text="@v.Value" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
                                        <NumericSpinEdit @bind-Value="@v.DisplayOrder" />
                                    </DxFormLayoutItem>
                                </DxFormLayout>
                            </EditContent>
                        </DrillList>
                    </DxFormLayoutGroup>
                </DxFormLayout>
            </EditContent>
        </DrillList>
    </DxTabPage>

    @* Varyantlar — SUNUCU TARAFINDA "Nitelik Eksenleri"nin kartezyen kombinasyonundan ÜRETİLİR (reconcile);
       satır elle eklenmez/silinmez (AllowAdd/Delete=false), eksen/değer üzerinden dolaylı kontrol edilir. ERP
       karşılığı olmayan (IsErpBacked=false) satırlar "N11-özel" rozetiyle ayırt edilir — bunlarda OverridePrice/
       OverrideStock ZORUNLU (server fail-fast; burada yalnız hint). Türetilmiş fiyat = NetCost×(1+Marj/100)
       SALT-OKUNUR. Sekme HER ZAMAN görünür (b9e5066 dersi — @if ile tüm sekmeyi gizlemek DxTabs'in async-sonrası
       yeni sekmeyi tanımamasına yol açıp kullanıcının sekmeyi hiç görememesine sebep oluyordu); boşsa içeride hint. *@
    <DxTabPage Text="@L["N11Product:Variants"]" TabIconCssClass="@TradeXpressIcons.ProductVariant">
        @* Eksen/değer düzenlendikten sonra TÜM ürünü kaydetmeden yalnız bu N11 kaydının varyant setini yeniler
           (RegenerateVariantsAsync — Full Update ile AYNI reconcile mekanizması, SaveAxesAndReconcileAsync). *@
        <span style="color:#6c757d; font-size:0.85rem;">@L["N11Product:RegenerateVariantsHint"]</span>
        <DxButton Text="@L["N11Product:RegenerateVariants"]" RenderStyle="ButtonRenderStyle.Primary"
                  CssClass="mb-2"
                  IconCssClass="@TradeXpressIcons.ProductVariant"
                  Click="@RegenerateVariantsAsync" />
        @if (Model.Variants.Count == 0)
        {
            <span style="color:#6c757d; font-size:0.85rem;">@L["N11Product:NoVariantsYetHint"]</span>
        }
        else
        {
            <span style="color:#6c757d; font-size:0.85rem;">@L["N11Product:PushPriceChainHint"]</span>
            <DrillList TItem="SalesChannelTrN11ProductVariantGraphDto"
                       @ref="_variantDrill"
                       Title="@L["N11Product:Variants"]"
                       EntityName="@L["ProductVariant"]"
                       EntityIcon="@TradeXpressIcons.ProductVariant"
                       Items="@Model.Variants"
                       KeyFieldName="Id"
                       PrimaryTextSelector="@(v => v.VariantCode)"
                       NewItemFactory="@(() => new SalesChannelTrN11ProductVariantGraphDto())"
                       AllowAdd="false"
                       AllowDelete="false"
                       ShowActiveFilter="false"
                       OnChanged="@(() => MarkDirty(nameof(Model.Variants)))">
                <GridColumns>
                    <GridLinkColumn Caption="@L["Code"]" Width="160px" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                                    TextSelector="@(item => VariantCodeOrLabel((SalesChannelTrN11ProductVariantGraphDto)item))"
                                    OnClick="@(item => _variantDrill?.EditItem((SalesChannelTrN11ProductVariantGraphDto)item))" />
                    <DxGridDataColumn FieldName="VariantName" Caption="@L["Name"]" />
                    <DxGridDataColumn Caption="@L["N11Product:Source"]" Width="120px">
                        <CellDisplayTemplate Context="cell">
                            @{ var vv = (SalesChannelTrN11ProductVariantGraphDto)cell.DataItem; }
                            @if (!vv.IsErpBacked)
                            {
                                <span style="display:flex; align-items:center; gap:0.35rem; color:#0369a1;">
                                    <i class="@TradeXpressIcons.SalesChannel" aria-hidden="true"></i>@L["N11Product:N11Only"]
                                </span>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="OverrideStock" Caption="@L["N11Product:OverrideStock"]" Width="110px" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="Margin" Caption="@L["N11Product:Margin"]" Width="100px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="OverridePrice" Caption="@L["N11Product:OverridePrice"]" Width="120px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="DerivedPrice" Caption="@L["N11Product:DerivedPrice"]" Width="130px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                </GridColumns>
                <EditContent Context="v">
                    <DxFormLayout CssClass="w-100">
                        @* Kimlik — SALT-OKUNUR. ERP-backed'te ERP kod/ad (SSOT); N11-only'de CombinationLabel (eksen
                           değerlerinin özeti) — ERP karşılığı yok. *@
                        <DxFormLayoutItem Caption="@L["Code"]" ColSpanMd="6" BeginRow="true">
                            <span>@(v.IsErpBacked ? v.VariantCode : VariantCodeOrLabel(v))</span>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["Name"]" ColSpanMd="6">
                            <span>@(v.IsErpBacked ? v.VariantName : L["N11Product:N11Only"].Value)</span>
                        </DxFormLayoutItem>
                        @if (!v.IsErpBacked)
                        {
                            <DxFormLayoutItem ColSpanMd="12">
                                <span style="color:#b45309; font-size:0.85rem;">@L["N11Product:OverrideRequiredForN11OnlyHint"]</span>
                            </DxFormLayoutItem>
                        }
                        @* Kanal-özel override — boş = ERP/türetilmiş devralınır (temizle butonuyla boşaltılır). *@
                        <DxFormLayoutItem Caption="@L["N11Product:OverridePrice"]" ColSpanMd="4" BeginRow="true">
                            <NumericSpinEdit TValue="decimal?" @bind-Value="@v.OverridePrice" DisplayFormat="N2"
                                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["N11Product:OverridePriceCurrency"]" ColSpanMd="4">
                            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?"
                                            Data="@_units"
                                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)"
                                            TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                                            Value="@v.OverridePriceCurrencyUnitId"
                                            ValueChanged="@((Guid? id) => OnOverrideCurrencyChanged(v, id))"
                                            AllowClear="true" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["N11Product:OverrideStock"]" ColSpanMd="4">
                            <NumericSpinEdit TValue="int?" @bind-Value="@v.OverrideStock"
                                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </DxFormLayoutItem>
                        @* Marj % — türetilmiş fiyatı sürer (ValueExpression'sız değil ama DerivedPrice canlı güncellensin diye handler'lı). *@
                        <DxFormLayoutItem Caption="@L["N11Product:Margin"]" ColSpanMd="4" BeginRow="true">
                            <NumericSpinEdit TValue="decimal?" Value="@v.Margin" DisplayFormat="N2"
                                             ValueChanged="@((decimal? m) => OnVariantMarginChanged(v, m))"
                                             ValueExpression="@(() => v.Margin)"
                                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </DxFormLayoutItem>
                        @* Net maliyet + türetilmiş fiyat — SALT-OKUNUR (reçeteden canlı; kur eksikse uyarı). *@
                        <DxFormLayoutItem Caption="@L["N11Product:NetCost"]" ColSpanMd="4">
                            @if (v.NetCostMissingRate)
                            {
                                <span style="color:#b45309;">@L["MissingRate"]</span>
                            }
                            else
                            {
                                <span>@(v.NetCost is { } nc ? $"{nc:N2} {v.NetCostCurrency}" : "-")</span>
                            }
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["N11Product:DerivedPrice"]" ColSpanMd="4">
                            <span>@(v.DerivedPrice is { } dp ? $"{dp:N2} {v.NetCostCurrency}" : "-")</span>
                        </DxFormLayoutItem>
                        @* Kanal-özel reçete — ERP reçetesinden klonlanır, sonra bağımsız (ERP paneli AYNEN yeniden kullanılır). *@
                        <DxFormLayoutGroup Caption="@L["Recipe"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                            <ProductRecipePanel Lines="v.RecipeLines"
                                                Metals="_metals" Scraps="_scraps" Futures="_futures"
                                                Jewelries="_jewelries" Stones="_stones" Services="_services" Units="_priceUnits"
                                                NetCost="@v.NetCost" NetCostCurrency="@v.NetCostCurrency" NetCostMissingRate="@v.NetCostMissingRate"
                                                OnChanged="@(async () => await HandleVariantRecipeChangedAsync(v))" />
                        </DxFormLayoutGroup>
                    </DxFormLayout>
                </EditContent>
            </DrillList>
        }
    </DxTabPage>

    @* Ürün özel bilgileri — KOŞULSUZ (her kategoride): serbest key/value satırları. Boş key kabul edilmez. *@
    <DxTabPage Text="@L["N11Product:SpecialInfo"]" TabIconCssClass="@TradeXpressIcons.Sliders">
        <span style="color:#6c757d; font-size:0.85rem;">@L["N11Product:SpecialInfoHint"]</span>
        <DrillList TItem="SalesChannelTrN11ProductSpecialInfoDto"
                   Title="@L["N11Product:SpecialInfo"]"
                   EntityName="@L["N11Product:SpecialInfo"]"
                   EntityIcon="@TradeXpressIcons.Sliders"
                   Items="@Model.SpecialInfo"
                   PrimaryTextSelector="@(s => s.Key)"
                   NewItemFactory="@(() => new SalesChannelTrN11ProductSpecialInfoDto())"
                   SaveGuard="@SpecialInfoSaveGuard"
                   ShowActiveFilter="false"
                   ShowExport="false"
                   ShowSearch="false"
                   OnChanged="@(() => MarkDirty(nameof(Model.SpecialInfo)))">
            <GridColumns>
                <DxGridDataColumn FieldName="Key" Caption="@L["N11Product:SpecialInfoKey"]" Width="30%" />
                <DxGridDataColumn FieldName="Value" Caption="@L["N11Product:SpecialInfoValue"]" />
            </GridColumns>
            <EditContent Context="s">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem Caption="@($"{L["N11Product:SpecialInfoKey"]} *")" ColSpanMd="12">
                        <DxTextBox @bind-Text="@s.Key" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["N11Product:SpecialInfoValue"]" ColSpanMd="12">
                        <DxMemo @bind-Text="@s.Value" Rows="4" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
                    </DxFormLayoutItem>
                </DxFormLayout>
            </EditContent>
        </DrillList>
    </DxTabPage>

    @* Görseller — N11'e GİDECEK varyantlar + görseller önizlemesi (read-only; SSOT ERP ürün formunda). *@
    @if (_preview is { Variants.Count: > 0 } or { Images.Count: > 0 })
    {
        <DxTabPage Text="@L["Images"]" TabIconCssClass="@TradeXpressIcons.Product">
            @if (_preview.Variants.Count > 0)
            {
                <h6 class="mt-1">@L["N11Product:PreviewVariants"]</h6>
                <DxGrid Data="@_preview.Variants" PageSize="50" PagerVisible="false" CssClass="w-100">
                    <Columns>
                        <DxGridDataColumn FieldName="Code" Caption="@L["Code"]" Width="130px" />
                        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" />
                        <DxGridDataColumn FieldName="Options" Caption="@L["AttributeSummary"]" />
                        <DxGridDataColumn FieldName="StockQuantity" Caption="@L["StockQuantity"]" Width="90px" />
                        <DxGridDataColumn FieldName="SalePrice" Caption="@L["SalePrice"]" Width="110px" />
                    </Columns>
                </DxGrid>
            }
            @if (_preview.Images.Count > 0)
            {
                <h6 class="mt-3">@L["N11Product:PreviewImages"]</h6>
                <DxGrid Data="@_preview.Images" PageSize="50" PagerVisible="false" CssClass="w-100">
                    <Columns>
                        <DxGridDataColumn Caption="" Width="70px" TextAlignment="GridTextAlignment.Center">
                            <CellDisplayTemplate Context="cell">
                                @{ var im = (N11PreviewImageDto)cell.DataItem; }
                                @if (!string.IsNullOrEmpty(im.PreviewDataUrl))
                                {
                                    <img src="@im.PreviewDataUrl" style="max-width:48px; max-height:48px; object-fit:cover;" />
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="Source" Caption="@L["ImageSource"]" />
                        <DxGridDataColumn FieldName="IsDefault" Caption="@L["Default"]" Width="90px" />
                    </Columns>
                </DxGrid>
            }
        </DxTabPage>
    }

    @* Varyant SKU'ları (read-only) — push + stok/fiyat senkronunda dolar. *@
    @if (Model.Skus.Count > 0)
    {
        <DxTabPage Text="@L["N11Product:Skus"]" TabIconCssClass="@TradeXpressIcons.SalesChannel">
            <DxGrid Data="@Model.Skus" PageSize="50" PagerVisible="false" CssClass="w-100">
                <Columns>
                    <DxGridDataColumn FieldName="SellerStockCode" Caption="@L["N11Product:SellerCode"]" />
                    <DxGridDataColumn FieldName="N11SkuId" Caption="@L["N11Product:N11SkuId"]" Width="130px" />
                    <DxGridDataColumn FieldName="LastSentQuantity" Caption="@L["N11Product:LastSentQuantity"]" Width="140px" />
                    <DxGridDataColumn FieldName="LastSentOptionPrice" Caption="@L["N11Product:LastSentOptionPrice"]" Width="140px" />
                    <DxGridDataColumn FieldName="N11Version" Caption="@L["N11Product:N11Version"]" Width="90px" />
                </Columns>
            </DxGrid>
        </DxTabPage>
    }

    @* N11 senkron durumu (read-only; push sonrası dolar). *@
    @if (Model.N11ProductId.HasValue || !string.IsNullOrEmpty(Model.LastError))
    {
        <DxTabPage Text="@L["N11Product:SyncStatus"]" TabIconCssClass="@TradeXpressIcons.SalesChannel">
            <DxFormLayout CssClass="w-100">
                @if (Model.N11ProductId.HasValue)
                {
                    <DxFormLayoutItem Caption="@L["N11Product:N11ProductId"]" ColSpanMd="4">
                        <span>@Model.N11ProductId</span>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["N11Product:SaleStatus"]" ColSpanMd="4">
                        <span>@Model.SaleStatus</span>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["N11Product:ApprovalStatus"]" ColSpanMd="4">
                        <span>@Model.ApprovalStatus</span>
                    </DxFormLayoutItem>
                }
                @if (!string.IsNullOrEmpty(Model.LastError))
                {
                    <DxFormLayoutItem Caption="@L["N11Product:LastError"]" ColSpanMd="12">
                        <span style="color:#dc2626;">@Model.LastError</span>
                    </DxFormLayoutItem>
                }
            </DxFormLayout>
        </DxTabPage>
    }
</DrillTabs>
