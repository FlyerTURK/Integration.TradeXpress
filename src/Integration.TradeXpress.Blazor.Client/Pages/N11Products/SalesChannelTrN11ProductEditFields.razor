@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* N11 ürün listeleme edit formu — kendi DxFormLayout'unu sağlar (drill EditContent DxFormLayout vermez).
   Kanal + kargo şablonu + condition + kategori (kademeli) + on-demand attribute + Seyahat özel bilgi + durum. *@

<DxFormLayout CssClass="w-100">
    @* Kategori EN BAŞTA — birincil karar (attribute'ları + Seyahat grubunu o belirler); kullanıcı önce kategoriyi seçer. *@
    <DxFormLayoutGroup Caption="@L["N11Product:Category"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
        <DxFormLayoutItem ColSpanMd="12">
            <N11CategoryPicker SelectedExternalId="@Model.CategoryExternalId"
                               SelectedName="@Model.CategoryName"
                               OnLeafSelected="OnCategorySelectedAsync" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    <DxFormLayoutGroup Caption="@L["N11Product:General"]" ColSpanMd="12">
        @* Kanal — HER ZAMAN salt-okunur: create'te otomatik atanır (şirkette tek N11 kanalı), SET-ONCE (değiştirilemez). *@
        <DxFormLayoutItem Caption="@L["SalesChannel"]" ColSpanMd="6">
            <span>@ChannelName</span>
        </DxFormLayoutItem>
        @* N11 satıcı kodu — sunucu üretir ("{ÜrünKodu}-{Sıra}"); yeni kayıtta henüz yok → kaydedilince görünür. *@
        @if (!string.IsNullOrEmpty(Model.SellerCode))
        {
            <DxFormLayoutItem Caption="@L["N11Product:SellerCode"]" ColSpanMd="6">
                <span>@Model.SellerCode</span>
            </DxFormLayoutItem>
        }
        <DxFormLayoutItem Caption="@L["N11ShipmentTemplate"]" ColSpanMd="6">
            <LookupComboBox TItem="N11ShipmentTemplateDto" TValue="string"
                            Data="@_templates"
                            ValueFieldName="@nameof(N11ShipmentTemplateDto.TemplateName)"
                            TextFieldName="@nameof(N11ShipmentTemplateDto.TemplateName)"
                            Value="@Model.ShipmentTemplateName"
                            ValueChanged="@OnShipmentTemplateChanged"
                            AllowClear="false" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11ProductCondition"]" ColSpanMd="6">
            <ComboBoxEnumEdit TEnum="N11ProductCondition" L="@L" @bind-Value="@Model.Condition" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:Domestic"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.Domestic" CheckType="CheckType.Switch">
                @(Model.Domestic ? L["Yes"] : L["No"])
            </DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:PreparingDay"]" ColSpanMd="6">
            <NumericSpinEdit TValue="int" @bind-Value="@Model.PreparingDay" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Product:MaxPurchaseQuantity"]" ColSpanMd="6">
            <NumericSpinEdit TValue="int?" @bind-Value="@Model.MaxPurchaseQuantity"
                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
                @(Model.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    @* Kategori attribute'ları — CELL-EDIT grid (on-demand; yaprak seçildiyse). Hücre normal metin görünür;
       TIKLAYINCA editör açılır (satıra göre: değer listesi → combo, serbest → metin); hücreden çıkınca değişiklik
       ANINDA uygulanır (Edit/Save butonu YOK). Nitelik adı salt-okunur (zorunlular *); ekleme/silme YOK. *@
    @if (_attributeRows.Count > 0)
    {
        <DxFormLayoutGroup Caption="@L["N11Product:Attributes"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
            <DxFormLayoutItem ColSpanMd="12">
                <DxGrid Data="@_attributeRows" KeyFieldName="AttributeId"
                        EditMode="GridEditMode.EditCell"
                        EditModelSaving="OnAttributeRowSaving"
                        PageSize="200" PagerVisible="false"
                        CssClass="w-100">
                    <Columns>
                        <DxGridDataColumn FieldName="Name" Caption="@L["ProductAttribute"]" Width="45%" ReadOnly="true">
                            <CellDisplayTemplate Context="cell">
                                @{ var r = (N11AttributeRow)cell.DataItem; }
                                <span>@(r.IsMandatory ? $"{r.Name} *" : r.Name)</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="Value" Caption="@L["Value"]">
                            <CellEditTemplate Context="cell">
                                @{ var row = (N11AttributeRow)cell.EditModel; }
                                @if (row.HasValueList)
                                {
                                    <DxComboBox TData="N11CategoryAttributeValueDto" TValue="string"
                                                Data="@row.Values"
                                                ValueFieldName="@nameof(N11CategoryAttributeValueDto.Value)"
                                                TextFieldName="@nameof(N11CategoryAttributeValueDto.Value)"
                                                Value="@row.Value"
                                                ValueChanged="@((string v) => row.Value = v)"
                                                ValueExpression="@(() => row.Value)"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                }
                                else
                                {
                                    <DxTextBox Text="@row.Value"
                                               TextChanged="@((string v) => row.Value = v)"
                                               TextExpression="@(() => row.Value)" />
                                }
                            </CellEditTemplate>
                        </DxGridDataColumn>
                    </Columns>
                </DxGrid>
            </DxFormLayoutItem>
        </DxFormLayoutGroup>
    }

    @* Seyahat özel bilgileri — YALNIZ Seyahat kategorisi seçiliyken (kategori yolu "Seyahat" içerir).
       Diğer kategorilerde gizli (kalabalık yapmaz). N11 specialProductInfoList HTML kabul eder. *@
    @if (IsTravelCategory)
    {
        <DxFormLayoutGroup Caption="@L["N11Product:SpecialInfo"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
            <DxFormLayoutItem ColSpanMd="12">
                <span style="color:#6c757d; font-size:0.85rem;">@L["N11Product:SpecialInfoHint"]</span>
            </DxFormLayoutItem>
            @foreach (var key in SpecialInfoKeys)
            {
                var k = key;
                <DxFormLayoutItem Caption="@L[$"N11Product:SpecialInfo:{k}"]" ColSpanMd="12">
                    <DxMemo Text="@GetSpecialInfo(k)" TextChanged="@((string v) => SetSpecialInfo(k, v))"
                            Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" ValidationEnabled="false" />
                </DxFormLayoutItem>
            }
        </DxFormLayoutGroup>
    }

    @* N11 senkron durumu (read-only; push sonrası dolar). *@
    @if (Model.N11ProductId.HasValue || !string.IsNullOrEmpty(Model.LastError))
    {
        <DxFormLayoutGroup Caption="@L["N11Product:SyncStatus"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
            @if (Model.N11ProductId.HasValue)
            {
                <DxFormLayoutItem Caption="@L["N11Product:N11ProductId"]" ColSpanMd="4">
                    <span>@Model.N11ProductId</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["N11Product:SaleStatus"]" ColSpanMd="4">
                    <span>@Model.SaleStatus</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["N11Product:ApprovalStatus"]" ColSpanMd="4">
                    <span>@Model.ApprovalStatus</span>
                </DxFormLayoutItem>
            }
            @if (!string.IsNullOrEmpty(Model.LastError))
            {
                <DxFormLayoutItem Caption="@L["N11Product:LastError"]" ColSpanMd="12">
                    <span style="color:#dc2626;">@Model.LastError</span>
                </DxFormLayoutItem>
            }
        </DxFormLayoutGroup>
    }
</DxFormLayout>
