@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* N11'den ÜRÜN içe aktarma paneli — kayıtlı kanalın kimliğiyle mağazadaki mevcut ürünleri salt GET ile çeker
   (/ms/product-query; N11'e SIFIR yazma) ve tam zinciri (şablon ürün + varyant + kanal kaydı + SKU + override)
   idempotent yazar. Yalnız kaydedilmiş kanalda gösterilir; sonuç raporu EKRANDA — sessiz geçilmez.
   Trendyol panelinden tek farkı: OTOMATİK BAŞLAMAZ (gerekçe .razor.cs'te). *@

<div class="mt-3" style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
    <DxButton Text="@L["N11Product:Import:Run"]"
              IconCssClass="@TradeXpressIcons.Download"
              RenderStyle="ButtonRenderStyle.Secondary"
              Enabled="@(!_busy)"
              Click="@ImportAsync" />
    @if (_busy)
    {
        <span style="font-size:0.85rem; color:#6c757d;">@L["N11Product:Import:Running"]</span>
    }
    else
    {
        <span style="font-size:0.85rem; color:#6c757d;">@L["N11Product:Import:Description"]</span>
    }
</div>
@if (_result is { } r)
{
    <div style="font-size:0.85rem; display:flex; flex-direction:column; gap:2px; margin-top:6px;">
        @if (r.TotalFetchedItems == 0)
        {
            <span>@L["N11Product:Import:Empty"]</span>
        }
        else
        {
            <span>@L["N11Product:Import:Summary", r.TotalFetchedItems, r.TotalRemoteProducts, r.CreatedProducts, r.CreatedChannelProducts, r.UpdatedChannelProducts]</span>
        }
        @if (r.AddedVariants > 0)
        {
            <span>@L["N11Product:Import:AddedVariants", r.AddedVariants]</span>
        }
        @if (r.StockDifferenceCount > 0)
        {
            <span style="color:#b45309;">@L["N11Product:Import:StockDifferences", r.StockDifferenceCount]</span>
        }
        @if (r.UnmatchedCategories.Count > 0)
        {
            <span style="color:#b45309;">@L["N11Product:Import:UnmatchedCategories"]: @r.UnmatchedCategories.Count</span>
        }
        @if (r.SkippedRows.Count > 0)
        {
            <span style="color:#b45309;">@L["N11Product:Import:Skipped"]: @r.SkippedRows.Count</span>
        }
        @if (IssueLines.Count > 0)
        {
            @* Tek yönlü Text bağı → ValidationEnabled=false ŞART (TextExpression yok — tekrarlayan DevExpress tuzağı). *@
            <DxMemo Text="@string.Join('\n', IssueLines)" ReadOnly="true" Rows="6"
                    ValidationEnabled="false" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        }
    </div>
}
