@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Bir N11 kanalına AİT ürün listelemeleri — PERSISTENT drill (kanal edit formunun içinde). Satır tıkla → düzenle;
   satır başına "N11'e Gönder". Yeni listeleme ürün tarafından yapılır → AllowAdd kapalı. *@

<div class="mt-3">
    <DrillList TItem="N11ProductListingDto"
               @ref="_drill"
               Title="@L["N11Listings"]"
               EntityName="@L["N11ProductListing"]"
               EntityIcon="@TradeXpressIcons.Product"
               Items="_listings"
               KeyFieldName="Id"
               SoftDelete="false"
               PrimaryTextSelector="@(l => ProductCodeOf(l))"
               ParentEntityName="@L["SalesChannelType:TrN11"]"
               ParentText="@Channel.Code"
               NewItemFactory="@NewListing"
               CloneFactory="@CloneListing"
               AllowAdd="false"
               PersistUpdate="@PersistUpdate"
               PersistDelete="@PersistDelete"
               OnChanged="StateHasChanged">
        <GridColumns>
            <DxGridDataColumn FieldName="ProductId" Caption="@L["Product"]">
                <CellDisplayTemplate>@ProductLabelOf((N11ProductListingDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="CategoryName" Caption="@L["N11Listing:Category"]" />
            <DxGridDataColumn FieldName="N11ProductId" Caption="@L["N11Listing:SyncStatus"]" Width="160px">
                <CellDisplayTemplate>@StatusTextOf((N11ProductListingDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn Caption="@L["N11Listing:Push"]" Width="150px" TextAlignment="GridTextAlignment.Center">
                <CellDisplayTemplate>
                    @{
                        var row = (N11ProductListingDto)context.DataItem;
                    }
                    <DxButton Text="@L["N11Listing:Push"]" RenderStyle="ButtonRenderStyle.Primary"
                              IconCssClass="@TradeXpressIcons.SalesChannel"
                              Click="@(() => PushAsync(row))" />
                </CellDisplayTemplate>
            </DxGridDataColumn>
        </GridColumns>
        <EditContent Context="l">
            <N11ProductListingEditFields Model="@l" Channels="@_channelAsList" />
        </EditContent>
    </DrillList>
</div>
