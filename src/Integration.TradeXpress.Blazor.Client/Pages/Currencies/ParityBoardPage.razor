@page "/currencies/parities"
@using System
@using Integration.TradeXpress.Currencies
@using Integration.TradeXpress.Permissions
@using Microsoft.AspNetCore.Authorization
@using DevExpress.Blazor
@attribute [Authorize(TradeXpressPermissions.CurrencyUnits.Default)]
@inherits Volo.Abp.AspNetCore.Components.AbpComponentBase
@implements IDisposable

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@L["Menu:ParityBoard"]</h5>
        <DxButton Text="@L["Refresh"]" RenderStyle="ButtonRenderStyle.Secondary" IconCssClass="fas fa-sync" Click="LoadAsync" />
    </div>
    <div class="card-body">
        @if (Parities.Count == 0)
        {
            <div class="text-muted p-3">@L["ParityBoardEmptyHint"]</div>
        }
        else
        {
            <DxGrid Data="Parities" PageSize="50" ShowPager="true" ColumnResizeMode="GridColumnResizeMode.NextColumn">
                <Columns>
                    <DxGridDataColumn FieldName="Code" Caption="@L["Pair"]" Width="120px" />
                    <DxGridDataColumn FieldName="BaseCode" Caption="@L["Base"]" Width="80px" />
                    <DxGridDataColumn FieldName="QuoteCode" Caption="@L["Quote"]" Width="80px" />
                    <DxGridDataColumn FieldName="Buy" Caption="@L["Buy"]" Width="140px" DisplayFormat="N4" />
                    <DxGridDataColumn FieldName="Sell" Caption="@L["Sell"]" Width="140px" DisplayFormat="N4" />
                    <DxGridDataColumn Caption="" Width="50px" AllowSort="false">
                        <CellDisplayTemplate>
                            @{ var p = (ParityBoardDto)context.DataItem; }
                            @if (p.GuardFired)
                            {
                                <span class="text-warning" title="@L["GuardFired"]"><i class="fas fa-exclamation-triangle"></i></span>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                </Columns>
            </DxGrid>
        }
    </div>
</div>
