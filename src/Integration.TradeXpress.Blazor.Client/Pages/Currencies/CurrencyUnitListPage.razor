@page "/currencies/currency-units"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Pages.Currencies.Models
@using Integration.TradeXpress.Blazor.Client.Pages.Currencies.Components
@using Integration.TradeXpress.Currencies
@using DevExpress.Blazor
@using Volo.Abp.MultiTenancy

@inherits CrudPageBase<CurrencyUnitGetDto, CurrencyUnitListDto, Guid, CurrencyUnitListRequestDto, CurrencyUnitCreateDto, CurrencyUnitUpdateDto>

<CrudLayout TGetDto="CurrencyUnitGetDto"
            TListDto="CurrencyUnitListDto"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["CurrencyUnit"]"
            EntityIcon="@TradeXpressIcons.CurrencyUnit"
            PrimaryTextSelector="@(m => m.Code)"
            PageTitle="@L["CurrencyUnits"]"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync"
            AllowColumnReordering="true">

    <ToolbarActions>
        @{
            var selectedItem = StateService.SelectedDataItems?.Count == 1
                ? StateService.SelectedDataItems[0] as CurrencyUnitListDto
                : null;
        }
        <DxButton Text="@L["SetMargin"]"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  IconCssClass="@TradeXpressIcons.CurrencyMargin"
                  Enabled="@(selectedItem != null)"
                  Click="@(async () => { if (selectedItem != null) await MarginDialog!.ShowAsync(selectedItem.Id, selectedItem.Code, selectedItem.Name); })" />
    </ToolbarActions>

    <GridColumns>
        <DxGridDataColumn FieldName="Code" Caption="@L["Code"]" Width="90px" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" />
        <DxGridDataColumn Caption="@L["Buy"]" Width="110px" AllowSort="false" TextAlignment="GridTextAlignment.Right">
            <CellDisplayTemplate>
                @LivePrice(((CurrencyUnitListDto)context.DataItem).Id, buy: true)
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn Caption="@L["Sell"]" Width="110px" AllowSort="false" TextAlignment="GridTextAlignment.Right">
            <CellDisplayTemplate>
                @LivePrice(((CurrencyUnitListDto)context.DataItem).Id, buy: false)
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Type" Caption="@L["Type"]" Width="100px" />
        <DxGridDataColumn FieldName="IsGlobal" Caption="@L["IsGlobal"]" Width="90px" />

        <DxGridBandColumn Caption="@L["FollowingAndMargin"]" Width="320px" Visible="@IsTenantMode">
            <Columns>
                <DxGridDataColumn FieldName="FollowingUnitCode" Caption="@L["FollowingUnit"]" Width="100px" />
                <DxGridDataColumn FieldName="FollowingMarginType" Caption="@L["MarginType"]" Width="100px" />
                <DxGridDataColumn FieldName="FollowingMarginValue" Caption="@L["MarginValue"]" Width="100px" />
            </Columns>
        </DxGridBandColumn>

        <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="90px" Visible="false" />
    </GridColumns>

    

</CrudLayout>

@* Marj "Ayarla" diyaloğu — append-only SetAsync; kaydedince grid'i yeniler. *@
<MarginSetDialog @ref="MarginDialog" OnSaved="GetListAsync" />




