@using System
@using System.Linq
@using Integration.TradeXpress.Tenants
@using Integration.TradeXpress.Companies
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Countries
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Components.Shared
@using Integration.TradeXpress.Blazor.Client.Services.Mdi
@using Integration.Framework.Blazor.Client.Components.Inputs
@using DevExpress.Blazor
@using Microsoft.Extensions.Localization

@inject ITenantAppService TenantAppService
@inject ICountryAppService CountryAppService
@inject ICurrencyUnitAppService CurrencyAppService
@inject ITabManager TabManager

@inherits CrudEditComponentBase<TenantGetDto, TenantListDto, Guid, TenantListRequestDto, TenantCreateDto, TenantUpdateDto>

<CrudEditShell TGetDto="TenantGetDto" TListDto="TenantListDto" TKey="Guid"
               IsPopupMode="@IsPopupMode" EditContext="@EditContext" EditController="@this">
    @RenderForm()
</CrudEditShell>

@code {
    private RenderFragment RenderForm() => @<text>
<DxFormLayout CssClass="w-100">
    <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
        <DxTextBox @bind-Text="@EditModel.Name" @ref="_nameBox" />
    </DxFormLayoutItem>
</DxFormLayout>

@* Kullanıcılar ve Şirketler yalnız YENİ tenant'ta (in-memory; save'de o tenant scope'unda oluşturulur). *@
@if (IsNewMode)
{
    @* ── Kullanıcılar: tek yönetici (admin) zorunlu; bayrak self-hariç canlı (devir/switch/sil). ── *@
    <div class="mt-3">
        <DrillList TItem="TenantUserInput"
                   Title="@L["Users"]"
                   EntityName="@L["Entity:User"]"
                   Items="EditModel.Users"
                   KeyFieldName="ClientKey"
                   PrimaryTextSelector="@(u => u.UserName)"
                   NewItemFactory="@(() => new TenantUserInput())"
                   MinItems="1"
                   SoftDelete="true"
                   IsNewItem="@(_ => true)"
                   MarkDeleted="@(_ => { })"
                   DeleteGuard="@UserDeleteGuard"
                   OnSelectionChanged="OnUserSelected"
                   OnItemSaved="OnUserSaved"
                   OnChanged="NotifyDirtyChanged">
            <ToolbarActions>
                <DxButton Text="@L["MakeAdmin"]"
                          RenderStyle="ButtonRenderStyle.Link"
                          IconCssClass="fas fa-user-shield"
                          Click="MakeUserAdmin"
                          Enabled="@(_selectedUser is { IsAdmin: false })" />
            </ToolbarActions>
            <GridColumns>
                <DxGridDataColumn FieldName="UserName" Caption="@L["UserName"]" />
                <DxGridDataColumn FieldName="Email" Caption="@L["Email"]" />
                <DxGridDataColumn FieldName="IsAdmin" Caption="@L["IsAdmin"]" Width="90px" TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">@(((TenantUserInput)cell.DataItem).IsAdmin ? L["Yes"].Value : "")</CellDisplayTemplate>
                </DxGridDataColumn>
            </GridColumns>
            <EditContent Context="u">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem Caption="@($"{L["UserName"]} *")" ColSpanMd="6"><DxTextBox @bind-Text="u.UserName" /></DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@($"{L["Email"]} *")" ColSpanMd="6"><DxTextBox @bind-Text="u.Email" /></DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@($"{L["Password"]} *")" ColSpanMd="6"><PasswordTextEdit @bind-Text="u.Password" Tooltip="@L["ShowPassword"]" /></DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@($"{L["ConfirmPassword"]} *")" ColSpanMd="6"><PasswordTextEdit @bind-Text="u.PasswordConfirm" Tooltip="@L["ShowPassword"]" /></DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["Name"]" ColSpanMd="6"><DxTextBox @bind-Text="u.Name" /></DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["Surname"]" ColSpanMd="6"><DxTextBox @bind-Text="u.Surname" /></DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["IsAdmin"]" ColSpanMd="6"><DxCheckBox @bind-Checked="u.IsAdmin" CheckType="CheckType.Switch" Enabled="@(!IsUserSoleAdmin(u))" /></DxFormLayoutItem>
                </DxFormLayout>
            </EditContent>
        </DrillList>
    </div>

    @* ── Şirketler: tam graf (paylaşılan CompanyEditFields + CompanyBranchDrill). Tek merkez şirket. ── *@
    <div class="mt-3">
        <DrillList TItem="CompanyGraphDto"
                   Title="@L["Companies"]"
                   EntityName="@L["Entity:Company"]"
                   Items="EditModel.Companies"
                   KeyFieldName="ClientKey"
                   PrimaryTextSelector="@(c => c.Code)"
                   NewItemFactory="@NewCompany"
                   CloneFactory="@CloneCompany"
                   MinItems="1"
                   SoftDelete="true"
                   IsNewItem="@(c => c.Id == Guid.Empty)"
                   MarkDeleted="@(c => c.IsDeleted = true)"
                   FilterPredicate="@(c => !c.IsDeleted)"
                   DeleteGuard="@CompanyDeleteGuard"
                   OnSelectionChanged="OnCompanySelected"
                   OnItemSaved="OnCompanySaved"
                   OnChanged="NotifyDirtyChanged">
            <ToolbarActions>
                <DxButton Text="@L["MakeHeadquarters"]"
                          RenderStyle="ButtonRenderStyle.Link"
                          IconCssClass="fas fa-building"
                          Click="MakeCompanyHeadquarters"
                          Enabled="@(_selectedCompany is { IsDeleted: false, IsHeadquarters: false })" />
            </ToolbarActions>
            <GridColumns>
                <DxGridDataColumn FieldName="Code" Caption="@L["Code"]" Width="110px" />
                <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" />
                <DxGridDataColumn FieldName="CountryCode" Caption="@L["Country"]" Width="90px" />
                <DxGridDataColumn FieldName="IsHeadquarters" Caption="@L["IsHeadquarters"]" Width="90px" TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">@(((CompanyGraphDto)cell.DataItem).IsHeadquarters ? L["Yes"].Value : "")</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="IsActive" Caption="@L["Status"]" Width="110px" TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell"><StatusCell Active="@(((CompanyGraphDto)cell.DataItem).IsActive)" /></CellDisplayTemplate>
                </DxGridDataColumn>
            </GridColumns>
            <EditContent Context="c">
                <CompanyEditFields Model="c" Units="_units" Countries="_countries"
                                   HeadquartersEnabled="@(!IsCompanySoleHq(c))" CodeEnabled="true" />
            </EditContent>
            <AfterEditForm Context="c">
                <CompanyBranchDrill Model="c" OnChanged="NotifyDirtyChanged" />
            </AfterEditForm>
        </DrillList>
    </div>
}
</text>;

    protected override Volo.Abp.Application.Services.ICrudAppService<
        TenantGetDto, TenantListDto, Guid, TenantListRequestDto, TenantCreateDto, TenantUpdateDto> CrudAppService => TenantAppService;

    protected override string EntityChangeKey => "Tenants";

    private DxTextBox? _nameBox;
    private List<CountryListDto> _countries = new();
    private List<CurrencyUnitListDto> _units = new();
    private TenantUserInput? _selectedUser;
    private CompanyGraphDto? _selectedCompany;

    protected override async Task OnInitializedAsync()
    {
        // Birim/ülke listeleri model oluşturmadan ÖNCE yüklenir (varsayılan şirketin base para birimi türetilsin).
        var countriesTask = CountryAppService.GetListAsync(new CountryListRequestDto { MaxResultCount = 1000 });
        var unitsTask = CurrencyAppService.GetListAsync(new CurrencyUnitListRequestDto { MaxResultCount = 1000 });
        await Task.WhenAll(countriesTask, unitsTask);
        _countries = (await countriesTask).Items.ToList();
        _units = (await unitsTask).Items.ToList();

        await base.OnInitializedAsync();
    }

    // Yeni tenant: başlangıç admin kullanıcısı + varsayılan merkez şirket (HQ şube + Ana Kasa). Snapshot ÖNCESİ.
    protected override Task OnModelCreatedAsync(TenantGetDto model)
    {
        model.Users.Add(new TenantUserInput
        {
            UserName = "admin",
            Email = "admin@admin.com",
            IsAdmin = true,
#if DEBUG
            Password = "1q2w3E*",
            PasswordConfirm = "1q2w3E*",
#endif
        });
        model.Companies.Add(NewCompany("MRK", "Merkez", "TR", isHeadquarters: true));
        return Task.CompletedTask;
    }

    public override async Task<bool> SaveAsync()
    {
        if (IsNewMode)
        {
            if (!EditModel.Users.Any(u => u.IsAdmin))
            {
                ShowErrorLines(L["TenantNeedsAdmin"]);
                return false;
            }
            if (!EditModel.Companies.Any(c => !c.IsDeleted && c.IsHeadquarters))
            {
                ShowErrorLines(L["TenantNeedsHq"]);
                return false;
            }
        }
        return await base.SaveAsync();
    }

    // ── Şirket düğümü fabrikaları ───────────────────────────────────────────────
    private CompanyGraphDto NewCompany() => NewCompany(string.Empty, string.Empty, "TR", isHeadquarters: false);

    private CompanyGraphDto NewCompany(string code, string name, string country, bool isHeadquarters) => new()
    {
        Code = code,
        Name = name,
        CountryCode = country,
        BaseCurrencyUnitId = DefaultUnitIdFor(country),
        IsHeadquarters = isHeadquarters,
        IsActive = true,
        DisplayOrder = 1,
        Branches =
        {
            new BranchGraphDto
            {
                Code = BranchConsts.DefaultHeadquartersCode,
                Name = BranchConsts.DefaultHeadquartersName,
                IsHeadquarters = true,
                DisplayOrder = 1,
                Vaults = { new VaultGraphDto { Code = VaultConsts.DefaultCode, Name = VaultConsts.DefaultName, IsDefault = true, DisplayOrder = 1 } },
            },
        },
    };

    // Ülkenin varsayılan para biriminin Id'si (yoksa TRY); birim listesinden çözülür.
    private Guid DefaultUnitIdFor(string country)
    {
        var ccy = _countries.FirstOrDefault(c => string.Equals(c.Code, country, StringComparison.OrdinalIgnoreCase))?.DefaultCurrencyCode;
        var unit = _units.FirstOrDefault(u => string.Equals(u.Code, ccy, StringComparison.OrdinalIgnoreCase))
            ?? _units.FirstOrDefault(u => u.Code == CurrencyUnitCode.TRY);
        return unit?.Id ?? Guid.Empty;
    }

    private static CompanyGraphDto CloneCompany(CompanyGraphDto c) => new()
    {
        Id = c.Id, ClientKey = c.ClientKey, IsDeleted = c.IsDeleted,
        Code = c.Code, Name = c.Name, CountryCode = c.CountryCode, BaseCurrencyUnitId = c.BaseCurrencyUnitId,
        IsHeadquarters = c.IsHeadquarters, IsActive = c.IsActive, DisplayOrder = c.DisplayOrder, Description = c.Description,
        Branches = c.Branches.Select(CloneBranch).ToList(),
    };

    private static BranchGraphDto CloneBranch(BranchGraphDto b) => new()
    {
        Id = b.Id, ClientKey = b.ClientKey, IsDeleted = b.IsDeleted,
        Code = b.Code, Name = b.Name, IsHeadquarters = b.IsHeadquarters,
        IsActive = b.IsActive, DisplayOrder = b.DisplayOrder, Description = b.Description,
        Vaults = b.Vaults.Select(CloneVault).ToList(),
    };

    private static VaultGraphDto CloneVault(VaultGraphDto v) => new()
    {
        Id = v.Id, ClientKey = v.ClientKey, IsDeleted = v.IsDeleted,
        Code = v.Code, Name = v.Name, IsDefault = v.IsDefault,
        IsActive = v.IsActive, DisplayOrder = v.DisplayOrder, Description = v.Description,
    };

    // ── Tekil-bayrak (admin / merkez şirket) — KENDİSİ hariç canlı ──────────────
    private void OnUserSelected(TenantUserInput? u) => _selectedUser = u;
    private void OnCompanySelected(CompanyGraphDto? c) => _selectedCompany = c;

    private bool IsUserSoleAdmin(TenantUserInput u)
        => u.IsAdmin && !EditModel.Users.Any(x => x.ClientKey != u.ClientKey && x.IsAdmin);

    private bool IsCompanySoleHq(CompanyGraphDto c)
        => c.IsHeadquarters && !EditModel.Companies.Any(x => x.ClientKey != c.ClientKey && !x.IsDeleted && x.IsHeadquarters);

    private string? UserDeleteGuard(TenantUserInput u)
        => IsUserSoleAdmin(u) ? L["CannotDeleteSoleAdmin"].Value : null;

    private string? CompanyDeleteGuard(CompanyGraphDto c)
        => IsCompanySoleHq(c) ? L["CannotDeleteHeadquartersCompany"].Value : null;

    private void OnUserSaved(TenantUserInput saved)
    {
        if (!saved.IsAdmin) return;
        foreach (var u in EditModel.Users)
            if (!ReferenceEquals(u, saved)) u.IsAdmin = false;
    }

    private void OnCompanySaved(CompanyGraphDto saved)
    {
        if (!saved.IsHeadquarters) return;
        foreach (var c in EditModel.Companies)
            if (!ReferenceEquals(c, saved) && !c.IsDeleted) c.IsHeadquarters = false;
    }

    private void MakeUserAdmin()
    {
        if (_selectedUser is null) return;
        foreach (var u in EditModel.Users) u.IsAdmin = false;
        _selectedUser.IsAdmin = true;
        NotifyDirtyChanged();
    }

    private void MakeCompanyHeadquarters()
    {
        if (_selectedCompany is null || _selectedCompany.IsDeleted) return;
        foreach (var c in EditModel.Companies) c.IsHeadquarters = false;
        _selectedCompany.IsHeadquarters = true;
        NotifyDirtyChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _nameBox != null)
            await _nameBox.FocusAsync();
    }

    public override async Task CloseAsync()
    {
        if (!IsPopupMode && CurrentMdiTab != null)
        {
            await TabManager.TryCloseAsync(CurrentMdiTab.Id);
        }
        else
        {
            await base.CloseAsync();
        }
    }
}
