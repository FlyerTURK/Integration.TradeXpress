@page "/tenant-management/tenants"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Tenants
@using DevExpress.Blazor
@inherits CrudPageBase<TenantGetDto, TenantListDto, Guid, TenantListRequestDto, TenantCreateDto, TenantUpdateDto>

<CrudLayout TGetDto="TenantGetDto"
            TListDto="TenantListDto"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["Entity:Tenant"]"
            EntityIcon="@TradeXpressIcons.Tenant"
            PrimaryTextSelector="@(m => m.Name)"
            PageTitle="@L["TenantManagement"]"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync">
    
    <GridColumns>
        <DxGridDataColumn FieldName="Id" Caption="ID" Width="100px" Visible="false" />
        <GridLinkColumn FieldName="Name" Caption="@L["Name"]" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                        OnClick="@(o => BeforeUpdateAsync((TenantListDto)o))" />
    </GridColumns>

    

</CrudLayout>





