@using System
@using System.Linq
@using System.Collections.Generic
@using Integration.TradeXpress.Tenants
@using Integration.TradeXpress.Companies
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Countries
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Components.Shared
@using Integration.Framework.Blazor.Client.Components.Inputs
@using DevExpress.Blazor
@using Microsoft.Extensions.Localization
@using Integration.Framework.Blazor.Client.Profiles
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IEntityProfileRegistry Profiles

@*
   Tenant DUMB Layout — Ad + (yalnız YENİ tenant'ta) Kullanıcılar drill (admin onboarding) + Şirketler drill
   (paylaşılan CompanyEditFields + CompanyBranchDrill grafı). In-memory graf → save'de server o tenant scope'unda
   oluşturur (onboarding/impersonation server-side). Drill değişimi EditChanged ile dirty/Save. Tekil-bayrak
   (admin/HQ) self-hariç canlı. Şirket-drill combo'larında Add/Edit YOK (Tenant popup'ta → nested popup olmaz).
*@
@* TEK DxFormLayout — tenant adı + admin + şirket + merkez şube hepsi burada. Bileşenler Embedded modda
   render edilir (kendi wrapper'larını taşımazlar) → caption sütunları baştan sona HİZALI kalır.
   Üst üste/iç içe DxFormLayout yığmak hizayı bozuyordu (kullanıcı uyarısı). *@
<DxFormLayout CssClass="w-100">
    @* @bind-Text:after → binding + validasyon korunur, yazdıkça yönetici e-posta VARSAYILANI tazelenir.
       (Text/TextChanged'e çevirseydik EditContext altında TextExpression gerekirdi — [validation-expr].) *@
    <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
        <DxTextBox @bind-Text="@Model.Name" @bind-Text:after="OnTenantNameChanged" />
    </DxFormLayoutItem>

    @if (IsNew)
    {
        @* Yönetici — onboarding'de TEK admin, drill DEĞİL inline (kullanıcı kararı). Ek kullanıcılar
           tenant açıldıktan sonra Identity ekranlarından eklenir. *@
        @if (AdminUser is { } admin)
        {
            <DxFormLayoutGroup Caption="@L["Tenant:AdminUser"]" ColSpanMd="12">
                <DxFormLayoutItem Caption="@($"{L["UserName"]} *")" ColSpanMd="6">
                    <DxTextBox @bind-Text="admin.UserName" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@($"{L["Email"]} *")" ColSpanMd="6">
                    <DxTextBox @bind-Text="admin.Email" />
                </DxFormLayoutItem>
                @* İSTİSNA — bu formda şifre AÇIK metin (maskeli PasswordTextEdit değil): tenant'ı host yöneticisi
                   kuruyor ve başlangıç şifresini tenant sahibine İLETMESİ gerekiyor; maskeli kutu neyin
                   ayarlandığını görünmez kılıyordu. Diğer TÜM şifre alanları maskeli kalır. *@
                <DxFormLayoutItem Caption="@($"{L["Password"]} *")" ColSpanMd="6">
                    <DxTextBox @bind-Text="admin.Password" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@($"{L["ConfirmPassword"]} *")" ColSpanMd="6">
                    <DxTextBox @bind-Text="admin.PasswordConfirm" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Name"]" ColSpanMd="6">
                    <DxTextBox @bind-Text="admin.Name" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Surname"]" ColSpanMd="6">
                    <DxTextBox @bind-Text="admin.Surname" />
                </DxFormLayoutItem>
            </DxFormLayoutGroup>
        }

        @* Şirket — merkez/açıklama/durum/sıra GİZLİ (varsayılanlarıyla taşınır).
           Merkez şube grubu şirketin çerçevesinin İÇİNE, en sona iner (GroupFooter). *@
        @if (FirstCompany is { } newCompany)
        {
            <CompanyEditFields Model="newCompany" Units="Units" Countries="Countries"
                               GroupCaption="@L["Tenant:HeadquartersCompany"].Value"
                               HeadquartersEnabled="false" CodeEnabled="true"
                               ShowHeadquarters="false" ShowAdvancedFields="false"
                               Embedded="true">
                <GroupFooter>
                    @if (FirstBranch is { } newBranch)
                    {
                        @* Merkez şube ŞİRKETİN bilanço birimini devralır — combo gizli olduğundan değeri
                           burada, render anında hizalıyoruz (kullanıcı şirketin ülkesini/birimini değiştirirse
                           şube de onunla gelsin; aksi halde şube açılıştaki birimde takılı kalırdı). *@
                        newBranch.BaseCurrencyUnitId = newCompany.BaseCurrencyUnitId;

                        <BranchEditFields Model="newBranch" Units="Units"
                                          GroupCaption="@L["Tenant:HeadquartersBranch"].Value"
                                          HeadquartersEnabled="false" CodeEnabled="true"
                                          ShowHeadquarters="false" ShowBaseCurrency="false"
                                          ShowAdvancedFields="false" AddressInsideGroup="true"
                                          Embedded="true"
                                          EmbeddedVault="@newBranch.Vaults.FirstOrDefault(v => !v.IsDeleted)"
                                          OnReferenceDataReload="@OnReferenceDataReload" />
                    }
                </GroupFooter>
            </CompanyEditFields>
        }
    }
</DxFormLayout>

@* ── GÜNCELLE modu: YAPISAL şirket ağacı (şirket → şube → kasa) ────────────────────────────────────
   Graf YALNIZ yapısal alan taşır (kod/ad/ülke/para birimi/merkez/durum/sıra/açıklama + adres) — sipariş,
   satış kanalı, bakiye ve kimlik bilgisi bu DTO'da hiç YOKTUR.

   Tarihçe (2026-08-07): bu drill tam yetkiliydi ama TenantUpdateDto yalnız `Name` taşıyordu ve UpdateAsync
   yalnız ChangeNameAsync çağırıyordu → yapılan HER yapısal değişiklik sessizce çöpe gidiyordu (ne hata, ne
   uyarı; yalnız "kaydedildi" diyen bir form). Önce salt-okunur kilitlendi, sonra graf diff'i UpdateAsync'e
   taşındı ve kilit kaldırıldı — düzenleme artık GERÇEKTEN kaydediliyor (TenantAppService.SaveCompanyGraphAsync). *@
@if (!IsNew)
{
    <DrillTabs CssClass="mt-3">
    <DxTabPage Text="@Profiles.PluralTitle("Company", L)" TabIconCssClass="@Profiles.Icon("Company")">
        @* Şirketler: tam graf (CompanyEditFields + CompanyBranchDrill). *@
        <DrillList TItem="CompanyGraphDto"
                   @ref="_companyDrill"
                   Title="@L["Companies"]"
                   EntityName="@L["Entity:Company"]"
                   EntityIcon="@Profiles.Icon("Company")"
                   Items="Model.Companies"
                   KeyFieldName="ClientKey"
                   PrimaryTextSelector="@(c => c.Code)"
                   NewItemFactory="@NewCompanyNode"
                   CloneFactory="@(c => c.Clone())"
                   MinItems="1"
                   SoftDelete="true"
                   IsNewItem="@(c => c.Id == Guid.Empty)"
                   MarkDeleted="@(c => c.IsDeleted = true)"
                   FilterPredicate="@(c => !c.IsDeleted)"
                   DeleteGuard="@CompanyDeleteGuard"
                   OnSelectionChanged="OnCompanySelected"
                   OnItemSaved="OnCompanySaved"
                   OnChanged="@(() => EditChanged?.Invoke())"
                   CustomActions="@CompanyActions">
            <GridColumns>
                <GridLinkColumn FieldName="Code" Caption="@L["Code"]" Width="110px" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1" OnClick="@(item => _companyDrill?.EditItem((CompanyGraphDto)item))" />
                <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" />
                @* Ülke id-only: in-memory graf düğümünde kod alanı yok → Countries lookup'ından id ile çöz. *@
                <DxGridDataColumn FieldName="CountryId" Caption="@L["Country"]" Width="90px" TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">@CountryCodeOf(((CompanyGraphDto)cell.DataItem).CountryId)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="IsHeadquarters" Caption="@L["IsHeadquarters"]" Width="90px" TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate Context="cell">@(((CompanyGraphDto)cell.DataItem).IsHeadquarters ? L["Yes"].Value : "")</CellDisplayTemplate>
                </DxGridDataColumn>
                <StatusColumn />
            </GridColumns>
            <EditContent Context="c">
                <CompanyEditFields Model="c" Units="Units" Countries="Countries"
                                   HeadquartersEnabled="@(!IsCompanySoleHq(c))" CodeEnabled="true" />
            </EditContent>
            <AfterEditForm Context="c">
                <DrillTabs CssClass="mt-3">
                    <DxTabPage Text="@Profiles.PluralTitle("Branch", L)" TabIconCssClass="@Profiles.Icon("Branch")">
                        <CompanyBranchDrill Model="c" Units="Units" OnChanged="@(() => EditChanged?.Invoke())"
                                            OnReferenceDataReload="@OnReferenceDataReload" />
                    </DxTabPage>
                </DrillTabs>
            </AfterEditForm>
        </DrillList>
    </DxTabPage>
    </DrillTabs>
}


@code {
    [Parameter, EditorRequired] public TenantGetDto Model { get; set; } = default!;
    [Parameter] public bool IsNew { get; set; }
    
    private DrillList<CompanyGraphDto>? _companyDrill;
    private DrillList<TenantUserInput>? _userDrill;

    // ── YENİ mod düz-form bağları ───────────────────────────────────────────────────────────────────
    // Onboarding TEK şirket + TEK merkez şube kurar (ApplyNewTenantDefaults). Düz form bu tek düğüme
    // bind eder; drill'in seçim/silme/çoğullama makinesi burada gereksizdir. Silinmiş düğüm atlanır.
    private CompanyGraphDto? FirstCompany =>
        Model.Companies.FirstOrDefault(c => !c.IsDeleted);

    private BranchGraphDto? FirstBranch =>
        FirstCompany?.Branches.FirstOrDefault(b => !b.IsDeleted);

    // Onboarding'in TEK yöneticisi — drill yerine inline düzenlenir. ApplyNewTenantDefaults bir admin satırı kurar;
    // yine de savunmacı: admin işaretli yoksa ilk satır, o da yoksa null (grup hiç render edilmez).
    private TenantUserInput? AdminUser =>
        Model.Users.FirstOrDefault(u => u.IsAdmin) ?? Model.Users.FirstOrDefault();

    // En son ÜRETİLEN e-posta. Kullanıcı kutuyu elle değiştirdiyse bu değerden sapar → bir daha ezmeyiz.
    private string? _autoAdminEmail;

    /// <summary>Tenant adı her zaman BÜYÜK HARF (kullanıcı kararı) + yönetici e-posta varsayılanını tazeler.
    /// Çevrim KÜLTÜRE DUYARLI: Türkçe'de "işık" → "İŞIK" (invariant çevrim "IŞIK" üretir, noktasız I ile yanlış).</summary>
    private void OnTenantNameChanged()
    {
        if (!string.IsNullOrEmpty(Model.Name))
        {
            Model.Name = Model.Name.ToUpper(System.Globalization.CultureInfo.CurrentCulture);
        }

        SyncAdminEmailDefault();
    }

    /// <summary>Yönetici e-posta VARSAYILANINI tenant adından tazeler: "Ekol Kuyumculuk" → admin@ekolkuyumculuk.com.
    /// Yalnız kullanıcı e-postaya DOKUNMADIYSA yazar (elle girilen değer korunur — varsayılan, dayatma değil).</summary>
    private void SyncAdminEmailDefault()
    {
        if (!IsNew || AdminUser is not { } admin)
        {
            return;
        }

        if (!string.IsNullOrEmpty(admin.Email) && admin.Email != _autoAdminEmail)
        {
            return;   // kullanıcı kendi e-postasını yazmış → dokunma
        }

        var slug = ToDomainSlug(Model.Name);
        _autoAdminEmail = string.IsNullOrEmpty(slug) ? null : $"admin@{slug}.com";
        admin.Email = _autoAdminEmail ?? string.Empty;
    }

    /// <summary>Tenant adını alan-adı parçasına indirger: Türkçe harfler ASCII'ye katlanır (ş→s, ı→i, ğ→g…),
    /// harf/rakam dışı her şey atılır, küçük harfe iner. "Öz Şahin Kuyumculuk" → "ozsahinkuyumculuk".</summary>
    private static string ToDomainSlug(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return string.Empty;
        }

        var builder = new System.Text.StringBuilder(name.Length);
        foreach (var ch in name.Trim())
        {
            var folded = ch switch
            {
                'ı' or 'İ' or 'I' or 'i' => 'i',
                'ş' or 'Ş' => 's',
                'ğ' or 'Ğ' => 'g',
                'ü' or 'Ü' => 'u',
                'ö' or 'Ö' => 'o',
                'ç' or 'Ç' => 'c',
                _ => char.ToLowerInvariant(ch),
            };

            if (char.IsLetterOrDigit(folded) && folded < 128)
            {
                builder.Append(folded);
            }
        }

        return builder.ToString();
    }

    // Şube düğümüne ŞİRKETİN ülkesini taşı: BranchEditFields adres popup'ında ülkeyi buna KİLİTLER
    // (FixedCountryId=Model.CompanyCountryId). Onboarding'de şube henüz kaydedilmediğinden bu alan boş gelir;
    // ayrıca kullanıcı şirketin ülkesini değiştirirse adres kilidi de onunla birlikte güncellenmelidir.
    // (Adres modelinin boş-DTO init'i BranchEditFields'in kendi OnParametersSet'inde — burada tekrarlanmaz.)
    protected override void OnParametersSet()
    {
        if (IsNew && FirstCompany is { } company && FirstBranch is { } branch)
        {
            branch.CompanyCountryId = company.CountryId;
        }
    }
    [Parameter] public List<CurrencyUnitListDto> Units { get; set; } = new();
    [Parameter] public List<CountryListDto> Countries { get; set; } = new();

    /// <summary>Inline combo'dan birim eklenince host'un (TenantEditHost) birim listesini tazelemesi için sinyal.</summary>
    [Parameter] public EventCallback OnReferenceDataReload { get; set; }

    // Drill (Kullanıcılar/Şirketler/Şube-Kasa) değişimini forma bildir — EntityEditForm EditChanged cascade'i.
    [CascadingParameter(Name = "EditChanged")] private Action? EditChanged { get; set; }

    private TenantUserInput? _selectedUser;
    private CompanyGraphDto? _selectedCompany;

    // Toolbar custom action'ları — liste sayfalarıyla AYNI descriptor sözleşmesi (SortIndex 300). void handler'lar
    // Func<Task>'e sarılır.
    private IReadOnlyList<CrudToolbarAction> CompanyActions => new[]
    {
        new CrudToolbarAction
        {
            SortIndex = 300,
            Text = L["MakeHeadquarters"],
            Tooltip = L["MakeHeadquarters"],
            IconCssClass = "custom-icon-company",
            Enabled = _selectedCompany is { IsDeleted: false, IsHeadquarters: false },
            OnClick = () => { MakeCompanyHeadquarters(); return Task.CompletedTask; },
        },
    };

    private IReadOnlyList<CrudToolbarAction> UserActions => new[]
    {
        new CrudToolbarAction
        {
            SortIndex = 300,
            Text = L["MakeAdmin"],
            Tooltip = L["MakeAdmin"],
            IconCssClass = "custom-icon-role",
            Enabled = _selectedUser is { IsAdmin: false },
            OnClick = () => { MakeUserAdmin(); return Task.CompletedTask; },
        },
    };

    // ── Yeni şirket düğümü grafı (host ApplyNewDefaults de kullanır → static, units/countries parametreli). ──
    public static CompanyGraphDto NewCompany(string code, string name, Guid? countryId, bool isHeadquarters,
        IReadOnlyList<CurrencyUnitListDto> units, IReadOnlyList<CountryListDto> countries)
    {
        var baseUnitId = DefaultUnitIdFor(countryId, units, countries);   // tek kaynak: şirket + HQ şube aynı base ile preset
        return new CompanyGraphDto
        {
            Code = code,
            Name = name,
            CountryId = countryId,
            BaseCurrencyUnitId = baseUnitId,
            IsHeadquarters = isHeadquarters,
            IsActive = true,
            DisplayOrder = 1,
            Branches =
            {
                new BranchGraphDto
                {
                    // Kod/ad BOŞ: onboarding'de kullanıcı elle girer (bkz. TenantEditHost.ApplyNewTenantDefaults).
                    // Şirket drill'inden (güncelle modu) yeni şube eklenirken de aynı davranış — kullanıcı adlandırır.
                    Code = string.Empty,
                    Name = string.Empty,
                    IsHeadquarters = true,
                    IsActive = true,
                    DisplayOrder = 1,
                    BaseCurrencyUnitId = baseUnitId,
                    Vaults = { new VaultGraphDto { Code = VaultConsts.DefaultCode, Name = VaultConsts.DefaultName, IsDefault = true, IsActive = true, DisplayOrder = 1 } },
                },
            },
        };
    }

    // Ülkenin varsayılan para biriminin Id'si (id-only zincir: Country.DefaultCurrencyUnitId; yoksa TRY).
    public static Guid DefaultUnitIdFor(Guid? countryId, IReadOnlyList<CurrencyUnitListDto> units, IReadOnlyList<CountryListDto> countries)
    {
        var unitId = countries.FirstOrDefault(c => c.Id == countryId)?.DefaultCurrencyUnitId;
        if (unitId is { } uid && units.Any(u => u.Id == uid))
        {
            return uid;
        }

        return units.FirstOrDefault(u => u.Code == CurrencyUnitCode.TRY)?.Id ?? Guid.Empty;
    }

    // Katalogdan ülke Id'sini koda göre bulur (yeni düğüm default'u + grid görüntü kolonu).
    public static Guid? CountryIdOf(string code, IReadOnlyList<CountryListDto> countries)
        => countries.FirstOrDefault(c => string.Equals(c.Code, code, StringComparison.OrdinalIgnoreCase))?.Id;

    // Grid görüntü kolonu: Country.Id → kod (in-memory graf düğümünde kod alanı taşınmaz).
    private string CountryCodeOf(Guid? countryId)
        => Countries.FirstOrDefault(c => c.Id == countryId)?.Code ?? string.Empty;

    // Drill add (parametresiz): boş şirket düğümü (TR default).
    private CompanyGraphDto NewCompanyNode() => NewCompany(string.Empty, string.Empty, CountryIdOf("TR", Countries), isHeadquarters: false, Units, Countries);

    // Clone() CompanyGraphDto'da (şube→kasa dahil tam deep-copy; tek kaynak → BaseCurrencyUnitId gibi
    // alanların "unutulan alan" bug'ı imkânsız — eski 3 kopyada biri bu yüzden boş combo veriyordu).

    // ── Tekil-bayrak (admin / merkez şirket) — KENDİSİ hariç canlı ──
    private void OnUserSelected(TenantUserInput? u) => _selectedUser = u;
    private void OnCompanySelected(CompanyGraphDto? c) => _selectedCompany = c;

    private bool IsUserSoleAdmin(TenantUserInput u)
        => u.IsAdmin && !Model.Users.Any(x => x.ClientKey != u.ClientKey && x.IsAdmin);

    private bool IsCompanySoleHq(CompanyGraphDto c)
        => c.IsHeadquarters && !Model.Companies.Any(x => x.ClientKey != c.ClientKey && !x.IsDeleted && x.IsHeadquarters);

    private string? UserDeleteGuard(TenantUserInput u)
        => IsUserSoleAdmin(u) ? L["CannotDeleteSoleAdmin"].Value : null;

    private string? CompanyDeleteGuard(CompanyGraphDto c)
        => IsCompanySoleHq(c) ? L["CannotDeleteHeadquartersCompany"].Value : null;

    private void OnUserSaved(TenantUserInput saved)
    {
        if (!saved.IsAdmin) return;
        foreach (var u in Model.Users)
            if (!ReferenceEquals(u, saved)) u.IsAdmin = false;
    }

    private void OnCompanySaved(CompanyGraphDto saved)
    {
        if (!saved.IsHeadquarters) return;
        foreach (var c in Model.Companies)
            if (!ReferenceEquals(c, saved) && !c.IsDeleted) c.IsHeadquarters = false;
    }

    private void MakeUserAdmin()
    {
        if (_selectedUser is null) return;
        foreach (var u in Model.Users) u.IsAdmin = false;
        _selectedUser.IsAdmin = true;
        EditChanged?.Invoke();
    }

    private void MakeCompanyHeadquarters()
    {
        if (_selectedCompany is null || _selectedCompany.IsDeleted) return;
        foreach (var c in Model.Companies) c.IsHeadquarters = false;
        _selectedCompany.IsHeadquarters = true;
        EditChanged?.Invoke();
    }
}

