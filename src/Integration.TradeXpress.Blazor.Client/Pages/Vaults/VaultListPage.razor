@page "/vaults/{BranchId:guid}"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Pages.Vaults.Models
@using Integration.TradeXpress.Vaults
@using DevExpress.Blazor
@inherits CrudPageBase<VaultGetDto, VaultListDto, Guid, VaultListRequestDto, VaultCreateDto, VaultUpdateDto>

<CrudLayout TGetDto="VaultGetDto"
            TListDto="VaultListDto"
            TViewModel="VaultViewModel"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["Entity:Vault"]"
            EntityIcon="@TradeXpressIcons.Vault"
            PrimaryTextSelector="@(m => m.Code)"
            ParentEntityName="@L["Entity:Branch"]"
            ParentTextSelector="@(_ => BranchCode)"
            PageTitle="@PageTitle"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync">

    <GridColumns>
        <GridLinkColumn FieldName="Code" Caption="@L["Code"]" Width="120px" VisibleIndex="0"
                        OnClick="@(o => BeforeUpdateAsync((VaultListDto)o))" />
        <DxGridDataColumn FieldName="BranchCode" Caption="@L["Entity:Branch"]" Width="120px" VisibleIndex="1" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" VisibleIndex="2" />
        <DxGridDataColumn FieldName="IsDefault" Caption="@L["IsDefault"]" Width="100px" VisibleIndex="3" />
        @* IsActive kolonu yok — toolbar'da IsActive switch filtre kontrolü var (aktif/pasif ayrımı orada). *@
        <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="90px" VisibleIndex="4" />
    </GridColumns>

    

</CrudLayout>





