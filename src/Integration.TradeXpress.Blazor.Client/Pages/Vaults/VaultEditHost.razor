@page "/vaults/edit/new"
@page "/vaults/edit/{Id:guid}"
@using System
@using System.Linq
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Branches
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Integration.Framework.Blazor.Client.Profiles
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IVaultAppService VaultAppService
@inject IObjectMapper Mapper
@inject IUiInteractionService UiService
@inject IEntityProfileRegistry Profiles

@*
   PİLOT vault edit (YENİ mimari) — VaultListPage'in EditComponentType'ı (popup'ta açılır).
   Host = persistence sahibi (PersistentCoordinator) + sunum. Agnostic EntityEditForm + dumb VaultLayout.
   Form API'ye DOKUNMAZ: OnCommit → coordinator → VaultAppService. BranchId drill-down bağlamından gelir.
*@

@if (_coordinator != null && _ready)
{
    <EntityEditForm TGetDto="VaultGetDto" TListDto="VaultListDto" TKey="Guid"
                    Model="@_model" IsNew="@_isNew"
                    FormCaption="@L[Profile.CaptionKey].Value"
                    EntityValue="@_model.Code"
                    ParentLabel="@L[ParentProfile.CaptionKey].Value"
                    ParentValue="@_model.BranchCode"
                    IconCssClass="@Profile.IconCssClass"
                    CanDeleteRecord="@(!_isNew && !_model.IsDefault)"
                    Placement="ToolbarPlacement.Top"
                    ValidateContext="ValidateVault"
                    OnCommit="CommitAsync"
                    OnSaveAndNew="SaveAndNewAsync"
                    OnSaveAndClose="SaveAndCloseAsync"
                    OnClose="CloseAsync"
                    OnDelete="DeleteAsync">
        <VaultLayout Model="@context" IsNew="@_isNew" />
    </EntityEditForm>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] [SupplyParameterFromQuery] public Guid? BranchId { get; set; }
    [Parameter] public string? BranchCode { get; set; }   // header L3 bağlamı (drill-down'dan; combo yok)
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private VaultGetDto _model = new();
    private bool _isNew = true;
    private bool _ready;
    private ICommitCoordinator<VaultGetDto, VaultListDto, Guid, VaultListRequestDto>? _coordinator;

    // Entity KİMLİĞİ tek kaynak: başlık/ikon/parent profilden (VaultListPage ile AYNI profil).
    private EntityProfile? _profile;
    private EntityProfile Profile => _profile ??= Profiles.Get(typeof(VaultGetDto));
    private EntityProfile? _parentProfile;
    private EntityProfile ParentProfile => _parentProfile ??= Profiles.GetByKey(Profile.ParentProfileKey!);

    protected override async Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<VaultGetDto, VaultListDto, Guid, VaultListRequestDto, VaultCreateDto, VaultUpdateDto>(
            VaultAppService, Mapper);

        await LoadAsync();
        _ready = true;
    }

    private async Task LoadAsync()
    {
        if (Id is { } id && id != Guid.Empty)
        {
            _model = await _coordinator!.GetForEditAsync(id);
            _isNew = false;
        }
        else
        {
            _model = _coordinator!.NewModel();
            _model.IsActive = true;
            _model.DisplayOrder = 1;
            if (BranchId is { } b && b != Guid.Empty) _model.BranchId = b;   // drill-down bağlamı
            _model.BranchCode = BranchCode ?? string.Empty;                 // header L3 (Şube: ...)
            _isNew = true;
        }
    }

    /// <summary>Standalone bağlam kuralı: Şube zorunlu (model attribute DEĞİL — drill'de boş olabilir).</summary>
    private IReadOnlyList<KeyValuePair<string, string>> ValidateVault(VaultGetDto m)
        => m.BranchId == Guid.Empty
            ? new[] { new KeyValuePair<string, string>(nameof(VaultGetDto.BranchId), L["Vault:BranchRequired"].Value) }
            : System.Array.Empty<KeyValuePair<string, string>>();

    private async Task CommitAsync(VaultGetDto m)
    {
        try
        {
            _model = await _coordinator!.CommitAsync(m);   // taze model → EntityEditForm rebind (* gider)
            _isNew = false;
            UiService.ShowSuccessToast(L["SuccessfullySaved"].Value);
            await OnSaved.InvokeAsync();                   // liste sayfasını tazele
            StateHasChanged();
        }
        catch (Exception ex)
        {
            UiService.ShowErrorToast(ex.Message);          // form açık + dirty kalır
        }
    }

    private Task SaveAndNewAsync()   // commit zaten OnCommit'te oldu → yeni boş forma geç
    {
        _model = _coordinator!.NewModel();
        _model.IsActive = true;
        _model.DisplayOrder = 1;
        if (BranchId is { } b && b != Guid.Empty) _model.BranchId = b;
        _isNew = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task SaveAndCloseAsync() => CloseAsync();   // commit zaten oldu

    private async Task DeleteAsync()
    {
        if (_isNew) return;   // onay EntityEditForm'da soruldu → buraya yalnız onaylanınca gelinir
        try
        {
            await _coordinator!.DeleteAsync(_model.Id);
            UiService.ShowSuccessToast(L["SuccessfullyDeleted"].Value);
            await OnSaved.InvokeAsync();   // listeyi tazele
            await CloseAsync();
        }
        catch (Exception ex)
        {
            UiService.ShowErrorToast(ex.Message);   // form açık kalır
        }
    }

    private Task CloseAsync() => OnClosed.InvokeAsync();
}



