@using Integration.TradeXpress.Blazor.Client.Pages.Vaults.Models
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Branches
@using Microsoft.Extensions.Localization
@using DevExpress.Blazor
@inject IBranchAppService BranchAppService

<DxFormLayout Data="@Model" CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        @* 1. Kod — yarım satır (yalnız) *@
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" @ref="_nameBox" />
        </DxFormLayoutItem>
        @* 2. Adı — tam satır *@
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" />
        </DxFormLayoutItem>
        @* Ara: Şube (üst entity, düzenlemede değişmez) — tam satır *@
        <DxFormLayoutItem Caption="@($"{L["Entity:Branch"]} *")" ColSpanMd="12">
            <DxComboBox Data="@_branches" @bind-Value="@Model.BranchId"
                        ValueFieldName="@nameof(BranchListDto.Id)"
                        TextFieldName="@nameof(BranchListDto.Code)"
                        ValidationEnabled="false"
                        Enabled="@(Model.Id == Guid.Empty)"
                        CssClass="w-100" />
            @if (Model.Id != Guid.Empty)
            {
                <div class="form-text text-muted small">@L["ParentImmutableHint"]</div>
            }
        </DxFormLayoutItem>
        @* Ara: Varsayılan kasa — yarım satır *@
        <DxFormLayoutItem Caption="@L["IsDefault"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsDefault" CheckType="CheckType.Switch">
                @(Model.IsDefault ? L["Yes"] : L["No"])
            </DxCheckBox>
            <div class="form-text text-muted small">@L["VaultDefaultHint"]</div>
        </DxFormLayoutItem>
        @* Sondan bir önceki: Açıklama — tam satır, DxMemo 2 satır, resize kapalı *@
        <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        @* Son satır: Durum (Status) yarım + Sıra (DisplayOrder) yarım *@
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
                @(Model.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
            <DxSpinEdit @bind-Value="@Model.DisplayOrder" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@code {
    [Parameter, EditorRequired] public VaultViewModel Model { get; set; } = default!;
    [Parameter, EditorRequired] public IStringLocalizer L { get; set; } = default!;

    private DxTextBox? _nameBox;
    private List<BranchListDto> _branches = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await BranchAppService.GetListAsync(new BranchListRequestDto { MaxResultCount = 1000 });
        _branches = result.Items.ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _nameBox != null)
            await _nameBox.FocusAsync();
    }
}
