@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Trendyol kategori senkronizasyon paneli — kayıtlı kanalın kimliğiyle host-global kategori ağacını Trendyol'dan
   çekip yerel DB'ye upsert eder (pazaryerine SIFIR yazma; salt GET). Yalnız kaydedilmiş kanalda gösterilir.
   Kategori picker'ı bu ağaçtan okur; sync edilmezse boş kalır → bu buton onu doldurur. *@

<div class="mt-3">
    <DxButton Text="@L["Trendyol:Category:Sync"]"
              IconCssClass="@TradeXpressIcons.Refresh"
              RenderStyle="ButtonRenderStyle.Secondary"
              Enabled="@(!_syncing)"
              Click="@SyncAsync" />
</div>
