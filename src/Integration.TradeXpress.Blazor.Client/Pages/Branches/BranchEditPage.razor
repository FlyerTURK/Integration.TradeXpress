@using System.Linq
@using Integration.TradeXpress.Blazor.Client.Pages.Branches.Models
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Companies
@using Integration.Framework.Blazor.Client.Services.Base
@using DevExpress.Blazor
@inject Microsoft.Extensions.Localization.IStringLocalizer<Integration.TradeXpress.Localization.TradeXpressResource> L
@inject ICompanyAppService CompanyAppService

<DxFormLayout Data="@Model" CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@($"{L["Entity:Company"]} *")" ColSpanMd="6">
            <DxComboBox Data="@Companies" @bind-Value="@Model.CompanyId"
                        ValueFieldName="@nameof(CompanyListDto.Id)"
                        TextFieldName="@nameof(CompanyListDto.Name)"
                        ValidationEnabled="false"
                        Enabled="@StateService.IsNewRecord"
                        CssClass="w-100" />
            @if (!StateService.IsNewRecord)
            {
                <div class="form-text text-muted small">@L["ParentImmutableHint"]</div>
            }
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Name" @ref="_nameBox" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Description" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    <DxFormLayoutGroup Caption="@L["Settings"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@L["IsHeadquarters"]" ColSpanMd="4">
            <DxCheckBox @bind-Checked="@Model.IsHeadquarters" CheckType="CheckType.Switch">
                @(Model.IsHeadquarters ? L["Yes"] : L["No"])
            </DxCheckBox>
            <div class="form-text text-muted small">@L["BranchHeadquartersHint"]</div>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["IsActive"]" ColSpanMd="4">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
                @(Model.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="4">
            <DxSpinEdit @bind-Value="@Model.DisplayOrder" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@code {
    [Parameter, EditorRequired] public BranchViewModel Model { get; set; } = default!;
    [Parameter, EditorRequired] public ICrudStateService<BranchGetDto, BranchListDto, Guid, BranchViewModel> StateService { get; set; } = default!;

    private DxTextBox? _nameBox;
    private List<CompanyListDto> Companies { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var companies = await CompanyAppService.GetListAsync(new CompanyListRequestDto { MaxResultCount = 1000 });
        Companies = companies.Items.ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _nameBox != null)
            await _nameBox.FocusAsync();
    }
}
