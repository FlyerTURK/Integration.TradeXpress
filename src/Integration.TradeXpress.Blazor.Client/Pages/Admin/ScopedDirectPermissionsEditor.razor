@using Integration.TradeXpress.Localization
@using Integration.TradeXpress.Companies
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Blazor.Client.Services
@using Volo.Abp.Application.Dtos
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Two-pane editor:
   Top    — grid of scope coordinates where the user has direct permission grants.
            Toolbar: Ekle (add scope), Sil (delete scope). Single-row selection.
   Bottom — Permission editor for the SELECTED scope. *@

<div class="scoped-direct-permissions-editor">

    @if (_loading)
    {
        <p>@L["Loading"]</p>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <DxGrid @ref="Grid"
                Data="_scopeRows"
                SelectionMode="GridSelectionMode.Single"
                PageSize="10">
            <DxGridDataColumn FieldName="CompanyCode" Caption="@L["Company"]" />
            <DxGridDataColumn FieldName="BranchCode" Caption="@L["Branch"]" />
            <DxGridDataColumn FieldName="VaultCode" Caption="@L["Vault"]" />
            <DxGridDataColumn FieldName="GrantedCount" Caption="@L["Permissions"]" Width="80px" />
            <DxGridCommandColumn Width="80px">
                <DxGridCommandColumnItem Command="Delete" Click="@(async () => await DeleteScopeAsync(SelectedRow))" />
            </DxGridCommandColumn>
        </DxGrid>

        <div class="mt-2">
            <DxButton Text="@L["Add"]" RenderStyle="ButtonRenderStyle.Primary" Click="ShowAddPopupAsync" />
        </div>

        @if (SelectedRow != null)
        {
            <div class="mt-4 pt-3" style="border-top: 1px solid #e0e0e0;">
                <h5>@L["DirectPermissions"] - @FormatScopeLabel(SelectedRow)</h5>
                <p style="color: #666; font-style: italic;">@L["PermissionManagementPending"]</p>
            </div>
        }
        else
        {
            <div class="mt-4" style="color: #666; font-style: italic;">
                @L["SelectRowToManagePermissions"]
            </div>
        }
    }

</div>

<DxPopup @bind-Visible="_showAddPopup" HeaderText="@L["AddScope"]" AllowDrag="true" ShowFooter="false">
    <DxFormLayout>
        <DxFormLayoutItem Caption="@L["Company"]" ColSpanMd="12">
            <DxComboBox Data="Companies"
                        @bind-Value="AddCompanyId"
                        @bind-Value:after="OnAddCompanyChangedAsync"
                        ValueFieldName="Id"
                        TextFieldName="Code"
                        NullText="@L["All"]"
                        AllowUserInput="false" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="@L["Branch"]" ColSpanMd="12">
            <DxComboBox Data="FilteredBranches"
                        @bind-Value="AddBranchId"
                        @bind-Value:after="OnAddBranchChangedAsync"
                        ValueFieldName="Id"
                        TextFieldName="Code"
                        NullText="@L["All"]"
                        AllowUserInput="false"
                        Enabled="@(AddCompanyId.HasValue)" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="@L["Vault"]" ColSpanMd="12">
            <DxComboBox Data="FilteredVaults"
                        @bind-Value="AddVaultId"
                        ValueFieldName="Id"
                        TextFieldName="Code"
                        NullText="@L["All"]"
                        AllowUserInput="false"
                        Enabled="@(AddBranchId.HasValue)" />
        </DxFormLayoutItem>
    </DxFormLayout>

    <div class="popup-footer mt-3">
        <DxButton Text="@L["Save"]" RenderStyle="ButtonRenderStyle.Primary" Click="SaveScopeAsync" />
        <DxButton Text="@L["Cancel"]" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _showAddPopup = false)" />
    </div>
</DxPopup>

@code {
    [Parameter, EditorRequired] public Guid UserId { get; set; }

    [Parameter] public EventCallback OnDirty { get; set; }

    private DxGrid Grid { get; set; } = default!;
    private bool _loading = true;
    private string? _error;

    private List<ScopeRowDto> _scopeRows = new();
    private ScopeRowDto? SelectedRow { get; set; }

    private bool _showAddPopup;
    private List<CompanyListDto> Companies = new();
    private List<BranchListDto> AllBranches = new();
    private List<VaultListDto> AllVaults = new();

    private Guid? AddCompanyId { get; set; }
    private Guid? AddBranchId { get; set; }
    private Guid? AddVaultId { get; set; }

    private List<BranchListDto> FilteredBranches => AddCompanyId.HasValue
        ? AllBranches.Where(b => b.CompanyId == AddCompanyId.Value).ToList()
        : new();

    private List<VaultListDto> FilteredVaults => AddBranchId.HasValue
        ? AllVaults.Where(v => v.BranchId == AddBranchId.Value).ToList()
        : new();

    [Inject]
    protected ICompanyAppService CompanyAppService { get; set; } = default!;

    [Inject]
    protected IBranchAppService BranchAppService { get; set; } = default!;

    [Inject]
    protected IVaultAppService VaultAppService { get; set; } = default!;

    [Inject]
    protected Integration.Framework.Blazor.Client.Services.Base.ITradeXpressUiService UiService { get; set; } = default!;

    protected override void OnInitialized()
    {
        LocalizationResource = typeof(TradeXpressResource);
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await base.OnInitializedAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var companiesResult = await CompanyAppService.GetListAsync(new CompanyListRequestDto { MaxResultCount = 200 });
            Companies = companiesResult.Items.ToList();

            var branchesResult = await BranchAppService.GetListAsync(new BranchListRequestDto { MaxResultCount = 500 });
            AllBranches = branchesResult.Items.ToList();

            var vaultsResult = await VaultAppService.GetListAsync(new VaultListRequestDto { MaxResultCount = 500 });
            AllVaults = vaultsResult.Items.ToList();

            // TODO: Load user's scoped direct permission assignments
            _scopeRows = new List<ScopeRowDto>();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            LogError(ex, "Error loading scoped direct permissions data");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ShowAddPopupAsync()
    {
        AddCompanyId = null;
        AddBranchId = null;
        AddVaultId = null;
        _showAddPopup = true;
    }

    private async Task OnAddCompanyChangedAsync()
    {
        AddBranchId = null;
        AddVaultId = null;
    }

    private async Task OnAddBranchChangedAsync()
    {
        AddVaultId = null;
    }

    private async Task SaveScopeAsync()
    {
        try
        {
            // Check for duplicates
            if (_scopeRows.Any(r => r.CompanyId == AddCompanyId && r.BranchId == AddBranchId && r.VaultId == AddVaultId))
            {
                UiService.ShowErrorToast(L["DuplicateScopeAssignment"]);
                return;
            }

            var newRow = new ScopeRowDto
            {
                CompanyId = AddCompanyId,
                CompanyCode = AddCompanyId.HasValue ? Companies.FirstOrDefault(c => c.Id == AddCompanyId.Value)?.Code : null,
                BranchId = AddBranchId,
                BranchCode = AddBranchId.HasValue ? AllBranches.FirstOrDefault(b => b.Id == AddBranchId.Value)?.Code : null,
                VaultId = AddVaultId,
                VaultCode = AddVaultId.HasValue ? AllVaults.FirstOrDefault(v => v.Id == AddVaultId.Value)?.Code : null,
                GrantedCount = 0
            };

            _scopeRows.Add(newRow);
            _showAddPopup = false;
            UiService.ShowSuccessToast(L["SuccessfullySaved"]);

            if (OnDirty.HasDelegate)
                await OnDirty.InvokeAsync();
        }
        catch (Exception ex)
        {
            LogError(ex, "Error saving scope");
            UiService.ShowErrorToast(ex.Message);
        }
    }

    private async Task DeleteScopeAsync(ScopeRowDto? row)
    {
        if (row == null) return;

        var result = await UiService.ConfirmDeleteAsync(L["DeleteConfirmationMessage"]);
        if (result != Integration.Framework.Blazor.Client.Services.Base.ConfirmDialogResult.Yes)
            return;

        try
        {
            _scopeRows.Remove(row);
            if (ReferenceEquals(SelectedRow, row))
                SelectedRow = null;

            UiService.ShowSuccessToast(L["SuccessfullyDeleted"]);

            if (OnDirty.HasDelegate)
                await OnDirty.InvokeAsync();
        }
        catch (Exception ex)
        {
            LogError(ex, "Error deleting scope");
            UiService.ShowErrorToast(ex.Message);
        }
    }

    private string FormatScopeLabel(ScopeRowDto row)
    {
        var parts = new[] { row.CompanyCode, row.BranchCode, row.VaultCode }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        return string.Join(" / ", parts);
    }

    public async Task CommitChangesAsync()
    {
        // TODO: Persist all pending changes to backend
        await Task.CompletedTask;
    }

    private void LogError(Exception ex, string message)
    {
        if (Logger != null)
        {
            Logger.LogError(ex, message);
        }
    }

    public class ScopeRowDto
    {
        public Guid? CompanyId { get; set; }
        public string? CompanyCode { get; set; }
        public Guid? BranchId { get; set; }
        public string? BranchCode { get; set; }
        public Guid? VaultId { get; set; }
        public string? VaultCode { get; set; }
        public int GrantedCount { get; set; }
    }
}
