@using Integration.TradeXpress.Localization
@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Contained mode: item'lar çerçeveli buton olarak render edilir → RenderStyle.Primary GERÇEK
   yüzey rengi verir (Plain modda yalnız metni boyuyordu). Kaydet primary yüzey; diğerleri
   varsayılan (secondary) yüzey. Kaydet ve Kapat ayrı ▾ dropdown'da (BeginGroup).
   Sil her zaman görünür (yeni kayıtta CanDelete=false → pasif), Yenile her zaman görünür.
   8px sol/sağ padding için dış div. *@
<div style="padding-left:8px; padding-right:8px;">
    <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Contained"
               AdaptivityAutoHideRootItems="true"
               AdaptivityAutoCollapseItemsToIcons="true"
               AdaptivityMinRootItemCount="1">

        @* ── Kaydet ── *@
        <DxToolbarItem Text="@L["Save"]"
                       RenderStyle="ButtonRenderStyle.Primary"
                        IconUrl="/images/xaf/action_save.svg"
                       IconCssClass="xaf-toolbar-item-icon"
                       Enabled="@CanSave"
                       Click="@((ToolbarItemClickEventArgs e) => OnSave.InvokeAsync())" />

        @* ── Kaydet ve Yeni ▾ (split button) — XAF kalıbı: DxToolbarItem.SplitDropDownButton.
             Ana tıklama = Kaydet ve Yeni; ok dropdown'ı = yalnız Kaydet ve Kapat. BeginGroup ile ayrı.
             ShowSaveAndNew=false ise gruptan tek aksiyon (Kaydet ve Kapat) kalır → XAF gibi DÜZ butona iner. ── *@
        @if (ShowSaveAndNew)
        {
            <DxToolbarItem Text="@L["SaveAndNew"]"
                           IconUrl="/images/xaf/action_save_new.svg"
                           IconCssClass="xaf-toolbar-item-icon"
                           SplitDropDownButton="true"
                           BeginGroup="true"
                           Enabled="@CanSave"
                           Click="@((ToolbarItemClickEventArgs e) => OnSaveAndNew.InvokeAsync())">
                <Items>
                    <DxToolbarItem Text="@L["SaveAndClose"]"
                                   IconCssClass="fas fa-circle-check xaf-toolbar-item-icon"
                                   Enabled="@CanSave"
                                   Click="@((ToolbarItemClickEventArgs e) => OnSaveAndClose.InvokeAsync())" />
                </Items>
            </DxToolbarItem>
        }
        else
        {
            <DxToolbarItem Text="@L["SaveAndClose"]"
                           IconCssClass="fas fa-circle-check xaf-toolbar-item-icon"
                           BeginGroup="true"
                           Enabled="@CanSave"
                           Click="@((ToolbarItemClickEventArgs e) => OnSaveAndClose.InvokeAsync())" />
        }

        @* ── Sil (yeni kayıtta pasif) ── *@
        @if (ShowDelete)
        {
            <DxToolbarItem Text="@L["Delete"]" BeginGroup="true"
                           IconUrl="/images/xaf/action_delete.svg"
                           IconCssClass="xaf-toolbar-item-icon"
                           Enabled="@CanDelete"
                           Click="@((ToolbarItemClickEventArgs e) => OnDelete.InvokeAsync())" />
        }

        @* ── Yenile ── *@
        @if (ShowRefresh)
        {
            <DxToolbarItem Tooltip="@L["Refresh"]" BeginGroup="true"
                           IconUrl="/images/xaf/action_refresh.svg"
                           IconCssClass="xaf-toolbar-item-icon"
                           Click="@((ToolbarItemClickEventArgs e) => OnRefresh.InvokeAsync())" />
        }

    </DxToolbar>
</div>

@code {
    // Kaydet grubu
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnSaveAndNew { get; set; }
    [Parameter] public EventCallback OnSaveAndClose { get; set; }
    [Parameter] public bool ShowSaveAndNew { get; set; } = true;
    [Parameter] public bool CanSave { get; set; } = true;

    // Sil — her zaman görünür; yeni kayıtta CanDelete=false ile pasif.
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public bool ShowDelete { get; set; } = true;
    [Parameter] public bool CanDelete { get; set; } = true;

    // Yenile — her zaman görünür.
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public bool ShowRefresh { get; set; } = true;

    protected override void OnInitialized()
    {
        LocalizationResource = typeof(TradeXpressResource);
        base.OnInitialized();
    }
}
