@page "/admin/roles/new"
@page "/admin/roles/{Id:guid}"
@using System
@using Integration.TradeXpress.Blazor.Client.Pages.Admin.Models
@using Integration.TradeXpress.Blazor.Client.Services
@using Integration.TradeXpress.Blazor.Client.Services.Identity
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject RoleCrudAdapter RoleAdapter
@inject IObjectMapper Mapper

@*
   Role edit host = İNCE SARMAL: coordinator (RoleCrudAdapter üstünden) + İZİN PANELİ kancaları.
   İzin paneli Role DTO'sunun parçası DEĞİL → ayrı servise yazılır:
     • HasExtraChanges → panel dirty'sini Kaydet/"*"/kapanış-onayına dahil et (extra-dirty).
     • OnAfterCommit → rol kaydedildikten SONRA (ProviderKey=Name artık geçerli) panel izinleri yazar (extra-commit).
   Statik (sistem) rol silinemez. Üst-seviye entity → @page (TAB; izin ağacı için ferah). Liste EntityChanges ile tazelenir.
*@
@if (_coordinator != null)
{
    <CrudEditHost TGetDto="RoleGetDto" TListDto="RoleListDto" TKey="Guid" TListRequestDto="RoleListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode"
                  OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["Role"].Value" IconCssClass="@TradeXpressIcons.Role"
                  EntityValue="@(m => m.Name)"
                  EntityChangeKey="@IdentityViewKeys.Roles"
                  CanDelete="@(m => !m.IsStatic)"
                  HasExtraChanges="@(() => _panel?.IsDirty == true)"
                  OnAfterCommit="@CommitPermissionsAsync">
        <RoleLayout Model="@context" PanelRefChanged="@OnPanelRef" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private ICommitCoordinator<RoleGetDto, RoleListDto, Guid, RoleListRequestDto>? _coordinator;
    private PermissionEditorPanel? _panel;   // RoleLayout'tan iletilen aktif izin paneli (Name dolunca var/null)

    protected override void OnInitialized()
        => _coordinator = new PersistentCoordinator<RoleGetDto, RoleListDto, Guid, RoleListRequestDto, CreateIdentityRoleInput, UpdateIdentityRoleInput>(
            RoleAdapter, Mapper);

    private void OnPanelRef(PermissionEditorPanel? p) => _panel = p;

    // Extra-commit: rol kaydedildikten sonra izinler artık var olan rolün adına (ProviderKey=Name) yazılır.
    private async Task CommitPermissionsAsync(RoleGetDto saved)
    {
        if (_panel != null)
            await _panel.CommitChangesAsync();
    }
}
