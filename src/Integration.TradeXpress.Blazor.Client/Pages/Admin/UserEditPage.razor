@using Integration.TradeXpress.Localization
@using Integration.TradeXpress.Blazor.Client.Services
@using Integration.TradeXpress.Blazor.Client.Services.Identity
@using Integration.TradeXpress.Blazor.Client.Pages.Admin.Models
@using Volo.Abp.Application.Dtos
@using DevExpress.Blazor
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Services.Mdi
@using Microsoft.AspNetCore.Components

@inject UserCrudAdapter UserAdapter
@inject ITabManager TabManager

@inherits CrudEditComponentBase<UserGetDto, UserListDto, Guid, UserListRequestDto, CreateIdentityUserInput, UpdateIdentityUserInput>

<CrudEditShell TGetDto="UserGetDto" TListDto="UserListDto" TKey="Guid"
               IsPopupMode="@IsPopupMode" EditContext="@EditContext" EditController="@this">
    @RenderForm()
</CrudEditShell>

@code {
    private ScopedRolesEditor? ScopedRolesEditor { get; set; }
    private PermissionEditorPanel? PermissionEditor { get; set; }

    // İzin paneli EditModel'e yansımaz; dirty'sini forma dahil et (Kaydet aktif + "*" + ayrılma onayı).
    // (ScopedRolesEditor değişince kendi kendine kaydeder → dirty'ye dahil değil.)
    protected override bool HasExtraChanges => PermissionEditor?.IsDirty == true;
    private void OnPermissionsDirtyChanged(bool _) => NotifyDirtyChanged();

    private RenderFragment RenderForm() => @<text>
<DxFormLayout CssClass="w-100">
    @* Kullanıcı adı — anahtar alan: yalnız, yarım satır (yeni kayıtta düzenlenebilir). *@
    <DxFormLayoutItem Caption="@($"{L["UserName"]} *")" ColSpanMd="6">
        <DxTextBox @bind-Text="EditModel.UserName" BindValueMode="BindValueMode.OnInput" Enabled="@IsNewMode" />
    </DxFormLayoutItem>
    <DxFormLayoutItem ColSpanMd="6"><Template></Template></DxFormLayoutItem>

    @* Ad + Soyad — yan yana yarımlar. *@
    <DxFormLayoutItem Caption="@L["Name"]" ColSpanMd="6">
        <DxTextBox @bind-Text="EditModel.Name" BindValueMode="BindValueMode.OnInput" />
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="@L["Surname"]" ColSpanMd="6">
        <DxTextBox @bind-Text="EditModel.Surname" BindValueMode="BindValueMode.OnInput" />
    </DxFormLayoutItem>

    @* E-posta + Telefon — yan yana yarımlar. *@
    <DxFormLayoutItem Caption="@L["Email"]" ColSpanMd="6">
        <DxTextBox @bind-Text="EditModel.Email" BindValueMode="BindValueMode.OnInput" />
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="@L["PhoneNumber"]" ColSpanMd="6">
        <DxTextBox @bind-Text="EditModel.PhoneNumber" BindValueMode="BindValueMode.OnInput" />
    </DxFormLayoutItem>

    @if (IsNewMode)
    {
        <DxFormLayoutItem Caption="@L["Password"]" ColSpanMd="6">
            <DxTextBox @bind-Text="EditModel.Password" BindValueMode="BindValueMode.OnInput" Password="true" />
        </DxFormLayoutItem>
    }

    @* Son satır: Durum (switch) — yarım. *@
    <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
        <DxCheckBox @bind-Checked="EditModel.IsActive" CheckType="CheckType.Switch" />
    </DxFormLayoutItem>
</DxFormLayout>

@if (!IsNewMode)
{
    <div class="mt-4">
        <DxTabs>
            <DxTabPage Text="@L["Permissions"]">
                <PermissionEditorPanel @ref="PermissionEditor" ProviderName="U" ProviderKey="@Id.ToString()" Embedded="true" DirtyChanged="OnPermissionsDirtyChanged" />
            </DxTabPage>
            <DxTabPage Text="@L["ScopedRoles"]">
                <ScopedRolesEditor @ref="ScopedRolesEditor" UserId="Id" />
            </DxTabPage>
        </DxTabs>
    </div>
}
</text>;

    protected override Volo.Abp.Application.Services.ICrudAppService<
        UserGetDto, UserListDto, Guid, UserListRequestDto, CreateIdentityUserInput, UpdateIdentityUserInput> CrudAppService => UserAdapter;

    protected override string EntityChangeKey => IdentityViewKeys.Users;

    protected override void OnInitialized()
    {
        LocalizationResource = typeof(TradeXpressResource);
        base.OnInitialized();
    }

    public override async Task<bool> SaveAsync()
    {
        var saved = await base.SaveAsync();
        if (saved && !IsNewMode)
        {
            if (PermissionEditor != null) await PermissionEditor.CommitChangesAsync();
            // ScopedRolesEditor auto-saves when changed, no commit needed.
        }
        return saved;
    }

    public override async Task CloseAsync()
    {
        if (!IsPopupMode && CurrentMdiTab != null)
        {
            TabManager.Close(CurrentMdiTab.Id);
        }
        else
        {
            await base.CloseAsync();
        }
    }
}



