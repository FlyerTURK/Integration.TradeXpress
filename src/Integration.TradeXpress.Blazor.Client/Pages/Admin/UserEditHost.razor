@page "/admin/users/new"
@page "/admin/users/{Id:guid}"
@using System
@using System.Collections.Generic
@using Integration.TradeXpress.Blazor.Client.Pages.Admin.Models
@using Integration.TradeXpress.Blazor.Client.Services
@using Integration.TradeXpress.Blazor.Client.Services.Identity
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject UserCrudAdapter UserAdapter
@inject IObjectMapper Mapper

@*
   User edit host = İNCE SARMAL: coordinator (UserCrudAdapter üstünden) + İZİN PANELİ kancaları.
   İzin paneli User DTO'sunun parçası DEĞİL → ayrı servise yazılır:
     • HasExtraChanges → panel dirty'sini Kaydet/"*"/kapanış-onayına dahil et (extra-dirty).
     • OnAfterCommit → kullanıcı kaydedildikten SONRA (ProviderKey=Id artık geçerli) panel izinleri yazar (extra-commit).
   ScopedRolesEditor de aynı kanca: inline stage edilir, extra-dirty + OnAfterCommit'te DB'ye yazılır. Yeni kullanıcı: şifre zorunlu (ValidateContext),
   IsActive=true default (ApplyNewDefaults). Üst-seviye entity → @page (TAB; izin ağacı için ferah). Liste EntityChanges ile tazelenir.
*@
@if (_coordinator != null)
{
    <CrudEditHost TGetDto="UserGetDto" TListDto="UserListDto" TKey="Guid" TListRequestDto="UserListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode"
                  OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["User"].Value" IconCssClass="@TradeXpressIcons.User"
                  EntityValue="@(m => m.UserName)"
                  EntityChangeKey="@IdentityViewKeys.Users"
                  ApplyNewDefaults="@(m => m.IsActive = true)"
                  ValidateContext="@ValidatePassword"
                  HasExtraChanges="@(() => _panel?.IsDirty == true || _scopedEditor?.IsDirty == true)"
                  OnAfterCommit="@CommitExtrasAsync">
        <UserLayout Model="@context" PanelRefChanged="@OnPanelRef" ScopedEditorRefChanged="@OnScopedRef" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private ICommitCoordinator<UserGetDto, UserListDto, Guid, UserListRequestDto>? _coordinator;
    private PermissionEditorPanel? _panel;   // UserLayout'tan iletilen aktif izin paneli (var olan kullanıcıda var/null)
    private ScopedRolesEditor? _scopedEditor; // UserLayout'tan iletilen scoped rol editörü (var olan kullanıcıda var/null)

    protected override void OnInitialized()
        => _coordinator = new PersistentCoordinator<UserGetDto, UserListDto, Guid, UserListRequestDto, CreateIdentityUserInput, UpdateIdentityUserInput>(
            UserAdapter, Mapper);

    private void OnPanelRef(PermissionEditorPanel? p) => _panel = p;
    private void OnScopedRef(ScopedRolesEditor? e) => _scopedEditor = e;

    // Yeni kullanıcıda şifre zorunlu (model attribute DEĞİL — mevcut kullanıcıda boş geçilir). Server otoritesi ek doğrular.
    private IReadOnlyList<KeyValuePair<string, string>> ValidatePassword(UserGetDto m)
        => m.Id == Guid.Empty && string.IsNullOrWhiteSpace(m.Password)
            ? new[] { new KeyValuePair<string, string>(nameof(UserGetDto.Password), L["Validation:Required", L["Password"]].Value) }
            : Array.Empty<KeyValuePair<string, string>>();

    // Extra-commit: kullanıcı kaydedildikten sonra izinler (ProviderKey=Id artık geçerli) + scoped rol atamaları yazılır.
    private async Task CommitExtrasAsync(UserGetDto saved)
    {
        if (_panel != null)
            await _panel.CommitChangesAsync();
        if (_scopedEditor != null)
            await _scopedEditor.CommitChangesAsync();
    }
}
