@using Integration.TradeXpress.Localization
@using Integration.TradeXpress.Blazor.Client.Services
@using Integration.TradeXpress.Blazor.Client.Services.Identity
@using Integration.TradeXpress.Blazor.Client.Pages.Admin.Models
@using Volo.Abp.Application.Dtos
@using DevExpress.Blazor
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Services.Mdi
@using Microsoft.AspNetCore.Components

@inject RoleCrudAdapter RoleAdapter
@inject ITabManager TabManager

@inherits CrudEditComponentBase<RoleGetDto, RoleListDto, Guid, RoleListRequestDto, CreateIdentityRoleInput, UpdateIdentityRoleInput>

<CrudEditShell TGetDto="RoleGetDto" TListDto="RoleListDto" TKey="Guid"
               IsPopupMode="@IsPopupMode" EditContext="@EditContext" EditController="@this">
    @RenderForm()
</CrudEditShell>

@code {
    private PermissionEditorPanel? PermissionEditor { get; set; }

    // Static (sistem) rol silinemez — merkezi toolbar Sil butonu bu kurala göre pasifleşir.
    protected override bool CanDeleteRecord => !IsNewMode && !EditModel.IsStatic;

    // İzin paneli EditModel'e yansımaz; dirty'sini forma dahil et (Kaydet aktif + "*" + ayrılma onayı).
    protected override bool HasExtraChanges => PermissionEditor?.IsDirty == true;
    private void OnPermissionsDirtyChanged(bool _) => NotifyDirtyChanged();

    private RenderFragment RenderForm() => @<text>
<DxFormLayout CssClass="w-100">
    @* Rol adı — anahtar alan: yalnız, yarım satır (statik rol adı değiştirilemez). *@
    <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="6">
        <DxTextBox @bind-Text="EditModel.Name" BindValueMode="BindValueMode.OnInput" Enabled="@(!EditModel.IsStatic)" />
    </DxFormLayoutItem>
    <DxFormLayoutItem ColSpanMd="6"><Template></Template></DxFormLayoutItem>

    @* Varsayılan + Herkese Açık — yan yana yarımlar. *@
    <DxFormLayoutItem Caption="@L["IsDefault"]" ColSpanMd="6">
        <DxCheckBox @bind-Checked="EditModel.IsDefault" CheckType="CheckType.Switch" />
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="@L["IsPublic"]" ColSpanMd="6">
        <DxCheckBox @bind-Checked="EditModel.IsPublic" CheckType="CheckType.Switch" />
    </DxFormLayoutItem>

    @if (EditModel.IsStatic)
    {
        <DxFormLayoutItem ColSpanMd="12">
            <Template>
                <div style="background:#cff4fc; color:#055160; border:1px solid #b6effb; border-radius:0.375rem; padding:0.5rem 0.75rem;">
                    @L["CannotModifyStaticRole"]
                </div>
            </Template>
        </DxFormLayoutItem>
    }
</DxFormLayout>

@* Ad girilir girilmez izin paneli görünür (yeni rolde de) — toggle'lar Kaydet'te rolle birlikte yazılır. *@
@if (!string.IsNullOrEmpty(EditModel.Name))
{
    <div class="mt-4">
        <DxTabs>
            <DxTabPage Text="@L["Permissions"]">
                <PermissionEditorPanel @ref="PermissionEditor"
                                       ProviderName="R"
                                       ProviderKey="@EditModel.Name"
                                       Embedded="true"
                                       DirtyChanged="OnPermissionsDirtyChanged" />
            </DxTabPage>
        </DxTabs>
    </div>
}
</text>;

    protected override Volo.Abp.Application.Services.ICrudAppService<
        RoleGetDto, RoleListDto, Guid, RoleListRequestDto, CreateIdentityRoleInput, UpdateIdentityRoleInput> CrudAppService => RoleAdapter;

    protected override string EntityChangeKey => IdentityViewKeys.Roles;

    protected override void OnInitialized()
    {
        LocalizationResource = typeof(TradeXpressResource);
        base.OnInitialized();
    }

    public override async Task<bool> SaveAsync()
    {
        // base.SaveAsync yeni rolde önce rolü oluşturur (Id set, IsNewMode→false); ardından izinler
        // artık var olan rolün adına (ProviderKey = EditModel.Name) yazılır → tek akışta birlikte kaydedilir.
        var saved = await base.SaveAsync();
        if (saved && PermissionEditor != null)
        {
            await PermissionEditor.CommitChangesAsync();
        }
        return saved;
    }

    public override async Task CloseAsync()
    {
        if (!IsPopupMode && CurrentMdiTab != null)
        {
            TabManager.Close(CurrentMdiTab.Id);
        }
        else
        {
            await base.CloseAsync();
        }
    }
}



