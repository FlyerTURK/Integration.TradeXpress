@using Integration.TradeXpress.Localization
@using Integration.TradeXpress.Companies
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Authorization
@using Integration.TradeXpress.Blazor.Client.Services
@using Volo.Abp.Application.Dtos
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

<div class="scoped-roles-editor">
    <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Contained">
        <DxToolbarItem BeginGroup="true">
            <Template>
                <DxComboBox Data="AvailableRoles" @bind-Value="SelectedRoleId"
                            ValueFieldName="Id" TextFieldName="Name"
                            NullText="@L["Role"]" Width="170px" />
            </Template>
        </DxToolbarItem>
        <DxToolbarItem>
            <Template>
                <DxComboBox TData="CompanyListDto" TValue="Guid?" Data="Companies"
                            Value="@SelectedCompanyId" ValueChanged="@((Guid? v) => OnCompanyChanged(v))"
                            ValueFieldName="Id" TextFieldName="Name"
                            NullText="@L["Company"]" Width="170px" ValidationEnabled="false"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </Template>
        </DxToolbarItem>
        <DxToolbarItem>
            <Template>
                <DxComboBox TData="BranchListDto" TValue="Guid?" Data="FilteredBranches"
                            Value="@SelectedBranchId" ValueChanged="@((Guid? v) => OnBranchChanged(v))"
                            ValueFieldName="Id" TextFieldName="Name"
                            NullText="@L["Branch"]" Width="170px"
                            Enabled="@(SelectedCompanyId.HasValue)" ValidationEnabled="false"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </Template>
        </DxToolbarItem>
        <DxToolbarItem>
            <Template>
                <DxComboBox Data="FilteredVaults" @bind-Value="SelectedVaultId"
                            ValueFieldName="Id" TextFieldName="Name"
                            NullText="@L["Vault"]" Width="170px"
                            Enabled="@(SelectedBranchId.HasValue)"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </Template>
        </DxToolbarItem>

        <DxToolbarItem Text="@L["Add"]" IconCssClass="custom-icon-add"
                       Enabled="@CanAdd" Click="AddAsync"
                       Alignment="ToolbarItemAlignment.Right" />
        <DxToolbarItem Text="@L["Delete"]" IconCssClass="custom-icon-delete"
                       Enabled="@(SelectedRole != null)" Click="DeleteSelected"
                       Alignment="ToolbarItemAlignment.Right" />
    </DxToolbar>

    <table style="width:100%; border-collapse:collapse; margin-top:.5rem; font-size:.9rem;">
        <thead>
            <tr style="text-align:left; border-bottom:2px solid #dee2e6;">
                <th style="padding:6px 10px;">@L["Role"]</th>
                <th style="padding:6px 10px;">@L["Company"]</th>
                <th style="padding:6px 10px;">@L["Branch"]</th>
                <th style="padding:6px 10px;">@L["Vault"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Roles)
            {
                <tr @key="row" @onclick="@(() => SelectedRole = row)" style="@RowStyle(row)">
                    <td style="padding:6px 10px;">@row.RoleName</td>
                    <td style="padding:6px 10px;">@Dash(row.CompanyCode)</td>
                    <td style="padding:6px 10px;">@Dash(row.BranchCode)</td>
                    <td style="padding:6px 10px;">@Dash(row.VaultCode)</td>
                </tr>
            }
            @if (Roles.Count == 0)
            {
                <tr><td colspan="4" style="padding:10px; color:#888;">@L["NoDataToDisplay"]</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public Guid UserId { get; set; }

    // İzin paneliyle aynı kanca: değişiklikler INLINE stage edilir, kullanıcı formu kaydedince
    // (CrudEditHost.OnAfterCommit) CommitChangesAsync ile DB'ye yazılır. Dirty → Kaydet aktif + "*".
    [Parameter] public EventCallback<bool> DirtyChanged { get; set; }

    private List<ScopedRoleRowVm> Roles { get; set; } = new();
    private readonly List<Guid> _deletedIds = new();   // commit'te silinecek mevcut atama Id'leri

    private List<IdentityRoleDto> AvailableRoles { get; set; } = new();
    private List<CompanyListDto> Companies { get; set; } = new();
    private List<BranchListDto> AllBranches { get; set; } = new();
    private List<VaultListDto> AllVaults { get; set; } = new();

    private ScopedRoleRowVm? SelectedRole { get; set; }
    private Guid? SelectedRoleId { get; set; }
    private Guid? SelectedCompanyId { get; set; }
    private Guid? SelectedBranchId { get; set; }
    private Guid? SelectedVaultId { get; set; }

    // Ekle yalnız Rol + Company seçiliyken aktif (kullanıcı kuralı).
    private bool CanAdd => SelectedRoleId.HasValue && SelectedCompanyId.HasValue;

    // Bekleyen değişiklik = yeni satır (Id boş) ya da silinmiş mevcut satır.
    public bool IsDirty => _deletedIds.Count > 0 || Roles.Any(r => r.Id == Guid.Empty);

    private List<BranchListDto> FilteredBranches => SelectedCompanyId.HasValue
        ? AllBranches.Where(b => b.CompanyId == SelectedCompanyId.Value).ToList()
        : new();

    private List<VaultListDto> FilteredVaults => SelectedBranchId.HasValue
        ? AllVaults.Where(v => v.BranchId == SelectedBranchId.Value).ToList()
        : new();

    [Inject] protected IIdentityRoleService IdentityRoleService { get; set; } = default!;
    [Inject] protected ICompanyAppService CompanyAppService { get; set; } = default!;
    [Inject] protected IBranchAppService BranchAppService { get; set; } = default!;
    [Inject] protected IVaultAppService VaultAppService { get; set; } = default!;
    [Inject] protected IUserScopedGrantAppService GrantService { get; set; } = default!;
    [Inject] protected Integration.Framework.Blazor.Client.Services.Base.ITradeXpressUiService UiService { get; set; } = default!;

    protected override void OnInitialized()
    {
        LocalizationResource = typeof(TradeXpressResource);
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await base.OnInitializedAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var rolesResult = await IdentityRoleService.GetListAsync(new Integration.TradeXpress.Blazor.Client.Services.GetIdentityRolesInput());
            AvailableRoles = rolesResult.Items.ToList();

            var companiesResult = await CompanyAppService.GetListAsync(new CompanyListRequestDto());
            Companies = companiesResult.Items.ToList();

            var branchesResult = await BranchAppService.GetListAsync(new BranchListRequestDto());
            AllBranches = branchesResult.Items.ToList();

            var vaultsResult = await VaultAppService.GetListAsync(new VaultListRequestDto());
            AllVaults = vaultsResult.Items.ToList();

            // Kullanıcının ROL kapsamları (RoleId dolu). Ad/kod yüklü lookup'lardan çözülür.
            var grants = await GrantService.GetByUserAsync(UserId);
            Roles = grants.Where(g => g.RoleId.HasValue).Select(ToRowVm).ToList();
            _deletedIds.Clear();
        }
        catch (Exception ex)
        {
            LogError(ex, "Error loading scoped roles data");
        }
    }

    private void OnCompanyChanged(Guid? value)
    {
        SelectedCompanyId = value;
        SelectedBranchId = null;   // üst değişince alt seçimler sıfırlanır (stale scope önlenir)
        SelectedVaultId = null;
    }

    private void OnBranchChanged(Guid? value)
    {
        SelectedBranchId = value;
        SelectedVaultId = null;
    }

    private async Task AddAsync()
    {
        if (!CanAdd) return;

        var existing = Roles.FirstOrDefault(r =>
            r.RoleId == SelectedRoleId!.Value &&
            r.CompanyId == SelectedCompanyId &&
            r.BranchId == SelectedBranchId &&
            r.VaultId == SelectedVaultId);

        if (existing != null)
        {
            UiService.ShowErrorToast(L["DuplicateRoleAssignment"]);
            return;
        }

        // INLINE stage (Id boş = henüz DB'de değil) — commit'te yazılır.
        Roles.Add(new ScopedRoleRowVm
        {
            Id = Guid.Empty,
            RoleId = SelectedRoleId!.Value,
            RoleName = AvailableRoles.FirstOrDefault(r => r.Id == SelectedRoleId)?.Name ?? string.Empty,
            CompanyId = SelectedCompanyId,
            CompanyCode = Companies.FirstOrDefault(c => c.Id == SelectedCompanyId)?.Code ?? string.Empty,
            BranchId = SelectedBranchId,
            BranchCode = AllBranches.FirstOrDefault(b => b.Id == SelectedBranchId)?.Code ?? string.Empty,
            VaultId = SelectedVaultId,
            VaultCode = AllVaults.FirstOrDefault(v => v.Id == SelectedVaultId)?.Code ?? string.Empty,
        });
        ResetSelection();
        await NotifyDirtyAsync();
    }

    private async Task DeleteSelected()
    {
        var role = SelectedRole;
        if (role == null) return;

        // INLINE stage: mevcut atama ise commit'te silinmek üzere işaretle; yeni (Id boş) ise sadece listeden çıkar.
        if (role.Id != Guid.Empty)
            _deletedIds.Add(role.Id);
        Roles.Remove(role);
        SelectedRole = null;
        await NotifyDirtyAsync();
    }

    private void ResetSelection()
    {
        SelectedRoleId = null;
        SelectedCompanyId = null;
        SelectedBranchId = null;
        SelectedVaultId = null;
    }

    /// <summary>Kullanıcı formu kaydedildikten SONRA çağrılır (CrudEditHost.OnAfterCommit): bekleyen ekle/sil DB'ye.</summary>
    public async Task CommitChangesAsync()
    {
        foreach (var id in _deletedIds.ToList())
            await GrantService.DeleteAsync(id);
        _deletedIds.Clear();

        foreach (var row in Roles.Where(r => r.Id == Guid.Empty).ToList())
        {
            var dto = await GrantService.CreateAsync(new UserScopedGrantCreateDto
            {
                UserId = UserId,
                RoleId = row.RoleId,
                CompanyId = row.CompanyId,
                BranchId = row.BranchId,
                VaultId = row.VaultId,
            });
            row.Id = dto.Id;
        }
        await NotifyDirtyAsync();
    }

    private async Task NotifyDirtyAsync() => await DirtyChanged.InvokeAsync(IsDirty);

    private ScopedRoleRowVm ToRowVm(UserScopedGrantDto g) => new()
    {
        Id = g.Id,
        RoleId = g.RoleId ?? Guid.Empty,
        RoleName = AvailableRoles.FirstOrDefault(r => r.Id == g.RoleId)?.Name ?? string.Empty,
        CompanyId = g.CompanyId,
        CompanyCode = Companies.FirstOrDefault(c => c.Id == g.CompanyId)?.Code ?? string.Empty,
        BranchId = g.BranchId,
        BranchCode = AllBranches.FirstOrDefault(b => b.Id == g.BranchId)?.Code ?? string.Empty,
        VaultId = g.VaultId,
        VaultCode = AllVaults.FirstOrDefault(v => v.Id == g.VaultId)?.Code ?? string.Empty,
    };

    private void LogError(Exception ex, string message) => Logger?.LogError(ex, message);

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private string RowStyle(ScopedRoleRowVm row)
        => "cursor:pointer; border-bottom:1px solid #eee;"
           + (ReferenceEquals(row, SelectedRole) ? " background:#e7f1ff;" : string.Empty);

    public class ScopedRoleRowVm
    {
        public Guid Id { get; set; }
        public Guid RoleId { get; set; }
        public string RoleName { get; set; } = string.Empty;
        public Guid? CompanyId { get; set; }
        public string CompanyCode { get; set; } = string.Empty;
        public Guid? BranchId { get; set; }
        public string BranchCode { get; set; } = string.Empty;
        public Guid? VaultId { get; set; }
        public string VaultCode { get; set; } = string.Empty;
    }
}

