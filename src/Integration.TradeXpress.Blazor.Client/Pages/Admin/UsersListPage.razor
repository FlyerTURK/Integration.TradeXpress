@page "/admin/users"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Pages.Admin.Models
@using Integration.TradeXpress.Blazor.Client.Services
@using DevExpress.Blazor
@inherits CrudPageBase<UserGetDto, UserListDto, Guid, UserListRequestDto, CreateIdentityUserInput, UpdateIdentityUserInput>

<CrudLayout TGetDto="UserGetDto"
            TListDto="UserListDto"
            TViewModel="UserEditViewModel"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["User"]"
            EntityIcon="@TradeXpressIcons.User"
            PageTitle="@L["Users"]"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync"
            CustomActions="@PermissionActions">

    <GridColumns>
        <GridLinkColumn FieldName="UserName" Caption="@L["UserName"]" Width="180px" VisibleIndex="0"
                        OnClick="@(o => BeforeUpdateAsync((UserListDto)o))" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" VisibleIndex="1" />
        <DxGridDataColumn FieldName="Surname" Caption="@L["Surname"]" VisibleIndex="2" />
        <DxGridDataColumn FieldName="Email" Caption="@L["Email"]" VisibleIndex="3" />
        <DxGridDataColumn FieldName="PhoneNumber" Caption="@L["PhoneNumber"]" Width="140px" VisibleIndex="4" />
        @* IsActive kolonu yok — toolbar'da Aktif/Pasif switch filtresi var. *@
    </GridColumns>

</CrudLayout>





