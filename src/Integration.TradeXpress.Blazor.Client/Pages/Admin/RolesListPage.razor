@page "/admin/roles"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Pages.Admin.Models
@using Integration.TradeXpress.Blazor.Client.Services
@using DevExpress.Blazor
@inherits CrudPageBase<RoleGetDto, RoleListDto, Guid, RoleListRequestDto, CreateIdentityRoleInput, UpdateIdentityRoleInput>

<CrudLayout TGetDto="RoleGetDto"
            TListDto="RoleListDto"
            TViewModel="RoleEditViewModel"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["Role"]"
            EntityIcon="@TradeXpressIcons.Role"
            PageTitle="@L["Roles"]"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync"
            CustomActions="@PermissionActions">

    <GridColumns>
        <GridLinkColumn FieldName="Name" Caption="@L["Name"]" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                        OnClick="@(o => BeforeUpdateAsync((RoleListDto)o))" />
        <DxGridDataColumn FieldName="IsDefault" Caption="@L["IsDefault"]" Width="120px" VisibleIndex="1" />
        <DxGridDataColumn FieldName="IsPublic" Caption="@L["IsPublic"]" Width="120px" VisibleIndex="2" />
        <DxGridDataColumn FieldName="IsStatic" Caption="@L["IsStatic"]" Width="120px" VisibleIndex="3" />
    </GridColumns>

</CrudLayout>





