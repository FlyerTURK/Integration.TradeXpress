@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Tek bir N11ShipmentAddressDto için adres formu (SELF-CONTAINED DxFormLayout) — Depo + İade adreslerinde
   yeniden kullanılır. DrillList EditContent'i DxFormLayout sağlamadığından bileşen kendi layout'unu taşır.
   İl seçilince o ilin ilçeleri on-demand yüklenir (IN11CityAppService.GetDistrictsAsync). *@

@* Coğrafya cascade seçici (üstte) — Ülke → İl/Eyalet → İlçe → Mahalle. Seçim aşağıdaki N11 il/ilçe combo'larını
   DOLDURUR (ortak modele yazar) + additive geo-ref'leri taşır. Mevcut CountryCode ile geri yüklenir (callback'siz). *@
<GeographyCascadePicker SelectedCountryCode="@Model.CountryCode"
                        SelectionChanged="@OnGeographySelected" />

<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@GroupCaption" ColSpanMd="12">
        <DxFormLayoutItem Caption="@L["N11Address:Title"]" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Title" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Address:PostalCode"]" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.PostalCode" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@(Required ? $"{L["N11Address:Line"]} *" : L["N11Address:Line"].Value)" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.Line" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@(Required ? $"{L["N11Address:City"]} *" : L["N11Address:City"].Value)" ColSpanMd="6">
            <DxComboBox Data="@Cities"
                        TData="N11CityDto"
                        TValue="string"
                        Value="@Model.CityCode"
                        ValueChanged="@(async (string v) => await OnCityChanged(v))"
                        TextFieldName="@nameof(N11CityDto.Name)"
                        ValueFieldName="@nameof(N11CityDto.CityCode)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        ValidationEnabled="false"
                        CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11Address:District"]" ColSpanMd="6">
            <DxComboBox Data="@_districts"
                        TData="N11DistrictDto"
                        TValue="string"
                        Value="@Model.DistrictCode"
                        ValueChanged="@((string v) => OnDistrictChanged(v))"
                        TextFieldName="@nameof(N11DistrictDto.Name)"
                        ValueFieldName="@nameof(N11DistrictDto.DistrictId)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        ValidationEnabled="false"
                        CssClass="w-100" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>
