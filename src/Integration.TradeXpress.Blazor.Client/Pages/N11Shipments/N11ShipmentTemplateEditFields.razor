@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* N11 kargo şablonu tam edit formu — DrillList EditContent'i içinde açılır. DrillList DxFormLayout SAĞLAMAZ →
   ana alanlar kendi DxFormLayout'unda; adresler self-contained bileşenler (kendi layout'larını taşır).
   Sıra (ui-blazor): ad üstte → tip → bayraklar → memo bilgiler → firmalar/iller → şartlı kargo (read-only) → adresler. *@

<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@($"{L["N11ShipmentTemplate:TemplateName"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.TemplateName" CssClass="w-100" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="@($"{L["N11ShipmentTemplate:DeliveryFeeType"]} *")" ColSpanMd="6">
            <ComboBoxEnumEdit TEnum="N11DeliveryFeeType" L="@L" @bind-Value="@Model.DeliveryFeeType" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["N11ShipmentTemplate:ShipmentMethod"]} *")" ColSpanMd="6">
            <ComboBoxEnumEdit TEnum="N11ShipmentMethod" L="@L" @bind-Value="@Model.ShipmentMethod" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="@L["N11ShipmentTemplate:SpecialDelivery"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.SpecialDelivery" CheckType="CheckType.Switch" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11ShipmentTemplate:CombinedShipmentAllowed"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.CombinedShipmentAllowed" CheckType="CheckType.Switch" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="@($"{L["N11ShipmentTemplate:ShippingInfo"]} *")" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.ShippingInfo" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["N11ShipmentTemplate:ExchangeInfo"]} *")" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.ExchangeInfo" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["N11ShipmentTemplate:InstallmentInfo"]} *")" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.InstallmentInfo" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="@L["N11ShipmentTemplate:CargoAccountNo"]" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.CargoAccountNo" CssClass="w-100" />
        </DxFormLayoutItem>

        <DxFormLayoutItem Caption="@($"{L["N11ShipmentTemplate:ShipmentCompanies"]} *")" ColSpanMd="12">
            <DxTagBox Data="@ShipmentCompanies"
                      TData="N11ShipmentCompanyDto"
                      TValue="string"
                      Values="@Model.ShipmentCompanyExternalIds"
                      ValuesChanged="@((IEnumerable<string> v) => OnCompaniesChanged(v))"
                      ValueFieldName="@nameof(N11ShipmentCompanyDto.ExternalId)"
                      TextFieldName="@nameof(N11ShipmentCompanyDto.Name)"
                      ValidationEnabled="false"
                      CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["N11ShipmentTemplate:ClaimShipmentCompany"]} *")" ColSpanMd="6">
            <DxComboBox Data="@ShipmentCompanies"
                        TData="N11ShipmentCompanyDto"
                        TValue="string"
                        @bind-Value="@Model.ClaimShipmentCompanyExternalId"
                        ValueFieldName="@nameof(N11ShipmentCompanyDto.ExternalId)"
                        TextFieldName="@nameof(N11ShipmentCompanyDto.Name)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        CssClass="w-100" />
        </DxFormLayoutItem>

        @* Şartlı kargo — DÜZENLENEBİLİR (canlı doğrulandı: push ile yazılır). Eşik boş = şartlı kargo yok. *@
        <DxFormLayoutItem Caption="@L["N11ShipmentTemplate:ConditionalShippingThreshold"]" ColSpanMd="6">
            <DxSpinEdit @bind-Value="@Model.ConditionalShippingThreshold" NullText="@L["N11ShipmentTemplate:ConditionalShippingNone"]" MinValue="0" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11ShipmentTemplate:ConditionalShippingUnit"]" ColSpanMd="6">
            <ComboBoxEnumEdit TEnum="N11ConditionalShippingUnit" L="@L" @bind-Value="@Model.ConditionalShippingUnit" />
        </DxFormLayoutItem>

        @* Tahmini kargo maliyeti — YEREL fiyatlama alanı, N11'e GİTMEZ. Bu şablonu kullanan ürünlerin
           reçetesindeki kargo satırı buradan beslenir; boşsa kanalın düz gider değeri kullanılır. *@
        <DxFormLayoutItem Caption="@L["N11ShipmentTemplate:EstimatedCost"]" ColSpanMd="6" BeginRow="true">
            <DxSpinEdit @bind-Value="@Model.EstimatedCost" NullText="@L["N11ShipmentTemplate:EstimatedCostNone"]" MinValue="0" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["N11ShipmentTemplate:EstimatedCostHint"]" ColSpanMd="6">
            <div style="font-size:0.85rem; color:#6c757d; padding-top:6px;">@L["N11ShipmentTemplate:EstimatedCostDescription"]</div>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@* Gönderilecek iller — "Tüm illere gönder" switch + (kapalıysa) checkbox listesi (TagBox yerine). *@
<N11DeliverableCitiesField Model="@Model" Cities="@Cities" />

@* Depo adresi (zorunlu) — kompakt özet + ✎ → popup (paylaşılan AddressFields; ülke SERBEST, N11 push City/İl-kodu okur). *@
<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@($"{L["N11ShipmentTemplate:WarehouseAddress"]} *")" ColSpanMd="12">
        <DxFormLayoutItem ColSpanMd="12">
            <ValueObjectEdit TValue="N11ShipmentAddressDto"
                             Value="@Model.WarehouseAddress"
                             DisplayProjection="@AddressSummary"
                             EmptyPredicate="@IsAddressEmpty"
                             OnEditClick="@OpenWarehouseAddressPopup"
                             PlaceholderText="@L["Address:EditHint"].Value" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@* İade/değişim adresi (zorunlu) — NewItemFactory'de new() init edilir → null olmaz. *@
@if (Model.ExchangeAddress != null)
{
    <DxFormLayout CssClass="w-100">
        <DxFormLayoutGroup Caption="@($"{L["N11ShipmentTemplate:ExchangeAddress"]} *")" ColSpanMd="12">
            <DxFormLayoutItem ColSpanMd="12">
                <ValueObjectEdit TValue="N11ShipmentAddressDto"
                                 Value="@Model.ExchangeAddress"
                                 DisplayProjection="@AddressSummary"
                                 EmptyPredicate="@IsAddressEmpty"
                                 OnEditClick="@OpenExchangeAddressPopup"
                                 PlaceholderText="@L["Address:EditHint"].Value" />
            </DxFormLayoutItem>
        </DxFormLayoutGroup>
    </DxFormLayout>
}

@* Depo/iade özel adres düzenleme popup'ları — body EditContext DIŞINDA render olabilir; AddressFields editörleri
   zaten ValidationEnabled=false (crash yok) + dirty form JSON snapshot ile yakalanır. Ülke SERBEST (FixedCountryId=null). *@
<DxPopup @bind-Visible="@_warehouseAddressPopupVisible" HeaderText="@L["N11ShipmentTemplate:WarehouseAddress"].Value"
         Width="min(95vw, 720px)" CloseOnOutsideClick="true" ShowFooter="true">
    <BodyContentTemplate Context="__warehouseAddr">
        <AddressFields Model="@Model.WarehouseAddress" FixedCountryId="null" DefaultCountryId="null" />
    </BodyContentTemplate>
    <FooterContentTemplate Context="__warehouseFtr">
        <DxButton Text="@L["Close"].Value"
                  RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Contained"
                  Click="@(() => _warehouseAddressPopupVisible = false)" />
    </FooterContentTemplate>
</DxPopup>

@if (Model.ExchangeAddress != null)
{
    <DxPopup @bind-Visible="@_exchangeAddressPopupVisible" HeaderText="@L["N11ShipmentTemplate:ExchangeAddress"].Value"
             Width="min(95vw, 720px)" CloseOnOutsideClick="true" ShowFooter="true">
        <BodyContentTemplate Context="__exchangeAddr">
            <AddressFields Model="@Model.ExchangeAddress" FixedCountryId="null" DefaultCountryId="null" />
        </BodyContentTemplate>
        <FooterContentTemplate Context="__exchangeFtr">
            <DxButton Text="@L["Close"].Value"
                      RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Contained"
                      Click="@(() => _exchangeAddressPopupVisible = false)" />
        </FooterContentTemplate>
    </DxPopup>
}
