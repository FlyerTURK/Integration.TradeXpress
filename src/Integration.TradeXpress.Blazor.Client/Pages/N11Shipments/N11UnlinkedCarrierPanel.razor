@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* ÖKSÜZ KARGO FİRMASI PANELİ — şablon içe aktarımından sonra carisi bağlanmamış firmaları gösterir ve
   kullanıcının KENDİ cari planından alt hesap seçmesini ister. Firma başına TEK satır: aynı firma birden çok
   şablonda geçse de bir kez sorulur, bağ kurulunca kanaldaki tüm şablonlara yayılır (tek firma = tek bakiye).
   Öksüz kalmadığında panel hiç çizilmez. *@

@if (_unlinked.Count > 0)
{
    <div class="mt-3">
        <DxFormLayout CssClass="w-100">
            <DxFormLayoutGroup Caption="@L["N11ShipmentTemplate:UnlinkedCarriers"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                <DxFormLayoutItem ColSpanMd="12">
                    <DxGrid Data="@_unlinked"
                            ShowFilterRow="false"
                            ShowPager="false"
                            CssClass="w-100">
                        <Columns>
                            <DxGridDataColumn FieldName="Name" Caption="@L["N11ShipmentTemplate:ShipmentCompanies"]" />
                            <DxGridDataColumn Caption="@L["N11ShipmentTemplate:DefaultSubAccount"]" Width="360px">
                                <CellDisplayTemplate Context="cell">
                                    @{
                                        var row = (N11ShipmentTemplateCompanyDto)cell.DataItem;
                                    }
                                    <DxComboBox Data="@SubAccounts"
                                                TData="SubAccountListDto"
                                                TValue="Guid?"
                                                Value="@row.SubAccountId"
                                                ValueChanged="@(async (Guid? v) => await LinkAsync(row, v))"
                                                ValueFieldName="@nameof(SubAccountListDto.Id)"
                                                TextFieldName="@nameof(SubAccountListDto.AccountSubCodeDisplay)"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                ValidationEnabled="false"
                                                CssClass="w-100" />
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                        </Columns>
                    </DxGrid>
                </DxFormLayoutItem>
            </DxFormLayoutGroup>
        </DxFormLayout>
    </div>
}
