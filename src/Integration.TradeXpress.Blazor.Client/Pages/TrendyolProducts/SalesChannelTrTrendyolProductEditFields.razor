@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@using Integration.TradeXpress.Blazor.Client.Pages.Products
@using Integration.TradeXpress.TrendyolCategories

@* Trendyol ürün listeleme edit formu. Form GENELİ tanımlar (kategori + marka + genel alanlar) üstte; ekranda yer kaplayan
   listeler (nitelikler, varyantlar, SKU/durum) DrillTabs sekmelerine ayrılır. N11 EditFields paritesi (id-bazlı fark). *@

<DxFormLayout CssClass="w-100">
    @* Kategori EN BAŞTA — birincil karar (attribute'ları o belirler); kullanıcı önce kategoriyi seçer. *@
    <DxFormLayoutGroup Caption="@L["TrendyolProduct:Category"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
        <DxFormLayoutItem ColSpanMd="12">
            <TrendyolCategoryPicker SelectedExternalId="@Model.CategoryId"
                                    SelectedName="@Model.CategoryName"
                                    OnLeafSelected="OnCategorySelectedAsync" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    <DxFormLayoutGroup Caption="@L["TrendyolProduct:General"]" ColSpanMd="12">
        @* Kanal — HER ZAMAN salt-okunur: create'te otomatik atanır (şirkette tek Trendyol kanalı), SET-ONCE. *@
        <DxFormLayoutItem Caption="@L["SalesChannel"]" ColSpanMd="6">
            <span>@ChannelName</span>
        </DxFormLayoutItem>
        @* Marka — Trendyol'a ÖZEL, ZORUNLU (N11'de yok). K3 hybrid: açılışta write-through cache listesi (DB),
           yazınca canlı ada-göre arama → BrandId; seçilen marka kayıtta cache'e düşer. *@
        <DxFormLayoutItem Caption="@L["TrendyolProduct:Brand"]" ColSpanMd="6">
            <LookupEdit TItem="BrandOption" TValue="string"
                        Data="@_brandResults"
                        ValueFieldName="@nameof(BrandOption.BrandId)"
                        TextFieldName="@nameof(BrandOption.Name)"
                        Value="@Model.BrandId"
                        ValueChanged="@OnBrandChangedAsync"
                        SelectedDisplayText="@Model.BrandName"
                        OnSearch="@OnBrandSearchAsync"
                        SearchMinLength="2"
                        SearchPlaceholder="@L["TrendyolProduct:SelectBrand"].Value"
                        Title="@L["TrendyolProduct:Brand"].Value"
                        NullText="@L["TrendyolProduct:SelectBrand"].Value"
                        AllowClear="false" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["TrendyolProduct:VatRate"]" ColSpanMd="6">
            <NumericSpinEdit TValue="int" @bind-Value="@Model.VatRate" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["TrendyolProduct:DimensionalWeight"]" ColSpanMd="6">
            <NumericSpinEdit TValue="decimal?" @bind-Value="@Model.DimensionalWeight" DisplayFormat="N2"
                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["TrendyolProduct:DeliveryDuration"]" ColSpanMd="6">
            <NumericSpinEdit TValue="int?" @bind-Value="@Model.DeliveryDuration"
                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["TrendyolProduct:FastDeliveryType"]" ColSpanMd="6">
            <ComboBoxEnumEdit TEnum="TrendyolFastDeliveryType?" L="@L" @bind-Value="@Model.FastDeliveryType"
                              NullText="@L["Optional"].Value"
                              ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
                @(Model.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@* ── Büyük listeler sekmelerde (form geneli dışındaki her şey) ── *@
<DrillTabs CssClass="mt-3">
    @* Kanal-özel açıklama — zengin metin (DxHtmlEditor). Boşsa push'ta ürün açıklaması devralınır. *@
    <DxTabPage Text="@L["TrendyolProduct:Description"]" TabIconCssClass="@TradeXpressIcons.Product">
        <span style="color:#6c757d; font-size:0.85rem;">@L["TrendyolProduct:DescriptionHint"]</span>
        <DxHtmlEditor Markup="@(Model.Description ?? string.Empty)"
                      MarkupChanged="@OnDescriptionChanged"
                      CssClass="w-100" Height="360px" />
    </DxTabPage>

    @* Kategori attribute'ları — CELL-EDIT grid (yaprak seçildiyse dolar). Kategori yoksa sekme gizli.
       Varyant eksenleri (Varianter=true) ÜRÜN seviyesinde GÖSTERİLMEZ (SKU/varyant başına gider). *@
    @if (_attributeRows.Count > 0)
    {
        <DxTabPage Text="@L["TrendyolProduct:Attributes"]" TabIconCssClass="@TradeXpressIcons.Sliders">
            <DxGrid Data="@_attributeRows" KeyFieldName="AttributeId"
                    EditMode="GridEditMode.EditCell"
                    EditModelSaving="OnAttributeRowSaving"
                    PageSize="200" PagerVisible="false"
                    CssClass="w-100">
                <Columns>
                    <DxGridDataColumn FieldName="Name" Caption="@L["ProductAttribute"]" Width="45%" ReadOnly="true">
                        <CellDisplayTemplate Context="cell">
                            @{ var r = (TrendyolAttributeRow)cell.DataItem; }
                            <span>@(r.IsMandatory ? $"{r.Name} *" : r.Name)</span>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="CustomValue" Caption="@L["Value"]">
                        <CellDisplayTemplate Context="cell">
                            @{ var r = (TrendyolAttributeRow)cell.DataItem; }
                            <span>@DisplayValue(r)</span>
                        </CellDisplayTemplate>
                        <CellEditTemplate Context="cell">
                            @{ var row = (TrendyolAttributeRow)cell.EditModel; }
                            @if (row.HasValueList)
                            {
                                <DxComboBox TData="TrendyolAttributeValueDto" TValue="int?"
                                            Data="@row.Values"
                                            ValueFieldName="@nameof(TrendyolAttributeValueDto.ValueId)"
                                            TextFieldName="@nameof(TrendyolAttributeValueDto.Value)"
                                            Value="@row.SelectedValueId"
                                            ValueChanged="@((int? v) => row.SelectedValueId = v)"
                                            ValueExpression="@(() => row.SelectedValueId)"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            }
                            else
                            {
                                <DxTextBox Text="@row.CustomValue"
                                           TextChanged="@((string v) => row.CustomValue = v)"
                                           TextExpression="@(() => row.CustomValue)" />
                            }
                        </CellEditTemplate>
                    </DxGridDataColumn>
                </Columns>
            </DxGrid>
        </DxTabPage>
    }

    @* Özellikler — KOMBİNASYON ÜRETİMİ amaçlı (kategori-attribute-push seçimi DEĞİL, o "Kategori Nitelikleri" sekmesi ayrı).
       İlk açılışta ERP ürününün niteliklerinden bir kez KLONLANIR (backend BuildDraftAttributesFromErpAsync); sonrası
       tamamen bağımsız — kullanıcı burada serbestçe özelliği/değeri ekler-siler, ERP'ye dokunmaz. Kaydet'te sunucu
       kartezyen kombinasyonu YENİDEN ÜRETİR ("Kombinasyonlar" sekmesindeki liste). N11 final UI'ından BİREBİR uyarlandı.
       Sekme HER ZAMAN görünür (b9e5066 dersi: koşul içeride, konteynerde değil). *@
    <DxTabPage Text="@L["TrendyolProduct:ProductAttributes"]" TabIconCssClass="@TradeXpressIcons.Sliders">
        <span style="color:#6c757d; font-size:0.85rem;">@L["TrendyolProduct:ProductAttributesHint"]</span>
        <DrillList TItem="SalesChannelTrTrendyolProductAttributeDto"
                   @ref="_attributeDrill"
                   Title="@L["TrendyolProduct:ProductAttributes"]"
                   EntityName="@L["TrendyolProduct:ProductAttribute"]"
                   EntityIcon="@TradeXpressIcons.Sliders"
                   Items="@Model.ProductAttributes"
                   KeyFieldName="ClientKey"
                   PrimaryTextSelector="@(a => a.Name)"
                   NewItemFactory="@(() => new SalesChannelTrTrendyolProductAttributeDto { DisplayOrder = NextAttributeOrder(Model.ProductAttributes) })"
                   SoftDelete="true"
                   IsNewItem="@(a => a.Id == Guid.Empty)"
                   MarkDeleted="@(a => a.IsDeleted = true)"
                   FilterPredicate="@(a => !a.IsDeleted)"
                   SaveGuard="@AttributeSaveGuard"
                   ShowActiveFilter="false"
                   OnChanged="@(() => MarkDirty(nameof(Model.ProductAttributes)))">
            <GridColumns>
                <GridLinkColumn FieldName="Name" Caption="@L["TrendyolProduct:AttributeName"]" Width="35%"
                                FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                                OnClick="@(item => _attributeDrill?.EditItem((SalesChannelTrTrendyolProductAttributeDto)item))" />
                <DxGridDataColumn Caption="@L["TrendyolProduct:AttributeValues"]">
                    <CellDisplayTemplate Context="cell">
                        @{ var ax = (SalesChannelTrTrendyolProductAttributeDto)cell.DataItem; }
                        <span>@(ax.Values.Any(v => !v.IsDeleted) ? string.Join(", ", ax.Values.Where(v => !v.IsDeleted).Select(v => v.Value)) : "-")</span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </GridColumns>
            <EditContent Context="ax">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem Caption="@($"{L["TrendyolProduct:AttributeName"]} *")" ColSpanMd="6" BeginRow="true">
                        <DxTextBox @bind-Text="@ax.Name" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
                        <NumericSpinEdit @bind-Value="@ax.DisplayOrder" />
                    </DxFormLayoutItem>
                    <DxFormLayoutGroup Caption="@L["TrendyolProduct:AttributeValues"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                        @* İç içe DrillList DOĞRUDAN parent EditContent'te (ui-blazor: EditForm yok,
                           CascadingValue<EditContext> doğal izolasyon — nested EditForm NRE'ye girer). *@
                        <DrillList TItem="SalesChannelTrTrendyolProductAttributeValueDto"
                                   @ref="_attributeValueDrill"
                                   Title="@L["TrendyolProduct:AttributeValues"]"
                                   EntityName="@L["TrendyolProduct:AttributeValue"]"
                                   EntityIcon="@TradeXpressIcons.Sliders"
                                   ParentEntityName="@L["TrendyolProduct:ProductAttribute"]"
                                   ParentText="@ax.Name"
                                   Items="@ax.Values"
                                   KeyFieldName="ClientKey"
                                   PrimaryTextSelector="@(v => v.Value)"
                                   NewItemFactory="@(() => new SalesChannelTrTrendyolProductAttributeValueDto { DisplayOrder = NextAttributeValueOrder(ax.Values) })"
                                   SoftDelete="true"
                                   IsNewItem="@(v => v.Id == Guid.Empty)"
                                   MarkDeleted="@(v => v.IsDeleted = true)"
                                   FilterPredicate="@(v => !v.IsDeleted)"
                                   SaveGuard="@AttributeValueSaveGuard"
                                   ShowActiveFilter="false"
                                   OnChanged="@(() => MarkDirty(nameof(Model.ProductAttributes)))">
                            <GridColumns>
                                <GridLinkColumn FieldName="Value" Caption="@L["Value"]"
                                                FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                                                OnClick="@(item => _attributeValueDrill?.EditItem((SalesChannelTrTrendyolProductAttributeValueDto)item))" />
                                <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="90px" />
                            </GridColumns>
                            <EditContent Context="v">
                                <DxFormLayout CssClass="w-100">
                                    <DxFormLayoutItem Caption="@($"{L["Value"]} *")" ColSpanMd="12">
                                        <DxTextBox @bind-Text="@v.Value" />
                                    </DxFormLayoutItem>
                                    <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
                                        <NumericSpinEdit @bind-Value="@v.DisplayOrder" />
                                    </DxFormLayoutItem>
                                </DxFormLayout>
                            </EditContent>
                        </DrillList>
                    </DxFormLayoutGroup>
                </DxFormLayout>
            </EditContent>
        </DrillList>
    </DxTabPage>

    @* Kombinasyonlar — SUNUCU TARAFINDA "Özellikler"in kartezyen kombinasyonundan ÜRETİLİR (reconcile);
       satır elle eklenmez/silinmez (AllowAdd/Delete=false), özellik/değer üzerinden dolaylı kontrol edilir. ERP
       karşılığı olmayan (IsErpBacked=false) satırlar "Trendyol-özel" rozetiyle ayırt edilir — bunlarda OverridePrice/
       OverrideStock ZORUNLU (server fail-fast; burada yalnız hint). Türetilmiş fiyat = NetCost×(1+Marj/100)
       SALT-OKUNUR. Sekme HER ZAMAN görünür (b9e5066 dersi); boşsa içeride hint. *@
    <DxTabPage Text="@L["TrendyolProduct:StockItems"]" TabIconCssClass="@TradeXpressIcons.ProductVariant">
        @* Özellik/değer düzenlendikten sonra TÜM ürünü kaydetmeden yalnız bu Trendyol kaydının kombinasyon setini
           yeniler (RegenerateStockItemsAsync — Full Update ile AYNI reconcile mekanizması). *@
        <span style="color:#6c757d; font-size:0.85rem;">@L["TrendyolProduct:RegenerateStockItemsHint"]</span>
        <DxButton Text="@L["TrendyolProduct:RegenerateStockItems"]" RenderStyle="ButtonRenderStyle.Primary"
                  CssClass="mb-2"
                  IconCssClass="@TradeXpressIcons.ProductVariant"
                  Click="@RegenerateStockItemsAsync" />
        @* Yan-maliyet satırlarını kanal gider ayarlarından TAZELER (idempotent): otomatik (işaretli) satırlar
           yeniden üretilir, kullanıcı satırlarına DOKUNULMAZ. Silinen otomatik satır da bununla geri gelir. *@
        <DxButton Text="@L["SideCost:Reapply"]" RenderStyle="ButtonRenderStyle.Secondary"
                  CssClass="mb-2 ms-1"
                  IconCssClass="@TradeXpressIcons.SalesChannel"
                  Click="@ReapplySideCostsAsync" />
        @if (Model.StockItems.Count == 0)
        {
            <span style="color:#6c757d; font-size:0.85rem;">@L["TrendyolProduct:NoStockItemsYetHint"]</span>
        }
        else
        {
            <span style="color:#6c757d; font-size:0.85rem;">@L["TrendyolProduct:PushPriceChainHint"]</span>
            <DrillList TItem="SalesChannelTrTrendyolProductStockItemGraphDto"
                       @ref="_stockItemDrill"
                       Title="@L["TrendyolProduct:StockItems"]"
                       EntityName="@L["TrendyolProduct:StockItem"]"
                       EntityIcon="@TradeXpressIcons.ProductVariant"
                       Items="@Model.StockItems"
                       KeyFieldName="Id"
                       PrimaryTextSelector="@(v => v.VariantCode)"
                       NewItemFactory="@(() => new SalesChannelTrTrendyolProductStockItemGraphDto())"
                       AllowAdd="false"
                       AllowDelete="false"
                       ShowActiveFilter="false"
                       OnChanged="@(() => MarkDirty(nameof(Model.StockItems)))">
                <GridColumns>
                    <GridLinkColumn Caption="@L["Code"]" Width="160px" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                                    TextSelector="@(item => StockItemCodeOrLabel((SalesChannelTrTrendyolProductStockItemGraphDto)item))"
                                    OnClick="@(item => _stockItemDrill?.EditItem((SalesChannelTrTrendyolProductStockItemGraphDto)item))" />
                    <DxGridDataColumn FieldName="VariantName" Caption="@L["Name"]" />
                    <DxGridDataColumn Caption="@L["TrendyolProduct:Source"]" Width="120px">
                        <CellDisplayTemplate Context="cell">
                            @{ var vv = (SalesChannelTrTrendyolProductStockItemGraphDto)cell.DataItem; }
                            @if (!vv.IsErpBacked)
                            {
                                <span style="display:flex; align-items:center; gap:0.35rem; color:#0369a1;">
                                    <i class="@TradeXpressIcons.SalesChannel" aria-hidden="true"></i>@L["TrendyolProduct:TrendyolOnly"]
                                </span>
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="OverrideStock" Caption="@L["TrendyolProduct:OverrideStock"]" Width="110px" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="Margin" Caption="@L["TrendyolProduct:Margin"]" Width="100px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="OverridePrice" Caption="@L["TrendyolProduct:OverridePrice"]" Width="120px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="DerivedPrice" Caption="@L["TrendyolProduct:DerivedPrice"]" Width="130px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                </GridColumns>
                <EditContent Context="v">
                    <DxFormLayout CssClass="w-100">
                        @* Kimlik — SALT-OKUNUR. ERP-backed'te ERP kod/ad (SSOT); Trendyol-only'de CombinationLabel
                           (özellik değerlerinin özeti) — ERP karşılığı yok. *@
                        <DxFormLayoutItem Caption="@L["Code"]" ColSpanMd="6" BeginRow="true">
                            <span>@(v.IsErpBacked ? v.VariantCode : StockItemCodeOrLabel(v))</span>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["Name"]" ColSpanMd="6">
                            <span>@(v.IsErpBacked ? v.VariantName : L["TrendyolProduct:TrendyolOnly"].Value)</span>
                        </DxFormLayoutItem>
                        @if (!v.IsErpBacked)
                        {
                            <DxFormLayoutItem ColSpanMd="12">
                                <span style="color:#b45309; font-size:0.85rem;">@L["TrendyolProduct:OverrideRequiredForTrendyolOnlyHint"]</span>
                            </DxFormLayoutItem>
                        }
                        @* Kanal-özel override — boş = ERP/türetilmiş devralınır (temizle butonuyla boşaltılır). *@
                        <DxFormLayoutItem Caption="@L["TrendyolProduct:OverridePrice"]" ColSpanMd="4" BeginRow="true">
                            <NumericSpinEdit TValue="decimal?" @bind-Value="@v.OverridePrice" DisplayFormat="N2"
                                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["TrendyolProduct:OverridePriceCurrency"]" ColSpanMd="4">
                            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?"
                                            Data="@_units"
                                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)"
                                            TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                                            Value="@v.OverridePriceCurrencyUnitId"
                                            ValueChanged="@((Guid? id) => OnOverrideCurrencyChanged(v, id))"
                                            AllowClear="true" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["TrendyolProduct:OverrideStock"]" ColSpanMd="4">
                            <NumericSpinEdit TValue="int?" @bind-Value="@v.OverrideStock"
                                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </DxFormLayoutItem>
                        @* Marj % — türetilmiş fiyatı sürer (DerivedPrice canlı güncellensin diye handler'lı). *@
                        <DxFormLayoutItem Caption="@L["TrendyolProduct:Margin"]" ColSpanMd="4" BeginRow="true">
                            <NumericSpinEdit TValue="decimal?" Value="@v.Margin" DisplayFormat="N2"
                                             ValueChanged="@((decimal? m) => OnStockItemMarginChanged(v, m))"
                                             ValueExpression="@(() => v.Margin)"
                                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </DxFormLayoutItem>
                        @* Sigortalı gönderim (Loomis deseni) — kanal ayarında tanımlı olsa bile VARSAYILAN KAPALI;
                           varyant bazında açılır (kullanıcı kararı 2026-07-10). Açınca satır 'Giderleri Yeniden
                           Uygula' ya da yeni klonda reçeteye girer. *@
                        <DxFormLayoutItem Caption="@L["SideCost:InsuredShipping"]" ColSpanMd="4">
                            <DxCheckBox @bind-Checked="@v.InsuredShippingEnabled" CheckType="CheckType.Switch">
                                @(v.InsuredShippingEnabled ? L["Active"] : L["Passive"])
                            </DxCheckBox>
                        </DxFormLayoutItem>
                        @* Net maliyet + türetilmiş fiyat — SALT-OKUNUR (reçeteden canlı; kur eksikse uyarı). *@
                        <DxFormLayoutItem Caption="@L["TrendyolProduct:NetCost"]" ColSpanMd="4">
                            @if (v.NetCostMissingRate)
                            {
                                <span style="color:#b45309;">@L["MissingRate"]</span>
                            }
                            else
                            {
                                <span>@(v.NetCost is { } nc ? $"{nc:N2} {v.NetCostCurrency}" : "-")</span>
                            }
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["TrendyolProduct:DerivedPrice"]" ColSpanMd="4">
                            <span>@(v.DerivedPrice is { } dp ? $"{dp:N2} {v.NetCostCurrency}" : "-")</span>
                        </DxFormLayoutItem>
                        @* Kanal-özel reçete — ERP reçetesinden klonlanır, sonra bağımsız (ERP paneli AYNEN yeniden kullanılır). *@
                        <DxFormLayoutGroup Caption="@L["Recipe"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                            <ProductRecipePanel Lines="v.RecipeLines"
                                                Metals="_metals" MetalVariants="_metalVariants" Scraps="_scraps" Futures="_futures"
                                                Jewelries="_jewelries" Stones="_stones" Goods="_goods" Services="_services" Units="_priceUnits"
                                                NetCost="@v.NetCost" NetCostCurrency="@v.NetCostCurrency" NetCostMissingRate="@v.NetCostMissingRate"
                                                OnChanged="@(async () => await HandleStockItemRecipeChangedAsync(v))" />
                        </DxFormLayoutGroup>
                    </DxFormLayout>
                </EditContent>
            </DrillList>
        }
    </DxTabPage>

    @* Varyant SKU'ları (read-only) — push + reconcile sonrası dolar. *@
    @if (Model.Skus.Count > 0)
    {
        <DxTabPage Text="@L["TrendyolProduct:Skus"]" TabIconCssClass="@TradeXpressIcons.SalesChannel">
            <DxGrid Data="@Model.Skus" PageSize="50" PagerVisible="false" CssClass="w-100">
                <Columns>
                    <DxGridDataColumn FieldName="StockCode" Caption="@L["TrendyolProduct:StockCode"]" />
                    <DxGridDataColumn FieldName="Barcode" Caption="@L["TrendyolProduct:Barcode"]" Width="150px" />
                    <DxGridDataColumn FieldName="LastSentQuantity" Caption="@L["TrendyolProduct:LastSentQuantity"]" Width="140px" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="LastSentListPrice" Caption="@L["TrendyolProduct:LastSentListPrice"]" Width="140px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="LastSentSalePrice" Caption="@L["TrendyolProduct:LastSentSalePrice"]" Width="140px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                </Columns>
            </DxGrid>
        </DxTabPage>
    }

    @* Push önizlemesi (read-only, T6) — Trendyol'a NE gideceği + uyarılar. GERÇEK PUSH YOK (henüz gönderilmedi). *@
    @if (_preview is not null)
    {
        <DxTabPage Text="@L["TrendyolProduct:Preview:Tab"]" TabIconCssClass="@TradeXpressIcons.SalesChannel">
            <span style="color:#6c757d; font-size:0.85rem;">@L["TrendyolProduct:Preview:Hint"]</span>

            @if (_preview.Warnings.Count > 0)
            {
                <h6 class="mt-2" style="color:#dc2626;">@L["TrendyolProduct:Preview:Warnings"]</h6>
                <DxGrid Data="@_preview.Warnings" PageSize="50" PagerVisible="false" CssClass="w-100">
                    <Columns>
                        <DxGridDataColumn Caption="@L["TrendyolProduct:Preview:Warning"]">
                            <CellDisplayTemplate Context="cell">
                                <span style="color:#dc2626;">@cell.DataItem</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>
                </DxGrid>
            }

            <h6 class="mt-3">@L["TrendyolProduct:Preview:ProductLevel"]</h6>
            <DxFormLayout CssClass="w-100">
                <DxFormLayoutItem Caption="@L["TrendyolProduct:ProductMainId"]" ColSpanMd="6">
                    <span>@_preview.Product.ProductMainId</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Name"]" ColSpanMd="6">
                    <span>@_preview.Product.Title</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["TrendyolProduct:Category"]" ColSpanMd="6">
                    <span>@(string.IsNullOrEmpty(_preview.Product.CategoryName) ? _preview.Product.CategoryId : _preview.Product.CategoryName)</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["TrendyolProduct:Brand"]" ColSpanMd="6">
                    <span>@(string.IsNullOrEmpty(_preview.Product.BrandName) ? _preview.Product.BrandId : _preview.Product.BrandName)</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["TrendyolProduct:VatRate"]" ColSpanMd="6">
                    <span>@_preview.Product.VatRate</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["TrendyolProduct:DimensionalWeight"]" ColSpanMd="6">
                    <span>@(_preview.Product.DimensionalWeight?.ToString("N2") ?? "-")</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["TrendyolProduct:DeliveryDuration"]" ColSpanMd="6">
                    <span>@(_preview.Product.DeliveryDuration?.ToString() ?? "-")</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["TrendyolProduct:FastDeliveryType"]" ColSpanMd="6">
                    <span>@(_preview.Product.FastDeliveryType is { } fdt ? L[$"Enum:TrendyolFastDeliveryType:{fdt}"].Value : "-")</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["TrendyolProduct:Preview:Description"]" ColSpanMd="6">
                    <span>@(_preview.Product.HasDescription ? L["Yes"] : L["No"])</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["TrendyolProduct:Preview:ImageCount"]" ColSpanMd="6">
                    <span>@_preview.Product.ImageCount</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["TrendyolProduct:Attributes"]" ColSpanMd="12">
                    <span>@(string.IsNullOrEmpty(_preview.Product.Attributes) ? "-" : _preview.Product.Attributes)</span>
                </DxFormLayoutItem>
            </DxFormLayout>

            @if (_preview.Items.Count > 0)
            {
                <h6 class="mt-3">@L["TrendyolProduct:Preview:Items"]</h6>
                <DxGrid Data="@_preview.Items" PageSize="50" PagerVisible="false" CssClass="w-100">
                    <Columns>
                        <DxGridDataColumn FieldName="Barcode" Caption="@L["TrendyolProduct:Barcode"]" Width="150px" />
                        <DxGridDataColumn FieldName="StockCode" Caption="@L["TrendyolProduct:StockCode"]" Width="140px" />
                        <DxGridDataColumn FieldName="Options" Caption="@L["AttributeSummary"]" />
                        <DxGridDataColumn FieldName="Quantity" Caption="@L["StockQuantity"]" Width="90px" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="ListPrice" Caption="@L["TrendyolProduct:Preview:ListPrice"]" Width="120px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="SalePrice" Caption="@L["TrendyolProduct:Preview:SalePrice"]" Width="120px" DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                    </Columns>
                </DxGrid>
            }
        </DxTabPage>
    }

    @* Trendyol senkron durumu (read-only; submit/refresh sonrası dolar). *@
    @if (!string.IsNullOrEmpty(Model.BatchRequestId) || !string.IsNullOrEmpty(Model.LastError))
    {
        <DxTabPage Text="@L["TrendyolProduct:SyncStatus"]" TabIconCssClass="@TradeXpressIcons.SalesChannel">
            <DxFormLayout CssClass="w-100">
                @if (!string.IsNullOrEmpty(Model.BatchRequestId))
                {
                    <DxFormLayoutItem Caption="@L["TrendyolProduct:BatchRequestId"]" ColSpanMd="6">
                        <span>@Model.BatchRequestId</span>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["TrendyolProduct:Status"]" ColSpanMd="6">
                        <span>@Model.Status</span>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["TrendyolProduct:FailedItemCount"]" ColSpanMd="6">
                        <span>@Model.FailedItemCount</span>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["TrendyolProduct:LastSyncedAt"]" ColSpanMd="6">
                        <span>@Model.LastSyncedAt</span>
                    </DxFormLayoutItem>
                }
                @if (!string.IsNullOrEmpty(Model.LastError))
                {
                    <DxFormLayoutItem Caption="@L["TrendyolProduct:LastError"]" ColSpanMd="12">
                        <span style="color:#dc2626;">@Model.LastError</span>
                    </DxFormLayoutItem>
                }
            </DxFormLayout>
        </DxTabPage>
    }
</DrillTabs>
