@page "/variant-templates"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.VariantTemplates
@using DevExpress.Blazor
@inherits CrudPageBase<VariantTemplateGetDto, VariantTemplateListDto, Guid, VariantTemplateListRequestDto, VariantTemplateCreateDto, VariantTemplateUpdateDto>

<CrudLayout TGetDto="VariantTemplateGetDto"
            TListDto="VariantTemplateListDto"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["VariantTemplate"]"
            EntityIcon="@TradeXpressIcons.VariantTemplate"
            PrimaryTextSelector="@(m => m.Code)"
            PageTitle="@L["VariantTemplates"]"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync">

    <GridColumns>
        <GridLinkColumn FieldName="Code" Caption="@L["Code"]" Width="120px" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                        OnClick="@(o => BeforeUpdateAsync((VariantTemplateListDto)o))" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" VisibleIndex="2" MinWidth="200" />
        <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="110px" VisibleIndex="3" />
    </GridColumns>

</CrudLayout>
