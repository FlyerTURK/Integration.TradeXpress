@using Integration.TradeXpress.Metals
@using Integration.TradeXpress.Permissions
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Metal DUMB Layout — MetalGetDto. FollowingUnit ZORUNLU + Factor(>0) + işçilik + sikke/adet. *@

<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["CurrencyUnit"]} *")" ColSpanMd="4">
            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?"
                            Data="@CurrencyUnits"
                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)" TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                            @bind-Value="@Model.FollowingUnitId"
                            SearchFilterCondition="ListSearchFilterCondition.Contains" NullText="@L["Select"].Value"
                            CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                            UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Factor"]} *")" ColSpanMd="4">
            <DxSpinEdit @bind-Value="@Model.Factor" DisplayFormat="N5" ShowSpinButtons="false" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["FactorChange"]" ColSpanMd="4">
            <DxCheckBox @bind-Checked="@Model.FactorChange" CheckType="CheckType.Switch">@(Model.FactorChange ? L["Yes"] : L["No"])</DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    <DxFormLayoutGroup Caption="@L["QuantityTracking"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@L["IsQuantity"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsQuantity" CheckType="CheckType.Switch">@(Model.IsQuantity ? L["Yes"] : L["No"])</DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["StableQuantity"]" ColSpanMd="6">
            <DxSpinEdit @bind-Value="@Model.StableQuantity" DisplayFormat="N5" ShowSpinButtons="false" CssClass="w-100" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    <DxFormLayoutGroup Caption="@L["Labor"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@L["LaborType"]" ColSpanMd="6">
            <DxComboBox TData="LaborTypeItem" TValue="MetalLaborType" Data="@_laborTypes"
                        @bind-Value="@Model.LaborType"
                        ValueFieldName="@nameof(LaborTypeItem.Value)" TextFieldName="@nameof(LaborTypeItem.Label)" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["LaborTypeChange"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.LaborTypeChange" CheckType="CheckType.Switch">@(Model.LaborTypeChange ? L["Yes"] : L["No"])</DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["EntryLabor"]" ColSpanMd="4">
            <DxSpinEdit @bind-Value="@Model.EntryLabor" DisplayFormat="N5" ShowSpinButtons="false" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["CurrencyUnit"]" ColSpanMd="4">
            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?" Data="@CurrencyUnits"
                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)" TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                            @bind-Value="@Model.EntryLaborUnitId" NullText="@L["Select"].Value"
                            CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                            UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["EntryLaborChange"]" ColSpanMd="4">
            <DxCheckBox @bind-Checked="@Model.EntryLaborChange" CheckType="CheckType.Switch">@(Model.EntryLaborChange ? L["Yes"] : L["No"])</DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["ExitLabor"]" ColSpanMd="4">
            <DxSpinEdit @bind-Value="@Model.ExitLabor" DisplayFormat="N5" ShowSpinButtons="false" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["CurrencyUnit"]" ColSpanMd="4">
            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?" Data="@CurrencyUnits"
                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)" TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                            @bind-Value="@Model.ExitLaborUnitId" NullText="@L["Select"].Value"
                            CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                            UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["ExitLaborChange"]" ColSpanMd="4">
            <DxCheckBox @bind-Checked="@Model.ExitLaborChange" CheckType="CheckType.Switch">@(Model.ExitLaborChange ? L["Yes"] : L["No"])</DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    @* Temsili görsel (TEK) — çekirdek paylaşılan bileşende (Product ile ortak); kaynağı boş bırakılan görsel save'de temizlenir. *@
    <DxFormLayoutGroup Caption="@L["Image"]" ColSpanMd="12">
        <SingleImageEditFields Model="@ImageModel"
                               UploadAsync="@UploadImageAsync"
                               MaxImageSizeBytes="@MetalConsts.MaxImageSizeBytes"
                               TooLargeErrorKey="TradeXpress:Metal:ImageTooLarge" />
    </DxFormLayoutGroup>

    <DxFormLayoutGroup Caption="@L["Other"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@L["Barcode"]" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Barcode" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">@(Model.IsActive ? L["Active"] : L["Passive"])</DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>
