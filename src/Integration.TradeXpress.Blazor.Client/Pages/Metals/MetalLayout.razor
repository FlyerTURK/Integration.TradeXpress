@using Integration.TradeXpress.Metals
@using Integration.TradeXpress.Permissions
@using Integration.TradeXpress.Variants
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Metal DUMB Layout — MetalGetDto. FollowingUnit ZORUNLU + Factor(>0) + işçilik + sikke/adet. *@

<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["CurrencyUnit"]} *")" ColSpanMd="4">
            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?"
                            Data="@CurrencyUnits"
                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)" TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                            @bind-Value="@Model.FollowingUnitId"
                            SearchFilterCondition="ListSearchFilterCondition.Contains" NullText="@L["Select"].Value"
                            CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                            UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Factor"]} *")" ColSpanMd="4">
            <DxSpinEdit @bind-Value="@Model.Factor" DisplayFormat="N5" ShowSpinButtons="false" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["FactorChange"]" ColSpanMd="4">
            <DxCheckBox @bind-Checked="@Model.FactorChange" CheckType="CheckType.Switch">@(Model.FactorChange ? L["Yes"] : L["No"])</DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    <DxFormLayoutGroup Caption="@L["QuantityTracking"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@L["IsQuantity"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsQuantity" CheckType="CheckType.Switch">@(Model.IsQuantity ? L["Yes"] : L["No"])</DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["StableQuantity"]" ColSpanMd="6">
            <DxSpinEdit @bind-Value="@Model.StableQuantity" DisplayFormat="N5" ShowSpinButtons="false" CssClass="w-100" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>


    <DxFormLayoutGroup Caption="@L["Other"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@L["Barcode"]" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Barcode" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6" BeginRow="true">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">@(Model.IsActive ? L["Active"] : L["Passive"])</DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@* En son: alt drill'ler — agnostik graf (in-memory; Metal 'Kaydet'inde birlikte persist). ANA görsel YOK (kaldırıldı) —
   görseller VARYANT seviyesinde (EntityVariantsPanel ShowImages). Nitelikler + Varyantlar TEK tab'da yan yana:
   sol Nitelikler (kendi ekle/düzelt/sil toolbar'ı), sağ üretilen Varyant gridi. Fiyat madende entity seviyesinde (ExtraFields yok). *@
<DrillTabs CssClass="mt-3">
    <DxTabPage Text="@L["Variants"]" TabIconCssClass="@TradeXpressIcons.ProductVariant">
        @* Nitelikler ayrı panelde DEĞİL → varyant gridinin "Özellikleri Düzenle" toolbar butonundan popup'ta (OnAttributesChanged bağlı). *@
        <EntityVariantsPanel TVariant="MetalVariantGraphDto" Variants="@Model.Variants" Attributes="@Model.Attributes"
                             ShowStockQuantity="false" ShowImages="true" OnAttributesChanged="@OnGenerateVariants">
            <ExtraFields Context="v">
                <DxFormLayoutItem Caption="@L["LaborType"]" ColSpanMd="12" BeginRow="true">
                    <DxComboBox TData="LaborTypeItem" TValue="MetalLaborType" Data="@_laborTypes"
                                @bind-Value="@v.LaborType"
                                ValueFieldName="@nameof(LaborTypeItem.Value)" TextFieldName="@nameof(LaborTypeItem.Label)" CssClass="w-100" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["EntryLabor"]" ColSpanMd="6" BeginRow="true">
                    <DxSpinEdit @bind-Value="@v.EntryLabor" DisplayFormat="N5" ShowSpinButtons="false" CssClass="w-100" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["CurrencyUnit"]" ColSpanMd="6">
                    <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?" Data="@CurrencyUnits"
                                    ValueFieldName="@nameof(CurrencyUnitListDto.Id)" TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                                    @bind-Value="@v.EntryLaborUnitId" NullText="@L["Select"].Value"
                                    CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                                    UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["ExitLabor"]" ColSpanMd="6" BeginRow="true">
                    <DxSpinEdit @bind-Value="@v.ExitLabor" DisplayFormat="N5" ShowSpinButtons="false" CssClass="w-100" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["CurrencyUnit"]" ColSpanMd="6">
                    <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?" Data="@CurrencyUnits"
                                    ValueFieldName="@nameof(CurrencyUnitListDto.Id)" TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                                    @bind-Value="@v.ExitLaborUnitId" NullText="@L["Select"].Value"
                                    CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                                    UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update" />
                </DxFormLayoutItem>
            </ExtraFields>
        </EntityVariantsPanel>
    </DxTabPage>
    @* KAYIT-GENELİ medya (CLAUDE.md §6): varyanta ÖZEL görseller Varyantlar sekmesinde ayrı durur, burası kaydın
       genel görselleridir. İki bağlamdan biri eksikse tip YARIMDIR — Good/Product deseniyle simetrik. *@
    <DxTabPage Text="@L["Media"]" TabIconCssClass="@TradeXpressIcons.Metal">
        <EntityMediaPanel Media="@Model.Media" />
    </DxTabPage>

    <DxTabPage Text="@L["Documents"]" TabIconCssClass="@TradeXpressIcons.Report">
        <EntityDocumentsPanel Documents="@Model.Documents" />
    </DxTabPage>
    <DxTabPage Text="@L["Notes"]" TabIconCssClass="@TradeXpressIcons.Comments">
        <EntityNotesPanel Notes="@Model.Notes" />
    </DxTabPage>
</DrillTabs>

