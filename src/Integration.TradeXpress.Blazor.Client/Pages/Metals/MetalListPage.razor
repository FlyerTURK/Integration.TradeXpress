@page "/metals"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Metals
@using DevExpress.Blazor
@inherits CrudPageBase<MetalGetDto, MetalListDto, Guid, MetalListRequestDto, MetalCreateDto, MetalUpdateDto>

<CrudLayout TGetDto="MetalGetDto"
            TListDto="MetalListDto"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["Metal"]"
            EntityIcon="@TradeXpressIcons.Metal"
            PrimaryTextSelector="@(m => m.Code)"
            PageTitle="@L["Metals"]"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync"
            CustomActions="@_customActions">

    <GridColumns>
        <DxGridDataColumn Caption="@L["Preview"]" Width="60px" VisibleIndex="0" TextAlignment="GridTextAlignment.Center">
            <CellDisplayTemplate Context="cell">
                @{ var item = (MetalListDto)cell.DataItem; }
                @if (!string.IsNullOrEmpty(item.ImagePreviewUrl))
                {
                    @* ham img: Dx görsel bileşeni yok — küçük, sınırlı önizleme (ProductListPage ile aynı desen) *@
                    <img src="@item.ImagePreviewUrl" alt="" style="max-height:32px; max-width:48px; object-fit:contain;" />
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <GridLinkColumn FieldName="Code" Caption="@L["Code"]" Width="130px" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                        OnClick="@(o => BeforeUpdateAsync((MetalListDto)o))" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" VisibleIndex="1"  MinWidth="200" />
        <GridLinkColumn FieldName="FollowingUnitCode" Caption="@L["CurrencyUnit"]" Width="110px" VisibleIndex="2"
                        OnClick="@(o => OpenUnitAsync(((MetalListDto)o).FollowingUnitId, ((MetalListDto)o).FollowingUnitCode))" />
        <DxGridDataColumn FieldName="Factor" Caption="@L["Factor"]" Width="100px" VisibleIndex="3"
                          DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" />
        <DxGridDataColumn FieldName="StableQuantity" Caption="@L["StableQuantity"]" Width="100px" VisibleIndex="4"
                          DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
    </GridColumns>

</CrudLayout>
