@page "/shipment-templates"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Shipments
@using DevExpress.Blazor
@inherits CrudPageBase<ShipmentTemplateGetDto, ShipmentTemplateListDto, Guid, ShipmentTemplateListRequestDto, ShipmentTemplateCreateDto, ShipmentTemplateUpdateDto>

<CrudLayout TGetDto="ShipmentTemplateGetDto"
            TListDto="ShipmentTemplateListDto"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["ShipmentTemplate"]"
            EntityIcon="@TradeXpressIcons.ShipmentTemplate"
            PrimaryTextSelector="@(m => m.Code)"
            PageTitle="@L["ShipmentTemplates"]"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync">

    <GridColumns>
        <GridLinkColumn FieldName="Code" Caption="@L["Code"]" Width="140px" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                        OnClick="@(o => BeforeUpdateAsync((ShipmentTemplateListDto)o))" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" VisibleIndex="2" MinWidth="200" />
        <DxGridDataColumn FieldName="FeeModel" Caption="@L["ShipmentTemplate:FeeModel"]" Width="150px" VisibleIndex="3">
            <CellDisplayTemplate>
                @L[$"Enum:ShipmentFeeModel:{((ShipmentTemplateListDto)context.DataItem).FeeModel}"]
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="CarrierName" Caption="@L["ShipmentTemplate:CarrierName"]" Width="160px" VisibleIndex="4" />
    </GridColumns>

</CrudLayout>
