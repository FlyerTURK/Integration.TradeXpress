@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Çekirdek kargo şablonunun SATIŞ KANALI dağıtımları drill'i — self-contained persistent (her işlem anında AppService'e
   yazılır). Ekle: bir N11 kanalı seçtirir → çekirdekten + kanal varsayılanlarından ön-doldurulmuş N11 kargo şablonu taslağı
   (BuildDeploymentDraftAsync; elle giriş bypass) → N11 edit formunda tamamlanır → CreateAsync (validated + N11 push). Grid:
   Kanal + Kanal Şablonu. Silme YOK (N11 silme API'si yok) → bilgi popup'ı. Desen: N11ShipmentTemplateDrill. *@

<div class="mt-3">
    <DrillList TItem="N11ShipmentTemplateDto"
               @ref="_drill"
               Title="@L["ShipmentTemplate:SalesChannels"]"
               EntityName="@L["N11ShipmentTemplate"]"
               EntityIcon="@TradeXpressIcons.SalesChannel"
               Items="_templates"
               KeyFieldName="Id"
               SoftDelete="false"
               PrimaryTextSelector="@(t => t.TemplateName)"
               NewItemFactory="@NewTemplateStub"
               CloneFactory="@CloneTemplate"
               PersistCreate="@PersistCreate"
               PersistUpdate="@PersistUpdate"
               AllowAdd="false"
               AllowDelete="false"
               OnChanged="@ReloadAsync"
               OnRefresh="@ReloadAsync"
               CustomActions="@TemplateActions">
        <GridColumns>
            <DxGridDataColumn FieldName="SalesChannelId" Caption="@L["ShipmentTemplate:ChannelName"]" Width="220px">
                <CellDisplayTemplate>@ChannelName((N11ShipmentTemplateDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <GridLinkColumn FieldName="TemplateName" Caption="@L["ShipmentTemplate:ChannelTemplateName"]"
                            OnClick="@(item => _drill?.EditItem((N11ShipmentTemplateDto)item))" />
        </GridColumns>
        <EditContent Context="t">
            <N11ShipmentTemplateEditFields Model="@t" Cities="@_cities" ShipmentCompanies="@_shipmentCompanies" />
        </EditContent>
    </DrillList>
</div>

@* Birden çok N11 kanalı varsa Ekle'de kanal seçtir (tek kanalda otomatik seçilir → bu popup gösterilmez). @bind-Value
   → ValueExpression otomatik (EditContext altında crash yok). *@
<DxPopup @bind-Visible="@_channelPickerVisible" HeaderText="@L["ShipmentTemplate:SelectChannel"].Value"
         Width="min(95vw, 480px)" CloseOnOutsideClick="true" ShowFooter="true">
    <BodyContentTemplate>
        <DxComboBox Data="@_n11Channels"
                    TData="SalesChannelListDto"
                    TValue="Guid?"
                    @bind-Value="@_pickedChannelId"
                    ValueFieldName="@nameof(SalesChannelListDto.Id)"
                    TextFieldName="@nameof(SalesChannelListDto.Name)"
                    CssClass="w-100" />
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="@L["Cancel"].Value"
                  RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Contained"
                  Click="@(() => _channelPickerVisible = false)" />
        <DxButton Text="@L["ShipmentTemplate:SelectChannelConfirm"].Value"
                  RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Contained"
                  Click="@ConfirmChannelPickAsync" />
    </FooterContentTemplate>
</DxPopup>
