@using System
@using System.Collections.Generic
@using Integration.TradeXpress.Stones
@using Integration.TradeXpress.Variants
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.TradeXpress.Permissions
@using Integration.Framework.Blazor.Client.Components.Crud
@using DevExpress.Blazor
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Stone (Taş) DUMB Layout — StoneGetDto. Basit: milyem/işçilik yok; tanım nitelikleri + adet/fiyat tipi + fiyat. *@

<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["StoneKind"]" ColSpanMd="4"><DxTextBox @bind-Text="@Model.StoneKind" /></DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["StoneType"]" ColSpanMd="4"><DxTextBox @bind-Text="@Model.StoneType" /></DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Color"]" ColSpanMd="4"><DxTextBox @bind-Text="@Model.Color" /></DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Cut"]" ColSpanMd="4"><DxTextBox @bind-Text="@Model.Cut" /></DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Clarity"]" ColSpanMd="4"><DxTextBox @bind-Text="@Model.Clarity" /></DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Sieve"]" ColSpanMd="4"><DxTextBox @bind-Text="@Model.Sieve" /></DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Category"]" ColSpanMd="6"><DxTextBox @bind-Text="@Model.Category" /></DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["GroupCode"]" ColSpanMd="6"><DxTextBox @bind-Text="@Model.GroupCode" /></DxFormLayoutItem>
    </DxFormLayoutGroup>

    <DxFormLayoutGroup Caption="@L["Pricing"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@L["IsQuantity"]" ColSpanMd="4">
            <DxCheckBox @bind-Checked="@Model.IsQuantity" CheckType="CheckType.Switch">@(Model.IsQuantity ? L["Yes"] : L["No"])</DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["PriceType"]" ColSpanMd="4">
            <DxCheckBox @bind-Checked="@Model.PriceByQuantity" CheckType="CheckType.Switch">@(Model.PriceByQuantity ? L["Count"] : L["Amount"])</DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["PriceTypeChange"]" ColSpanMd="4">
            <DxCheckBox @bind-Checked="@Model.PriceTypeChange" CheckType="CheckType.Switch">@(Model.PriceTypeChange ? L["Yes"] : L["No"])</DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["EntryPrice"]" ColSpanMd="4">
            <DxSpinEdit @bind-Value="@Model.EntryPrice" DisplayFormat="N2" ShowSpinButtons="false" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["CurrencyUnit"]" ColSpanMd="2">
            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?" Data="@CurrencyUnits"
                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)" TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                            @bind-Value="@Model.EntryPriceUnitId" NullText="@L["Select"].Value"
                            CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                            UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["ExitPrice"]" ColSpanMd="4">
            <DxSpinEdit @bind-Value="@Model.ExitPrice" DisplayFormat="N2" ShowSpinButtons="false" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["CurrencyUnit"]" ColSpanMd="2">
            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?" Data="@CurrencyUnits"
                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)" TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                            @bind-Value="@Model.ExitPriceUnitId" NullText="@L["Select"].Value"
                            CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                            UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    <DxFormLayoutGroup Caption="@L["Other"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">@(Model.IsActive ? L["Active"] : L["Passive"])</DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@* En son: alt drill'ler — agnostik graf (in-memory; Stone 'Kaydet'inde birlikte persist). Paneller DxTabPage ÜRETMEZ,
   içeriği üretir (DrillTabs CollectionFiller wrapper gotcha'sı). Kod/ad/varyant üretimi sunucuda (synchronizer). *@
<DrillTabs CssClass="mt-3">
    <DxTabPage Text="@L["Attributes"]" TabIconCssClass="@TradeXpressIcons.Sliders">
        <EntityAttributesPanel Attributes="@Model.Attributes" />
    </DxTabPage>
    @* Varyant-başı fiyat/stok YOK (fiyat taşta) → ExtraFields yok. Stok Adedi GİZLİ (stok VoucherLine ledger'ından). *@
    <DxTabPage Text="@L["Variants"]" TabIconCssClass="@TradeXpressIcons.ProductVariant">
        <EntityVariantsPanel TVariant="EntityVariantGraphDto" Variants="@Model.Variants" Attributes="@Model.Attributes"
                             OnGenerate="@OnGenerateVariants" ShowStockQuantity="false" ShowImages="true" />
    </DxTabPage>
    <DxTabPage Text="@L["Images"]" TabIconCssClass="@TradeXpressIcons.Stone">
        <EntityImagesPanel Images="@Model.Images" EntityIcon="@TradeXpressIcons.Stone" />
    </DxTabPage>
    <DxTabPage Text="@L["Documents"]" TabIconCssClass="@TradeXpressIcons.Report">
        <EntityDocumentsPanel Documents="@Model.Documents" />
    </DxTabPage>
    <DxTabPage Text="@L["Notes"]" TabIconCssClass="@TradeXpressIcons.Comments">
        <EntityNotesPanel Notes="@Model.Notes" />
    </DxTabPage>
</DrillTabs>
