@page "/stones/new"
@page "/stones/{Id:guid}"
@using System
@using System.Linq
@using System.Collections.Generic
@using Integration.TradeXpress.Stones
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IStoneAppService StoneAppService
@inject ICurrencyUnitAppService CurrencyUnitAppService
@inject Volo.Abp.ObjectMapping.IObjectMapper Mapper
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenant

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="StoneGetDto" TListDto="StoneListDto" TKey="Guid" TListRequestDto="StoneListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["Stone"].Value" IconCssClass="@TradeXpressIcons.Stone"
                  EntityValue="@(m => m.Code)"
                  IsReadOnly="@(m => m.IsGlobal && CurrentTenant?.Id != null)"
                  ApplyNewDefaults="@(m => { m.IsActive = true; m.PriceTypeChange = true; })">
        <StoneLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" CurrencyUnits="@_units" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private List<CurrencyUnitListDto> _units = new();
    private ICommitCoordinator<StoneGetDto, StoneListDto, Guid, StoneListRequestDto>? _coordinator;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<StoneGetDto, StoneListDto, Guid, StoneListRequestDto, StoneCreateDto, StoneUpdateDto>(
            StoneAppService, Mapper);

        var result = await CurrencyUnitAppService.GetListAsync(new CurrencyUnitListRequestDto { MaxResultCount = 1000 });
        _units = result.Items.ToList();

        _ready = true;
    }
}
