@page "/stones/new"
@page "/stones/{Id:guid}"
@using System
@using Integration.TradeXpress.Stones
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Volo.Abp.ObjectMapping
@using Integration.TradeXpress.Blazor.Client.Services.Working
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IStoneAppService StoneAppService
@inject ICurrencyUnitAppService CurrencyUnitAppService
@inject IObjectMapper Mapper
@inject IWorkingContextService Working
@inject IUiInteractionService UiService

@*
   Taş edit host — STANDART CrudEditHost akışı (Good ile birebir desen). Company-scoped: tenant, host(global)
   kayıtları düzenleyemez (IsReadOnly). Yeni kayıt default'ları working şirkete + standart ana varyanta atanır.
*@

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="StoneGetDto" TListDto="StoneListDto" TKey="Guid" TListRequestDto="StoneListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  SupportsSaveAndNew="@SupportsSaveAndNew" SupportsDelete="@SupportsDelete"
                  FormCaption="@L["Stone"].Value" IconCssClass="@TradeXpressIcons.Stone"
                  EntityValue="@(m => m.Code)"
                  IsReadOnly="@(m => m.IsGlobal && CurrentTenant?.Id != null)"
                  ApplyNewDefaults="@ApplyNewDefaults">
        <StoneLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" CurrencyUnits="@_units"
                     OnGenerateVariants="@(async () => await GenerateVariantsAsync(context))" />
    </CrudEditHost>
}
