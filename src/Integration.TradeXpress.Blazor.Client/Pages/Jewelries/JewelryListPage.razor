@page "/jewelries"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Jewelries
@using DevExpress.Blazor
@inherits CrudPageBase<JewelryGetDto, JewelryListDto, Guid, JewelryListRequestDto, JewelryCreateDto, JewelryUpdateDto>

<CrudLayout TGetDto="JewelryGetDto"
            TListDto="JewelryListDto"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["Jewelry"]"
            EntityIcon="@TradeXpressIcons.Jewelry"
            PrimaryTextSelector="@(m => m.Code)"
            PageTitle="@L["Jewelries"]"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync">

    <GridColumns>
        <DxGridDataColumn Caption="@L["Preview"]" Width="60px" VisibleIndex="0" TextAlignment="GridTextAlignment.Center">
            <CellDisplayTemplate Context="cell">
                @{ var item = (JewelryListDto)cell.DataItem; }
                @if (!string.IsNullOrEmpty(item.ImagePreviewUrl))
                {
                    @* ham img: Dx görsel bileşeni yok — küçük, sınırlı önizleme (MetalListPage ile aynı desen) *@
                    <img src="@item.ImagePreviewUrl" alt="" style="max-height:32px; max-width:48px; object-fit:contain;" />
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <GridLinkColumn FieldName="Code" Caption="@L["Code"]" Width="120px" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                        OnClick="@(o => BeforeUpdateAsync((JewelryListDto)o))" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" VisibleIndex="1"  MinWidth="200" />
        <DxGridDataColumn FieldName="Model" Caption="@L["JewelryModel"]" Width="120px" VisibleIndex="2" />
        <DxGridDataColumn FieldName="Kind" Caption="@L["StoneKind"]" Width="110px" VisibleIndex="3" />
    </GridColumns>

</CrudLayout>
