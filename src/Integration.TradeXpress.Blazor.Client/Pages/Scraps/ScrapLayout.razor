@using System
@using System.Collections.Generic
@using Integration.TradeXpress.Scraps
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.TradeXpress.Permissions
@using Integration.Framework.Blazor.Client.Components.Crud
@using DevExpress.Blazor
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Scrap DUMB Layout — ScrapGetDto'yu forma yansıtır. FollowingUnit ZORUNLU + Factor (0..1) + FactorChange. *@

<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["CurrencyUnit"]} *")" ColSpanMd="6">
            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?"
                            Data="@CurrencyUnits"
                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)"
                            TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                            @bind-Value="@Model.FollowingUnitId"
                            SearchFilterCondition="ListSearchFilterCondition.Contains"
                            NullText="@L["Select"].Value"
                            OnEditRequested="@OnEditFollowingUnit"
                            CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                            UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Factor"]} *")" ColSpanMd="6">
            <DxSpinEdit @bind-Value="@Model.Factor" DisplayFormat="N5" ShowSpinButtons="false" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["FactorChange"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.FactorChange" CheckType="CheckType.Switch">
                @(Model.FactorChange ? L["Yes"] : L["No"])
            </DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
                @(Model.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@code {
    [Parameter, EditorRequired] public ScrapGetDto Model { get; set; } = default!;
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public IReadOnlyList<CurrencyUnitListDto> CurrencyUnits { get; set; } = Array.Empty<CurrencyUnitListDto>();
    [Parameter] public Func<Guid?, Task>? OnEditFollowingUnit { get; set; }
}
