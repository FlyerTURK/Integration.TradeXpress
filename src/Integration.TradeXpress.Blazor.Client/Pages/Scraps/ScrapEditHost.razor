@page "/scraps/new"
@page "/scraps/{Id:guid}"
@using System
@using System.Linq
@using System.Collections.Generic
@using Integration.TradeXpress.Scraps
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IScrapAppService ScrapAppService
@inject ICurrencyUnitAppService CurrencyUnitAppService
@inject Volo.Abp.ObjectMapping.IObjectMapper Mapper
@inject Integration.TradeXpress.Blazor.Client.Services.Mdi.ITabManager TabManager

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="ScrapGetDto" TListDto="ScrapListDto" TKey="Guid" TListRequestDto="ScrapListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  SupportsSaveAndNew="@SupportsSaveAndNew" SupportsDelete="@SupportsDelete"
                  FormCaption="@L["Scrap"].Value" IconCssClass="@TradeXpressIcons.Scrap"
                  EntityValue="@(m => m.Code)"
                  IsReadOnly="@(m => m.IsGlobal && CurrentTenant?.Id != null)"
                  ApplyNewDefaults="@ApplyNewDefaults">
        <ScrapLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" CurrencyUnits="@_units"
                     OnEditFollowingUnit="@OnEditFollowingUnitAsync" />
    </CrudEditHost>
}

