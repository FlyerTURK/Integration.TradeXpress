@page "/scraps/new"
@page "/scraps/{Id:guid}"
@using System
@using System.Linq
@using System.Collections.Generic
@using Integration.TradeXpress.Scraps
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IScrapAppService ScrapAppService
@inject ICurrencyUnitAppService CurrencyUnitAppService
@inject Volo.Abp.ObjectMapping.IObjectMapper Mapper
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenant
@inject Integration.TradeXpress.Blazor.Client.Services.Mdi.ITabManager TabManager

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="ScrapGetDto" TListDto="ScrapListDto" TKey="Guid" TListRequestDto="ScrapListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["Scrap"].Value" IconCssClass="@TradeXpressIcons.Scrap"
                  EntityValue="@(m => m.Code)"
                  IsReadOnly="@(m => m.IsGlobal && CurrentTenant?.Id != null)"
                  ApplyNewDefaults="@(m => { m.IsActive = true; m.Factor = 0.570m; m.FactorChange = true; })">
        <ScrapLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" CurrencyUnits="@_units"
                     OnEditFollowingUnit="@OnEditFollowingUnitAsync" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private List<CurrencyUnitListDto> _units = new();
    private ICommitCoordinator<ScrapGetDto, ScrapListDto, Guid, ScrapListRequestDto>? _coordinator;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<ScrapGetDto, ScrapListDto, Guid, ScrapListRequestDto, ScrapCreateDto, ScrapUpdateDto>(
            ScrapAppService, Mapper);

        var result = await CurrencyUnitAppService.GetListAsync(new CurrencyUnitListRequestDto { MaxResultCount = 1000 });
        _units = result.Items.ToList();

        _ready = true;
    }

    private async Task OnEditFollowingUnitAsync(Guid? followingId)
    {
        if (followingId is not { } id || id == Guid.Empty) return;
        var code = _units.FirstOrDefault(u => u.Id == id)?.Code;
        await TabManager.OpenOrActivateAsync(
            $"/currencies/currency-units/{id}",
            $"{L["CurrencyUnit"]}: {code}",
            TradeXpressIcons.CurrencyUnit);
    }
}
