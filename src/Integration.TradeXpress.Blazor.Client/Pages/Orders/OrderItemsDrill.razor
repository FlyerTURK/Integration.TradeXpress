@using Integration.TradeXpress.Orders
@using Integration.TradeXpress.SalesChannels
@using Integration.Framework.Blazor.Client.Components.Crud
@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IOrderAppService OrderAppService

@*
   Sipariş KALEMLERİ drill'i — CompanyBranchDrill deseni (DrillList), ama AllowAdd=false AllowDelete=false: sipariş
   kalemi pazaryerinden gelir, elle eklenip silinemez, yalnız düzenlenir (customText düzeltmesi + ürün versiyonu
   bağı). Persistent mod: her satır kendi Kaydet'iyle sunucuya ANINDA yazılır (SaveOrderLineEditAsync).
*@

@if (_items is not null)
{
    <div class="mt-2">
        <DrillList TItem="OrderLineEditDto"
                   @ref="_drill"
                   Title="@L["Order:Detail:Lines"]"
                   EntityName="@L["Order:Line:Product"]"
                   Items="_items"
                   KeyFieldName="RemoteLineId"
                   PrimaryTextSelector="@(l => l.ProductName)"
                   AllowAdd="false"
                   AllowDelete="false"
                   ShowActiveFilter="false"
                   NewItemFactory="@NewItem"
                   PersistCreate="@(item => Task.FromResult(item))"
                   PersistUpdate="@SaveLineAsync"
                   CloneFactory="@CloneItem">
            <GridColumns>
                <DxGridDataColumn FieldName="ProductName" Caption="@L["Order:Line:Product"]" MinWidth="240">
                    <CellDisplayTemplate>
                        @{ var item = (OrderLineEditDto)context.DataItem; }
                        <div style="display:flex; flex-direction:column; gap:2px;">
                            @if (!string.IsNullOrWhiteSpace(item.ProductSellerCode))
                            {
                                <span style="font-size:0.78rem; color:#6c757d;">@item.ProductSellerCode</span>
                            }
                            <span style="font-weight:600;">@(item.ProductName ?? "-")</span>
                        </div>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="Quantity" Caption="@L["Order:Line:Quantity"]" Width="70px"
                                  DisplayFormat="N0" TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="Price" Caption="@L["Order:Line:UnitPrice"]" Width="100px"
                                  DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" />
                <DxGridDataColumn FieldName="Status" Caption="@L["Order:Line:Status"]" Width="150px">
                    <CellDisplayTemplate>@ItemStatusText(((OrderLineEditDto)context.DataItem).Status)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="ProductSnapshotName" Caption="@L["Order:Detail:ProductMatch"]" Width="160px" />
            </GridColumns>
            <EditContent Context="item">
                <DxFormLayout>
                    <DxFormLayoutGroup Caption="@L["Order:Detail:Reference"]" ColSpanMd="12">
                        <DxFormLayoutItem Caption="@L["Order:Line:Product"]" ColSpanMd="12">@item.ProductName</DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["Order:Line:StockCode"]" ColSpanMd="6">@item.ProductSellerCode</DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["Order:Line:Quantity"]" ColSpanMd="3">@item.Quantity.ToString("N0")</DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["Order:Line:UnitPrice"]" ColSpanMd="3">@item.Price.ToString("N2")</DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["Order:Line:Status"]" ColSpanMd="6">@ItemStatusText(item.Status)</DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["Order:Detail:Commission"]" ColSpanMd="3">@Money(item.Commission)</DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["Order:Detail:Discount"]" ColSpanMd="3">@Money(item.DiscountTotal)</DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["Order:Detail:Shipment"]" ColSpanMd="6">
                            @* Firma adı (düz metin) + takip no (firma URL destekliyorsa tıklanabilir → popup). *@
                            <span style="display:inline-flex; align-items:center; gap:0.35rem; flex-wrap:wrap;">
                                @if (!string.IsNullOrWhiteSpace(item.ShipmentCompany))
                                {
                                    <span>@item.ShipmentCompany</span>
                                }
                                <TrackingNumberDisplay CarrierName="@item.ShipmentCompany" TrackingNumber="@item.TrackingNumber" />
                            </span>
                        </DxFormLayoutItem>
                        @if (!string.IsNullOrWhiteSpace(item.Attributes))
                        {
                            <DxFormLayoutItem Caption="@L["Order:Detail:Attributes"]" ColSpanMd="12">@item.Attributes</DxFormLayoutItem>
                        }
                    </DxFormLayoutGroup>

                    @if (item.ProductSnapshotName is not null || item.ProductSnapshotImageUrl is not null)
                    {
                        <DxFormLayoutGroup Caption="@L["Order:Detail:ProductMatch"]" ColSpanMd="12">
                            @if (!string.IsNullOrWhiteSpace(item.ProductSnapshotImageUrl))
                            {
                                <DxFormLayoutItem ColSpanMd="3">
                                    <img src="@item.ProductSnapshotImageUrl" alt="" style="max-width:100%; max-height:80px; border-radius:4px;" />
                                </DxFormLayoutItem>
                            }
                            <DxFormLayoutItem Caption="@L["Order:Line:Product"]" ColSpanMd="9">@item.ProductSnapshotName</DxFormLayoutItem>
                        </DxFormLayoutGroup>
                    }

                    @if (item.CustomTexts.Count > 0)
                    {
                        <DxFormLayoutGroup Caption="@L["Order:Detail:CustomText"]" ColSpanMd="12">
                            @foreach (var ct in item.CustomTexts)
                            {
                                <DxFormLayoutItem Caption="@ct.Option" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                                    <div style="display:flex; flex-direction:column; gap:2px;">
                                        <span style="font-size:0.78rem; color:#6c757d; white-space:pre-line;">@L["Order:Detail:OriginalText"]: @ct.OriginalText</span>
                                        <DxMemo @bind-Text="@ct.CorrectedText" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100"
                                                NullText="@ct.OriginalText" />
                                    </div>
                                </DxFormLayoutItem>
                            }
                        </DxFormLayoutGroup>
                    }

                    @* ── ÜRÜN EŞLEŞTİRME — rezervasyonun ÖN KOŞULU. ──────────────────────────────────────
                       Otomatik eşleştirme kanal ürününün SKU sözlüğüne bakar; sözlük boşsa hiçbir kalem
                       eşleşmez ve her sipariş rezervasyonda "Kurulamadı" olarak kilitlenir (canlıda 126/126).
                       Buradan elle eşleştirilen kalem sonraki senkron turunda KENDİLİĞİNDEN rezerve olur —
                       ayrı "yeniden dene" düğmesi yok, çünkü bloklanmış rezervasyon her turda yeniden deneniyor.
                       Combo EditContext altında manuel bağlı → ValidationEnabled="false" ŞART ([validation-expr]). *@
                    <DxFormLayoutGroup Caption="@L["Order:Detail:ProductMatch"]" ColSpanMd="12">
                        <DxFormLayoutItem Caption="@L["Order:Line:MatchedProduct"]" ColSpanMd="12">
                            <DxComboBox TData="OrderLineMatchCandidateDto" TValue="Guid?"
                                        Data="@_matchCandidates"
                                        Value="@item.ProductVariantId"
                                        ValueChanged="@((Guid? v) => item.ProductVariantId = v)"
                                        ValueFieldName="@nameof(OrderLineMatchCandidateDto.EntityVariantId)"
                                        TextFieldName="@nameof(OrderLineMatchCandidateDto.DisplayText)"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        NullText="@L["Order:Line:MatchProductPlaceholder"].Value"
                                        ValidationEnabled="false"
                                        CssClass="w-100" />
                        </DxFormLayoutItem>
                        @* Eşleşme YOKSA sebebi yazılır: boş bir combo kullanıcıya neyin eksik olduğunu söylemez. *@
                        <DxFormLayoutItem ColSpanMd="12" Visible="@(item.ProductVariantId is null)">
                            <InfoNotice Text="@L["Order:Line:MatchMissingHint"].Value" />
                        </DxFormLayoutItem>
                    </DxFormLayoutGroup>

                    @* ── Sipariş Fazı O2 — state machine: N11'e YAZAN aksiyonlar (GERÇEK, geri alınamaz). ── *@
                    <DxFormLayoutGroup Caption="@L["Order:Action:Title"]" ColSpanMd="12">
                        <DxFormLayoutItem Caption="@L["Order:Action:CurrentStatus"]" ColSpanMd="12">
                            <b>@ActionStatusLabel(item.ActionStatus)</b>
                            @if (item.ActionStatus == OrderLineActionStatus.Rejected && !string.IsNullOrWhiteSpace(item.RejectReason))
                            {
                                <span style="color:#6c757d;"> — @item.RejectReason</span>
                            }
                        </DxFormLayoutItem>

                        @* N11 uzak durumu satıcı-aksiyonu bekliyor mu? Beklemiyorsa (kargoda/teslim/tamamlandı/iptal/red…)
                           aksiyon butonları GİZLENİR — N11 bunu zaten işledi, operatör tekrar denemesin. Beklerken mevcut
                           yerel-ActionStatus alt-gate'i (Pending→Kabul/Red, Accepted→Kargo) iç içe KORUNUR. *@
                        @if (AwaitsSellerAction(item))
                        {
                            @if (item.ActionStatus == OrderLineActionStatus.Pending)
                            {
                                <DxFormLayoutItem Caption="@L["Order:Action:NumberOfPackages"]" ColSpanMd="4">
                                    <NumericSpinEdit @bind-Value="@item.ActionInputNumberOfPackages" />
                                </DxFormLayoutItem>
                                <DxFormLayoutItem ColSpanMd="8" CaptionPosition="CaptionPosition.Vertical">
                                    <DxButton Text="@L["Order:Action:Accept"]" RenderStyle="ButtonRenderStyle.Success"
                                              Enabled="@(!_actionBusy)" Click="@(() => AcceptClickedAsync(item))" />
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@L["Order:Action:RejectReason"]" ColSpanMd="8">
                                    <DxTextBox @bind-Text="@item.ActionInputRejectReason" />
                                </DxFormLayoutItem>
                                <DxFormLayoutItem ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                                    <DxButton Text="@L["Order:Action:Reject"]" RenderStyle="ButtonRenderStyle.Danger"
                                              Enabled="@(!_actionBusy)" Click="@(() => RejectClickedAsync(item))" />
                                </DxFormLayoutItem>
                            }
                            else if (item.ActionStatus == OrderLineActionStatus.Accepted)
                            {
                                <DxFormLayoutItem Caption="@L["Order:Action:ShipmentCompanyId"]" ColSpanMd="4">
                                    <DxTextBox @bind-Text="@item.ActionInputShipmentCompanyId" />
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@L["Order:Ship:Tracking"]" ColSpanMd="4">
                                    <DxTextBox @bind-Text="@item.ActionInputTrackingNumber" />
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="@L["Order:Ship:Campaign"]" ColSpanMd="4">
                                    <DxTextBox @bind-Text="@item.ActionInputCampaignNumber" />
                                </DxFormLayoutItem>
                                <DxFormLayoutItem ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                                    <DxButton Text="@L["Order:Action:Ship"]" RenderStyle="ButtonRenderStyle.Primary"
                                              Enabled="@(!_actionBusy)" Click="@(() => ShipClickedAsync(item))" />
                                </DxFormLayoutItem>
                            }
                        }
                        else
                        {
                            <DxFormLayoutItem ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                                <span style="color:#6c757d;">@string.Format(L["Order:Action:N11Processed"].Value, ItemStatusText(item.Status))</span>
                            </DxFormLayoutItem>
                        }
                    </DxFormLayoutGroup>
                </DxFormLayout>
            </EditContent>
        </DrillList>
    </div>
}
