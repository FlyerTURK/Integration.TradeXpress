@using Integration.TradeXpress.Orders
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Components.Shared
@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Sipariş adresi (Fatura/Teslimat) — kompakt ÖZET + ✎ → popup (branch/kargo şablonu ValueObjectEdit deseni; DRY).
   Özet ithal adresin TAMAMINI gösterir (alıcı adı + adres) → hiçbir şey gizli kalmaz. Düzenleme popup'ta:
   alıcı-KİMLİK alanları (Ad/GSM/TC/Vergi) + ortak AddressFields geo-picker (ülke TR-kilitli). Kaydet = order
   form'un kendi save'iyle (Model order edit modelinin parçası; ayrı persist yok); Reset/İptal = açılış snapshot'ı.
*@

<DxFormLayoutItem Caption="@Caption" ColSpanMd="12">
    <ValueObjectEdit TValue="OrderEditAddressDto"
                     Value="@Model"
                     DisplayProjection="@AddressSummary"
                     EmptyPredicate="@IsEmpty"
                     OnEditClick="@OpenPopup"
                     PlaceholderText="@L["Address:EditHint"].Value" />
</DxFormLayoutItem>

@if (Model != null)
{
    <ValueObjectEditPopup TValue="OrderEditAddressDto"
                          @bind-Visible="@_popupVisible"
                          Model="@Model"
                          HeaderText="@Caption"
                          IconCssClass="@TradeXpressIcons.AddressCard">
        @* TEK DxFormLayout: alıcı-kimlik (adres DEĞİL) + adres (Embedded picker) → hepsi aynı caption sütununda HİZALI.
           AddressFields Embedded → kendi wrapper'ı yok, item'ları bu layout'a iner. *@
        <DxFormLayout CssClass="w-100">
            <DxFormLayoutItem Caption="@L["Order:Detail:Buyer"]" ColSpanMd="12">
                <DxTextBox @bind-Text="@Model.FullName" ValidationEnabled="false" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Order:Address:Gsm"]" ColSpanMd="6">
                <DxTextBox @bind-Text="@Model.Gsm" ValidationEnabled="false" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Order:Detail:TcId"]" ColSpanMd="6">
                <DxTextBox @bind-Text="@Model.TcId" ValidationEnabled="false" />
            </DxFormLayoutItem>
            @* Vergi Dairesi ÖNCE, Vergi No SONRA (kullanıcı kararı — buyer ile tutarlı). *@
            <DxFormLayoutItem Caption="@L["Order:Detail:TaxOffice"]" ColSpanMd="6">
                <DxTextBox @bind-Text="@Model.TaxOffice" ValidationEnabled="false" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Order:Detail:TaxId"]" ColSpanMd="6">
                <DxTextBox @bind-Text="@Model.TaxId" ValidationEnabled="false" />
            </DxFormLayoutItem>

            @* Adres (geo-picker + Cadde + UBL) — ortak bileşen, ülke TR-kilitli, Embedded (bu layout'a iner). *@
            <AddressFields Model="@Model" FixedCountryId="@FixedCountryId" Embedded="true" />
        </DxFormLayout>
    </ValueObjectEditPopup>
}
