@using Integration.TradeXpress.Orders
@using Integration.TradeXpress.SalesChannels
@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Sipariş edit formu İÇERİĞİ (dumb Layout — EntityEditForm/CrudEditHost bunu sarar). Başlık/totals SALT-OKUMA
   referans (N11'den); Buyer/Fatura/Teslimat adresi/Kargo EDİTABLE (Model üzerinden — değer zaten AppService'te
   düzeltme??orijinal ile dolu geldi). Kalemler ayrı bileşende (OrderItemsDrill, kendi verisini kendi yükler).
*@

<div style="display:flex; flex-direction:column; gap:14px;">

    @* ── Sipariş bilgileri (salt-okuma referans) + Kargo (editable) ── *@
    <DxFormLayout>
        <DxFormLayoutItem Caption="@L["Order:Channel"]" ColSpanMd="4">@ChannelText(Model.ChannelType, Model.SalesChannelCode)</DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Order:OrderNumber"]" ColSpanMd="4">@Model.OrderNumber</DxFormLayoutItem>
        @* Kanalın İÇ sipariş id'si (ör. N11 "id") — Sipariş No'dan FARKLI; API detay/aksiyon çağrıları bu id ile çalışır. *@
        <DxFormLayoutItem Caption="@L["Order:RemoteOrderId"]" ColSpanMd="4">@Model.RemoteOrderId</DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Order:Date"]" ColSpanMd="4">@Model.OrderDate.ToString("g")</DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Order:Status"]" ColSpanMd="4">@StatusLabel(Model.NeutralStatus)</DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Order:RemoteStatus"]" ColSpanMd="4">@RemoteOrderStatusText(Model)</DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Order:Amount"]" ColSpanMd="4">@Model.TotalAmount.ToString("N2")</DxFormLayoutItem>
        @if (Model.Detail?.PaymentType is { Length: > 0 } payment)
        {
            <DxFormLayoutItem Caption="@L["Order:Detail:PaymentType"]" ColSpanMd="4">@PaymentTypeText(payment)</DxFormLayoutItem>
        }
        @if (Model.Detail?.InvoiceType is { } invoiceType)
        {
            <DxFormLayoutItem Caption="@L["Order:Detail:InvoiceType"]" ColSpanMd="4">@InvoiceTypeLabel(invoiceType)</DxFormLayoutItem>
        }
        <DxFormLayoutItem Caption="@L["Order:Cargo"]" ColSpanMd="4">
            <DxTextBox @bind-Text="@Model.CargoProvider" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Order:Tracking"]" ColSpanMd="8">
            @* Editable takip no + firma harici takip URL'si destekliyorsa tıklanabilir takip linki (yan yana). *@
            <div style="display:flex; align-items:center; gap:0.5rem;">
                <div style="flex:1 1 auto;">
                    <DxTextBox @bind-Text="@Model.CargoTrackingNumber" />
                </div>
                <TrackingNumberDisplay CarrierName="@Model.CargoProvider" TrackingNumber="@Model.CargoTrackingNumber" />
            </div>
        </DxFormLayoutItem>
    </DxFormLayout>

    @* ── Alıcı + Adresler — kompakt özet + ✎ → popup (VO deseni; adres/kargo şablonuyla tutarlı). TEK DxFormLayout →
       Alıcı/Fatura/Teslimat aynı caption sütununu paylaşır (özetler AYNI HİZADA). Alıcı kuralları: ad boşsa Fatura
       Adresi adına düşer; TCKN yalnız doluysa; Vergi Dairesi → Vergi No (bu sırada) yalnız doluysa. ── *@
    <DxFormLayout>
        <OrderBuyerEditFields Caption="@(L["Order:Detail:Buyer"].Value)"
                              Buyer="@Model.Buyer"
                              BillingName="@Model.BillingAddress?.FullName" />
        <OrderAddressEditFields Caption="@(L["Order:Detail:BillingAddress"].Value)"
                                Model="@Model.BillingAddress" FixedCountryId="@Model.CountryId" />
        <OrderAddressEditFields Caption="@(L["Order:Detail:ShippingAddress"].Value)"
                                Model="@Model.ShippingAddress" FixedCountryId="@Model.CountryId" />
    </DxFormLayout>

    @* ── Sipariş Fazı O2 — edit formu toolbar'ındaki "Kabul Et" için paket sayısı girdisi (yalnız N11 + bekleyen kalem
       + N11 sipariş durumu satıcı-aksiyonu bekliyorsa; Tamamlandı/İptal siparişte Kabul/Red butonlarıyla birlikte
       GİZLENİR). Reddet'in gerekçesi burada DEĞİL — tıklanınca UiService.PromptAsync ile SORULUR (OrderEditHost). ── *@
    @if (Model.ChannelType == SalesChannelType.TrN11 && Model.PendingLineCount > 0
         && N11OrderStatusCatalog.AwaitsSellerActionForOrder(Model.RemoteStatus))
    {
        <DxFormLayout>
            <DxFormLayoutGroup Caption="@L["Order:Action:Title"]" ColSpanMd="12">
                <DxFormLayoutItem Caption="@L["Order:Action:NumberOfPackages"]" ColSpanMd="4">
                    <NumericSpinEdit @bind-Value="@Model.ActionInputNumberOfPackages" />
                </DxFormLayoutItem>
            </DxFormLayoutGroup>
        </DxFormLayout>
    }

    @* ── Tutar kırılımı (salt-okuma — N11 hesaplaması) ── *@
    @if (Model.Detail?.Totals is { } totals)
    {
        <DxFormLayout>
            <DxFormLayoutItem Caption="@L["Order:Detail:OriginalPrice"]" ColSpanMd="4">@Money(totals.OriginalPrice)</DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Order:Detail:SellerInvoice"]" ColSpanMd="4">@Money(totals.SellerInvoiceAmount)</DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Order:Detail:Due"]" ColSpanMd="4">@Money(totals.DueAmount)</DxFormLayoutItem>
            @if (DerivedShipping(totals) is { } shipping)
            {
                <DxFormLayoutItem Caption="@L["Order:Detail:ShippingFee"]" ColSpanMd="4">@Money(shipping)</DxFormLayoutItem>
            }
            <DxFormLayoutItem Caption="@L["Order:Detail:MallDiscount"]" ColSpanMd="4">@Money(totals.TotalMallDiscountPrice)</DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Order:Detail:SellerDiscount"]" ColSpanMd="4">@Money(totals.TotalSellerDiscount)</DxFormLayoutItem>
        </DxFormLayout>
    }

    @* ── Kalemler — drill (AllowAdd/AllowDelete=false: sipariş kalemi eklenip silinemez, yalnız düzenlenir). ── *@
    <OrderItemsDrill @ref="_itemsDrill" OrderId="@Model.Id" ChannelType="@Model.ChannelType" />
</div>
