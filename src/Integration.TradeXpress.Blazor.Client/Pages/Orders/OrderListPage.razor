@page "/orders"
@using Integration.TradeXpress.Orders
@using Integration.TradeXpress.SalesChannels
@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   ORTAK SİPARİŞ PANELİ — TEK SEVİYELİ CrudLayout server-side grid. Satır = SİPARİŞ (kanal/no/tarih/müşteri/
   ürün detayı/durum/tutar); kalemler "Ürün Detayı" sütununda satır içinde görünür (OrderItemsCell) — genişletilecek
   detay satırı YOK. Kalemin zengin alanları sipariş popup'ında.
   Sıralama: order status → tarih (yeni→eski). Create/Delete YOK (Order yalnız senkronizasyondan gelir) — yalnız
   DÜZENLEME (STANDART CrudEditHost/EntityEditForm akışı: OnUpdateClick → ViewOpener → OrderEditHost). "Siparişleri Çek"
   pazaryerinden (Trendyol + N11) çeker; arka planda OrderSyncBackgroundWorker boş kanalları kendiliğinden doldurur.
*@

<CrudLayout TGetDto="OrderDto"
            TListDto="OrderListDto"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["Order"]"
            EntityIcon="@TradeXpressIcons.SalesChannel"
            PageTitle="@L["Orders"]"
            LayoutVersion="v4"
            ShowNew="false"
            ShowColumnFilter="true"
            CustomActions="@_customActions"
            OnUpdateClick="OpenDetailAsync"
            OnRefreshClick="ReloadAsync"
            OnSearchChanged="OnSearchAsync">

    <GridColumns>
        <DxGridDataColumn FieldName="ChannelType" Caption="@L["Order:Channel"]" Width="140px" VisibleIndex="1">
            <CellDisplayTemplate>@ChannelLabel((OrderListDto)context.DataItem)</CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="OrderNumber" Caption="@L["Order:OrderNumber"]" Width="160px" VisibleIndex="2" />
        @* Sipariş tarihi bir ANDIR (pazaryerinden UTC gelir) → kullanıcının yerel saatine çevrilir.
           Ham DisplayFormat sunucunun/veritabanının UTC'sini basıyordu: müşteri "23:40'ta sipariş verdim"
           derken panoda 20:40 görünüyordu ve hiçbir yerde "UTC" yazmadığı için fark edilmiyordu.
           SIRALAMA/FİLTRE bozulmaz — FieldName duruyor, yalnız hücrenin ÇİZİMİ değişti. *@
        <DxGridDataColumn FieldName="OrderDate" Caption="@L["Order:Date"]" Width="150px" VisibleIndex="3">
            <CellDisplayTemplate><UtcLocalText Value="@(((OrderListDto)context.DataItem).OrderDate)" /></CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="CustomerName" Caption="@L["Order:Customer"]" MinWidth="180" VisibleIndex="4" />
        @* Ürün detayı — kalemler SATIR İÇİNDE (N11 satıcı panelindeki "Ürün Detayı" sütunu deseni). Sıralama/
           filtre/gruplama KAPALI: kalem alanları sunucunun izinli alan listesinde yok, açık bırakılsa kullanıcı
           filtreler ama sonuç değişmezdi (yanıltıcı affordance). Export da kapalı — hücre çok satırlı. *@
        <DxGridDataColumn FieldName="Items" Name="OrderItemsCell" Caption="@L["Order:Items"]" MinWidth="260" VisibleIndex="5"
                          AllowSort="false" AllowGroup="false" FilterRowEditorVisible="false" ExportEnabled="false">
            <CellDisplayTemplate>
                <OrderItemsCell Items="@(((OrderListDto)context.DataItem).Items)" />
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="NeutralStatus" Caption="@L["Order:Status"]" Width="130px" VisibleIndex="6">
            <CellDisplayTemplate>@StatusLabel(((OrderListDto)context.DataItem).NeutralStatus)</CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="TotalAmount" Caption="@L["Order:Amount"]" Width="120px"
                          DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" VisibleIndex="7" />
    </GridColumns>

    @* Master-detail satırı 2026-07-28'de KALDIRILDI (Hakan): kalemler artık "Ürün Detayı" sütununda satır içinde
       görünüyor, genişletmeye gerek kalmadı. Kalemin zengin alanları (komisyon/indirim/kargo/nitelik/tarihler)
       kaybolmadı — sipariş popup'ında OrderDetailItemDto üzerinden, detay satırından DAHA GENİŞ haliyle duruyor. *@

</CrudLayout>

@* Çekim sonuç raporu (sessiz geçilmez) — çekilen/yeni/güncellenen + pencere + uyarılar. *@
<DxPopup @bind-Visible="_showReport"
         HeaderText="@L["Order:Fetch:ReportTitle"]"
         Width="min(520px, 96vw)"
         MaxHeight="90vh"
         CloseOnEscape="true"
         ShowFooter="true">
    <BodyContentTemplate>
        <div style="display:flex; flex-direction:column; gap:8px;">
            <div>@ReportSummary</div>
            @if (!string.IsNullOrEmpty(ReportWindow))
            {
                <div style="font-size:0.85rem; color:#6c757d;">@ReportWindow</div>
            }
            <DxMemo Text="@ReportIssues"
                    ReadOnly="true"
                    ValidationEnabled="false"
                    Rows="8"
                    ResizeMode="MemoResizeMode.Disabled"
                    CssClass="w-100"
                    Visible="@(!string.IsNullOrEmpty(ReportIssues))" />
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="@L["Close"]" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => _showReport = false)" />
    </FooterContentTemplate>
</DxPopup>
