@using Integration.TradeXpress.Blazor.Client.Pages.Companies.Models
@using Integration.Framework.Blazor.Client.Components.Crud
@using DevExpress.Blazor
@inject Microsoft.Extensions.Localization.IStringLocalizer<Integration.TradeXpress.Localization.TradeXpressResource> L

<DrillList TItem="VaultTreeItemViewModel"
           Title="@L["Menu:Vaults"]"
           EntityName="@L["Entity:Vault"]"
           EntityIcon="@TradeXpressIcons.Vault"
           PrimaryTextSelector="@(v => v.Code)"
           ParentEntityName="@ParentEntityName"
           ParentText="@ParentText"
           Items="@Items"
           MinItems="@MinItems"
           NewItemFactory="@CompanyTreeMapping.NewDefaultVault"
           CloneFactory="@CompanyTreeMapping.CloneVault"
           PersistCreate="PersistCreate"
           PersistUpdate="PersistUpdate"
           PersistDelete="PersistDelete"
           OnItemSaved="OnVaultSaved"
           OnItemDeleted="OnItemDeleted"
           OnRefresh="OnRefresh"
           AllowInlineEdit="AllowInlineEdit"
           OnChanged="OnChanged">
    <GridColumns>
        <DxGridDataColumn FieldName="Code" Caption="@L["Code"]" Width="100px" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" />
        <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="90px" />
        <DxGridDataColumn FieldName="IsDefault" Caption="@L["IsDefault"]" Width="100px" />
        <DxGridDataColumn FieldName="IsActive" Caption="@L["Status"]" Width="110px">
            <CellDisplayTemplate><StatusCell Active="@((bool)context.Value)" /></CellDisplayTemplate>
            @* Satır-içi düzenleme: ikonlu Aktif/Pasif combobox. EditBoxDisplayTemplate yalnız tam
               DxComboBox'ta olduğundan (DxComboBoxSettings'te yok) CellEditTemplate kullanıyoruz;
               combobox edit model'in IsActive alanına bağlanır. Hem açılır listede hem seçili kutuda ikon. *@
            <CellEditTemplate Context="edit">
                @{ var vm = (VaultTreeItemViewModel)edit.EditModel; }
                <DxComboBox Data="@_statusItems" TData="StatusOption" TValue="bool"
                            @bind-Value="vm.IsActive"
                            ValueFieldName="Value" TextFieldName="Text">
                    <EditBoxDisplayTemplate>
                        @if (context.DataItem != null)
                        {
                            <StatusCell Active="@context.DataItem.Value" />
                        }
                    </EditBoxDisplayTemplate>
                    <ItemDisplayTemplate>
                        <StatusCell Active="@context.DataItem.Value" />
                    </ItemDisplayTemplate>
                </DxComboBox>
            </CellEditTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="Description" Caption="@L["Description"]" />
    </GridColumns>
    <EditContent Context="vault">
        <DxFormLayout Data="@vault" CssClass="w-100">
            @* 1. Kod — yarım satır (yalnız) *@
            <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
                <DxTextBox @bind-Text="@vault.Code" />
            </DxFormLayoutItem>
            @* 2. Adı — tam satır *@
            <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
                <DxTextBox @bind-Text="@vault.Name" />
            </DxFormLayoutItem>
            @* Ara: Varsayılan kasa — yarım satır *@
            <DxFormLayoutItem ColSpanMd="6">
                <CaptionTemplate>
                    <InfoCaption Text="@L["IsDefault"].Value"
                                 HintText="@L["Vault:IsDefaultHint"].Value"
                                 Required="false" />
                </CaptionTemplate>
                <Template>
                    <DxCheckBox @bind-Checked="@vault.IsDefault" CheckType="CheckType.Switch">
                        @(vault.IsDefault ? L["Yes"] : L["No"])
                    </DxCheckBox>
                </Template>
            </DxFormLayoutItem>
            @* Sondan bir önceki: Açıklama — tam satır, DxMemo 2 satır, resize kapalı *@
            <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
                <DxMemo @bind-Text="@vault.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
            </DxFormLayoutItem>
            @* Son satır: Durum (Status) yarım + Sıra (DisplayOrder) yarım *@
            <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
                <DxCheckBox @bind-Checked="@vault.IsActive" CheckType="CheckType.Switch">
                    @(vault.IsActive ? L["Active"] : L["Passive"])
                </DxCheckBox>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
                <NumericSpinEdit @bind-Value="@vault.DisplayOrder" />
            </DxFormLayoutItem>
        </DxFormLayout>
    </EditContent>
</DrillList>

@code {
    [Parameter, EditorRequired] public List<VaultTreeItemViewModel> Items { get; set; } = default!;
    [Parameter] public int MinItems { get; set; } = 1;
    [Parameter] public EventCallback<VaultTreeItemViewModel> OnItemDeleted { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Bağlanırsa Refresh butonu görünür (yalnız persistent modda anlamlı).</summary>
    [Parameter] public EventCallback OnRefresh { get; set; }

    /// <summary>true → düzenleme satır-içi panelde açılır (yalnız nested OLMAYAN kullanımda; bkz. DrillList).</summary>
    [Parameter] public bool AllowInlineEdit { get; set; }

    /// <summary>Üst entity (Şube) adı + metni — açılan kasa edit popup başlığında " - [Şube: KOD]".</summary>
    [Parameter] public string? ParentEntityName { get; set; }
    [Parameter] public string? ParentText { get; set; }

    /// <summary>null = in-memory mod, non-null = persistent mod.</summary>
    [Parameter] public Func<VaultTreeItemViewModel, Task<VaultTreeItemViewModel>>? PersistCreate { get; set; }
    [Parameter] public Func<VaultTreeItemViewModel, Task<VaultTreeItemViewModel>>? PersistUpdate { get; set; }
    [Parameter] public Func<VaultTreeItemViewModel, Task>? PersistDelete { get; set; }

    // Status kolonunun satır-içi combobox'ı için Aktif/Pasif seçenekleri (bool → metin).
    private sealed record StatusOption(bool Value, string Text);
    private List<StatusOption> _statusItems => new() { new(true, L["Active"]), new(false, L["Passive"]) };

    private void OnVaultSaved(VaultTreeItemViewModel saved)
    {
        if (!saved.IsDefault) return;
        foreach (var v in Items)
            if (v != saved) v.IsDefault = false;
    }
}
