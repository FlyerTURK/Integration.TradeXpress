@page "/branches/edit/new"
@page "/branches/edit/{Id:guid}"
@using System
@using System.Collections.Generic
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Companies
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IBranchAppService BranchAppService
@inject ICompanyAppService CompanyAppService
@inject ILookupCache<CurrencyUnitListDto> CurrencyLookup
@inject IObjectMapper Mapper

@*
   Branch edit host = İNCE HOST: coordinator + yeni-kayıt default'ları (parent CompanyId + görünür default kasa).
   Kasalar drill'i BranchLayout'ta (in-memory graf → Branch save'inde VaultAppService'e gider). commit/save/delete/close
   generic CrudEditHost'ta. Route YOK → child entity, BranchListPage POPUP açar (CompanyId AdditionalEditParameters ile).
*@

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="BranchGetDto" TListDto="BranchListDto" TKey="Guid" TListRequestDto="BranchListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["Entity:Branch"].Value" IconCssClass="@TradeXpressIcons.Branch"
                  EntityValue="@(m => m.Code)"
                  ApplyNewDefaults="@ApplyNewBranchDefaults">
        <BranchLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" Units="@_units" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    /// <summary>Parent şirket (yeni branch için; BranchListPage AdditionalEditParameters ile geçirir).</summary>
    [Parameter] [SupplyParameterFromQuery] public Guid? CompanyId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private ICommitCoordinator<BranchGetDto, BranchListDto, Guid, BranchListRequestDto>? _coordinator;
    private List<CurrencyUnitListDto> _units = new();
    // Yeni branch için parent şirketin ülkesi (adres formunun FixedCountryId'si = ülke kilidi). Mevcut branch'te
    // bu değer server GetDto'dan gelir; yeni branch'te GetDto client'ta boş üretildiğinden burada çözülür.
    private Guid? _companyCountryId;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<BranchGetDto, BranchListDto, Guid, BranchListRequestDto, BranchCreateDto, BranchUpdateDto>(
            BranchAppService, Mapper);
        try { _units = new List<CurrencyUnitListDto>(await CurrencyLookup.GetAsync()); }   // döviz cache (TTL + auto-invalidate)
        catch { /* feed yoksa boş; combo boş kalır */ }

        // Yeni branch: adres ülke kilidini parent şirketin ülkesinden çöz (tek ekstra read). Çözülemezse kilit yok
        // (picker ülke combo'su görünür) — server yine kayıtta ülke-kilidi uygular (SSOT).
        if (Id is null && CompanyId is { } companyId)
        {
            try { _companyCountryId = (await CompanyAppService.GetAsync(companyId)).CountryId; }
            catch { /* şirket okunamadı → kilit yok (fallback serbest mod) */ }
        }

        _ready = true;
    }

    // Yeni branch: parent şirket + şirket ülkesi (adres kilidi) + görünür varsayılan kasa (snapshot ÖNCESİ → IsDirty tetiklemez).
    private void ApplyNewBranchDefaults(BranchGetDto m)
    {
        m.IsActive = true;
        m.DisplayOrder = 1;
        m.CompanyCountryId = _companyCountryId;
        if (CompanyId.HasValue)
            m.CompanyId = CompanyId.Value;

        m.Vaults.Add(new VaultGraphDto
        {
            Code = VaultConsts.DefaultCode,
            Name = VaultConsts.DefaultName,
            IsDefault = true,
            DisplayOrder = 1,
        });
    }
}


