@using System
@using System.Collections.Generic
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Vaults
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IBranchAppService BranchAppService
@inject IObjectMapper Mapper

@*
   Branch edit host = İNCE SARMAL: coordinator + yeni-kayıt default'ları (parent CompanyId + görünür default kasa).
   Kasalar drill'i BranchLayout'ta (in-memory graf → Branch save'inde VaultAppService'e gider). commit/save/delete/close
   generic CrudEditHost'ta. Route YOK → child entity, BranchListPage POPUP açar (CompanyId AdditionalEditParameters ile).
*@

@if (_coordinator != null)
{
    <CrudEditHost TGetDto="BranchGetDto" TListDto="BranchListDto" TKey="Guid" TListRequestDto="BranchListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["Entity:Branch"].Value" IconCssClass="@TradeXpressIcons.Branch"
                  EntityValue="@(m => m.Code)"
                  ApplyNewDefaults="@ApplyNewBranchDefaults">
        <BranchLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    /// <summary>Parent şirket (yeni branch için; BranchListPage AdditionalEditParameters ile geçirir).</summary>
    [Parameter] public Guid? CompanyId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private ICommitCoordinator<BranchGetDto, BranchListDto, Guid, BranchListRequestDto>? _coordinator;

    protected override void OnInitialized()
        => _coordinator = new PersistentCoordinator<BranchGetDto, BranchListDto, Guid, BranchListRequestDto, BranchCreateDto, BranchUpdateDto>(
            BranchAppService, Mapper);

    // Yeni branch: parent şirket + görünür varsayılan kasa (snapshot ÖNCESİ → IsDirty tetiklemez).
    private void ApplyNewBranchDefaults(BranchGetDto m)
    {
        m.IsActive = true;
        m.DisplayOrder = 1;
        if (CompanyId.HasValue)
            m.CompanyId = CompanyId.Value;

        m.Vaults.Add(new VaultGraphDto
        {
            Code = VaultConsts.DefaultCode,
            Name = VaultConsts.DefaultName,
            IsDefault = true,
            DisplayOrder = 1,
        });
    }
}
