@page "/companies"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Pages.Companies.Models
@using Integration.TradeXpress.Companies
@using DevExpress.Blazor
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@inherits CrudPageBase<CompanyGetDto, CompanyListDto, Guid, CompanyListRequestDto, CompanyCreateDto, CompanyUpdateDto>

<CrudLayout TGetDto="CompanyGetDto"
            TListDto="CompanyListDto"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["Entity:Company"]"
            EntityIcon="@TradeXpressIcons.Company"
            PrimaryTextSelector="@(m => m.Code)"
            PageTitle="@L["Menu:Companies"]"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync"
            CustomActions="@BranchActions">

    <GridColumns>
        <GridLinkColumn FieldName="Code" Caption="@L["Code"]" Width="120px" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                        OnClick="@(o => BeforeUpdateAsync((CompanyListDto)o))" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" VisibleIndex="1"  MinWidth="200" />
        <GridLinkColumn FieldName="CountryCode" Caption="@L["CountryCode"]" Width="100px" VisibleIndex="2"
                        OnClick="@(o => OpenCountryAsync((CompanyListDto)o))" />
        <GridLinkColumn FieldName="BaseCurrencyCode" Caption="@L["BaseCurrency"]" Width="140px" VisibleIndex="3"
                        OnClick="@(o => OpenUnitAsync(((CompanyListDto)o).BaseCurrencyUnitId, ((CompanyListDto)o).BaseCurrencyCode))" />
        <DxGridDataColumn FieldName="IsHeadquarters" Caption="@L["IsHeadquarters"]" Width="100px" VisibleIndex="4" />
        <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="90px" VisibleIndex="5" />
    </GridColumns>

    

</CrudLayout>







