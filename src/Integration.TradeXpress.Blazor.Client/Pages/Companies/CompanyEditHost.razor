@page "/companies/new"
@page "/companies/{Id:guid}"
@using System
@using System.Collections.Generic
@using System.Linq
@using Integration.TradeXpress.Companies
@using Integration.TradeXpress.Countries
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@using Integration.TradeXpress.Blazor.Client.Pages.Countries
@using Integration.TradeXpress.Blazor.Client.Pages.Financials.CurrencyUnits
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject ICompanyAppService CompanyAppService
@inject ICountryAppService CountryAppService
@inject ILookupCache<CurrencyUnitListDto> CurrencyLookup
@inject IViewOpener ViewOpener
@inject IPopupService PopupService
@inject IObjectMapper Mapper

@*
   Company edit host = İNCE HOST: coordinator + referanslar (döviz cache + ülke direkt) + yeni-kayıt default'ları
   (görünür HQ şube + onun default kasası). Şube/Kasa grafı CompanyLayout/CompanyBranchDrill'de (in-memory → save'de
   AppService normalize eder). commit/save/delete/close generic CrudEditHost'ta. CompanyListPage'in EditComponentType'ı (TAB).
*@

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="CompanyGetDto" TListDto="CompanyListDto" TKey="Guid" TListRequestDto="CompanyListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["Entity:Company"].Value" IconCssClass="@TradeXpressIcons.Company"
                  EntityValue="@(m => m.Code)"
                  ApplyNewDefaults="@ApplyNewCompanyDefaults">
        <CompanyLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" Units="@_units" Countries="@_countries"
                       OnAddCurrency="@OnAddCurrencyAsync" OnEditCurrency="@OnEditCurrencyAsync"
                       OnAddCountry="@OnAddCountryAsync" OnEditCountry="@OnEditCountryAsync"
                       OnReferenceDataReload="@ReloadUnitsAsync" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private List<CurrencyUnitListDto> _units = new();
    private List<CountryListDto> _countries = new();
    private ICommitCoordinator<CompanyGetDto, CompanyListDto, Guid, CompanyListRequestDto>? _coordinator;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<CompanyGetDto, CompanyListDto, Guid, CompanyListRequestDto, CompanyCreateDto, CompanyUpdateDto>(
            CompanyAppService, Mapper);

        try
        {
            _units = new List<CurrencyUnitListDto>(await CurrencyLookup.GetAsync());   // döviz cache (TTL + auto-invalidate)
            _countries = (await CountryAppService.GetListAsync(new CountryListRequestDto { MaxResultCount = 1000 })).Items.ToList();
        }
        catch { /* feed yoksa boş; combolar boş kalır */ }

        _ready = true;
    }

    // Yeni şirket: görünür varsayılan HQ şube + onun varsayılan kasası (snapshot ÖNCESİ → IsDirty tetiklemez).
    private void ApplyNewCompanyDefaults(CompanyGetDto m)
    {
        m.IsActive = true;
        m.DisplayOrder = 1;
        m.Branches.Add(new BranchGraphDto
        {
            Code = BranchConsts.DefaultHeadquartersCode,
            Name = BranchConsts.DefaultHeadquartersName,
            IsHeadquarters = true,
            DisplayOrder = 1,
            Vaults =
            {
                new VaultGraphDto
                {
                    Code = VaultConsts.DefaultCode,
                    Name = VaultConsts.DefaultName,
                    IsDefault = true,
                    DisplayOrder = 1,
                },
            },
        });
    }

    // ── Quick-add/edit (combo +/✎). Company TAB'da → referans edit POPUP açılır (host serbest). ──
    private async Task<Guid> OnAddCurrencyAsync()
    {
        var before = _units.Select(u => u.Id).ToHashSet();
        await OpenRefAsync(typeof(CurrencyUnitEditHost), null);
        _units = new List<CurrencyUnitListDto>(await CurrencyLookup.GetAsync());   // cache invalidate sonrası taze
        StateHasChanged();
        return _units.Select(u => u.Id).FirstOrDefault(id => !before.Contains(id));  // yeni Id → auto-select (yoksa Empty)
    }

    private async Task OnEditCurrencyAsync(Guid id)   // currency Value = Id
    {
        await OpenRefAsync(typeof(CurrencyUnitEditHost), id);
        _units = new List<CurrencyUnitListDto>(await CurrencyLookup.GetAsync());
        StateHasChanged();
    }

    private async Task<Guid?> OnAddCountryAsync()
    {
        var before = _countries.Select(c => c.Id).ToHashSet();
        await OpenRefAsync(typeof(CountryEditHost), null);
        _countries = (await CountryAppService.GetListAsync(new CountryListRequestDto { MaxResultCount = 1000 })).Items.ToList();
        StateHasChanged();
        // Yeni Id (öncekinde olmayan) → combo auto-select; yoksa null (seçim değişmez).
        return _countries.Select(c => (Guid?)c.Id).FirstOrDefault(id => id is { } v && !before.Contains(v));
    }

    private async Task OnEditCountryAsync(Guid? id)   // country Value = Id (id-only geçiş)
    {
        if (id is not { } countryId || countryId == Guid.Empty) return;
        await OpenRefAsync(typeof(CountryEditHost), countryId);
        _countries = (await CountryAppService.GetListAsync(new CountryListRequestDto { MaxResultCount = 1000 })).Items.ToList();
        StateHasChanged();
    }

    // Gömülü merkez şube adresinden yeni il/ilçe eklenince coğrafya combo'ları tazelensin (TenantEditHost deseni).
    // Şube adresi YALNIZ yeni-şirket formunda gömülü çizilir; güncelleme modunda drill kendi tazelemesini yapar.
    private async Task ReloadUnitsAsync()
    {
        _units = new List<CurrencyUnitListDto>(await CurrencyLookup.GetAsync());
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenRefAsync(Type host, object? id)
    {
        var extra = new Dictionary<string, object>
        {
            { "OnClosed", EventCallback.Factory.Create(this, () => PopupService.Close()) },
        };
        await ViewOpener.OpenAsync(host, id, string.Empty, null, extra);
    }
}
