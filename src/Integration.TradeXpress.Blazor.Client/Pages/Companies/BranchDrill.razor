@using Integration.TradeXpress.Blazor.Client.Pages.Companies.Models
@using Integration.Framework.Blazor.Client.Components.Crud
@using DevExpress.Blazor
@inject Microsoft.Extensions.Localization.IStringLocalizer<Integration.TradeXpress.Localization.TradeXpressResource> L

@* Başlık DxFormLayoutGroup caption'ından geldiği için DrillList'in kendi Title'ı verilmez. *@
<DrillList TItem="BranchTreeItemViewModel"
           EntityName="@L["Entity:Branch"]"
           EntityIcon="@TradeXpressIcons.Branch"
           PrimaryTextSelector="@(b => b.Code)"
           ParentEntityName="@ParentEntityName"
           ParentText="@ParentText"
           Items="@Items"
           MinItems="1"
           NewItemFactory="@NewBranch"
           CloneFactory="@CompanyTreeMapping.CloneBranch"
           DeleteGuard="@BranchDeleteGuard"
           OnItemSaved="OnBranchSaved"
           OnItemDeleted="OnItemDeleted"
           OnChanged="OnChanged">
    <GridColumns>
        <DxGridDataColumn FieldName="Code" Caption="@L["Code"]" Width="100px" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" />
        <DxGridDataColumn FieldName="IsHeadquarters" Caption="@L["IsHeadquarters"]" Width="100px" />
        <DxGridDataColumn FieldName="IsActive" Caption="@L["Status"]" Width="110px">
            <CellDisplayTemplate><StatusCell Active="@((bool)context.Value)" /></CellDisplayTemplate>
        </DxGridDataColumn>
    </GridColumns>
    <EditContent Context="branch">
        <BranchEditForm Branch="@branch" PersistVaults="false" OnChanged="OnChanged" />
    </EditContent>
</DrillList>

@code {
    [Parameter, EditorRequired] public List<BranchTreeItemViewModel> Items { get; set; } = default!;
    [Parameter] public EventCallback<BranchTreeItemViewModel> OnItemDeleted { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Üst entity (Şirket) adı + metni — açılan şube edit popup başlığında " - [Şirket: KOD]".</summary>
    [Parameter] public string? ParentEntityName { get; set; }
    [Parameter] public string? ParentText { get; set; }

    private BranchTreeItemViewModel NewBranch() => new()
    {
        Vaults = { CompanyTreeMapping.NewDefaultVault() }
    };

    private string? BranchDeleteGuard(BranchTreeItemViewModel branch)
        => branch.IsHeadquarters ? L["TradeXpress:Branch:CannotDeleteHeadquarters"] : null;

    private void OnBranchSaved(BranchTreeItemViewModel saved)
    {
        if (!saved.IsHeadquarters) return;
        foreach (var b in Items)
            if (b != saved) b.IsHeadquarters = false;
    }
}
