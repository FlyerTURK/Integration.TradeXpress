@using System
@using System.Collections.Generic
@using Integration.TradeXpress.Companies
@using Integration.TradeXpress.Countries
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Components.Crud
@using DevExpress.Blazor
@using Integration.Framework.Blazor.Client.Profiles
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IEntityProfileRegistry Profiles

@*
   Company DUMB Layout — paylaşılan CompanyEditFields (form) + merkez şube. İkisi de Tenant ile paylaşılır
   (ICompanyGraph). Şirketin kendi HQ switch'i: form içi devir yok → yüklü (orijinal) HQ ise kilitli.

   YENİ vs GÜNCELLE ayrımı (2026-08-02 Hakan isteği: "yeni şirket formu tenant formu gibi olsun"):
   · YENİ  → merkez şube alanları şirketin çerçevesi İÇİNDE gömülü (TenantLayout deseninin birebir aynısı).
             Gerekçe: org kuralı gereği şirket en az bir şubeyle doğar (host varsayılan HQ şubeyi zaten kurar);
             kullanıcıyı ayrı bir drill'e gönderip "şube ekle" dedirtmek, zorunlu adımı isteğe bağlı gösteriyordu.
   · GÜNCELLE → Şube→Kasa drill'i (çok şubeli yapıyı yönetmenin tek makul yüzeyi; gömülü form ölçeklenmez).
*@
@if (IsNew)
{
    <DxFormLayout CssClass="w-100">
        @* Embedded: alanlar parent'ın TEK layout'una iner (iç içe DxFormLayout caption hizasını kaydırır). *@
        <CompanyEditFields Model="@Model" Units="@Units" Countries="@Countries"
                           HeadquartersEnabled="@(!_originalWasHq)" CodeEnabled="true"
                           Embedded="true"
                           OnAddCurrency="@OnAddCurrency" OnEditCurrency="@OnEditCurrency"
                           OnAddCountry="@OnAddCountry" OnEditCountry="@OnEditCountry">
            <GroupFooter>
                @if (FirstBranch is { } newBranch)
                {
                    @* Merkez şube ŞİRKETİN bilanço birimini devralır — combo gizli olduğundan değeri burada,
                       render anında hizalıyoruz (kullanıcı şirketin ülkesini/birimini değiştirirse şube de
                       onunla gelsin; aksi halde şube açılıştaki birimde takılı kalırdı). TenantLayout ile aynı. *@
                    newBranch.BaseCurrencyUnitId = Model.BaseCurrencyUnitId;

                    <BranchEditFields Model="newBranch" Units="@Units"
                                      GroupCaption="@L["Company:HeadquartersBranch"].Value"
                                      HeadquartersEnabled="false" CodeEnabled="true"
                                      ShowHeadquarters="false" ShowBaseCurrency="false"
                                      ShowAdvancedFields="false" AddressInsideGroup="true"
                                      Embedded="true"
                                      OnReferenceDataReload="@OnReferenceDataReload" />
                }
            </GroupFooter>
        </CompanyEditFields>
    </DxFormLayout>
}
else
{
    <CompanyEditFields Model="@Model" Units="@Units" Countries="@Countries"
                       HeadquartersEnabled="@(!_originalWasHq)" CodeEnabled="true"
                       OnAddCurrency="@OnAddCurrency" OnEditCurrency="@OnEditCurrency"
                       OnAddCountry="@OnAddCountry" OnEditCountry="@OnEditCountry" />

    @* Tek drill de tablı yapıda + entity ikonu (genel desen). *@
    <DrillTabs CssClass="mt-3">
        <DxTabPage Text="@Profiles.PluralTitle("Branch", L)" TabIconCssClass="@Profiles.Icon("Branch")">
            <CompanyBranchDrill Model="@Model" Units="@Units" OnChanged="@(() => EditChanged?.Invoke())" />
        </DxTabPage>
    </DrillTabs>
}
