@using System
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Blazor.Client.Components.Crud
@using DevExpress.Blazor
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Branch DUMB Layout — paylaşılan BranchEditFields (alanlar) + VaultDrill (kasalar). I/O yok.
   Alanlar/validasyon BranchEditFields'te (Company şube-drill'i ile AYNI); kasalar VaultDrill'de (DRY).
   HQ switch: form içi devir yok → yüklü (orijinal) HQ ise kilitli. Drill değişimi EditChanged ile dirty.
*@
<BranchEditFields Model="@Model" HeadquartersEnabled="@(!_originalWasHq)" CodeEnabled="@IsNew" />

<div class="mt-3">
    @* Tek drill de tablı yapıda + entity ikonu (genel desen). *@
    <DxTabs>
        <DxTabPage Text="@L["Menu:Vaults"]" TabIconCssClass="@TradeXpressIcons.Vault">
            <VaultDrill Vaults="Model.Vaults" OnChanged="@(() => EditChanged?.Invoke())" />
        </DxTabPage>
    </DxTabs>
</div>

@code {
    [Parameter, EditorRequired] public BranchGetDto Model { get; set; } = default!;
    [Parameter] public bool IsNew { get; set; }

    // Drill (Kasalar) değişimini forma bildir — EntityEditForm EditChanged cascade'i.
    [CascadingParameter(Name = "EditChanged")] private Action? EditChanged { get; set; }

    // Kök branch HQ switch: form içi devir yok → yüklü (orijinal) HQ ise kilitli. İlk parametre set'inde yakala.
    private bool _originalWasHq;
    private bool _hqCaptured;

    protected override void OnParametersSet()
    {
        if (!_hqCaptured && Model is not null)
        {
            _originalWasHq = Model.IsHeadquarters;
            _hqCaptured = true;
        }
    }
}
