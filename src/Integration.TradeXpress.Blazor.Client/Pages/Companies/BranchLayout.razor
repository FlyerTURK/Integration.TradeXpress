@using System
@using System.Linq
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Blazor.Client.Pages.Vaults
@using Integration.Framework.Blazor.Client.Components.Crud
@using DevExpress.Blazor
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Branch DUMB Layout — BranchGetDto'yu forma yansıtır + Kasalar drill'ini host eder. I/O yok.
   Vault graf in-memory (soft-delete: silinen IsDeleted kalır, gridde gizli, Branch save'inde VaultAppService'e gider).
   Drill değişimi @onchange/EditContext'e DÜŞMEZ → EditChanged cascade'i ile forma bildirilir (dirty/toolbar/*).
   HQ switch: kök branch'te form içi devir yok → yüklü (orijinal) HQ ise kilitli.
*@
<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" Enabled="@IsNew" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" />
        </DxFormLayoutItem>
        <DxFormLayoutItem ColSpanMd="6">
            <CaptionTemplate>
                <InfoCaption Text="@L["IsHeadquarters"].Value"
                             HintText="@L["Branch:IsHeadquartersHint"].Value"
                             Required="false" />
            </CaptionTemplate>
            <Template>
                @* Merkez şube ise switch kapalı: tek merkezi false'a çekmesin (devir = başka şubeyi merkez yapmak). *@
                <DxCheckBox @bind-Checked="@Model.IsHeadquarters" CheckType="CheckType.Switch"
                            Enabled="@(!_originalWasHq)">
                    @(Model.IsHeadquarters ? L["Yes"] : L["No"])
                </DxCheckBox>
            </Template>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
        <DxMemo @bind-Text="@Model.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
        <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
            @(Model.IsActive ? L["Active"] : L["Passive"])
        </DxCheckBox>
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
        <NumericSpinEdit @bind-Value="@Model.DisplayOrder" />
    </DxFormLayoutItem>
</DxFormLayout>

@* Kasalar drill — DRY: standalone ile AYNI dumb VaultLayout. *@
<div class="mt-3">
    <DrillList TItem="VaultGraphDto"
               Title="@L["Menu:Vaults"]"
               EntityName="@L["Entity:Vault"]"
               Items="Model.Vaults"
               KeyFieldName="ClientKey"
               PrimaryTextSelector="@(v => v.Code)"
               NewItemFactory="@NewVault"
               CloneFactory="@CloneVault"
               MinItems="1"
               SoftDelete="true"
               IsNewItem="@(v => v.Id == Guid.Empty)"
               MarkDeleted="@(v => v.IsDeleted = true)"
               FilterPredicate="@(v => !v.IsDeleted)"
               DeleteGuard="@(v => VaultDeleteGuard(v))"
               OnSelectionChanged="OnVaultSelected"
               OnItemSaved="OnVaultSaved"
               OnChanged="@(() => EditChanged?.Invoke())">
        <ToolbarActions>
            <DxButton Text="@L["MakeDefaultVault"]"
                      RenderStyle="ButtonRenderStyle.Link"
                      IconCssClass="fas fa-star"
                      Click="MakeSelectedDefault"
                      Enabled="@(_selectedVault is { IsDeleted: false, IsDefault: false })" />
        </ToolbarActions>
        <GridColumns>
            <DxGridDataColumn FieldName="Code" Caption="@L["Code"]" Width="120px" />
            <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" />
            <DxGridDataColumn FieldName="IsDefault" Caption="@L["IsDefault"]" Width="90px" TextAlignment="GridTextAlignment.Left">
                <CellDisplayTemplate Context="cell">@(((VaultGraphDto)cell.DataItem).IsDefault ? L["Yes"].Value : "")</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="90px" />
        </GridColumns>
        <EditContent Context="v">
            <VaultLayout Model="@v" IsNew="@(v.Id == Guid.Empty)" IsDefaultEnabled="@(!IsVaultSoleDefault(v))" />
        </EditContent>
    </DrillList>
</div>

@code {
    [Parameter, EditorRequired] public BranchGetDto Model { get; set; } = default!;
    [Parameter] public bool IsNew { get; set; }

    // Drill (Kasalar) değişimini forma bildir (dirty/toolbar/*) — EntityEditForm EditChanged cascade'i.
    [CascadingParameter(Name = "EditChanged")] private Action? EditChanged { get; set; }

    // Kök branch HQ switch: form içi devir yok → yüklü (orijinal) HQ ise kilitli. İlk parametre set'inde yakala.
    private bool _originalWasHq;
    private bool _hqCaptured;

    protected override void OnParametersSet()
    {
        if (!_hqCaptured && Model is not null)
        {
            _originalWasHq = Model.IsHeadquarters;
            _hqCaptured = true;
        }
    }

    private VaultGraphDto? _selectedVault;
    private void OnVaultSelected(VaultGraphDto? v) => _selectedVault = v;

    private static VaultGraphDto NewVault() => new() { IsActive = true, DisplayOrder = 1 };

    private static VaultGraphDto CloneVault(VaultGraphDto v) => new()
    {
        Id = v.Id,
        ClientKey = v.ClientKey,
        IsDeleted = v.IsDeleted,
        Code = v.Code,
        Name = v.Name,
        IsDefault = v.IsDefault,
        IsActive = v.IsActive,
        DisplayOrder = v.DisplayOrder,
        Description = v.Description,
    };

    // Tekil-bayrak devri: kaydedilen kasa varsayılan ise diğer (silinmemiş) kasaların varsayılanını düşür.
    private void OnVaultSaved(VaultGraphDto saved)
    {
        if (!saved.IsDefault) return;
        foreach (var v in Model.Vaults)
            if (!ReferenceEquals(v, saved) && !v.IsDeleted)
                v.IsDefault = false;
    }

    // Tek varsayılan kasa mı? KENDİSİ hariç başka varsayılan yoksa tektir → silinemez + switch kapalı.
    private bool IsVaultSoleDefault(VaultGraphDto v)
        => v.IsDefault && !Model.Vaults.Any(x => x.ClientKey != v.ClientKey && !x.IsDeleted && x.IsDefault);

    private string? VaultDeleteGuard(VaultGraphDto v)
        => IsVaultSoleDefault(v) ? L["CannotDeleteDefaultVault"].Value : null;

    // Seçili kasayı varsayılan yap (diğerlerini düşür) — in-memory; save'de VaultAppService normalize eder.
    private void MakeSelectedDefault()
    {
        if (_selectedVault is null || _selectedVault.IsDeleted) return;
        foreach (var v in Model.Vaults)
            v.IsDefault = false;
        _selectedVault.IsDefault = true;
        EditChanged?.Invoke();
    }
}
