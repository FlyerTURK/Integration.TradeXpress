@page "/branches/{CompanyId:guid}"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Pages.Companies.Models
@using Integration.TradeXpress.Branches
@using DevExpress.Blazor
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@inherits CrudPageBase<BranchGetDto, BranchListDto, Guid, BranchListRequestDto, BranchCreateDto, BranchUpdateDto>

<CrudLayout TGetDto="BranchGetDto"
            TListDto="BranchListDto"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["Entity:Branch"]"
            EntityIcon="@TradeXpressIcons.Branch"
            PrimaryTextSelector="@(m => m.Code)"
            ParentEntityName="@L["Entity:Company"]"
            ParentTextSelector="@(_ => CompanyCode)"
            PageTitle="@PageTitle"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync">

    <GridColumns>
        <DxGridDataColumn FieldName="Code" Caption="@L["Code"]" Width="120px" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" />
        <DxGridDataColumn FieldName="IsHeadquarters" Caption="@L["IsHeadquarters"]" Width="120px" />
        @* IsActive kolonu yok — toolbar'da IsActive switch filtre kontrolü var (aktif/pasif ayrımı orada). *@
        <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="90px" Visible="false" />
    </GridColumns>

    <ToolbarActions>
        <DxButton Text="@L["Menu:Vaults"]" IconCssClass="@($"{TradeXpressIcons.Vault} toolbar-action-vaults")"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Enabled="@(SelectedBranch != null)"
                  Click="OpenVaultsAsync" />
    </ToolbarActions>

    

</CrudLayout>





