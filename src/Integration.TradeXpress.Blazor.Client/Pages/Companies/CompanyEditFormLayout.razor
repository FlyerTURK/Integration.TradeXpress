@using System.Linq
@using Integration.TradeXpress.Blazor.Client.Pages.Companies.Models
@using Integration.TradeXpress.Countries
@using Integration.TradeXpress.Currencies
@using Microsoft.Extensions.Localization
@using DevExpress.Blazor

@* Şirket düzenleme alanları — salt görünüm (dumb layout). Yaşam döngüsü (EditContext, dirty,
   save/cancel) koordinatöre (CrudEditForm ← CrudEditModal) ait; bu komponent yalnız bağlar. *@

<DxFormLayout Data="@Model" CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        @* 1. Kod — yarım satır *@
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" />
        </DxFormLayoutItem>
        @* 2. Adı — tam satır *@
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" @ref="_nameBox" />
        </DxFormLayoutItem>
        @* 3. Ülke — yarım satır *@
        <DxFormLayoutItem Caption="@($"{L["Country"]} *")" ColSpanMd="6">
            <DxComboBox Data="@Countries" Value="@Model.CountryCode"
                        ValueFieldName="@nameof(CountryListDto.Code)"
                        TextFieldName="@nameof(CountryListDto.Code)"
                        ValueChanged="@((string code) => OnCountryChanged(code))"
                        ValidationEnabled="false"
                        NullText="@L["Country"]"
                        CssClass="w-100" />
        </DxFormLayoutItem>
        @* 4. Değerleme Para Birimi — yarım satır *@
        <DxFormLayoutItem ColSpanMd="6" CaptionFor="baseCcy">
            <CaptionTemplate>
                @* Metin + ⓘ ikonu. Native title mobilde tap'le açılmaz → tıkla/tap'le açılan DxFlyout. *@
                <span style="display:inline-flex; align-items:center; gap:0.25rem; line-height:1;">
                    <span>@L["BaseCurrency"] *</span>
                    <span id="baseCcyHint" class="fas fa-circle-info text-muted small"
                          style="cursor:pointer;"
                          @onclick="@(() => _baseCcyHintOpen = !_baseCcyHintOpen)"
                          @onclick:stopPropagation="true"></span>
                </span>
                <DxFlyout @bind-IsOpen="_baseCcyHintOpen"
                          PositionTarget="#baseCcyHint"
                          BodyText="@L["BaseCurrencyHint"]" />
            </CaptionTemplate>
            <Template>
                <DxComboBox Data="@Units" Value="@Model.BaseCurrencyUnitId"
                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)"
                            TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                            ValueChanged="@((Guid id) => OnBaseCurrencyChanged(id))"
                            ValidationEnabled="false"
                            InputId="baseCcy"
                            CssClass="w-100" />
            </Template>
        </DxFormLayoutItem>
        @* Ara: Merkez — yarım satır (yalnız) *@
        <DxFormLayoutItem Caption="@L["IsHeadquarters"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsHeadquarters" CheckType="CheckType.Switch">
                @(Model.IsHeadquarters ? L["Yes"] : L["No"])
            </DxCheckBox>
        </DxFormLayoutItem>
        @* Sondan bir önceki: Açıklama — tam satır, DxMemo 2 satır, resize kapalı *@
        <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        @* Son satır: Durum (Status) yarım + Sıra (DisplayOrder) yarım, yanında *@
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
                @(Model.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
            <DxSpinEdit @bind-Value="@Model.DisplayOrder" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    @* Şubeler — drill artık form layout'un içinde bir grup; kenarları Genel/Ayarlar ile birebir hizalı. *@
    <DxFormLayoutGroup Caption="@L["Menu:Branches"]" ColSpanMd="12">
        <DxFormLayoutItem ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
            <BranchDrill Items="@Model.Branches"
                         ParentEntityName="@L["Entity:Company"]"
                         ParentText="@Model.Code"
                         OnItemDeleted="OnBranchDeleted"
                         OnChanged="OnChanged" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@code {
    [Parameter, EditorRequired] public CompanyViewModel Model { get; set; } = default!;
    [Parameter, EditorRequired] public IStringLocalizer L { get; set; } = default!;
    [Parameter] public List<CurrencyUnitListDto> Units { get; set; } = new();
    [Parameter] public List<CountryListDto> Countries { get; set; } = new();

    /// <summary>Combo veya drill değişince ateşlenir — parent dirty işaretlemesini tetikler.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private DxTextBox? _nameBox;
    private bool _baseCcyHintOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _nameBox != null)
            await _nameBox.FocusAsync();
    }

    private void OnCountryChanged(string code)
    {
        Model.CountryCode = code;
        var country = Countries.FirstOrDefault(c => c.Code == code);
        if (country?.DefaultCurrencyCode is { Length: > 0 } ccy)
        {
            var unit = Units.FirstOrDefault(u => string.Equals(u.Code, ccy, StringComparison.OrdinalIgnoreCase));
            if (unit != null)
                Model.BaseCurrencyUnitId = unit.Id;
        }
        _ = OnChanged.InvokeAsync();
    }

    private void OnBaseCurrencyChanged(Guid id)
    {
        Model.BaseCurrencyUnitId = id;
        _ = OnChanged.InvokeAsync();
    }

    private void OnBranchDeleted(BranchTreeItemViewModel branch)
    {
        if (branch.Id is { } id) Model.DeletedBranchIds.Add(id);
    }
}
