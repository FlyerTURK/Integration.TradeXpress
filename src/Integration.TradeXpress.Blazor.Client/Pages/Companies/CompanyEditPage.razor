@using System
@using System.Linq
@using Integration.TradeXpress.Companies
@using Integration.TradeXpress.Countries
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Services.Mdi
@using DevExpress.Blazor
@using Microsoft.Extensions.Localization

@inject ICompanyAppService CompanyAppService
@inject ICurrencyUnitAppService CurrencyAppService
@inject ICountryAppService CountryAppService
@inject ITabManager TabManager

@inherits CrudEditComponentBase<CompanyGetDto, CompanyListDto, Guid, CompanyListRequestDto, CompanyCreateDto, CompanyUpdateDto>

<CrudEditShell TGetDto="CompanyGetDto" TListDto="CompanyListDto" TKey="Guid"
               IsPopupMode="@IsPopupMode" EditContext="@EditContext" EditController="@this">
    @* Paylaşılan şirket formu (TenantEditPage de aynı bileşenleri kullanır). Şirketin kendi merkez
       switch'i standalone'da snapshot-temelli (form içinde devir yok). *@
    <CompanyEditFields Model="@EditModel" Units="@Units" Countries="@Countries"
                       HeadquartersEnabled="@(!_originalCompanyWasHq)" CodeEnabled="@IsNewMode" />
    <CompanyBranchDrill Model="@EditModel" OnChanged="NotifyDirtyChanged" />
</CrudEditShell>

@code {
    protected override Volo.Abp.Application.Services.ICrudAppService<
        CompanyGetDto, CompanyListDto, Guid, CompanyListRequestDto, CompanyCreateDto, CompanyUpdateDto> CrudAppService => CompanyAppService;

    protected override string EntityChangeKey => "Companies";

    public List<CurrencyUnitListDto> Units { get; set; } = new();
    public List<CountryListDto> Countries { get; set; } = new();

    private bool _originalCompanyWasHq;

    public override async Task LoadDataAsync()
    {
        await base.LoadDataAsync();
        var currenciesTask = CurrencyAppService.GetListAsync(new CurrencyUnitListRequestDto { MaxResultCount = 1000 });
        var countriesTask = CountryAppService.GetListAsync(new CountryListRequestDto { MaxResultCount = 1000 });
        await Task.WhenAll(currenciesTask, countriesTask);
        Units = (await currenciesTask).Items.ToList();
        Countries = (await countriesTask).Items.ToList();
        _originalCompanyWasHq = EditModel.IsHeadquarters;
    }

    public override async Task<bool> SaveAsync()
    {
        var ok = await base.SaveAsync();
        if (ok) _originalCompanyWasHq = EditModel.IsHeadquarters;
        return ok;
    }

    // Yeni şirket: görünür varsayılan HQ şube + onun varsayılan kasası (snapshot ÖNCESİ → IsDirty tetiklemez).
    protected override Task OnModelCreatedAsync(CompanyGetDto model)
    {
        model.Branches.Add(new BranchGraphDto
        {
            Code = BranchConsts.DefaultHeadquartersCode,
            Name = BranchConsts.DefaultHeadquartersName,
            IsHeadquarters = true,
            DisplayOrder = 1,
            Vaults =
            {
                new VaultGraphDto
                {
                    Code = VaultConsts.DefaultCode,
                    Name = VaultConsts.DefaultName,
                    IsDefault = true,
                    DisplayOrder = 1,
                },
            },
        });
        return Task.CompletedTask;
    }

    public override async Task CloseAsync()
    {
        if (!IsPopupMode && CurrentMdiTab != null)
        {
            await TabManager.TryCloseAsync(CurrentMdiTab.Id);
        }
        else
        {
            await base.CloseAsync();
        }
    }
}
