@using Integration.TradeXpress.Blazor.Client.Pages.Companies.Models
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Vaults
@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IVaultAppService VaultAppService

@* Şube düzenleme formu — hem in-memory (şirket ağacı) hem persistent (şube popup) modunda çalışır.
   PersistVaults=false → VaultDrill in-memory, şirket SaveTree'siyle kaydedilir.
   PersistVaults=true  → VaultDrill persistent, IVaultAppService ile anında yazar. *@

<DxFormLayout Data="@Branch" CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        @* 1. Kod — yarım satır *@
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Branch.Code" />
        </DxFormLayoutItem>
        @* 2. Adı — tam satır *@
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Branch.Name" />
        </DxFormLayoutItem>
        @* Ara: Merkez — yarım satır (yalnız) *@
        <DxFormLayoutItem Caption="@L["IsHeadquarters"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Branch.IsHeadquarters" CheckType="CheckType.Switch">
                @(Branch.IsHeadquarters ? L["Yes"] : L["No"])
            </DxCheckBox>
            <div class="form-text text-muted small">@L["BranchHeadquartersHint"]</div>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    @* Sondan bir önceki: Açıklama — tam satır, DxMemo 2 satır, resize kapalı *@
    <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
        <DxMemo @bind-Text="@Branch.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
    </DxFormLayoutItem>
    @* Son satır: Durum (Status) yarım + Sıra (DisplayOrder) yarım *@
    <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
        <DxCheckBox @bind-Checked="@Branch.IsActive" CheckType="CheckType.Switch">
            @(Branch.IsActive ? L["Active"] : L["Passive"])
        </DxCheckBox>
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
        <DxSpinEdit @bind-Value="@Branch.DisplayOrder" />
    </DxFormLayoutItem>

    @* Kasalar — drill form layout'un içinde bir grup; kenarları Genel ile birebir hizalı (Şirket deseni). *@
    <DxFormLayoutGroup Caption="@L["Menu:Vaults"]" ColSpanMd="12">
        <DxFormLayoutItem ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
            @if (PersistVaults && Branch.Id == null)
            {
                @* Persistent modda kasa eklemek için şubenin önden kaydedilmiş olması gerekir. *@
                <div class="form-text text-muted small">@L["VaultsRequireSavedBranch"]</div>
            }
            else
            {
                <VaultDrill Items="@Branch.Vaults"
                            MinItems="@(PersistVaults ? 0 : 1)"
                            ParentEntityName="@L["Entity:Branch"]"
                            ParentText="@Branch.Code"
                            PersistCreate="@(PersistVaults ? PersistVaultCreate : null)"
                            PersistUpdate="@(PersistVaults ? PersistVaultUpdate : null)"
                            PersistDelete="@(PersistVaults ? PersistVaultDelete : null)"
                            OnItemDeleted="HandleVaultDeleted"
                            OnRefresh="VaultRefreshCallback"
                            AllowInlineEdit="@PersistVaults"
                            OnChanged="OnChanged" />
            }
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@code {
    [Parameter, EditorRequired] public BranchTreeItemViewModel Branch { get; set; } = default!;

    /// <summary>
    /// false (varsayılan) = in-memory mod: kasa değişiklikleri şirket SaveTree'siyle toplu kaydedilir.
    /// true = persistent mod: her kasa işlemi anında IVaultAppService'e gider.
    /// </summary>
    [Parameter] public bool PersistVaults { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    // Refresh yalnız persistent modda anlamlı; in-memory modda boş callback (buton görünmez).
    private EventCallback VaultRefreshCallback =>
        PersistVaults ? EventCallback.Factory.Create(this, RefreshVaultsAsync) : EventCallback.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Persistent modda mevcut şubeyi açarken kasaları yükle.
        if (PersistVaults && Branch.Id != null && Branch.Vaults.Count == 0)
            await LoadVaultsAsync();
    }

    // Persistent modda kasaları sunucudan (yeniden) yükler.
    private async Task LoadVaultsAsync()
    {
        if (Branch.Id == null) return;
        try
        {
            var list = await VaultAppService.GetListAsync(new VaultListRequestDto
            {
                MaxResultCount = DrillConsts.MaxInMemoryChildren,
                BranchId = Branch.Id.Value,
            });
            foreach (var v in list.Items)
                Branch.Vaults.Add(ToVm(v));
            if (list.TotalCount > Branch.Vaults.Count)
                await Notify.Warn(L["TradeXpress:Drill:CeilingReached"]);
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    // Refresh: mevcut listeyi temizleyip sunucudan tazeler (persistent mod).
    private async Task RefreshVaultsAsync()
    {
        Branch.Vaults.Clear();
        await LoadVaultsAsync();
    }

    // In-memory modda silinen mevcut kasaların Id'lerini şubeye kaydeder (SaveTree için).
    private void HandleVaultDeleted(VaultTreeItemViewModel vault)
    {
        if (!PersistVaults && vault.Id is { } id)
            Branch.DeletedVaultIds.Add(id);
    }

    private async Task<VaultTreeItemViewModel> PersistVaultCreate(VaultTreeItemViewModel vm)
        => ToVm(await VaultAppService.CreateAsync(new VaultCreateDto
        {
            BranchId = Branch.Id!.Value,
            Code = vm.Code,
            Name = vm.Name,
            IsDefault = vm.IsDefault,
            DisplayOrder = vm.DisplayOrder,
            Description = vm.Description,
        }));

    private async Task<VaultTreeItemViewModel> PersistVaultUpdate(VaultTreeItemViewModel vm)
        => ToVm(await VaultAppService.UpdateAsync(vm.Id!.Value, new VaultUpdateDto
        {
            Code = vm.Code,
            Name = vm.Name,
            IsDefault = vm.IsDefault,
            IsActive = vm.IsActive,
            DisplayOrder = vm.DisplayOrder,
            Description = vm.Description,
        }));

    private Task PersistVaultDelete(VaultTreeItemViewModel vm)
        => VaultAppService.DeleteAsync(vm.Id!.Value);

    private static VaultTreeItemViewModel ToVm(VaultListDto d) => new()
        { Id = d.Id, Code = d.Code, Name = d.Name, IsDefault = d.IsDefault, IsActive = d.IsActive, DisplayOrder = d.DisplayOrder };

    private static VaultTreeItemViewModel ToVm(VaultGetDto d) => new()
        { Id = d.Id, Code = d.Code, Name = d.Name, IsDefault = d.IsDefault, IsActive = d.IsActive, DisplayOrder = d.DisplayOrder, Description = d.Description };
}
