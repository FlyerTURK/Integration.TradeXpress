@using Integration.TradeXpress.Blazor.Client.Pages.Companies.Models
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Branches
@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IBranchAppService BranchAppService

@* Şube kalıcı drill popup'ı. Parent yalnız görünürlük + şirket kimliği verir.
   Kasa yönetimi BranchEditForm(PersistVaults=true) içinde yaşar — ayrı VaultDrillPopup yok. *@

<DxPopup @bind-Visible="Visible" @bind-Visible:event="VisibleChanged"
         HeaderText="@($"{CompanyName} — {L["Menu:Branches"]}")"
         Width="85%" MaxWidth="980px" MaxHeight="90vh" Scrollable="true"
         ShowCloseButton="true" CloseOnEscape="true" CloseOnOutsideClick="false">
    <Content>
        @if (Visible)
        {
            <DrillList TItem="BranchTreeItemViewModel"
                       Title="@L["Menu:Branches"]"
                       EntityName="@L["Entity:Branch"]"
                       Items="@_items"
                       FilterPredicate="@Filter"
                       MinItems="1"
                       NewItemFactory="@(() => new BranchTreeItemViewModel())"
                       CloneFactory="@CompanyTreeMapping.CloneBranch"
                       DeleteGuard="@DeleteGuard"
                       PersistCreate="PersistCreate"
                       PersistUpdate="PersistUpdate"
                       PersistDelete="PersistDelete"
                       OnItemSaved="OnItemSaved">
                <ToolbarActions>
                    <div style="display:flex; align-items:center; gap:0.4rem; white-space:nowrap;">
                        <DxCheckBox Checked="@_activeFilter"
                                    CheckedChanged="@((bool v) => { _activeFilter = v; })"
                                    CheckType="CheckType.Switch" />
                        <span>@(_activeFilter ? L["ActiveRecords"] : L["PassiveRecords"])</span>
                    </div>
                </ToolbarActions>
                <GridColumns>
                    <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" />
                    <DxGridDataColumn FieldName="IsHeadquarters" Caption="@L["IsHeadquarters"]" Width="100px" />
                </GridColumns>
                <EditContent Context="branch">
                    <BranchEditForm Branch="@branch" PersistVaults="true" />
                </EditContent>
            </DrillList>
        }
    </Content>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public string CompanyName { get; set; } = "";

    private List<BranchTreeItemViewModel> _items = new();
    private bool _activeFilter = true;
    private Guid _loadedForCompanyId;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && CompanyId != Guid.Empty && CompanyId != _loadedForCompanyId)
        {
            _loadedForCompanyId = CompanyId;
            await LoadAsync();
        }
        else if (!Visible)
        {
            _loadedForCompanyId = Guid.Empty;
            _activeFilter = true;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var list = await BranchAppService.GetListAsync(new BranchListRequestDto
            {
                MaxResultCount = DrillConsts.MaxInMemoryChildren,
                CompanyId = CompanyId,
            });
            _items = list.Items.Select(ToBranchVm).ToList();
            if (list.TotalCount > _items.Count)
                await Notify.Warn(L["TradeXpress:Drill:CeilingReached"]);
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    private bool Filter(BranchTreeItemViewModel b) => b.IsActive == _activeFilter;

    private string? DeleteGuard(BranchTreeItemViewModel b)
        => b.IsHeadquarters ? L["TradeXpress:Branch:CannotDeleteHeadquarters"] : null;

    private void OnItemSaved(BranchTreeItemViewModel saved)
    {
        if (!saved.IsHeadquarters) return;
        foreach (var b in _items)
            if (b != saved) b.IsHeadquarters = false;
    }

    private async Task<BranchTreeItemViewModel> PersistCreate(BranchTreeItemViewModel vm)
        => ToBranchVm(await BranchAppService.CreateAsync(new BranchCreateDto
        {
            CompanyId = CompanyId,
            Name = vm.Name,
            IsHeadquarters = vm.IsHeadquarters,
            DisplayOrder = vm.DisplayOrder,
            Description = vm.Description,
        }));

    private async Task<BranchTreeItemViewModel> PersistUpdate(BranchTreeItemViewModel vm)
        => ToBranchVm(await BranchAppService.UpdateAsync(vm.Id!.Value, new BranchUpdateDto
        {
            Name = vm.Name,
            IsHeadquarters = vm.IsHeadquarters,
            IsActive = vm.IsActive,
            DisplayOrder = vm.DisplayOrder,
            Description = vm.Description,
        }));

    private Task PersistDelete(BranchTreeItemViewModel vm)
        => BranchAppService.DeleteAsync(vm.Id!.Value);

    private static BranchTreeItemViewModel ToBranchVm(BranchListDto d) => new()
        { Id = d.Id, Name = d.Name, IsHeadquarters = d.IsHeadquarters, IsActive = d.IsActive, DisplayOrder = d.DisplayOrder };

    private static BranchTreeItemViewModel ToBranchVm(BranchGetDto d) => new()
        { Id = d.Id, Name = d.Name, IsHeadquarters = d.IsHeadquarters, IsActive = d.IsActive, DisplayOrder = d.DisplayOrder, Description = d.Description };
}
