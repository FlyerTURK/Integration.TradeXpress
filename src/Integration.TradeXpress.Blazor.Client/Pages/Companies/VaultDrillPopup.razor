@using Integration.TradeXpress.Blazor.Client.Pages.Companies.Models
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Vaults
@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IVaultAppService VaultAppService

@* Kasa kalıcı drill popup'ı — kendi ekosistemi: veri yükleme, CRUD, filtre.
   Parent (CompanyListPage) yalnız görünürlük + şube kimliği verir. *@

<DxPopup @bind-Visible="Visible" @bind-Visible:event="VisibleChanged"
         HeaderText="@($"{BranchName} — {L["Menu:Vaults"]}")"
         Width="80%" MaxWidth="860px" MaxHeight="90vh" Scrollable="true"
         ShowCloseButton="true" CloseOnEscape="true" CloseOnOutsideClick="false">
    <Content>
        @if (Visible)
        {
            <DrillList TItem="VaultTreeItemViewModel"
                       Title="@L["Menu:Vaults"]"
                       EntityName="@L["Entity:Vault"]"
                       Items="@_items"
                       FilterPredicate="@Filter"
                       MinItems="1"
                       NewItemFactory="@(() => new VaultTreeItemViewModel())"
                       CloneFactory="@CompanyTreeMapping.CloneVault"
                       PersistCreate="PersistCreate"
                       PersistUpdate="PersistUpdate"
                       PersistDelete="PersistDelete"
                       OnItemSaved="OnItemSaved">
                <ToolbarActions>
                    <div style="display:flex; align-items:center; gap:0.4rem; white-space:nowrap;">
                        <DxCheckBox Checked="@_activeFilter"
                                    CheckedChanged="@((bool v) => { _activeFilter = v; })"
                                    CheckType="CheckType.Switch" />
                        <span>@(_activeFilter ? L["ActiveRecords"] : L["PassiveRecords"])</span>
                    </div>
                </ToolbarActions>
                <GridColumns>
                    <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" />
                    <DxGridDataColumn FieldName="IsDefault" Caption="@L["IsDefault"]" Width="100px" />
                </GridColumns>
                <EditContent Context="vault">
                    <DxFormLayout Data="@vault" CssClass="w-100">
                        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="8">
                            <DxTextBox @bind-Text="@vault.Name" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="4">
                            <DxSpinEdit @bind-Value="@vault.DisplayOrder" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["IsDefault"]" ColSpanMd="6">
                            <DxCheckBox @bind-Checked="@vault.IsDefault" CheckType="CheckType.Switch">
                                @(vault.IsDefault ? L["Yes"] : L["No"])
                            </DxCheckBox>
                            <div class="form-text text-muted small">@L["VaultDefaultHint"]</div>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["IsActive"]" ColSpanMd="6">
                            <DxCheckBox @bind-Checked="@vault.IsActive" CheckType="CheckType.Switch">
                                @(vault.IsActive ? L["Active"] : L["Passive"])
                            </DxCheckBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
                            <DxTextBox @bind-Text="@vault.Description" />
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </EditContent>
            </DrillList>
        }
    </Content>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public Guid BranchId { get; set; }
    [Parameter] public string BranchName { get; set; } = "";

    private List<VaultTreeItemViewModel> _items = new();
    private bool _activeFilter = true;
    private Guid _loadedForBranchId;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && BranchId != Guid.Empty && BranchId != _loadedForBranchId)
        {
            _loadedForBranchId = BranchId;
            await LoadAsync();
        }
        else if (!Visible)
        {
            _loadedForBranchId = Guid.Empty;
            _activeFilter = true;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            var list = await VaultAppService.GetListAsync(new VaultListRequestDto
            {
                MaxResultCount = DrillConsts.MaxInMemoryChildren,
                BranchId = BranchId,
            });
            _items = list.Items.Select(ToVm).ToList();
            if (list.TotalCount > _items.Count)
                await Notify.Warn(L["TradeXpress:Drill:CeilingReached"]);
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex);
        }
    }

    private bool Filter(VaultTreeItemViewModel v) => v.IsActive == _activeFilter;

    private void OnItemSaved(VaultTreeItemViewModel saved)
    {
        if (!saved.IsDefault) return;
        foreach (var v in _items)
            if (v != saved) v.IsDefault = false;
    }

    private async Task<VaultTreeItemViewModel> PersistCreate(VaultTreeItemViewModel vm)
        => ToVm(await VaultAppService.CreateAsync(new VaultCreateDto
        {
            BranchId = BranchId,
            Name = vm.Name,
            IsDefault = vm.IsDefault,
            DisplayOrder = vm.DisplayOrder,
            Description = vm.Description,
        }));

    private async Task<VaultTreeItemViewModel> PersistUpdate(VaultTreeItemViewModel vm)
        => ToVm(await VaultAppService.UpdateAsync(vm.Id!.Value, new VaultUpdateDto
        {
            Name = vm.Name,
            IsDefault = vm.IsDefault,
            IsActive = vm.IsActive,
            DisplayOrder = vm.DisplayOrder,
            Description = vm.Description,
        }));

    private Task PersistDelete(VaultTreeItemViewModel vm)
        => VaultAppService.DeleteAsync(vm.Id!.Value);

    private static VaultTreeItemViewModel ToVm(VaultListDto d) => new()
        { Id = d.Id, Name = d.Name, IsDefault = d.IsDefault, IsActive = d.IsActive, DisplayOrder = d.DisplayOrder };

    private static VaultTreeItemViewModel ToVm(VaultGetDto d) => new()
        { Id = d.Id, Name = d.Name, IsDefault = d.IsDefault, IsActive = d.IsActive, DisplayOrder = d.DisplayOrder, Description = d.Description };
}
