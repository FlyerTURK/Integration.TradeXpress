@page "/currencies/parities/new"
@page "/currencies/parities/{Id:guid}"
@using System
@using System.Collections.Generic
@using Integration.TradeXpress.Financials.Parities
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IParityAppService ParityAppService
@inject ILookupCache<CurrencyUnitListDto> CurrencyLookup
@inject IObjectMapper Mapper

@*
   Parity edit host = İNCE SARMAL: coordinator + döviz adayları (read-koordinatör/cache) + config.
   Global (host) parite tenant'ta salt-okunur (IsReadOnly). Base/Quote immutable (Layout Enabled=IsNew).
   commit/save/delete/close TEK yerde (generic CrudEditHost). ParityListPage'in EditComponentType'ı (TAB).
*@

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="ParityGetDto" TListDto="ParityListDto" TKey="Guid" TListRequestDto="ParityListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["Parity"].Value" IconCssClass="@TradeXpressIcons.Parity"
                  EntityValue="@(m => string.IsNullOrEmpty(m.BaseCode) ? null : $"{m.BaseCode}/{m.QuoteCode}")"
                  IsReadOnly="@(m => m.IsGlobal && CurrentTenant?.Id != null)"
                  ApplyNewDefaults="@(m => { m.IsActive = true; m.DisplayOrder = 1; })">
        <ParityLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" Currencies="@_currencies" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private IReadOnlyList<CurrencyUnitListDto> _currencies = Array.Empty<CurrencyUnitListDto>();
    private ICommitCoordinator<ParityGetDto, ParityListDto, Guid, ParityListRequestDto>? _coordinator;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<ParityGetDto, ParityListDto, Guid, ParityListRequestDto, ParityCreateDto, ParityUpdateDto>(
            ParityAppService, Mapper);

        try { _currencies = await CurrencyLookup.GetAsync(); }
        catch { _currencies = Array.Empty<CurrencyUnitListDto>(); }

        _ready = true;
    }
}
