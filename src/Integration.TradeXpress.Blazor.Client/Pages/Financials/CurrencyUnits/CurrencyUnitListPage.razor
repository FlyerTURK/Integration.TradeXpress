@page "/currencies/currency-units"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Pages.Financials.CurrencyUnits.Models
@using Integration.TradeXpress.Blazor.Client.Pages.Financials.CurrencyUnits.Components
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.TradeXpress.Financials.Parities
@using DevExpress.Blazor
@using Volo.Abp.MultiTenancy

@inherits CrudPageBase<CurrencyUnitGetDto, CurrencyUnitListDto, Guid, CurrencyUnitListRequestDto, CurrencyUnitCreateDto, CurrencyUnitUpdateDto>

<CrudLayout TGetDto="CurrencyUnitGetDto"
            TListDto="CurrencyUnitListDto"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["CurrencyUnit"]"
            EntityIcon="@TradeXpressIcons.CurrencyUnit"
            PrimaryTextSelector="@(m => m.Code)"
            PageTitle="@L["CurrencyUnits"]"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync"
            CustomActions="@MarginActions"
            AllowColumnReordering="true">

    <GridColumns>
        @* Sıra: Kod · Ad · Alış · Satış (Ad band dışında, Kod'un hemen sağında). *@
        <GridLinkColumn FieldName="Code" Caption="@L["Code"]" Width="90px" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                        OnClick="@(o => BeforeUpdateAsync((CurrencyUnitListDto)o))" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" MinWidth="180" Width="220px" VisibleIndex="1" />

        @* Canlı alış/satış özet kolonları; flash+gradyan burada da aktif. *@
        <DxGridDataColumn Caption="@L["Buy"]" Width="110px" AllowSort="false" VisibleIndex="2" TextAlignment="GridTextAlignment.Right">
            <CellDisplayTemplate>
                @{ var _qbid = ((CurrencyUnitListDto)context.DataItem).Id; }
                <span style="@PriceCellStyle(_qbid, true)"><b>@LivePrice(_qbid, buy: true)</b></span>
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn Caption="@L["Sell"]" Width="110px" AllowSort="false" VisibleIndex="3" TextAlignment="GridTextAlignment.Right">
            <CellDisplayTemplate>
                @{ var _qsid = ((CurrencyUnitListDto)context.DataItem).Id; }
                <span style="@PriceCellStyle(_qsid, false)"><b>@LivePrice(_qsid, buy: false)</b></span>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        @* Diğer kimlik kolonları "Genel Bilgiler" band'ı altında. *@
        <DxGridBandColumn Caption="@L["GeneralInfo"]" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="4">
            <Columns>
                <DxGridDataColumn FieldName="Type" Caption="@L["Type"]" Width="90px" TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate>@L[$"Enum:CurrencyUnitType:{((CurrencyUnitListDto)context.DataItem).Type}"]</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="IsGlobal" Caption="@L["Kind"]" Width="90px" TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate>@(((CurrencyUnitListDto)context.DataItem).IsGlobal ? L["CurrencyKind:Global"] : L["CurrencyKind:Company"])</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="AlwaysShowInBalance" Caption="@L["AlwaysShowInBalance"]" Width="110px" TextAlignment="GridTextAlignment.Left">
                    <CellDisplayTemplate>@(((CurrencyUnitListDto)context.DataItem).AlwaysShowInBalance ? L["Show"].Value : "")</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="80px" />
            </Columns>
        </DxGridBandColumn>

        <DxGridBandColumn Caption="@L["FollowingAndMargin"]" Visible="@IsTenantMode" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="5">
            <Columns>
                @* Takip birimi de bir para birimi → edit'ini MDI sekmesinde aç (linkli). *@
                <GridLinkColumn FieldName="FollowingUnitCode" Caption="@L["FollowingUnit"]" Width="100px" FixedPosition="GridColumnFixedPosition.Left" VisibleIndex="1"
                                OnClick="@(o => OpenUnitAsync(((CurrencyUnitListDto)o).FollowingUnitId, ((CurrencyUnitListDto)o).FollowingUnitCode))" />
                <DxGridDataColumn Caption="@L["Buy"]" Width="95px" AllowSort="false" VisibleIndex="1" TextAlignment="GridTextAlignment.Right">
                    <CellDisplayTemplate>@FollowedPrice(((CurrencyUnitListDto)context.DataItem).FollowingUnitId, buy: true)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn Caption="@L["Sell"]" Width="95px" AllowSort="false" VisibleIndex="2" TextAlignment="GridTextAlignment.Right">
                    <CellDisplayTemplate>@FollowedPrice(((CurrencyUnitListDto)context.DataItem).FollowingUnitId, buy: false)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="FollowingMarginType" Caption="@L["MarginType"]" Width="100px" VisibleIndex="3">
                    <CellDisplayTemplate>@FollowingMarginTypeText(((CurrencyUnitListDto)context.DataItem).FollowingMarginType)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="FollowingMarginValue" Caption="@L["MarginValue"]" Width="100px" VisibleIndex="4" DisplayFormat="N5" />
            </Columns>
        </DxGridBandColumn>

        @* Alış/Satış band'ları EN SONDA: her biri Baz Fiyat · Marj Tipi · Marj · (bold) Fiyat *@
        <DxGridBandColumn Caption="@L["BuyPrice"]" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="6">
            <Columns>
                <DxGridDataColumn Caption="@L["BasePrice"]" Width="95px" AllowSort="false" TextAlignment="GridTextAlignment.Right">
                    <CellDisplayTemplate>@LiveRaw(((CurrencyUnitListDto)context.DataItem).Id, buy: true)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn Caption="@L["MarginType"]" Width="90px" AllowSort="false">
                    <CellDisplayTemplate>@LiveMarginType(((CurrencyUnitListDto)context.DataItem).Id, buy: true)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn Caption="@L["MarginValue"]" Width="80px" AllowSort="false" TextAlignment="GridTextAlignment.Right">
                    <CellDisplayTemplate>@LiveMarginValue(((CurrencyUnitListDto)context.DataItem).Id, buy: true)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn Caption="@L["Price"]" Width="110px" AllowSort="false" TextAlignment="GridTextAlignment.Right">
                    <CellDisplayTemplate>
                        @{ var _bid = ((CurrencyUnitListDto)context.DataItem).Id; }
                        <span style="@PriceCellStyle(_bid, true)"><b>@LivePrice(_bid, buy: true)</b></span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </DxGridBandColumn>
        <DxGridBandColumn Caption="@L["SellPrice"]" CaptionAlignment="GridTextAlignment.Center" VisibleIndex="7">
            <Columns>
                <DxGridDataColumn Caption="@L["BasePrice"]" Width="95px" AllowSort="false" TextAlignment="GridTextAlignment.Right">
                    <CellDisplayTemplate>@LiveRaw(((CurrencyUnitListDto)context.DataItem).Id, buy: false)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn Caption="@L["MarginType"]" Width="90px" AllowSort="false">
                    <CellDisplayTemplate>@LiveMarginType(((CurrencyUnitListDto)context.DataItem).Id, buy: false)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn Caption="@L["MarginValue"]" Width="80px" AllowSort="false" TextAlignment="GridTextAlignment.Right">
                    <CellDisplayTemplate>@LiveMarginValue(((CurrencyUnitListDto)context.DataItem).Id, buy: false)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn Caption="@L["Price"]" Width="110px" AllowSort="false" TextAlignment="GridTextAlignment.Right">
                    <CellDisplayTemplate>
                        @{ var _sid = ((CurrencyUnitListDto)context.DataItem).Id; }
                        <span style="@PriceCellStyle(_sid, false)"><b>@LivePrice(_sid, buy: false)</b></span>
                    </CellDisplayTemplate>
                </DxGridDataColumn>
            </Columns>
        </DxGridBandColumn>

    </GridColumns>

    

</CrudLayout>

@* Marj "Ayarla" diyaloğu — append-only SetAsync; kaydedince grid'i yeniler. *@
<MarginSetDialog @ref="MarginDialog" OnSaved="GetListAsync" />




