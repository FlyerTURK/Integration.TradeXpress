@page "/currencies/currency-units/new"
@page "/currencies/currency-units/{Id:guid}"
@using System
@using System.Linq
@using System.Collections.Generic
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject ICurrencyUnitAppService CurrencyUnitAppService
@inject IObjectMapper Mapper
@inject Integration.TradeXpress.Blazor.Client.Services.Mdi.ITabManager TabManager

@*
   CurrencyUnit edit host = ince sarmal: coordinator + takip adayları (referans) + config.
   Global birim tenant'ta salt-okunur (IsReadOnly). EnsureFollowingDefault: yeni/yüklü birimde takip boşsa
   bir global birime otomatik bağla (OnModelReady → snapshot öncesi). commit/save/delete/close generic host'ta.
*@

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="CurrencyUnitGetDto" TListDto="CurrencyUnitListDto" TKey="Guid" TListRequestDto="CurrencyUnitListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["CurrencyUnit"].Value" IconCssClass="@TradeXpressIcons.CurrencyUnit"
                  EntityValue="@(m => m.Code)"
                  IsReadOnly="@(m => m.IsGlobal && CurrentTenant?.Id != null)"
                  ApplyNewDefaults="@(m => { m.IsActive = true; m.DisplayOrder = 1; })"
                  OnModelReady="@(m => { EnsureFollowingDefault(m); return Task.CompletedTask; })">
        <CurrencyUnitLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" FollowCandidates="@_allUnits"
                            OnEditFollowingUnit="@OnEditFollowingUnitAsync" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private List<CurrencyUnitListDto> _allUnits = new();
    private ICommitCoordinator<CurrencyUnitGetDto, CurrencyUnitListDto, Guid, CurrencyUnitListRequestDto>? _coordinator;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<CurrencyUnitGetDto, CurrencyUnitListDto, Guid, CurrencyUnitListRequestDto, CurrencyUnitCreateDto, CurrencyUnitUpdateDto>(
            CurrencyUnitAppService, Mapper);

        var result = await CurrencyUnitAppService.GetListAsync(new CurrencyUnitListRequestDto { MaxResultCount = 1000 });
        _allUnits = result.Items.ToList();

        _ready = true;
    }

    // Takip birimi combo'sundaki ✎ → o birimin edit'ini MDI sekmesinde aç. (Bu host POPUP'ta açılabildiğinden
    // referansı popup'ta açmak nested-popup olur → TAB ile açıyoruz; grid linkleriyle de tutarlı.)
    private async Task OnEditFollowingUnitAsync(Guid? followingId)
    {
        if (followingId is not { } id || id == Guid.Empty) return;
        var code = _allUnits.FirstOrDefault(u => u.Id == id)?.Code;
        await TabManager.OpenOrActivateAsync(
            $"/currencies/currency-units/{id}",
            $"{L["CurrencyUnit"]}: {code}",
            TradeXpressIcons.CurrencyUnit);
    }

    // Tenant'ta bir birim mutlaka bir global birimi takip eder; takip boşsa otomatik bağla (önce aynı Tür'den
    // ilk global, yoksa ilk global). Host'ta / zaten seçiliyse / global birimde dokunma. (snapshot öncesi → dirty değil)
    private void EnsureFollowingDefault(CurrencyUnitGetDto m)
    {
        if (CurrentTenant?.Id == null || m.IsGlobal || m.FollowingUnitId.HasValue) return;
        var pool = _allUnits.Where(u => u.Id != m.Id).ToList();
        var match = pool.FirstOrDefault(c => c.IsGlobal && c.Type == m.Type)
                 ?? pool.FirstOrDefault(c => c.IsGlobal);
        if (match != null)
        {
            m.FollowingUnitId = match.Id;
            m.FollowingMarginType = MarginType.Multiply;
            m.FollowingMarginValue = 1m;
        }
    }
}
