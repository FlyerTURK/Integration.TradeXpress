@page "/accounts/new"
@page "/accounts/{Id:guid}"
@using System
@using System.Linq
@using System.Collections.Generic
@using Integration.TradeXpress.Accounts
@using Integration.TradeXpress.Companies
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.TradeXpress.Blazor.Client.Pages.Financials.CurrencyUnits
@using Integration.TradeXpress.Blazor.Client.Services.Working
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IAccountAppService AccountAppService
@inject ICurrencyUnitAppService CurrencyUnitAppService
@inject ICompanyAppService CompanyAppService
@inject IWorkingContextService Working
@inject IObjectMapper Mapper
@inject Integration.TradeXpress.Blazor.Client.Services.Mdi.ITabManager TabManager

@*
   Account edit host = ince sarmal: coordinator + para birimi adayları + şirket varsayılanları (limit/bakiye birimi
   = şirketin bilanço/base birimi). CompanyId çalışma bağlamından gelir (company-scoped). commit/save generic host'ta.
*@

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="AccountGetDto" TListDto="AccountListDto" TKey="Guid" TListRequestDto="AccountListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["Account"].Value" IconCssClass="@TradeXpressIcons.Account"
                  EntityValue="@(m => m.Code)"
                  ApplyNewDefaults="@(m => ApplyNew(m))">
        <AccountLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" Currencies="@_units"
                       OnEditCurrency="@OnEditCurrencyAsync" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    /// <summary>true (default): yeni Account'a otomatik bir default SubAccount eklenir. false: eklenmez
    /// (ör. SubAccount manuel oluşturulurken account inline eklenirse çift kayıt olmasın).</summary>
    [Parameter] public bool CreateChilds { get; set; } = true;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private List<CurrencyUnitListDto> _units = new();
    private Guid? _companyBaseUnitId;
    private ICommitCoordinator<AccountGetDto, AccountListDto, Guid, AccountListRequestDto>? _coordinator;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<AccountGetDto, AccountListDto, Guid, AccountListRequestDto, AccountCreateDto, AccountUpdateDto>(
            AccountAppService, Mapper);

        var res = await CurrencyUnitAppService.GetListAsync(new CurrencyUnitListRequestDto { MaxResultCount = 1000 });
        _units = res.Items.ToList();

        await Working.EnsureLoadedAsync();
        if (Working.CurrentCompanyId is { } cid)
        {
            try { _companyBaseUnitId = (await CompanyAppService.GetAsync(cid)).BaseCurrencyUnitId; }
            catch { /* şirket okunamadıysa varsayılan atlanır */ }
        }

        _ready = true;
    }

    // Yeni kayıt: company = çalışma şirketi; bakiye+limit birimi varsayılan = şirketin bilanço/base birimi.
    // Ayrıca varsayılan "ANAHESAP" alt hesabı (BranchId=null) eklenir → her cari hesap en az 1 alt hesapla doğar.
    private void ApplyNew(AccountGetDto m)
    {
        m.IsActive = true;
        m.CompanyId = Working.CurrentCompanyId ?? Guid.Empty;
        if (_companyBaseUnitId is { } b)
        {
            m.BalanceCurrencyUnitId ??= b;
            m.LimitUnitId ??= b;
        }
        if (CreateChilds && m.SubAccounts.Count == 0)
        {
            m.SubAccounts.Add(new SubAccountGraphDto
            {
                Code = AccountConsts.DefaultSubAccountCode,
                Name = AccountConsts.DefaultSubAccountName,
            });
        }
    }

    private async Task OnEditCurrencyAsync(Guid? unitId)
    {
        if (unitId is not { } id || id == Guid.Empty) return;
        var code = _units.FirstOrDefault(u => u.Id == id)?.Code;
        await TabManager.OpenOrActivateAsync(
            $"/currencies/currency-units/{id}",
            $"{L["CurrencyUnit"]}: {code}",
            TradeXpressIcons.CurrencyUnit);
    }
}
