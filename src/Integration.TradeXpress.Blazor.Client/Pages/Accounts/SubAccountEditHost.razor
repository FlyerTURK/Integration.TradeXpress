@page "/sub-accounts/new"
@page "/sub-accounts/{Id:guid}"
@using System
@using Integration.TradeXpress.Accounts
@using Integration.TradeXpress.Permissions
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@using DevExpress.Blazor
@inherits CrudComponentBase
@inject ISubAccountAppService SubAccountAppService
@inject IAccountAppService AccountAppService
@inject IObjectMapper Mapper

@if (_coordinator != null)
{
    <CrudEditHost TGetDto="SubAccountGetDto" TListDto="SubAccountListDto" TKey="Guid" TListRequestDto="SubAccountListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["SubAccount"].Value" IconCssClass="@TradeXpressIcons.SubAccount"
                  EntityValue="@(m => m.Code)"
                  ApplyNewDefaults="@ApplyNewSubAccountDefaults"
                  Context="m">
        
        <DxFormLayout CssClass="w-100">
            @* Cari (Account) lookup — Code'dan ÖNCE yarım satır; yeni kayıtta seçilir, edit'te salt-okunur (UpdateDto'da AccountId yok).
               CanAdd/CanEdit KAPALI (bilinçli): bu form kendisi popup'ta açılır; içinden Account popup'ı açmak
               PopupService tek-popup modelinde bu formu EZER (iç içe popup istisnası). Ana hesap yönetimi çağıran
               yüzeyin Account lookup'ında (ör. AccountSelectionPanel üst combosu / Account listesi). *@
            <DxFormLayoutItem Caption="@($"{L["Account"]} *")" ColSpanMd="6">
                <LookupComboBox TItem="AccountListDto" TValue="Guid?"
                                Data="@_accounts"
                                ValueFieldName="@nameof(AccountListDto.Id)"
                                TextFieldName="@nameof(AccountListDto.Code)"
                                Value="@(m.AccountId == Guid.Empty ? (Guid?)null : m.AccountId)"
                                ValueChanged="@((Guid? id) => m.AccountId = id ?? Guid.Empty)"
                                Enabled="@(m.Id == Guid.Empty)"
                                NullText="@L["Select"].Value"
                                CanAdd="false"
                                CanEdit="false">
                    <Columns>
                        <DxListEditorColumn FieldName="@nameof(AccountListDto.Code)" Caption="@L["Code"].Value" Width="40%" />
                        <DxListEditorColumn FieldName="@nameof(AccountListDto.Name)" Caption="@L["Name"].Value" />
                    </Columns>
                </LookupComboBox>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6" BeginRow="true"><DxTextBox @bind-Text="m.Code" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12"><DxTextBox @bind-Text="m.Name" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
                <DxCheckBox @bind-Checked="m.IsActive" CheckType="CheckType.Switch">
                    @(m.IsActive ? L["Active"] : L["Passive"])
                </DxCheckBox>
            </DxFormLayoutItem>
        </DxFormLayout>

    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    /// <summary>Parent account (yeni subaccount için; SubAccountListPage AdditionalEditParameters ile geçirir).</summary>
    [Parameter] [SupplyParameterFromQuery] public Guid? AccountId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private ICommitCoordinator<SubAccountGetDto, SubAccountListDto, Guid, SubAccountListRequestDto>? _coordinator;
    private List<AccountListDto> _accounts = new();

    protected override void OnInitialized()
        => _coordinator = new PersistentCoordinator<SubAccountGetDto, SubAccountListDto, Guid, SubAccountListRequestDto, SubAccountCreateDto, SubAccountUpdateDto>(
            SubAccountAppService, Mapper);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var res = await AccountAppService.GetListAsync(new AccountListRequestDto { MaxResultCount = 1000 });
        _accounts = res.Items.ToList();
    }

    // Yeni subaccount: parent account + active default
    private void ApplyNewSubAccountDefaults(SubAccountGetDto m)
    {
        m.IsActive = true;
        if (AccountId.HasValue)
            m.AccountId = AccountId.Value;
    }
}


