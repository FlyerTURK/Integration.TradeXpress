@page "/sub-accounts/new"
@page "/sub-accounts/{Id:guid}"
@using System
@using Integration.TradeXpress.Accounts
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@using DevExpress.Blazor
@inherits CrudComponentBase
@inject ISubAccountAppService SubAccountAppService
@inject IObjectMapper Mapper

@if (_coordinator != null)
{
    <CrudEditHost TGetDto="SubAccountGetDto" TListDto="SubAccountListDto" TKey="Guid" TListRequestDto="SubAccountListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["SubAccount"].Value" IconCssClass="@TradeXpressIcons.SubAccount"
                  EntityValue="@(m => m.Code)"
                  ApplyNewDefaults="@ApplyNewSubAccountDefaults"
                  Context="m">
        
        <DxFormLayout CssClass="w-100">
            <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6"><DxTextBox @bind-Text="m.Code" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12"><DxTextBox @bind-Text="m.Name" /></DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
                <DxCheckBox @bind-Checked="m.IsActive" CheckType="CheckType.Switch">
                    @(m.IsActive ? L["Active"] : L["Passive"])
                </DxCheckBox>
            </DxFormLayoutItem>
        </DxFormLayout>

    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    /// <summary>Parent account (yeni subaccount için; SubAccountListPage AdditionalEditParameters ile geçirir).</summary>
    [Parameter] [SupplyParameterFromQuery] public Guid? AccountId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private ICommitCoordinator<SubAccountGetDto, SubAccountListDto, Guid, SubAccountListRequestDto>? _coordinator;

    protected override void OnInitialized()
        => _coordinator = new PersistentCoordinator<SubAccountGetDto, SubAccountListDto, Guid, SubAccountListRequestDto, SubAccountCreateDto, SubAccountUpdateDto>(
            SubAccountAppService, Mapper);

    // Yeni subaccount: parent account + active default
    private void ApplyNewSubAccountDefaults(SubAccountGetDto m)
    {
        m.IsActive = true;
        if (AccountId.HasValue)
            m.AccountId = AccountId.Value;
    }
}


