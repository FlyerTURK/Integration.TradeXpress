@page "/cari-islemler"
@using DevExpress.Blazor
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.TradeXpress.Vouchers
@using Integration.TradeXpress.Accounts
@using System.Threading
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@implements IDisposable
@inject IEffectivePriceAppService PriceService
@inject IVoucherAppService VoucherService
@inject Integration.Framework.Blazor.Client.Services.Base.ITradeXpressUiService Ui
@inject ITabManager Tabs

<DxLayoutBreakpoint MaxWidth="768" @bind-IsActive="@_isMobile" />

<div style="@GridStyle()">

    @* Liste modunda gizli (display:none) — state korunur (Geri'de cari/fiş seçimi kaybolmaz). *@
    <div style="@($"{PanelBox()} grid-area:p1; min-height:unset; overflow:hidden;{(_listMode ? " display:none;" : "")}")">
        <AccountSelectionPanel @ref="_accountPanel"
                               OnLineSaved="@OnLineSaved"
                               OnSubAccountSelected="@OnSubAccountSelected"
                               OnVoucherOpened="@OnVoucherOpened"
                               OnProcessActiveChanged="@(v => _processActive = v)"
                               OnLockChanged="@(v => _accountLocked = v)"
                               OnListRequested="@EnterListModeAsync" />
    </div>

    <div style="@($"{PanelBox()} grid-area:p2; display:grid; grid-template-rows:auto 1fr; {(_isMobile ? "min-height:340px;" : "min-height:0;")}")">
        @if (_listMode)
        {
            <DxToolbar Adaptive="false">
                <DxToolbarItem BeginGroup="true">
                    <Template>
                        <DxDateRangePicker StartDate="@_listStart" EndDate="@_listEnd"
                                           StartDateChanged="@((DateTime? d) => OnListRangeChanged(d ?? _listStart, _listEnd))"
                                           EndDateChanged="@((DateTime? d) => OnListRangeChanged(_listStart, d ?? _listEnd))"
                                           DisplayFormat="dd.MM.yyyy" style="width:280px;" />
                    </Template>
                </DxToolbarItem>
                <DxToolbarItem Text="@L["Back"].Value" IconCssClass="fas fa-arrow-left" Click="@ExitListModeAsync" />
            </DxToolbar>
        }
        @* Düzelt/Sil: yalnız cari panel KİLİTLİ (TAMAM) ve process paneli KAPALI iken; liste modunda da görünür. *@
        @if (_accountLocked && !_processActive)
        {
            <DxToolbar>
                <DxToolbarItem Text="@L["Edit"].Value" IconCssClass="fas fa-pen-to-square"
                               Enabled="@(_selectedLine != null)" Click="@OnEditLine" />
                <DxToolbarItem Text="@L["Delete"].Value" IconCssClass="fas fa-trash"
                               Enabled="@(_selectedLine != null)" Click="@OnDeleteLine" />
            </DxToolbar>
        }
        <div style="min-height:0; min-width:0; overflow:auto;">
        <DxGrid Data="@_voucherLines" ShowSearchBox="false" PageSize="50" CssClass="h-100"
                KeyFieldName="@nameof(VoucherLineDto.Id)"
                ShowFilterRow="true"
                SelectionMode="GridSelectionMode.Single"
                AllowSelectRowByClick="true"
                SelectedDataItem="@_selectedLine"
                SelectedDataItemChanged="@OnLineSelected">
            <Columns>
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.VoucherDate)"   Caption="@nameof(VoucherLineDto.VoucherDate)"   DisplayFormat="dd.MM.yyyy HH:mm" Width="120px" Visible="@_listMode" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.VoucherNumber)" Caption="@nameof(VoucherLineDto.VoucherNumber)" Width="80px" Visible="@_listMode" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.ProcessCode)" Caption="@nameof(VoucherLineDto.ProcessCode)" Width="70px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.CommodityCode)"    Caption="@nameof(VoucherLineDto.CommodityCode)"    Width="90px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.Quantity)"         Caption="@nameof(VoucherLineDto.Quantity)"         DisplayFormat="N0" TextAlignment="GridTextAlignment.Right" Width="70px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.Amount)"           Caption="@nameof(VoucherLineDto.Amount)"           DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" Width="100px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.Factor)"           Caption="@nameof(VoucherLineDto.Factor)"           DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" Width="90px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.Total)"            Caption="@nameof(VoucherLineDto.Total)"            DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" Width="100px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.MainUnitCode)"     Caption="@nameof(VoucherLineDto.MainUnitCode)"     Width="100px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.PayFactor)"        Caption="@nameof(VoucherLineDto.PayFactor)"        DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" Width="100px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.PayTotal)"         Caption="@nameof(VoucherLineDto.PayTotal)"         DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" Width="100px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.PayCommodityCode)" Caption="@nameof(VoucherLineDto.PayCommodityCode)" Width="120px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.PayUnitCode)"      Caption="@nameof(VoucherLineDto.PayUnitCode)"      Width="100px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.MarketPrice)"      Caption="@nameof(VoucherLineDto.MarketPrice)"      DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" Width="100px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.Profit)"           Caption="@nameof(VoucherLineDto.Profit)"           DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" Width="100px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.DueDate)"          Caption="@nameof(VoucherLineDto.DueDate)"          DisplayFormat="dd.MM.yyyy" Width="100px" />
                <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.Description)"      Caption="@nameof(VoucherLineDto.Description)" />
            </Columns>
        </DxGrid>
        </div>
    </div>

    <div style="@($"{PanelBox()} grid-area:p3;{(_isMobile ? " min-height:380px;" : " width:300px;")}")">
        <DxTabs TabsPosition="TabsPosition.Bottom" CssClass="w-100">
            <DxTabPage Text="@L["Balance"].Value">
                @* Konsolide toplam — hesabın bakiye birimi cinsinden, canlı kurla; alacak=yeşil/borç=kırmızı gradyan.
                   Bakiye yoksa (0) gösterilmez. (≈ = bir birim değerlenemedi.) *@
                @if (_consTotal != 0m)
                {
                    <div style="@($"height:34px; display:flex; align-items:center; justify-content:center; padding:0 10px; border-radius:4px; color:#fff; font-weight:700; font-size:1.05rem; background:{(_consTotal >= 0m ? "linear-gradient(to bottom,#1b5e20,#66bb6a)" : "linear-gradient(to bottom,#7f0000,#ef5350)")};")">
                        @(_consComplete ? "" : "≈ ")@Math.Abs(_consTotal).ToString("N2") @_baseCode @(_consTotal < 0m ? "(B)" : "(A)")
                    </div>
                }
                <DxGrid Data="@_balanceRows" ShowSearchBox="false" PageSize="1000" CssClass="mt-2">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(VoucherBalanceLineDto.UnitCode)" Caption="@nameof(VoucherBalanceLineDto.UnitCode)" Width="70px" />
                        <DxGridDataColumn FieldName="@nameof(VoucherBalanceLineDto.Credit)" Caption="@nameof(VoucherBalanceLineDto.Credit)" TextAlignment="GridTextAlignment.Right">
                            <CellDisplayTemplate>
                                @{ var c = ((VoucherBalanceLineDto)context.DataItem).Credit; }
                                @if (c > 0)
                                {
                                    <span style="color:#2e7d32; font-weight:600;">@c.ToString("N2")</span>
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(VoucherBalanceLineDto.Debt)" Caption="@nameof(VoucherBalanceLineDto.Debt)" TextAlignment="GridTextAlignment.Right">
                            <CellDisplayTemplate>
                                @{ var d = ((VoucherBalanceLineDto)context.DataItem).Debt; }
                                @if (d > 0)
                                {
                                    <span style="color:#c62828; font-weight:600;">@d.ToString("N2")</span>
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>
                </DxGrid>
            </DxTabPage>
            <DxTabPage Text="@L["LiveRates"].Value">
                <DxGrid Data="@_liveRates" ShowSearchBox="false" PageSize="1000">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(CurrentPriceDto.CurrencyUnitCode)"
                                          Caption="@nameof(CurrentPriceDto.CurrencyUnitCode)" Width="70px" />
                        <DxGridDataColumn FieldName="@nameof(CurrentPriceDto.Buy)"
                                          Caption="@nameof(CurrentPriceDto.Buy)"  DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(CurrentPriceDto.Sell)"
                                          Caption="@nameof(CurrentPriceDto.Sell)" DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" />
                    </Columns>
                </DxGrid>
            </DxTabPage>
        </DxTabs>
    </div>

</div>

@* Silme onayı: rakam doğrulama + neden *@
<DxPopup @bind-Visible="@_showDeleteDialog" HeaderText="Satır Sil" Width="360px" ShowFooter="false">
    <BodyContentTemplate>
        <div style="display:flex; flex-direction:column; gap:10px;">
            <div>Silmek için doğrulayın: <b>@_deleteA + @_deleteB = ?</b></div>
            <DxSpinEdit TValue="int?" @bind-Value="@_deleteAnswer" ShowSpinButtons="false" CssClass="w-100" />
            <DxTextBox @bind-Text="@_deleteReason" NullText="Silme nedeni" CssClass="w-100" />
            <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:4px;">
                <DxButton Text="Sil" IconCssClass="fas fa-trash"
                          RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="@ConfirmDeleteAsync" />
                <DxButton Text="İptal"
                          RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="@(() => _showDeleteDialog = false)" />
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>

@code {
    private bool _isMobile;

    // VoucherLines — kaydedilen fişin satırları (p2 grid).
    private List<VoucherLineDto> _voucherLines = new();
    private object? _selectedLine;
    private Guid? _currentVoucherId;
    private AccountSelectionPanel? _accountPanel;
    private bool _processActive;   // süreç paneli açıkken Düzelt/Sil toolbar gizli
    private bool _accountLocked;   // cari panel TAMAM ile kilitliyken Düzelt/Sil görünür

    // Liste modu: cari'nin tarih aralığındaki tüm satırları (fiş-bağımsız). Sağ bakiye görünür kalır.
    private bool _listMode;
    private DateTime _listStart = DateTime.Today.AddDays(-7);
    private DateTime _listEnd   = DateTime.Today;

    // Bakiye (p3 Bakiye sekmesi) — anlık hesap.
    private List<VoucherBalanceLineDto> _balanceRows = new();
    private Guid? _currentSubAccountId;

    // Konsolide toplam — hesabın bakiye birimi cinsinden, canlı kurla (her tikte).
    private Guid    _baseUnitId;
    private string  _baseCode = string.Empty;
    private decimal _consTotal;
    private bool    _consComplete = true;

    private async Task OnLineSaved(Guid voucherId)
    {
        _currentVoucherId = voucherId;
        _voucherLines = await VoucherService.GetLinesAsync(voucherId);
        _selectedLine = null;
        await RefreshBalanceAsync();
        await InvokeAsync(StateHasChanged);
    }

    [CascadingParameter(Name = "CurrentMdiTab")]
    private Integration.Framework.Blazor.Client.Services.Mdi.IMdiTab? CurrentMdiTab { get; set; }

    private async Task OnSubAccountSelected(SubAccountListDto? sa)
    {
        _currentSubAccountId = sa?.Id;
        _voucherLines = new();   // farklı cari → satır gridini temizle

        // Sekme başlığı: cari seçilince 2 satır (L1=Hesap, L2=Alt hesap); seçim yoksa tek satır.
        if (CurrentMdiTab != null)
        {
            var header = sa is null
                ? new Integration.Framework.Blazor.Client.Services.Mdi.TabHeaderData { FormCaption = "Cari İşlemler" }
                : new Integration.Framework.Blazor.Client.Services.Mdi.TabHeaderData
                {
                    FormCaption = sa.AccountDisplay,
                    EntityValue = sa.SubAccountDisplay,
                    IconCssClass = "fas fa-right-left",
                };
            Tabs.UpdateTabHeader(CurrentMdiTab.Id, header);
        }

        await RefreshBalanceAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnVoucherOpened(Guid? voucherId)
    {
        // TAMAM → seçili fişin hareketlerini göster; yeni fiş/HESAP SEÇ → boşalt.
        _currentVoucherId = voucherId;
        _voucherLines = voucherId is { } id
            ? await VoucherService.GetLinesAsync(id)
            : new List<VoucherLineDto>();
        _selectedLine = null;
        await RefreshBalanceAsync();   // seçim yok → cari toplamı
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnterListModeAsync()
    {
        if (_currentSubAccountId is null)
        {
            Ui.ShowWarningToast("Önce cari seçin.");
            return;
        }
        _listMode = true;
        _selectedLine = null;
        await ReloadListAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnListRangeChanged(DateTime start, DateTime end)
    {
        _listStart = start;
        _listEnd   = end;
        await ReloadListAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadListAsync()
    {
        _voucherLines = _currentSubAccountId is { } id
            ? await VoucherService.GetLinesByDateRangeAsync(id, _listStart.Date, _listEnd.Date.AddDays(1))
            : new List<VoucherLineDto>();
    }

    private async Task ExitListModeAsync()
    {
        _listMode = false;
        _selectedLine = null;
        _voucherLines = _currentVoucherId is { } vid
            ? await VoucherService.GetLinesAsync(vid)
            : new List<VoucherLineDto>();
        await RefreshBalanceAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnEditLine()
    {
        if (_selectedLine is VoucherLineDto line && _accountPanel is not null)
        {
            var dto = await VoucherService.GetLineForEditAsync(line.Id);
            await _accountPanel.BeginEditLineAsync(dto);
        }
    }

    // ── Silme onayı (rakam doğrulama + neden) ──
    private static readonly Random _rng = new();
    private bool   _showDeleteDialog;
    private int    _deleteA, _deleteB;
    private int?   _deleteAnswer;
    private string _deleteReason = string.Empty;

    private void OnDeleteLine()
    {
        if (_selectedLine is not VoucherLineDto || _currentVoucherId is null)
            return;

        _deleteA      = _rng.Next(1, 10);
        _deleteB      = _rng.Next(1, 10);
        _deleteAnswer = null;
        _deleteReason = string.Empty;
        _showDeleteDialog = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_selectedLine is not VoucherLineDto line || _currentVoucherId is not { } vid)
            return;

        if (_deleteAnswer != _deleteA + _deleteB)
        {
            Ui.ShowWarningToast("Doğrulama toplamı yanlış.");
            return;
        }
        if (string.IsNullOrWhiteSpace(_deleteReason))
        {
            Ui.ShowWarningToast("Silme nedeni gerekli.");
            return;
        }

        _showDeleteDialog = false;
        await VoucherService.DeleteLineAsync(vid, line.Id, _deleteReason.Trim());
        _voucherLines = await VoucherService.GetLinesAsync(vid);
        _selectedLine = null;
        await RefreshBalanceAsync();
        await InvokeAsync(StateHasChanged);
        Ui.ShowSuccessToast("Satır silindi.");
    }

    private async Task OnLineSelected(object? item)
    {
        _selectedLine = item;
        if (item is VoucherLineDto line)
        {
            _balanceRows = line.RunningBalances;   // seçili satıra kadarki yürüyen bakiye
            ComputeConsolidated();
        }
        else
        {
            await RefreshBalanceAsync();            // seçim kalktı → cari toplamı
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshBalanceAsync()
    {
        if (_currentSubAccountId is { } id)
        {
            var res = await VoucherService.GetBalancesAsync(id);
            _balanceRows  = res.Lines;
            _baseUnitId   = res.BalanceUnitId;
            _baseCode     = res.BalanceCode;
        }
        else
        {
            _balanceRows = new List<VoucherBalanceLineDto>();
            _baseUnitId  = Guid.Empty;
            _baseCode    = string.Empty;
        }
        ComputeConsolidated();
    }

    /// <summary>Görünen bakiye satırlarını canlı kurla hesabın bakiye birimine çevirip toplar.
    /// Kuru olmayan birim → toplama katılmaz, ≈ (eksik) işaretlenir.</summary>
    private void ComputeConsolidated()
    {
        decimal total = 0m;
        var complete = true;

        var buyById = _liveRates.ToDictionary(p => p.Id, p => p.Buy);
        var baseBuy = buyById.GetValueOrDefault(_baseUnitId);

        foreach (var row in _balanceRows)
        {
            if (row.Net == 0m) continue;

            if (row.UnitId == _baseUnitId)
            {
                total += row.Net;                     // zaten base cinsinden
                continue;
            }

            var unitBuy = buyById.GetValueOrDefault(row.UnitId);
            if (unitBuy <= 0m || baseBuy <= 0m)
            {
                complete = false;                     // değerlenemedi
                continue;
            }

            total += row.Net * unitBuy / baseBuy;     // pivot üzerinden base'e çevir
        }

        _consTotal    = total;
        _consComplete = complete;
    }

    private string DirectionText(ProcessDirectionType d)
        => L[$"Enum:ProcessDirectionType:{d}"].Value;

    private string PaymentText(ProcessPaymentType? p)
        => p is { } v ? L[$"Enum:ProcessPaymentType:{v}"].Value : string.Empty;

    private List<CurrentPriceDto> _liveRates = new();
    private PeriodicTimer? _rateTimer;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await RefreshRatesAsync();
        _ = LiveRateLoopAsync();
    }

    private async Task LiveRateLoopAsync()
    {
        _rateTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await _rateTimer.WaitForNextTickAsync())
            {
                await RefreshRatesAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshRatesAsync()
    {
        try { _liveRates = await PriceService.GetCurrentPricesAsync(); }
        catch { }
        ComputeConsolidated();   // konsolide toplam canlı kurla her tikte tazelensin
    }

    public void Dispose() => _rateTimer?.Dispose();

    private string GridStyle()
    {
        if (_isMobile)
            return _listMode
                ? "display:grid; gap:10px; padding:10px; grid-template-columns:1fr; grid-template-areas:'p3' 'p2'; overflow-y:auto; max-height:calc(100vh - 110px);"
                : "display:grid; gap:10px; padding:10px; grid-template-columns:1fr; grid-template-areas:'p1' 'p3' 'p2'; overflow-y:auto; max-height:calc(100vh - 110px);";

        return _listMode
            ? "display:grid; gap:10px; padding:10px; height:calc(100vh - 110px); grid-template-columns:minmax(0,1fr) 300px; grid-template-areas:'p2 p3';"
            : "display:grid; gap:10px; padding:10px; height:calc(100vh - 110px); grid-template-columns:minmax(0,1fr) 300px; grid-template-rows:auto 1fr; grid-template-areas:'p1 p3' 'p2 p3';";
    }

    private static string PanelBox() =>
        "box-sizing:border-box; border-radius:12px; padding:8px; min-width:0;";
}
