@page "/cari-islemler"
@using System.Threading
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@implements IDisposable
@inject IEffectivePriceAppService PriceService
@inject IVoucherAppService VoucherService
@inject ITradeXpressUiService Ui
@inject ITabManager Tabs
@inject IGridExportAssemblyLoader ExportLoader

@* .tx-tabs-stretched kuralları main.css'te tek kaynak (E9: razor içi mükerrer <style> kaldırıldı). *@

<DxLayoutBreakpoint MaxWidth="768" @bind-IsActive="@_isMobile" />

<div style="@GridStyle()">

    @* Liste modunda gizli (display:none) — state korunur (Geri'de cari/fiş seçimi kaybolmaz). *@
    <div style="@($"{PanelBox()} grid-area:p1; min-height:unset; overflow:hidden;{(_listMode && !_processActive ? " display:none;" : "")}")">
        <AccountSelectionPanel @ref="_accountPanel"
                               InitialSubAccountId="@SubAccountId"
                               InitialVoucherId="@VoucherId"
                               OnLineSaved="@OnLineSaved"
                               OnSubAccountSelected="@OnSubAccountSelected"
                               OnVoucherOpened="@OnVoucherOpened"
                               OnProcessActiveChanged="@(v => _processActive = v)"
                               OnLockChanged="@(v => _accountLocked = v)"
                               OnListRequested="@EnterListModeAsync" />
    </div>

    @if (_currentSubAccountId.HasValue && _accountLocked)
    {
        <div style="@($"{PanelBox()} grid-area:p2; {(_isMobile ? "height:65vh; min-height:0; display:flex; flex-direction:column;" : "min-height:0; height:100%; display:flex; flex-direction:column;")}")">
            <DxTabs TabsPosition="TabsPosition.Bottom" CssClass="w-100 h-100 tx-tabs-stretched">
                <DxTabPage Text="@L["Transactions"].Value" TabIconCssClass="custom-icon-list">
                    <div style="display:flex; flex-direction:column; height:100%;">
                        <div style="flex-shrink:0; font-size:14px; font-weight:bold; text-align:center; letter-spacing:1px; text-transform:uppercase; width:100%; padding:6px; border-radius:4px 4px 0 0; background-color:color-mix(in srgb, var(--tx-theme-primary, var(--bs-primary, #0d6efd)) 8%, transparent);">
                            @L["TransactionList"].Value
                        </div>

                        @if (_accountLocked && !_processActive)
                        {
                            <div style="flex-shrink:0; padding:8px 12px; border-left:1px solid color-mix(in srgb, var(--tx-theme-primary, var(--bs-primary, #0d6efd)) 8%, transparent); border-right:1px solid color-mix(in srgb, var(--tx-theme-primary, var(--bs-primary, #0d6efd)) 8%, transparent); background-color:transparent;">
                                <DxToolbar Adaptive="false">
                                    @* Düzelt/Sil satır-içi ikonlar yerine toolbar BAŞINDA; seçili satır(lar) üzerinde çalışır (sade görünüm). *@
                                    <DxToolbarItem Text="@L["Edit"].Value" IconCssClass="custom-icon-edit" Click="@OnEditLine" Enabled="@(_selectedLine != null)" />
                                    <DxToolbarItem Text="@L["Delete"].Value" IconCssClass="custom-icon-delete" Click="@OnDeleteLine" Enabled="@(_selectedLines.Count >= 1)" />
                                    @if (_listMode)
                                    {
                                        @* Ekstre: işlem-tipi çoklu-seçim filtresi (server-side; devreden/kapanış da aynı filtreyle yürür). *@
                                        <DxToolbarItem BeginGroup="true" Alignment="ToolbarItemAlignment.Right">
                                            <Template Context="toolbarContext">
                                                <DxTagBox Data="@_processTypeItems"
                                                          TData="ProcessTypeItem" TValue="ProcessType"
                                                          Values="@_listTypes"
                                                          ValuesChanged="@(async (IEnumerable<ProcessType> v) => await OnListTypesChanged(v))"
                                                          ValuesExpression="@(() => _listTypes)"
                                                          ValueFieldName="@nameof(ProcessTypeItem.Value)"
                                                          TextFieldName="@nameof(ProcessTypeItem.Text)"
                                                          NullText="@L["AllProcessTypes"].Value"
                                                          ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                          style="width:260px;" />
                                            </Template>
                                        </DxToolbarItem>
                                        <DxToolbarItem BeginGroup="true" Alignment="ToolbarItemAlignment.Right">
                                            <Template Context="toolbarContext">
                                                <DxDateRangePicker StartDate="@_listStart" EndDate="@_listEnd"
                                                                   StartDateChanged="@((DateTime? d) => OnListRangeChanged(d ?? _listStart, _listEnd))"
                                                                   EndDateChanged="@((DateTime? d) => OnListRangeChanged(_listStart, d ?? _listEnd))"
                                                                   DisplayFormat="@L["ShortDateFormat"].Value" style="width:280px;" />
                                            </Template>
                                        </DxToolbarItem>
                                        @* Excel export — merkezi xaf export ikonu (CrudToolbarActions.Export ile aynı görsel). *@
                                        <DxToolbarItem BeginGroup="true" Alignment="ToolbarItemAlignment.Right"
                                                       Tooltip="@L["ExportToExcel"].Value"
                                                       IconUrl="/images/xaf/action_export_toxlsx.svg" IconCssClass="xaf-toolbar-item-icon"
                                                       Click="@ExportListToExcelAsync" />
                                        <DxToolbarItem BeginGroup="true" Alignment="ToolbarItemAlignment.Right" Text="@L["Back"].Value" IconCssClass="custom-icon-back" Click="@ExitListModeAsync" />
                                    }
                                </DxToolbar>
                            </div>
                        }

                        @if (_listMode && !_processActive)
                        {
                            @* Ekstre DEVREDEN şeridi (grid üstü): dönem öncesi birim-bazlı net — Bakiye sekmesi renk dili (yeşil=ALACAK, kırmızı=BORÇ). *@
                            <div style="flex-shrink:0; display:flex; align-items:center; gap:14px; flex-wrap:wrap; padding:5px 12px; font-size:12px; border-left:1px solid color-mix(in srgb, var(--tx-theme-primary, var(--bs-primary, #0d6efd)) 8%, transparent); border-right:1px solid color-mix(in srgb, var(--tx-theme-primary, var(--bs-primary, #0d6efd)) 8%, transparent); background-color:color-mix(in srgb, var(--tx-theme-primary, var(--bs-primary, #0d6efd)) 4%, transparent);">
                                <span style="font-weight:700; letter-spacing:0.5px;">@L["OpeningBalance"].Value.ToUpper()</span>
                                @foreach (var b in _listOpening.Where(x => x.Net != 0m))
                                {
                                    <span style="font-weight:600; color:@(b.Net > 0m ? "#2e7d32" : "#c62828");">@Math.Abs(b.Net).ToString("N2") @b.UnitCode @(b.Net > 0m ? "(A)" : "(B)")</span>
                                }
                                @if (_listOpening.All(x => x.Net == 0m))
                                {
                                    <span style="opacity:0.6;">—</span>
                                }
                            </div>
                        }
                        <div style="flex:1; min-height:0; min-width:0; overflow:hidden; display:flex; flex-direction:column;">
                            <DxGrid @ref="_listGrid" Data="@_voucherLines" ShowSearchBox="false" PageSize="50" CssClass="w-100 tx-grid-fill"
                                    KeyFieldName="@nameof(VoucherLineDto.Id)"
                                    ShowFilterRow="true"
                                    SelectionMode="GridSelectionMode.Multiple"
                                    AllowSelectRowByClick="true"
                                    SelectedDataItems="@_selectedLines"
                                    SelectedDataItemsChanged="@OnLinesSelected">
                                <Columns>
                                    @if (_accountLocked && !_processActive)
                                    {
                                        @* Çoklu-seçim kolonu (sola sabit); Düzelt/Sil toolbar'dan seçili satır(lar) üzerinde çalışır. *@
                                        <DxGridSelectionColumn Width="36px" FixedPosition="GridColumnFixedPosition.Left" AllowSelectAll="true" AllowReorder="false" />
                                    }
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.VoucherDate)"   Caption="@L["Date"].ToString().ToUpper()"   DisplayFormat="dd.MM.yyyy HH:mm" Width="120px" Visible="@_listMode" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.VoucherNumber)" Caption="@L["Nr"].ToString().ToUpper()" Width="80px" Visible="@_listMode" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.ProcessCode)" Caption="@L["Process"].ToString().ToUpper()" Width="70px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.CommodityCode)"    Caption="@L["Code"].ToString().ToUpper()"    Width="90px" />
                                    @* Virman karşı hesabı — ÖNDE (scroll'suz görünür; sağ uçtayken kullanıcı bulamıyordu). Yalnız Transfer satırlarında dolu. *@
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.CounterAccountCode)" Caption="@L["Transfer_CounterAccount"].ToString().ToUpper()" Width="110px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.Quantity)"         Caption="@L["Quantity"].ToString().ToUpper()"         DisplayFormat="N0" TextAlignment="GridTextAlignment.Right" Width="70px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.Amount)"           Caption="@L["Amount"].ToString().ToUpper()"           DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" Width="100px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.Factor)"           Caption="@L["Factor"].ToString().ToUpper()"           DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" Width="90px" />
                                    @* Takoz kolonları — YALNIZ takoz satırı varken görünür (diğer görünümlerde grid şişmesin). *@
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.ReportNo)"         Caption="@L["Voucher_Op_ReportNo"].ToString().ToUpper()" Width="90px"  Visible="@_hasBullionRows" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.AssayAmount)"      Caption="@L["BullionStock_Assay"].ToString().ToUpper()"  DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" Width="80px"  Visible="@_hasBullionRows" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.SilverFactor)"     Caption="@L["Voucher_Op_AgMilyem"].ToString().ToUpper()" DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" Width="90px"  Visible="@_hasBullionRows" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.PlatinumFactor)"   Caption="@L["Voucher_Op_PtMilyem"].ToString().ToUpper()" DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" Width="90px"  Visible="@_hasBullionRows" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.PalladiumFactor)"  Caption="@L["Voucher_Op_PdMilyem"].ToString().ToUpper()" DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" Width="90px"  Visible="@_hasBullionRows" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.Total)"            Caption="@L["Total"].ToString().ToUpper()"            DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" Width="100px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.MainUnitCode)"     Caption="@L["Unit"].ToString().ToUpper()"     Width="100px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.PayFactor)"        Caption="@L["Rate"].ToString().ToUpper()"        DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" Width="100px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.PayTotal)"         Caption="@L["Total"].ToString().ToUpper()"         DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" Width="100px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.PayCommodityCode)" Caption="@L["Unit"].ToString().ToUpper()" Width="120px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.PayUnitCode)"      Caption="@L["Code"].ToString().ToUpper()"      Width="100px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.MarketPrice)"      Caption="@L["Market"].ToString().ToUpper()"      DisplayFormat="N5" TextAlignment="GridTextAlignment.Right" Width="100px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.Profit)"           Caption="@L["Profit"].ToString().ToUpper()"           DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" Width="100px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.DueDate)"          Caption="@L["Due"].ToString().ToUpper()"          DisplayFormat="dd.MM.yyyy" Width="100px" />
                                    <DxGridDataColumn AllowSort="false" FieldName="@nameof(VoucherLineDto.CreatorName)"      Caption="@L["User"].ToString().ToUpper()"         Width="120px" Visible="@_listMode" />
                                </Columns>
                            </DxGrid>
                        </div>
                        @if (_listMode && !_processActive)
                        {
                            @* Ekstre KAPANIŞ (son durum) şeridi (grid altı): son yürüyen bakiye — Bakiye sekmesini bozmayan, Liste moduna özgü dip-toplam. *@
                            <div style="flex-shrink:0; display:flex; align-items:center; gap:14px; flex-wrap:wrap; padding:5px 12px; font-size:12px; border:1px solid color-mix(in srgb, var(--tx-theme-primary, var(--bs-primary, #0d6efd)) 8%, transparent); border-top:none; border-radius:0 0 4px 4px; background-color:color-mix(in srgb, var(--tx-theme-primary, var(--bs-primary, #0d6efd)) 8%, transparent);">
                                <span style="font-weight:700; letter-spacing:0.5px;">@L["ClosingBalance"].Value.ToUpper()</span>
                                @foreach (var b in _listClosing.Where(x => x.Net != 0m))
                                {
                                    <span style="font-weight:600; color:@(b.Net > 0m ? "#2e7d32" : "#c62828");">@Math.Abs(b.Net).ToString("N2") @b.UnitCode @(b.Net > 0m ? "(A)" : "(B)")</span>
                                }
                                @if (_listClosing.All(x => x.Net == 0m))
                                {
                                    <span style="opacity:0.6;">—</span>
                                }
                            </div>
                        }
                        @if (_selectedLine is VoucherLineDto selectedLine)
                        {
                            <div class="mt-2" style="flex-shrink:0;">
                                <DxMemo Text="@selectedLine.Description" ReadOnly="true" Rows="1" ResizeMode="MemoResizeMode.Vertical" CssClass="w-100" />
                            </div>
                        }
                    </div>
                </DxTabPage>
            </DxTabs>
        </div>
    }

    @if (_currentSubAccountId.HasValue)
    {
        <div style="@($"{PanelBox()} grid-area:p3;{(_isMobile ? "" : " width:300px; min-height:0; height:100%; display:flex; flex-direction:column;")}")">
            <DxTabs TabsPosition="TabsPosition.Bottom" CssClass="w-100 h-100 tx-tabs-stretched">
                <DxTabPage Text="@L["Balance"].Value">
                    <div style="display:flex; flex-direction:column; height:100%;">
                        @* Konsolide toplam — hesabın bakiye birimi cinsinden, canlı kurla; alacak=yeşil/borç=kırmızı gradyan.
                           Bakiye yoksa (0) gösterilmez. (≈ = bir birim değerlenemedi.) *@
                        @if (_consTotal != 0m)
                        {
                            <div style="@($"flex-shrink:0; height:34px; display:flex; align-items:center; justify-content:center; padding:0 10px; border-radius:4px 4px 0 0; color:#fff; font-weight:700; font-size:1.05rem; background:{(_consTotal >= 0m ? "var(--gradient-green)" : "var(--gradient-red)")};")">
                                @(_consComplete ? "" : "≈ ")@Math.Abs(_consTotal).ToString("N2") @_baseCode @(_consTotal < 0m ? "(B)" : "(A)")
                            </div>
                        }
                        <div style="flex:1; min-height:0; overflow:hidden; display:flex; flex-direction:column;">
                            <DxGrid Data="@_balanceRows" ShowSearchBox="false" PageSize="1000" CssClass="w-100 tx-grid-fill">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(VoucherBalanceLineDto.UnitCode)" Caption="@L["Code"].Value.ToString().ToUpper()" Width="70px" TextAlignment="GridTextAlignment.Left" CaptionAlignment="GridTextAlignment.Center"/>
                            <DxGridDataColumn FieldName="@nameof(VoucherBalanceLineDto.Credit)" Caption="@L["Credit"].Value.ToString().ToUpper()" TextAlignment="GridTextAlignment.Right" CaptionAlignment="GridTextAlignment.Center">
                                <CellDisplayTemplate>
                                    @{ var c = ((VoucherBalanceLineDto)context.DataItem).Credit; }
                                    @if (c > 0)
                                    {
                                        <span style="color:#2e7d32; font-weight:600;">@c.ToString("N2")</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(VoucherBalanceLineDto.Debt)" Caption="@L["Debit"].Value.ToString().ToUpper()" TextAlignment="GridTextAlignment.Right" CaptionAlignment="GridTextAlignment.Center">
                                <CellDisplayTemplate>
                                    @{ var d = ((VoucherBalanceLineDto)context.DataItem).Debt; }
                                    @if (d > 0)
                                    {
                                        <span style="color:#c62828; font-weight:600;">@d.ToString("N2")</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                        </Columns>
                    </DxGrid>
                        </div>
                    </div>
                </DxTabPage>
                <DxTabPage Text="@L["LiveRates"].Value">
                    <div style="display:flex; flex-direction:column; height:100%;">
                        <div style="flex:1; min-height:0; overflow:hidden; display:flex; flex-direction:column;">
                            <DxGrid Data="@_liveRates" ShowSearchBox="false" PageSize="1000" CssClass="w-100 h-100">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(CurrentPriceDto.CurrencyUnitCode)"
                                              Caption="@nameof(CurrentPriceDto.CurrencyUnitCode)" Width="70px" />
                            <DxGridDataColumn FieldName="@nameof(CurrentPriceDto.Buy)"
                                              Caption="@nameof(CurrentPriceDto.Buy)" TextAlignment="GridTextAlignment.Right" Width="115px">
                                <CellDisplayTemplate>
                                    @{ var row = (CurrentPriceDto)context.DataItem; }
                                    <span style="@PriceCellStyle(row.Id, true)"><b>@row.Buy.ToString("N5")</b></span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(CurrentPriceDto.Sell)"
                                              Caption="@nameof(CurrentPriceDto.Sell)" TextAlignment="GridTextAlignment.Right" Width="115px">
                                <CellDisplayTemplate>
                                    @{ var row = (CurrentPriceDto)context.DataItem; }
                                    <span style="@PriceCellStyle(row.Id, false)"><b>@row.Sell.ToString("N5")</b></span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                        </Columns>
                    </DxGrid>
                        </div>
                    </div>
                </DxTabPage>
            </DxTabs>
        </div>
    }

</div>

@* Silme onayı: rakam doğrulama + neden *@
<DxPopup @bind-Visible="@_showDeleteDialog" HeaderText="Satır Sil" Width="360px" ShowFooter="false">
    <BodyContentTemplate>
        <div style="display:flex; flex-direction:column; gap:10px;">
            <div><b>@_selectedLines.Count</b> satır silinecek. Doğrulayın: <b>@_deleteA + @_deleteB = ?</b></div>
            <DxSpinEdit TValue="int?" @bind-Value="@_deleteAnswer" ShowSpinButtons="false" CssClass="w-100" />
            <DxTextBox @bind-Text="@_deleteReason" NullText="Silme nedeni" CssClass="w-100" />
            <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:4px;">
                <DxButton Text="Sil" IconCssClass="custom-icon-delete"
                          RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="@ConfirmDeleteAsync" />
                <DxButton Text="İptal"
                          RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Contained"
                          Click="@(() => _showDeleteDialog = false)" />
            </div>
        </div>
    </BodyContentTemplate>
</DxPopup>
