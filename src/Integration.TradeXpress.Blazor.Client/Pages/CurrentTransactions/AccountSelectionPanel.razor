@using DevExpress.Blazor
@using Integration.TradeXpress.Accounts
@using Integration.TradeXpress.Vouchers
@using Integration.TradeXpress.Vaults
@using System.Globalization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject ISubAccountAppService SubAccountService
@inject IVoucherAppService VoucherService
@inject IVaultAppService VaultService
@inject Integration.TradeXpress.Blazor.Client.Services.Working.IWorkingContextService Working
@inject Integration.Framework.Blazor.Client.Services.Base.ITradeXpressUiService Ui
@inject Integration.Framework.Blazor.Client.Services.Base.IViewOpener ViewOpener
@inject Integration.Framework.Blazor.Client.Services.Base.IPopupService PopupService

@if (_activeProcess == null)
{
<div class="d-flex flex-column account-selection-wrapper">
    <div class="d-flex flex-column flex-md-row gap-3">
        <!-- Sol Panel -->
        <div style="flex: 0 0 auto; width: 100%; max-width: 700px;">
            <DxFormLayout>
                <!-- Row 1 -->
                <DxFormLayoutItem Caption="@L["Account"]" ColSpanMd="12">
                    <LookupComboBox TItem="SubAccountListDto" TValue="Guid?"
                                    Data="@_subAccounts"
                                    ValueFieldName="@nameof(SubAccountListDto.Id)"
                                    TextFieldName="@nameof(SubAccountListDto.AccountSubCodeDisplay)"
                                    Value="@_model.SubAccountId"
                                    ValueChanged="@OnSubAccountChanged"
                                    LostFocus="@OnSubAccountLostFocus"
                                    NullText="@L["Select"].Value"
                                    AllowClear="true"
                                    Enabled="@(!_locked)"
                                    OnEditRequested="@OnEditSubAccountAsync"
                                    OnAddRequested="@OnAddSubAccountAsync">
                        <Columns>
                            <DxListEditorColumn FieldName="@nameof(SubAccountListDto.AccountDisplay)"
                                                Caption="@L["Account"]" Width="50%" />
                            <DxListEditorColumn FieldName="@nameof(SubAccountListDto.SubAccountDisplay)"
                                                Caption="@L["SubAccount"]" />
                        </Columns>
                    </LookupComboBox>
                </DxFormLayoutItem>

                <!-- Row 2 -->
                <DxFormLayoutItem Caption="@L["VoucherSelection"].Value" ColSpanMd="6" Visible="@(_model.SubAccountId.HasValue)">
                    <DxComboBox TData="VoucherComboItem" TValue="Guid?"
                                Data="@_voucherItems"
                                ValueFieldName="@nameof(VoucherComboItem.Id)"
                                TextFieldName="@nameof(VoucherComboItem.DisplayText)"
                                Value="@_selectedVoucherId"
                                ValueChanged="@OnVoucherChanged"
                                DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                NullText="@L["NewVoucherPlaceholder"].Value"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                Enabled="@(!_locked)"
                                CssClass="w-100">

                        <Columns>
                            <DxListEditorColumn FieldName="@nameof(VoucherComboItem.VoucherNo)"
                                                Caption="@L["VoucherNumber"].Value" Width="120px" />
                            <DxListEditorColumn FieldName="@nameof(VoucherComboItem.Date)"
                                                Caption="@L["Date"].Value" />
                            <DxListEditorColumn FieldName="@nameof(VoucherComboItem.CurrentTransactionCount)" Caption="@L["Count"].Value" />
                        </Columns>
                    </DxComboBox>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="@L["Vault"].Value" ColSpanMd="6" Visible="@(_model.SubAccountId.HasValue)">
                    @if (_selectedVoucherId.HasValue)
                    {
                        <DxTextBox Text="@_selectedVaultDisplay" Enabled="false" CssClass="w-100" />
                    }
                    else
                    {
                        <DxComboBox TData="VaultListDto" TValue="Guid?"
                                    Data="@_branchVaults"
                                    ValueFieldName="@nameof(VaultListDto.Id)"
                                    TextFieldName="@nameof(VaultListDto.Code)"
                                    Value="@_model.VaultId"
                                    ValueChanged="@((Guid? id) => { _model.VaultId = id; })"
                                    DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                    NullText="@L["SelectVault"].Value"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    Enabled="@(!_locked)"
                                    CssClass="w-100">
                            <DxListEditorColumn FieldName="@nameof(VaultListDto.Code)" Caption="@L["Code"].Value" Width="100px" />
                            <DxListEditorColumn FieldName="@nameof(VaultListDto.Name)" Caption="@L["Name"].Value" />
                        </DxComboBox>
                    }
                </DxFormLayoutItem>

                <!-- Row 3 -->
                <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12" Visible="@(_model.SubAccountId.HasValue)">
                    <DxTextBox @bind-Text="@_model.Description"
                               Enabled="@(!_locked && !_selectedVoucherId.HasValue)"
                               CssClass="w-100" />
                </DxFormLayoutItem>

                <!-- Row 4 -->
                <DxFormLayoutItem Caption="@L["Date"].Value" ColSpanMd="6" Visible="@(_model.SubAccountId.HasValue)">
                    <DxDateEdit Date="@_displayVoucherDate"
                                DateChanged="@((DateTime? d) => OnVoucherDateChanged(d ?? DateTime.Now))"
                                Enabled="@(!_locked && !_selectedVoucherId.HasValue)"
                                Format="dd.MM.yyyy HH:mm"
                                TimeSectionVisible="true"
                                CssClass="w-100" />
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="6" Visible="@(_model.SubAccountId.HasValue)">
                    <div style="display:flex; justify-content:flex-end; width:100%; height:100%; align-items:flex-end;">
                        <DxButton Text="@(_locked ? L["SelectAccount"].Value : L["Confirm"].Value)"
                                  IconCssClass="@(_locked ? "custom-icon-address-card" : "custom-icon-check")"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  Click="@OnConfirmClicked" />
                    </div>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>

        <!-- Sağ Panel (Boş) -->
        <div class="right-selection-panel flex-grow-1">
            <!-- İleride buraya başka editler eklenecek -->
        </div>
    </div>

    @if (_showActionToolbar)
    {
        <hr class="my-2" style="border-top: 1px solid var(--bs-border-color);" />
        <DxToolbar AdaptivityAutoHideRootItems="false" AdaptivityAutoCollapseItemsToIcons="false" CssClass="mt-2">
            <DxToolbarItem BeginGroup="true" Text="@($"3-{L["Metal"].ToString().ToUpper()}")" IconCssClass="custom-icon-metal" Click="@OnMetalClicked" />
            <DxToolbarItem BeginGroup="true" Text="@($"4-{L["Scrap"].ToString().ToUpper()}")" IconCssClass="custom-icon-scrap" Click="@OnScrapClicked" />
            <DxToolbarItem BeginGroup="true" Text="@($"5-{L["CashProcess"].ToString().ToUpper()}")" IconCssClass="custom-icon-cash" Click="@OnCashClicked" />
            <DxToolbarItem BeginGroup="true" Text="@($"6-{L["Convert"].ToString().ToUpper()}")" IconCssClass="custom-icon-convert" Click="@OnConvertClicked" />
            <DxToolbarItem BeginGroup="true" Text="@($"7-{L["Service"].ToString().ToUpper()}")" IconCssClass="custom-icon-service" Click="@OnServiceClicked" />
            <DxToolbarItem BeginGroup="true" Text="@($"8-{L["Future"].ToString().ToUpper()}")" IconCssClass="custom-icon-future" Click="@OnFutureClicked" />
            <DxToolbarItem BeginGroup="true" Text="@($"9-{L["Stone"].ToString().ToUpper()}")" IconCssClass="custom-icon-stone" Click="@OnStoneClicked" />
            <DxToolbarItem BeginGroup="true" Text="@($"M-{L["Jewelry"].ToString().ToUpper()}")" IconCssClass="custom-icon-jewelry" Click="@OnJewelryClicked" />
            <DxToolbarItem BeginGroup="true" Text="@($"B-{L["Bullion"].ToString().ToUpper()}")" IconCssClass="custom-icon-bullion" Click="@OnBullionClicked" />
            <DxToolbarItem BeginGroup="true" Text="@($"0-{L["List"].ToString().ToUpper()}")" IconCssClass="custom-icon-list" Click="@OnListClicked" />
        </DxToolbar>
    }
</div>
}

