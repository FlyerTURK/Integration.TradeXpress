@inject IVoucherAppService VoucherService
@inject IVaultAppService VaultService
@inject Integration.TradeXpress.Blazor.Client.Services.Working.IWorkingContextService Working
@inject IUiInteractionService Ui
@inject IViewOpener ViewOpener
@inject IPopupService PopupService

<style>
    /* İşlem tipi butonları dar ekranda alt satıra aksın (wrap).
       KÖK NEDEN (tema CSS + DxToolbar kaynak analizi, DevExpress 25.2.5):
       1) DxToolbar kök elemente Adaptivity* parametreleri false olsa bile HER ZAMAN
          'dxbl-toolbar-adaptive' class'ı basar (DxToolbar.GetCssClass sabit yield).
       2) Butonları taşıyan gerçek flex konteyner kök değil, içteki '.dxbl-btn-toolbar'dır;
          adaptive modda tema onu 'position:absolute' yapar ve 'flex-wrap:nowrap' verir →
          köke verilen flex-wrap etkisizdir (kökün tek çocuğu var).
       3) Toolbar'ın JS custom element'i köke INLINE style yazar:
          - updateToolbarHeight → tek satıra göre sabit 'height: Npx'
          - checkUpdateMinWidth → tüm butonların toplamı kadar 'min-width: Npx' (küçülmeyi,
            dolayısıyla wrap'i engeller)
          Inline stili ezmek için bu ikisinde !important şart. */
    .tx-process-type-toolbar.dxbl-toolbar {
        height: auto !important;
        min-width: 0 !important;
    }

    /* Asıl flex konteyner: absolute'tan akışa geri al + wrap ver.
       Ölçüm klonu '.dxbl-virtual-toolbar' hariç (tema onu zaten !important ile gizli tutar). */
    .tx-process-type-toolbar.dxbl-toolbar > .dxbl-btn-toolbar:not(.dxbl-virtual-toolbar) {
        position: static;
        flex: 1 1 auto;
        min-width: 0;
        flex-wrap: wrap;
        row-gap: 4px;
    }

    /* İşlem paneli sarmalayıcısı — 10 panelin ortak stili TEK kaynak (DRY). */
    .tx-process-panel-wrap {
        overflow-x: auto;
    }
</style>

@if (_activeProcess == null)
{
<div class="d-flex flex-column account-selection-wrapper">
    <div class="d-flex flex-column flex-md-row gap-3">
        <!-- Sol Panel -->
        <div style="flex: 0 0 auto; width: 100%; max-width: 700px;">
            <DxFormLayout>
                <!-- KARŞI TARAF KİPİ ROTADAN gelir (Mode parametresi) — form içinde kip combo'su YOKTUR
                     (kullanıcı kararı): /cari-islemler → Cari (tek combo: Alt Hesap) · /transfers → İç Kasa
                     (Şube→Kasa; kayıt postlanmaz, Teyit teklifi kurulur). İki kipin seçim ekseni farklı
                     olduğu için aşağıdaki combo'lar Visible ile birbirini dışlar. -->

                <!-- ALT HESAP (SubAccount) — TEK combo (2026-07-15 kullanıcı kararı: ayrı Account seviyesi
                     GEREKMEZ). Ana hesap seçimi yerine dropdown'da Account kodu bir KOLON olarak görünür;
                     Account, seçilen alt hesabın kendi AccountId'sinden türer (_model.AccountId zaten
                     OnSubAccountChanged'de böyle atanıyordu — üst combo hiçbir zaman kaynak DEĞİLDİ).
                     Ekle/düzelt orijinal SubAccountEditHost popup'ını açar. -->
                <DxFormLayoutItem Caption="@L["SubAccount"]" ColSpanMd="12" Visible="@(!IsInternalMode)">
                    <LookupComboBox TItem="SubAccountListDto" TValue="Guid?"
                                    Data="@_subAccounts"
                                    ValueFieldName="@nameof(SubAccountListDto.Id)"
                                    TextFieldName="@nameof(SubAccountListDto.Code)"
                                    Value="@_model.SubAccountId"
                                    ValueChanged="@OnSubAccountChanged"
                                    LostFocus="@OnSubAccountLostFocus"
                                    NullText="@L["Select"].Value"
                                    AllowClear="true"
                                    Enabled="@(!_locked)"
                                    OnEditRequested="@OnEditSubAccountAsync"
                                    OnAddRequested="@OnAddSubAccountAsync"
                                    CreatePolicy="@TradeXpressPermissions.SubAccounts.Create"
                                    UpdatePolicy="@TradeXpressPermissions.SubAccounts.Update">
                        <Columns>
                            <DxListEditorColumn FieldName="@nameof(SubAccountListDto.AccountCode)"
                                                Caption="@L["Account"]" Width="35%" />
                            <DxListEditorColumn FieldName="@nameof(SubAccountListDto.Code)"
                                                Caption="@L["Code"]" Width="25%" />
                            <DxListEditorColumn FieldName="@nameof(SubAccountListDto.Name)"
                                                Caption="@L["Name"]" />
                        </Columns>
                    </LookupComboBox>
                </DxFormLayoutItem>

                <!-- Row 1c: İÇ KASA kipi — Cari cascade'inin YERİNE TEK Kasa combosu (2026-07-16 kullanıcı kararı:
                     Cari işlemlerde Account+SubAccount'u tek comboya indirdiğimiz AYNI desen — ayrı Şube seviyesi
                     GEREKMEZ, Şube kodu dropdown'da bir KOLON olarak görünür). Seçilen kasa KARŞI TARAFTIR;
                     kayıt postlanmaz, onun GELEN kutusuna Teyit teklifi düşer. -->
                <DxFormLayoutItem Caption="@L["Confirmation:CounterpartyVault"]" ColSpanMd="12" Visible="@IsInternalMode">
                    <DxComboBox TData="VaultListDto" TValue="Guid?"
                                Data="@CounterpartyVaultOptions"
                                ValueFieldName="@nameof(VaultListDto.Id)"
                                TextFieldName="@nameof(VaultListDto.Code)"
                                Value="@_counterpartyVaultId"
                                ValueChanged="@(async (Guid? id) => await OnCounterpartyVaultChangedAsync(id))"
                                NullText="@L["SelectVault"].Value"
                                Enabled="@(!_locked)"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                CssClass="w-100">
                        <DxListEditorColumn FieldName="@nameof(VaultListDto.BranchCode)" Caption="@L["Confirmation:CounterpartyBranch"]" Width="35%" />
                        <DxListEditorColumn FieldName="@nameof(VaultListDto.Code)" Caption="@L["Code"].Value" Width="25%" />
                        <DxListEditorColumn FieldName="@nameof(VaultListDto.Name)" Caption="@L["Name"].Value" />
                    </DxComboBox>
                </DxFormLayoutItem>

                <!-- Row 2 -->
                <DxFormLayoutItem Caption="@L["VoucherSelection"].Value" ColSpanMd="6" Visible="@SelectionReady">
                    <DxComboBox TData="VoucherComboItem" TValue="Guid?"
                                Data="@_voucherItems"
                                ValueFieldName="@nameof(VoucherComboItem.Id)"
                                TextFieldName="@nameof(VoucherComboItem.DisplayText)"
                                Value="@_selectedVoucherId"
                                ValueChanged="@OnVoucherChanged"
                                DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                NullText="@L["NewVoucherPlaceholder"].Value"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                Enabled="@(!_locked)"
                                CssClass="w-100">

                        <Columns>
                            <DxListEditorColumn FieldName="@nameof(VoucherComboItem.VoucherNo)"
                                                Caption="@L["VoucherNumber"].Value" Width="120px" />
                            <DxListEditorColumn FieldName="@nameof(VoucherComboItem.Date)"
                                                Caption="@L["Date"].Value" />
                            <DxListEditorColumn FieldName="@nameof(VoucherComboItem.CurrentTransactionCount)" Caption="@L["Count"].Value" />
                        </Columns>
                    </DxComboBox>
                </DxFormLayoutItem>

                <!-- Kendi kasam — iç kipte BAŞLATAN (gönderen) kasadır. -->
                <DxFormLayoutItem Caption="@L["Vault"].Value" ColSpanMd="6" Visible="@SelectionReady">
                    @if (_selectedVoucherId.HasValue)
                    {
                        <DxTextBox Text="@_selectedVaultDisplay" Enabled="false" CssClass="w-100" />
                    }
                    else
                    {
                        <DxComboBox TData="MyVaultDto" TValue="Guid?"
                                    Data="@_branchVaults"
                                    ValueFieldName="@nameof(MyVaultDto.Id)"
                                    TextFieldName="@nameof(MyVaultDto.Code)"
                                    Value="@_model.VaultId"
                                    ValueChanged="@((Guid? id) => { _model.VaultId = id; })"
                                    DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                    NullText="@L["SelectVault"].Value"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    Enabled="@(!_locked)"
                                    CssClass="w-100">
                            <DxListEditorColumn FieldName="@nameof(MyVaultDto.Code)" Caption="@L["Code"].Value" Width="100px" />
                            <DxListEditorColumn FieldName="@nameof(MyVaultDto.Name)" Caption="@L["Name"].Value" />
                        </DxComboBox>
                    }
                </DxFormLayoutItem>

                <!-- Row 3 -->
                <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12" Visible="@SelectionReady">
                    <DxTextBox @bind-Text="@_model.Description"
                               Enabled="@(!_locked && !_selectedVoucherId.HasValue)"
                               CssClass="w-100" />
                </DxFormLayoutItem>

                <!-- Row 4 -->
                <DxFormLayoutItem Caption="@L["Date"].Value" ColSpanMd="6" Visible="@SelectionReady">
                    <DxDateEdit Date="@_displayVoucherDate"
                                DateChanged="@((DateTime? d) => OnVoucherDateChanged(d ?? DateTime.Now))"
                                Enabled="@(!_locked && !_selectedVoucherId.HasValue)"
                                Format="dd.MM.yyyy HH:mm"
                                TimeSectionVisible="true"
                                CssClass="w-100" />
                </DxFormLayoutItem>

                <DxFormLayoutItem ColSpanMd="6" Visible="@SelectionReady">
                    <div style="display:flex; justify-content:flex-end; width:100%; height:100%; align-items:flex-end;">
                        <DxButton Text="@(_locked ? L["SelectAccount"].Value : L["Confirm"].Value)"
                                  IconCssClass="@(_locked ? "custom-icon-address-card" : "custom-icon-check")"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  Enabled="@(_locked || CanConfirm)"
                                  Click="@OnConfirmClicked" />
                    </div>
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>

        <!-- Sağ Panel (Boş) -->
        <div class="right-selection-panel flex-grow-1">
            <!-- İleride buraya başka editler eklenecek -->
        </div>
    </div>

    @if (_showActionToolbar)
    {
        <hr class="my-2" style="border-top: 1px solid var(--bs-border-color);" />
        <DxToolbar AdaptivityAutoHideRootItems="false" AdaptivityAutoCollapseItemsToIcons="false" CssClass="mt-2 tx-process-type-toolbar">
            @* Tüm işlem tipleri "Yeni" dropdown'ı altında (reçete toolbar deseni); Liste AYRI buton.
               Kısayol prefiksleri (1-9/M/Ç/D/V) hotkey ipucu olarak korunur. *@
            <DxToolbarItem Text="@L["New"]" IconCssClass="custom-icon-add">
                <Items>
                    <DxToolbarItem Text="@($"1-{L["Bullion_In"].ToString().ToUpper()}")" IconCssClass="custom-icon-bullion" Click="@OnBullionInClicked" Visible="@IsProcessVisible(ProcessType.Bullion)" />
                    <DxToolbarItem Text="@($"2-{L["Bullion_Out"].ToString().ToUpper()}")" IconCssClass="custom-icon-bullion" Click="@OnBullionOutClicked" Visible="@IsProcessVisible(ProcessType.Bullion)" />
                    <DxToolbarItem Text="@($"3-{L["Metal"].ToString().ToUpper()}")" IconCssClass="custom-icon-metal" Click="@OnMetalClicked" Visible="@IsProcessVisible(ProcessType.Metal)" />
                    <DxToolbarItem Text="@($"4-{L["Scrap"].ToString().ToUpper()}")" IconCssClass="custom-icon-scrap" Click="@OnScrapClicked" Visible="@IsProcessVisible(ProcessType.Scrap)" />
                    <DxToolbarItem Text="@($"5-{L["CashProcess"].ToString().ToUpper()}")" IconCssClass="custom-icon-cash" Click="@OnCashClicked" Visible="@IsProcessVisible(ProcessType.Cash)" />
                    <DxToolbarItem Text="@($"6-{L["Convert"].ToString().ToUpper()}")" IconCssClass="custom-icon-convert" Click="@OnConvertClicked" Visible="@IsProcessVisible(ProcessType.Convert)" />
                    <DxToolbarItem Text="@($"7-{L["Service"].ToString().ToUpper()}")" IconCssClass="custom-icon-service" Click="@OnServiceClicked" Visible="@IsProcessVisible(ProcessType.Service)" />
                    <DxToolbarItem Text="@($"8-{L["Future"].ToString().ToUpper()}")" IconCssClass="custom-icon-future" Click="@OnFutureClicked" Visible="@IsProcessVisible(ProcessType.Future)" />
                    <DxToolbarItem Text="@($"9-{L["Stone"].ToString().ToUpper()}")" IconCssClass="custom-icon-stone" Click="@OnStoneClicked" Visible="@IsProcessVisible(ProcessType.Stone)" />
                    <DxToolbarItem Text="@($"M-{L["Jewelry"].ToString().ToUpper()}")" IconCssClass="custom-icon-jewelry" Click="@OnJewelryClicked" Visible="@IsProcessVisible(ProcessType.Jewelry)" />
                    <DxToolbarItem Text="@($"U-{L["Good"].ToString().ToUpper()}")" IconCssClass="custom-icon-good" Click="@OnGoodClicked" Visible="@IsProcessVisible(ProcessType.Good)" />
                    <DxToolbarItem Text="@($"Ç-{L["Assay"].ToString().ToUpper()}")" IconCssClass="custom-icon-bullion" Click="@OnAssayClicked" Visible="@IsProcessVisible(ProcessType.Assay)" />
                    <DxToolbarItem Text="@($"D-{L["DebitNote"].ToString().ToUpper()}")" IconCssClass="custom-icon-report" Click="@OnDebitNoteClicked" Visible="@IsProcessVisible(ProcessType.DebitNote)" />
                    <DxToolbarItem Text="@($"V-{L["Transfer"].ToString().ToUpper()}")" IconCssClass="custom-icon-convert" Click="@OnTransferClicked" Visible="@IsProcessVisible(ProcessType.Transfer)" />
                </Items>
            </DxToolbarItem>
            <DxToolbarItem BeginGroup="true" Text="@($"0-{L["List"].ToString().ToUpper()}")" IconCssClass="custom-icon-list" Click="@OnListClicked" />
        </DxToolbar>
    }
</div>
}

