@using Integration.TradeXpress.Futures
@inherits ProcessPanelHostBase

<DxLayoutBreakpoint MaxWidth="768" @bind-IsActive="@_isMobile" />

<ProcessPanelBase Direction="@Model.Direction" OnSave="@HandleSave" SaveEnabled="@(!IsSaving)" OnBack="@OnBack"
                 ProcessTypeName="@L["Future"].Value"
                 AccountCode="@Context.AccountCode"
                 SubAccountCode="@Context.SubAccountCode">

    <div style="padding:8px; @(_isMobile ? "" : "overflow-x:auto;")">
    <div style="display:flex; @(_isMobile ? "flex-direction:column;" : "width:max-content;") gap:4px; align-items:flex-start;">

        @* Grup 1 — Yön (Alış/Satış) + Vade *@
        <div style="@GroupStyle()">
            <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.Direction)</small>
            <DxComboBox TData="DirectionItem" TValue="ProcessDirectionType"
                        Data="@_directionItems" Value="@Model.Direction" ValueChanged="@OnDirectionChanged"
                        DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                        ValueFieldName="@nameof(DirectionItem.Value)" TextFieldName="@nameof(DirectionItem.Label)"
                        style="@ControlStyle()" />
            <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.DueDate)</small>
            <DxDateEdit Date="@Model.DueDate" DateChanged="@((DateTime? d) => Model.DueDate = d)"
                        Format="dd.MM.yyyy" style="@ControlStyle()" />
        </div>

        <div style="display:flex; flex-direction:column; gap:4px; @(_isMobile ? "width:100%;" : "flex-shrink:0;")">
            <div style="display:flex; @(_isMobile ? "flex-direction:column;" : "") gap:4px; align-items:flex-start;">

                @* Grup 2 — Vadeli enstrüman = Commodity *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.CommodityId)</small>
                    <DxComboBox TData="FutureListDto" TValue="Guid?"
                                Data="@_activeFutures"
                                ValueFieldName="@nameof(FutureListDto.Id)"
                                TextFieldName="@nameof(FutureListDto.Code)"
                                Value="@Model.CommodityId" ValueChanged="@OnFutureChanged"
                                DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                SearchMode="ListSearchMode.AutoSearch" style="@ControlStyle()" />
                </div>

                @* Grup 3 — Miktar (Amount) *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.Amount)</small>
                    <NumericSpinEdit TValue="decimal" Value="@Model.Amount" ValueChanged="@OnAmountChanged" BindValueMode="BindValueMode.OnInput"
                                     ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
                </div>

                @* Grup 4 — Çarpan (FollowingFactor, kilitli) *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.Factor)</small>
                    <NumericSpinEdit TValue="decimal" Value="@Model.Factor" Enabled="false"
                                     ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                </div>

                @* Grup 5 — Tutar (Total = Miktar × Çarpan, kilitli) *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.Total)</small>
                    <NumericSpinEdit TValue="decimal" Value="@Model.Total" Enabled="false"
                                     ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
                </div>

                @* Grup 6 — Karşı birim (FollowingUnit hariç) = PayCommodity *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.PayCommodityId)</small>
                    <DxComboBox TData="CurrencyUnitListDto" TValue="Guid?"
                                Data="@_payUnits"
                                ValueFieldName="@nameof(CurrencyUnitListDto.Id)" TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                                Value="@Model.PayCommodityId" ValueChanged="@OnPayUnitChanged"
                                DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                SearchMode="ListSearchMode.AutoSearch" style="@ControlStyle()" />
                </div>

                @* Grup 6b — Fiyat Tipi (Gram/Ons) — salt UI; kanonik (gram) PayFactor saklanır *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@L["PriceType"]</small>
                    <DxComboBox TData="PriceTypeItem" TValue="PayFactorType"
                                Data="@_priceTypeItems" Value="@_priceType" ValueChanged="@OnPriceTypeChanged"
                                DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                ValueFieldName="@nameof(PriceTypeItem.Value)" TextFieldName="@nameof(PriceTypeItem.Label)"
                                style="@ControlStyle()" />
                </div>

                @* Grup 7 — Fiyat (parite; Ons modunda ×31.1035 gösterilir) *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.PayFactor)</small>
                    <NumericSpinEdit TValue="decimal" Value="@DisplayPayFactor" ValueChanged="@OnDisplayPayFactorChanged" BindValueMode="BindValueMode.OnInput"
                                     ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                </div>

                @* Grup 8 — PayTutar *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.PayTotal)</small>
                    <NumericSpinEdit TValue="decimal" Value="@Model.PayTotal" ValueChanged="@OnPayTotalChanged"
                                     ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
                </div>

            </div>

            <div style="display:flex; flex-direction:column; gap:4px;">
                @if (_isMobile)
                {
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.Description)</small>
                }
                <DxTextBox @bind-Text="@Model.Description" CssClass="w-100" />
            </div>
        </div>

    </div>
    </div>

</ProcessPanelBase>
