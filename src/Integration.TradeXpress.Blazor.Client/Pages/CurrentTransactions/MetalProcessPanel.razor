@using Integration.TradeXpress.Metals
@using Integration.TradeXpress.Permissions
@using Integration.TradeXpress.Variants
@using Integration.TradeXpress.Blazor.Client.Pages.Metals
@inherits ProcessPanelHostBase

<DxLayoutBreakpoint MaxWidth="768" @bind-IsActive="@_isMobile" />

<ProcessPanelBase Direction="@Model.Direction" OnSave="@HandleSave" SaveEnabled="@(!IsSaving)" OnBack="@OnBack"
                 ProcessTypeName="@L["Metal"].Value"
                 PaymentTypeName="@_paymentItems.FirstOrDefault(p => p.Value == Model.PaymentType)?.Label"
                 AccountCode="@Context.AccountCode"
                 SubAccountCode="@Context.SubAccountCode">

    <div style="padding:8px; @(_isMobile ? "" : "overflow-x:auto;")">
    <div style="display:flex; @(_isMobile ? "flex-direction:column;" : "width:max-content;") gap:4px; align-items:flex-start;">

        @* Grup 1 — Yön + Ödeme tipi *@
        <div style="@GroupStyle()">
            <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.Direction)</small>
            <DxComboBox TData="DirectionItem" TValue="ProcessDirectionType"
                        Data="@_directionItems" Value="@Model.Direction" ValueChanged="@OnDirectionChanged"
                        DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                        ValueFieldName="@nameof(DirectionItem.Value)" TextFieldName="@nameof(DirectionItem.Label)" style="@ControlStyle()" />
            @if (_isMobile)
            {
                <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.PaymentType)</small>
            }
            <DxComboBox TData="PaymentItem" TValue="ProcessPaymentType?"
                        Data="@_paymentItems" Value="@Model.PaymentType" ValueChanged="@OnPaymentTypeChanged"
                        DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                        ValueFieldName="@nameof(PaymentItem.Value)" TextFieldName="@nameof(PaymentItem.Label)" style="@ControlStyle()" />
        </div>

        <div style="display:flex; flex-direction:column; gap:4px; @(_isMobile ? "width:100%;" : "flex-shrink:0;")">
            <div style="display:flex; @(_isMobile ? "flex-direction:column;" : "") gap:4px; align-items:flex-start;">

                @* Maden = Commodity (+ altında varyant combo'su, alt alta) — iki kat genişlik (240px) *@
                <div style="@GroupStyle(240)">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.CommodityId)</small>
                    @* Standart lookup: ✎/+ butonları Metals Update/Create iznine bağlı; add/edit MetalEditHost
                       popup'ıyla açılır, kayıt sonrası liste EntityChange ile tazelenip yeni kayıt auto-select olur. *@
                    <LookupComboBox TItem="MetalListDto" TValue="Guid?"
                                    Data="@_activeMetals"
                                    ValueFieldName="@nameof(MetalListDto.Id)"
                                    TextFieldName="@nameof(MetalListDto.Code)"
                                    Value="@Model.CommodityId" ValueChanged="@(async (Guid? v) => await OnMetalChangedAsync(v))"
                                    AllowClear="false"
                                    EditComponentType="typeof(MetalEditHost)"
                                    CreatePolicy="@TradeXpressPermissions.Metals.Create"
                                    UpdatePolicy="@TradeXpressPermissions.Metals.Update"
                                    OnLookupReloadRequested="@ReloadMetalsAsync" />
                    @* Varyant — caption masaüstünde GİZLİ (yalnız mobilde). Tek varyant → combo pasif + VariantId null; çoklu → ana varsayılan.
                       ✎/+ seçili MADENin kartını açar (varyant yönetimi orada; commodity id ile — varyant id DEĞİL). *@
                    @if (_isMobile)
                    {
                        <small style="@ProcessPanelStyles.Label">@L["Variant"]</small>
                    }
                    <LookupComboBox TItem="CommodityVariantOptionDto" TValue="Guid?"
                                    Data="@_variantOptions"
                                    ValueFieldName="@nameof(CommodityVariantOptionDto.Id)" TextFieldName="@nameof(CommodityVariantOptionDto.Code)"
                                    Value="@Model.VariantId" ValueChanged="@OnVariantChanged"
                                    AllowClear="false" Enabled="@(_variantOptions.Count > 1)"
                                    CreatePolicy="@TradeXpressPermissions.Metals.Create" UpdatePolicy="@TradeXpressPermissions.Metals.Update"
                                    OnEditRequested="@(_ => OpenMetalCardAsync())"
                                    OnAddRequested="@OpenMetalCardForAddAsync"
                                    OnLookupReloadRequested="@ReloadVariantsForCurrentMetalAsync" />
                </div>

                @if (_showAdet)
                {
                    @* Quantity — yarım genişlik (60px) *@
                    <div style="@GroupStyle(60)">
                        <small style="@ProcessPanelStyles.Label">@L["Count"]</small>
                        <NumericSpinEdit TValue="decimal" Value="@Model.Quantity" ValueChanged="@OnQuantityChanged" BindValueMode="BindValueMode.OnInput"
                                         ShowSpinButtons="false" DisplayFormat="N0" Mask="N0" />
                    </div>
                }

                @* Miktar (gram) = Amount *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.Amount)</small>
                    <NumericSpinEdit TValue="decimal" Value="@Model.Amount" ValueChanged="@OnAmountChanged" BindValueMode="BindValueMode.OnInput"
                                     Enabled="@(!_amountReadOnly)" ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
                </div>

                @* Milyem = Factor: Normal'de saf milyem (düzenlenebilir), Peşin/Bedelli'de efektif Factor (işçilik yedirilmiş, salt-okunur) *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@L["Factor"]</small>
                    <NumericSpinEdit TValue="decimal" Value="@(HasPriceMode ? Model.Factor : _baseFactor)" ValueChanged="@OnFactorChanged" BindValueMode="BindValueMode.OnInput"
                                     Enabled="@(!_factorReadOnly && !HasPriceMode)" ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                </div>

                @* Has = Total (= Amount × Factor). Amount veya Factor düzenlenebilirse Total da düzenlenebilir (geri-hesap). *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@L["Has"]</small>
                    <NumericSpinEdit TValue="decimal" Value="@Model.Total" ValueChanged="@OnTotalChanged"
                                     Enabled="@(!_amountReadOnly || (!_factorReadOnly && !HasPriceMode))"
                                     ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                </div>

                @* TEK PAY SETİ (ERPPROV3 paritesi) — işçilik + bedel TEK Model.Pay* alanlarında; ödeme tipine göre yalnız
                   RATE caption'ı + hesap dalı değişir. Normal/İade/Emanet → işçilik (caption "İşçilik (Adet/Miktar)"); Peşin/Bedelli → bedel. *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@PayRateCaption</small>
                    <NumericSpinEdit TValue="decimal" Value="@Model.PayFactor" ValueChanged="@OnPayFactorChanged" BindValueMode="BindValueMode.OnInput"
                                     Enabled="@(HasPriceMode || !_laborReadOnly)" ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                </div>
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.PayTotal)</small>
                    <NumericSpinEdit TValue="decimal" Value="@Model.PayTotal" ValueChanged="@OnPayTotalChanged"
                                     Enabled="@(HasPriceMode || !_laborReadOnly)" ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
                </div>
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.PayCommodityId)</small>
                    <DxComboBox TData="PayComboItem" TValue="Guid?"
                                Data="@_activePayItems"
                                ValueFieldName="@nameof(PayComboItem.Id)" TextFieldName="@nameof(PayComboItem.Code)"
                                Value="@Model.PayCommodityId" ValueChanged="@OnPayItemChanged"
                                DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                SearchMode="ListSearchMode.AutoSearch" style="@ControlStyle()" />
                </div>

            </div>

            @* Vade (CommodityId altında, boyut sabit) + Açıklama (satır sonuna kadar genişler) *@
            <div style="display:flex; @(_isMobile ? "flex-direction:column;" : "") gap:4px; align-items:flex-start;">
                <div style="@GroupStyle()">
                    @if (_isMobile)
                    {
                        <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.DueDate)</small>
                    }
                    <DxDateEdit Date="@Model.DueDate" DateChanged="@((DateTime? d) => Model.DueDate = d)"
                                Format="dd.MM.yyyy" style="@ControlStyle()" />
                </div>
                <div style="display:flex; flex-direction:column; gap:4px; @(_isMobile ? "width:100%;" : "flex:1; min-width:0;")">
                    @if (_isMobile)
                    {
                        <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.Description)</small>
                    }
                    <DxTextBox @bind-Text="@Model.Description" CssClass="w-100" />
                </div>
            </div>
        </div>

    </div>
    </div>

</ProcessPanelBase>
