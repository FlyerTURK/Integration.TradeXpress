@inject IStringLocalizer<TradeXpressResource> L

<div style="display:flex; flex-direction:column; box-sizing:border-box;">

    <div style="@StripStyle(); display:flex; align-items:center; padding:0 10px; color:#fff; font-size:0.85rem; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
        @StripText()
    </div>

    <div>
        @ChildContent
    </div>

    <div style="display:flex; justify-content:flex-end; gap:8px; padding:8px 8px 4px; border-top:1px solid #ddd;">
        <DxButton Text="@L["Save"].Value"
                  IconCssClass="custom-icon-save"
                  RenderStyle="ButtonRenderStyle.Primary"
                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                  Enabled="@SaveEnabled"
                  Click="@OnSave" />
        <DxButton Text="@L["Back"].Value"
                  IconCssClass="custom-icon-back"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  RenderStyleMode="ButtonRenderStyleMode.Contained"
                  Click="@OnBack" />
    </div>
</div>
