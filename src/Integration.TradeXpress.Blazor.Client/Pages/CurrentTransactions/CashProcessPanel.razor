@inherits ProcessPanelHostBase

<DxLayoutBreakpoint MaxWidth="768" @bind-IsActive="@_isMobile" />

<ProcessPanelBase Direction="@Model.Direction" OnSave="@HandleSave" SaveEnabled="@(!IsSaving)" OnBack="@OnBack"
                 ProcessTypeName="@L["CashProcess"].Value"
                 PaymentTypeName="@_paymentItems.FirstOrDefault(p => p.Value == Model.PaymentType)?.Label"
                 AccountCode="@Context.AccountCode"
                 SubAccountCode="@Context.SubAccountCode">

    @* Masaüstü: dış kapsayıcı yatay scroll. Mobil: scroll yok, dikey akış (parent form kaydırır). *@
    <div style="padding:8px; @(_isMobile ? "" : "overflow-x:auto;")">
    @* İçerik: masaüstünde flex-row + width:max-content (sabit doğal genişlik → daralınca scroll). Mobilde flex-column. *@
    <div style="display:flex; @(_isMobile ? "flex-direction:column;" : "width:max-content;") gap:4px; align-items:flex-start;">

        @* Sol — Grup 1: İşlem yönü + ödeme tipi *@
        <div style="@GroupStyle()">
            <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.Direction)</small>
            <DxComboBox TData="DirectionItem" TValue="ProcessDirectionType"
                        Data="@_directionItems"
                        Value="@Model.Direction"
                        ValueChanged="@OnDirectionChanged"
                        DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                        ValueFieldName="@nameof(DirectionItem.Value)"
                        TextFieldName="@nameof(DirectionItem.Label)"
                        style="@ControlStyle()">
                <ItemTemplate>
                    <span style="font-weight:600;">@context.Label</span>
                </ItemTemplate>
            </DxComboBox>
            @if (_isMobile)
            {
                <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.PaymentType)</small>
            }
            <DxComboBox TData="PaymentItem" TValue="ProcessPaymentType?"
                        Data="@_paymentItems"
                        Value="@Model.PaymentType"
                        ValueChanged="@OnPaymentTypeChanged"
                        DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                        ValueFieldName="@nameof(PaymentItem.Value)"
                        TextFieldName="@nameof(PaymentItem.Label)"
                        NullText="@L["PaymentType"].Value"
                        style="@ControlStyle()" />
        </div>

        @* Sağ — Grup 2-6 (üst satır) + Description (altta, satır genişliğinde) *@
        <div style="display:flex; flex-direction:column; gap:4px; @(_isMobile ? "width:100%;" : "flex-shrink:0;")">

            @* Sağ üst satır: Grup 2-6. Masaüstü nowrap (daralınca dış scroll), mobil dikey. *@
            <div style="display:flex; @(_isMobile ? "flex-direction:column;" : "") gap:4px; align-items:flex-start;">

                @* Grup 2 — Emtia *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.CommodityId)</small>
                    @if (_selectedCash != null && !_selectedCash.IsActive)
                    {
                        <DxTextBox Text="@_selectedCash.Code" ReadOnly="true" style="@ControlStyle()" />
                    }
                    else
                    {
                        <DxComboBox TData="CashListDto" TValue="Guid?"
                                    Data="@_activeCashes"
                                    ValueFieldName="@nameof(CashListDto.Id)"
                                    TextFieldName="@nameof(CashListDto.Code)"
                                    Value="@Model.CommodityId"
                                    ValueChanged="@OnCommodityChanged"
                                    DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    style="@ControlStyle()" />
                    }
                </div>

                @* Grup 3 — Miktar (Amount) *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.Amount)</small>
                    <NumericSpinEdit TValue="decimal"
                                     Value="@Model.Amount"
                                     ValueChanged="@OnTotalChanged" BindValueMode="BindValueMode.OnInput"
                                     ShowSpinButtons="false"
                                     DisplayFormat="N2"
                                     Mask="N2" />
                </div>

                @* Grup 4 — Ödeme aracı (PayCommodity) *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.PayCommodityId)</small>
                    @if (_selectedPayItem != null && !_selectedPayItem.IsActive)
                    {
                        <DxTextBox Text="@_selectedPayItem.Code" ReadOnly="true" style="@ControlStyle()" />
                    }
                    else
                    {
                        <DxComboBox TData="PayComboItem" TValue="Guid?"
                                    Data="@_activePayItems"
                                    ValueFieldName="@nameof(PayComboItem.Id)"
                                    TextFieldName="@nameof(PayComboItem.Code)"
                                    Value="@Model.PayCommodityId"
                                    ValueChanged="@OnPayCommodityChanged"
                                    DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    style="@ControlStyle()" />
                    }
                </div>

                @* Grup 5 — Fiyat *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.PayFactor)</small>
                    <NumericSpinEdit TValue="decimal"
                                     Value="@Model.PayFactor"
                                     ValueChanged="@OnPayFactorChanged" BindValueMode="BindValueMode.OnInput"
                                     Enabled="@(!_payFactorReadOnly)"
                                     ShowSpinButtons="false"
                                     DisplayFormat="N5"
                                     Mask="N5" />
                </div>

                @* Grup 6 — Tutar *@
                <div style="@GroupStyle()">
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.PayTotal)</small>
                    <NumericSpinEdit TValue="decimal"
                                     Value="@Model.PayTotal"
                                     ValueChanged="@OnPayTotalChanged"
                                     Enabled="@(!_payTotalReadOnly)"
                                     ShowSpinButtons="false"
                                     DisplayFormat="N2"
                                     Mask="N2" />
                </div>

            </div>@* /sağ üst satır *@

            @* Description — sağ kolon genişliğine (üst satır toplamı) otomatik uzar (align-items:stretch default). *@
            <div style="display:flex; flex-direction:column; gap:4px;">
                @if (_isMobile)
                {
                    <small style="@ProcessPanelStyles.Label">@nameof(VoucherLineDto.Description)</small>
                }
                <DxTextBox @bind-Text="@Model.Description" CssClass="w-100" />
            </div>

        </div>@* /sağ kolon *@

    </div>@* /içerik *@
    </div>@* /scroll wrapper *@

</ProcessPanelBase>
