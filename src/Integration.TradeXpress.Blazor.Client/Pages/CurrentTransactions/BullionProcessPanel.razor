@inject IStringLocalizer<TradeXpressResource> L
@inject ICurrencyUnitAppService CurrencyUnitService
@inject IAssayOfficeAppService AssayOfficeService
@inject IEffectivePriceAppService PriceService
@inject IVoucherAppService VoucherService
@inject IUiInteractionService Ui

@* TAKOZ GİRİŞ paneli — DevExpress DxFormLayout (responsive ColSpan; mobilde DevExpress breakpoint'lere göre
   yeniden dizer, kayma/daralma olmaz). 5 bölüm: Kimlik · Milyem(AU/AG) · Platin/Paladyum · İşçilik · Açıklama
   + sağ Takoz Bakiyesi özeti. Yön sabit GİRİŞ. Kayıt: BullionBalancePoster (server). *@

@* IsNarrow kabuğun mobil kipini (yükseklik sınırı + sticky başlık/Kaydet çubuğu) açar; diğer dokuz panelle
   aynı desen. Bu panel içeriğini DxFormLayout ile dizdiği için bayrağı başka yerde kullanmaz. *@
<DxLayoutBreakpoint MaxWidth="768" @bind-IsActive="@_isMobile" />

<ProcessPanelBase Direction="ProcessDirectionType.Inbound" OnSave="@HandleSave" SaveEnabled="@(!_saving)" OnBack="@OnBack"
                  ProcessTypeName="@L["Bullion"].Value" IsNarrow="@_isMobile"
                  AccountCode="@AccountCode" SubAccountCode="@SubAccountCode">

    <DxFormLayout CssClass="w-100">

        @* ── Kimlik ── *@
        <DxFormLayoutGroup Caption="@L["Bullion_Section_Identity"]" ColSpanMd="12">
            <DxFormLayoutItem Caption="@L["Voucher_Op_BullionNo"]" ColSpanMd="3" ColSpanSm="6">
                <span class="tx-readonly-value">@(_bullionCode ?? "—")</span>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Voucher_Op_BullionType"]" ColSpanMd="3" ColSpanSm="6">
                <DxComboBox Data="@_bullionTypes" TData="TypeOpt" TValue="BullionType"
                            ValueFieldName="Value" TextFieldName="Label" DropDownTriggerMode="DropDownTriggerMode.Click"
                            Value="@_bullionType" ValueChanged="@((BullionType v) => { _bullionType = v; Recalc(); })" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Voucher_Op_AssayOffice"]" ColSpanMd="3" ColSpanSm="6">
                <DxComboBox Data="@_assayOffices" TData="AssayOpt" TValue="Guid?"
                            ValueFieldName="Id" TextFieldName="Name" DropDownTriggerMode="DropDownTriggerMode.Click"
                            @bind-Value="_assayOfficeId" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Voucher_Op_ReportNo"]" ColSpanMd="3" ColSpanSm="6">
                <DxTextBox @bind-Text="_reportNo" @bind-Text:after="OnReportNoChanged" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Voucher_Op_Quantity"]" ColSpanMd="3" ColSpanSm="6">
                <NumericSpinEdit TValue="decimal" Value="@_amount" ValueChanged="@OnAmountChanged" BindValueMode="BindValueMode.OnInput"
                                 ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["BullionStock_Assay"]" ColSpanMd="3" ColSpanSm="6">
                <NumericSpinEdit TValue="decimal" Value="@_assayAmount" ValueChanged="@OnAssayAmountChanged" BindValueMode="BindValueMode.OnInput"
                                 ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["BullionStock_Report"]" ColSpanMd="3" ColSpanSm="6">
                <DxComboBox Data="@_reportOptions" TData="BoolOpt" TValue="bool"
                            ValueFieldName="Value" TextFieldName="Label" DropDownTriggerMode="DropDownTriggerMode.Click"
                            Enabled="@_reportToggleEnabled"
                            Value="@_isReport" ValueChanged="@OnReportChanged" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Voucher_Extra_Extra"]" ColSpanMd="3" ColSpanSm="6">
                <DxComboBox Data="@_extraOptions" TData="BoolOpt" TValue="bool"
                            ValueFieldName="Value" TextFieldName="Label" DropDownTriggerMode="DropDownTriggerMode.Click"
                            Enabled="@_isReport"
                            Value="@_isExtra" ValueChanged="@((bool v) => { _isExtra = v; Recalc(); })" />
            </DxFormLayoutItem>
        </DxFormLayoutGroup>

        @* ── Milyem (AU/AG) — yalnız RAPORLU ── *@
        @if (_isReport)
        {
            <DxFormLayoutGroup Caption="@L["Bullion_Section_Fineness"]" ColSpanMd="12">
                <DxFormLayoutItem Caption="@L["Voucher_Op_AuMilyem"]" ColSpanMd="3" ColSpanSm="6">
                    <NumericSpinEdit TValue="decimal" Value="@_auMilyem" ValueChanged="@OnAuMilyemChanged" BindValueMode="BindValueMode.OnInput"
                                     ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="HAS" ColSpanMd="3" ColSpanSm="6">
                    <span>@_hasValue.ToString("N2")</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Voucher_Op_AgMilyem"]" ColSpanMd="3" ColSpanSm="6">
                    <NumericSpinEdit TValue="decimal" Value="@_agMilyem" ValueChanged="@OnAgMilyemChanged" BindValueMode="BindValueMode.OnInput"
                                     ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="GUM" ColSpanMd="3" ColSpanSm="6">
                    <span>@_gumValue.ToString("N2")</span>
                </DxFormLayoutItem>
            </DxFormLayoutGroup>
        }

        @* ── Platin / Paladyum — yalnız RAPORLU+EXTRA ── *@
        @if (_isReport && _isExtra)
        {
            <DxFormLayoutGroup Caption="@L["Bullion_Section_Extra"]" ColSpanMd="12">
                <DxFormLayoutItem Caption="@L["Voucher_Op_PtMilyem"]" ColSpanMd="3" ColSpanSm="6">
                    <NumericSpinEdit TValue="decimal" Value="@_ptMilyem" ValueChanged="@OnPtMilyemChanged" BindValueMode="BindValueMode.OnInput"
                                     ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="PLT" ColSpanMd="3" ColSpanSm="6">
                    <span>@_pltValue.ToString("N2")</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Voucher_Op_PdMilyem"]" ColSpanMd="3" ColSpanSm="6">
                    <NumericSpinEdit TValue="decimal" Value="@_pdMilyem" ValueChanged="@OnPdMilyemChanged" BindValueMode="BindValueMode.OnInput"
                                     ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="PLD" ColSpanMd="3" ColSpanSm="6">
                    <span>@_pldValue.ToString("N2")</span>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Voucher_Op_PlatinumMode"]" ColSpanMd="6" ColSpanSm="6">
                    <DxComboBox Data="@_dispositions" TData="DispOpt" TValue="MetalDisposition"
                                ValueFieldName="Value" TextFieldName="Label" DropDownTriggerMode="DropDownTriggerMode.Click"
                                Value="@_platinumMode" ValueChanged="@((MetalDisposition v) => { _platinumMode = v; Recalc(); })" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Voucher_Op_PalladiumMode"]" ColSpanMd="6" ColSpanSm="6">
                    <DxComboBox Data="@_dispositions" TData="DispOpt" TValue="MetalDisposition"
                                ValueFieldName="Value" TextFieldName="Label" DropDownTriggerMode="DropDownTriggerMode.Click"
                                Value="@_palladiumMode" ValueChanged="@((MetalDisposition v) => { _palladiumMode = v; Recalc(); })" />
                </DxFormLayoutItem>
            </DxFormLayoutGroup>
        }

        @* ── İşçilik (4 metal; PT/PD raporlu+extra) ── *@
        <DxFormLayoutGroup Caption="@L["Bullion_Section_Labor"]" ColSpanMd="12">
            <DxFormLayoutItem Caption="@L["Voucher_Op_GoldLabor"]" ColSpanMd="3" ColSpanSm="6">
                <NumericSpinEdit TValue="decimal" Value="@_goldLaborRate" ValueChanged="@OnGoldLaborRateChanged" BindValueMode="BindValueMode.OnInput"
                                 ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Voucher_Op_Unit"]" ColSpanMd="3" ColSpanSm="6">
                <DxComboBox Data="@_allUnitOptions" TData="UnitOpt" TValue="Guid?"
                            ValueFieldName="Id" TextFieldName="Code" DropDownTriggerMode="DropDownTriggerMode.Click"
                            @bind-Value="_goldLaborUnitId" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Voucher_Op_SilverLabor"]" ColSpanMd="3" ColSpanSm="6">
                <NumericSpinEdit TValue="decimal" Value="@_silverLaborRate" ValueChanged="@OnSilverLaborRateChanged" BindValueMode="BindValueMode.OnInput"
                                 ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Voucher_Op_Unit"]" ColSpanMd="3" ColSpanSm="6">
                <DxComboBox Data="@_allUnitOptions" TData="UnitOpt" TValue="Guid?"
                            ValueFieldName="Id" TextFieldName="Code" DropDownTriggerMode="DropDownTriggerMode.Click"
                            @bind-Value="_silverLaborUnitId" />
            </DxFormLayoutItem>
            @if (_isReport && _isExtra)
            {
                <DxFormLayoutItem Caption="@L["Voucher_Op_PtLabor"]" ColSpanMd="3" ColSpanSm="6">
                    <NumericSpinEdit TValue="decimal" Value="@_ptLaborRate" ValueChanged="@OnPtLaborRateChanged" BindValueMode="BindValueMode.OnInput"
                                     ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Voucher_Op_Unit"]" ColSpanMd="3" ColSpanSm="6">
                    <DxComboBox Data="@_allUnitOptions" TData="UnitOpt" TValue="Guid?"
                                ValueFieldName="Id" TextFieldName="Code" DropDownTriggerMode="DropDownTriggerMode.Click"
                                @bind-Value="_ptLaborUnitId" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Voucher_Op_PdLabor"]" ColSpanMd="3" ColSpanSm="6">
                    <NumericSpinEdit TValue="decimal" Value="@_pdLaborRate" ValueChanged="@OnPdLaborRateChanged" BindValueMode="BindValueMode.OnInput"
                                     ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Voucher_Op_Unit"]" ColSpanMd="3" ColSpanSm="6">
                    <DxComboBox Data="@_allUnitOptions" TData="UnitOpt" TValue="Guid?"
                                ValueFieldName="Id" TextFieldName="Code" DropDownTriggerMode="DropDownTriggerMode.Click"
                                @bind-Value="_pdLaborUnitId" />
                </DxFormLayoutItem>
            }
            <DxFormLayoutItem Caption="@L["Voucher_Op_LaborMode"]" ColSpanMd="4" ColSpanSm="6">
                <DxComboBox Data="@_laborModes" TData="ModeOpt" TValue="BullionLaborMode"
                            ValueFieldName="Value" TextFieldName="Label" DropDownTriggerMode="DropDownTriggerMode.Click"
                            Value="@_laborMode" ValueChanged="@OnLaborModeChanged" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Voucher_Op_PayUnit"]" ColSpanMd="4" ColSpanSm="6">
                <DxComboBox Data="@_cashUnitOptions" TData="UnitOpt" TValue="Guid?"
                            ValueFieldName="Id" TextFieldName="Code" DropDownTriggerMode="DropDownTriggerMode.Click"
                            Enabled="@(_laborMode == BullionLaborMode.WithCash)"
                            @bind-Value="_payUnitId" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Voucher_Op_SilverMode"]" ColSpanMd="4" ColSpanSm="6">
                <DxComboBox Data="@_dispositions" TData="DispOpt" TValue="MetalDisposition"
                            ValueFieldName="Value" TextFieldName="Label" DropDownTriggerMode="DropDownTriggerMode.Click"
                            Enabled="@_isReport"
                            Value="@_silverMode" ValueChanged="@((MetalDisposition v) => { _silverMode = v; Recalc(); })" />
            </DxFormLayoutItem>
        </DxFormLayoutGroup>

        @* ── Açıklama + Takoz Bakiyesi özeti ── *@
        <DxFormLayoutGroup Caption="@L["Voucher_Op_Description"]" ColSpanMd="@(_summaryLegs.Count > 0 ? 8 : 12)">
            <DxFormLayoutItem ColSpanMd="12">
                <DxTextBox @bind-Text="_description" />
            </DxFormLayoutItem>
        </DxFormLayoutGroup>

        @if (_summaryLegs.Count > 0)
        {
            <DxFormLayoutGroup Caption="@L["Voucher_Op_BullionSummary"]" ColSpanMd="4">
                @foreach (var leg in _summaryLegs)
                {
                    <DxFormLayoutItem Caption="@leg.Code" ColSpanMd="12" ColSpanSm="6">
                        <span class="tx-leg-value @(leg.Value >= 0 ? "pos" : "neg")">@leg.Value.ToString("N2")</span>
                        @* Raporsuz TAKOZ bacağının HAS değerlemesi (salt gösterim; legacy Stok.TakozOzet ×0.6). *@
                        @if (leg.Code == BullionConsts.PseudoUnitCode)
                        {
                            <span style="margin-left:6px; opacity:.65; font-size:.85em;">@L["Voucher_Op_ApproxHas", (leg.Value * BullionConsts.DefaultCarpan).ToString("N2")]</span>
                        }
                    </DxFormLayoutItem>
                }
            </DxFormLayoutGroup>
        }
    </DxFormLayout>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-warning mt-2" style="margin:8px;">@_error</div>
    }
</ProcessPanelBase>
