@using System.Globalization
@using Integration.TradeXpress.Localization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TradeXpressResource> L
@inject IJSRuntime Js

@*  Pre-auth tenant selector popup. Validates the typed name against /account/find-tenant
    before handing the resolved name back to Login.razor.

    Security: empty input resolves to host context (sysadmin). We do NOT advertise
    this in the UI to avoid leaking the host-login hint to casual attackers. *@

<DxPopup @bind-Visible="@_visible"
         HeaderText="@L["Firma Seç"].Value"
         Width="95%"
         MaxWidth="420px"
         MaxHeight="90vh"
         Scrollable="true"
         ShowFooter="true"
         CloseOnOutsideClick="false"
         Closed="@OnClosed">
    <Content>
        <DxFormLayout CaptionPosition="CaptionPosition.Vertical">
            <DxFormLayoutItem Caption="@L["Firma Adı"].Value" ColSpanMd="12">
                @* focusout → editörden AYRILINCA büyük harfe çevir (her tuşta DEĞİL: OnInput modunda her
                   karakterde çevirmek imleci zıplatır). keydown/Enter → Uygula butonuna odaklan; buton gerçek
                   bir <button> olduğundan İKİNCİ Enter'ı tarayıcı kendisi tıklamaya çevirir (ek kod yok). *@
                <div @onfocusout="UpperCaseInput" @onkeydown="OnInputKeyDownAsync">
                    <DxTextBox @ref="_inputBox"
                               @bind-Text="_input"
                               @bind-Text:after="OnInputChanged"
                               BindValueMode="BindValueMode.OnInput"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never"
                               NullText="@L["Firma adı seçiniz..."].Value" />
                </div>
            </DxFormLayoutItem>
        </DxFormLayout>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="erp-login-tenant-error" role="alert">@_error</div>
        }
    </Content>
    <FooterContentTemplate Context="popup">
        <div class="erp-login-popup-footer">
            @* Id sabit: editörde Enter'a basılınca erpUx.focusById bu butonu odaklar. *@
            <DxButton Id="@ApplyButtonId"
                      Text="@L["Login_TenantPickerApply"].Value"
                      RenderStyle="ButtonRenderStyle.Primary"
                      Enabled="@(!_busy)"
                      Click="@ApplyAsync" />
            <DxButton Text="@L["Cancel"].Value"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(!_busy)"
                      Click="@CancelAsync" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    [Parameter, EditorRequired] public bool                  Visible        { get; set; }
    [Parameter]                 public EventCallback<bool>   VisibleChanged { get; set; }
    [Parameter]                 public string?               Current        { get; set; }
    [Parameter]                 public EventCallback<string> OnApplied      { get; set; }

    /// <summary>Uygula butonunun sabit DOM id'si — Enter ile odaklanmak için (erpUx.focusById).</summary>
    private const string ApplyButtonId = "tenant-picker-apply";

    private bool       _visible;
    private string     _input          = string.Empty;
    private string?    _error;
    private bool       _busy;
    private bool       _previousVisible;
    private DxTextBox? _inputBox;

    protected override async Task OnParametersSetAsync()
    {
        _visible = Visible;
        if (Visible && !_previousVisible)
        {
            _input = Current ?? string.Empty;
            _error = null;
            await Task.Yield();
            if (_inputBox is not null)
            {
                try { await _inputBox.FocusAsync(); }
                catch { /* JS not ready */ }
            }
        }
        _previousVisible = Visible;
    }

    private async Task ApplyAsync()
    {
        if (_busy) return;

        var trimmed = (_input ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(trimmed))
        {
            // Empty → host context, no validation needed.
            await OnApplied.InvokeAsync(string.Empty);
            await CloseAsync();
            return;
        }

        _busy  = true;
        _error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await Js.InvokeAsync<FindTenantResult>("erpFetchFindTenant", trimmed);
            if (result.Found)
            {
                await OnApplied.InvokeAsync(result.Name ?? trimmed);
                await CloseAsync();
            }
            else
            {
                _error = string.Format(L["Login_TenantNotFound"].Value, trimmed);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task CancelAsync() => CloseAsync();

    private async Task CloseAsync()
    {
        _visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private void OnClosed() => _ = VisibleChanged.InvokeAsync(false);

    private void OnInputChanged() => _error = null;

    /// <summary>Editörden ayrılınca firma adını BÜYÜK HARFE çevirir. Tenant adları her zaman UPPERCASE
    /// (2026-07-25 kuralı) ve sunucudaki kayıt da öyle → eşleşme şansı artar.
    /// Çevrim KÜLTÜRE DUYARLI: Türkçe'de "ışık" → "IŞIK", invariant çevrim noktasız/noktalı I'yı bozardı.</summary>
    private void UpperCaseInput()
    {
        var upper = (_input ?? string.Empty).Trim().ToUpper(CultureInfo.CurrentCulture);
        if (!string.Equals(upper, _input, StringComparison.Ordinal))
        {
            _input = upper;
        }
    }

    /// <summary>Editörde Enter → önce büyük harfe çevir (Enter da "ayrılma" sayılır), sonra Uygula butonuna
    /// odaklan. İKİNCİ Enter'ı tarayıcı odaklı &lt;button&gt; üzerinde tıklamaya çevirir — ayrı kod gerekmez.</summary>
    private async Task OnInputKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is not ("Enter" or "NumpadEnter"))
        {
            return;
        }

        UpperCaseInput();
        await InvokeAsync(StateHasChanged);
        try { await Js.InvokeVoidAsync("erpUx.focusById", ApplyButtonId); }
        catch { /* JS hazır değilse sessiz geç — odak kullanıcıda kalır */ }
    }

    private sealed record FindTenantResult(bool Found, string? Name);
}
