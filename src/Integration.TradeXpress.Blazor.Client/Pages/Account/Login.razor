@page "/account/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout EmptyLayout
@using Integration.TradeXpress.Blazor.Client.Layout
@using Integration.TradeXpress.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TradeXpressResource> L
@inject NavigationManager Nav
@inject IJSRuntime Js

@*  Custom Blazor login page — replaces ABP's default Account/Login Razor Page.

    Cookie sign-in flow: browser JS (erpFetchSignIn) POSTs credentials to
    /account/sign-in-cookie → server sets ASP.NET Identity auth cookie → forceLoad
    navigation carries the cookie to the authenticated app. *@

<PageTitle>@L["Login_Title"]</PageTitle>

<div class="erp-login-shell">
    <div class="erp-login-banner">
        <span class="erp-login-appname">TradeXpress</span>
    </div>

    <div class="erp-login-main">
        <div class="erp-login-card">

            <div class="erp-login-card-header">
                <div role="heading" aria-level="1" class="erp-login-title">@L["Login_Title"]</div>
                <div @onkeydown="OnLanguageKeyDown">
                    <DxComboBox @ref="_langCombo"
                                TData="LangItem"
                                TValue="string"
                                Data="@_languages"
                                TextFieldName="@nameof(LangItem.Label)"
                                ValueFieldName="@nameof(LangItem.Code)"
                                Value="@_selectedCulture"
                                ValueChanged="@OnLanguageChangedAsync"
                                DropDownVisibleChanged="@(v => _langDropDownOpen = v)"
                                CssClass="erp-login-lang-combo"
                                SizeMode="SizeMode.Small" />
                </div>
            </div>

            <div class="erp-login-card-body">
                <p class="erp-login-intro">@L["Login_Intro"]</p>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="erp-login-error" role="alert">@_error</div>
                }

                <DxFormLayout CssClass="erp-login-form" CaptionPosition="CaptionPosition.Vertical">
                    <DxFormLayoutItem Caption="@L["Login_TenantLabel"].Value" ColSpanMd="12">
                        @* Alan SALT-OKUNUR: değer yalnız popup'tan seçilir. Bu yüzden kutunun HERHANGİ bir
                           yerine tek tık popup'ı açar (2026-07-25 Hakan) — eskiden yalnız sağdaki buton ve F4
                           açıyordu, kutuya tıklamak hiçbir şey yapmıyordu. Butonun kendi Click'i de aynı metodu
                           çağırır; ikisi de aynı bayrağı set ettiğinden çift tetikleme zararsızdır.
                           cursor:pointer → alanın tıklanabilir olduğu görünsün (salt-okunur kutu metin imleci verir). *@
                        <div @onkeydown="OnTenantKeyDown" @onclick="OpenTenantPickerAsync" style="cursor:pointer;">
                            <DxTextBox @ref="_tenantBox" Text="@TenantDisplay" ReadOnly="true" NullText="@L["Firma Seçiniz..."].Value">
                                <Buttons>
                                    <DxEditorButton Text="@L["Login_TenantChange"].Value"
                                                    Click="@OpenTenantPickerAsync" />
                                </Buttons>
                            </DxTextBox>
                        </div>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="@L["Login_UserName"].Value" ColSpanMd="12">
                        <div @onkeydown="OnUserNameKeyDown">
                            <DxTextBox @ref="_userBox"
                                       @bind-Text="_userName"
                                       @bind-Text:after="OnUserNameChanged"
                                       BindValueMode="BindValueMode.OnInput"
                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </div>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="@L["Login_Password"].Value" ColSpanMd="12">
                        <div @onkeydown="OnPasswordKeyDown">
                            <DxTextBox @key="_credentialsResetKey"
                                       @ref="_passwordBox"
                                       @bind-Text="_password"
                                       Password="@(!_passwordVisible)"
                                       Enabled="@(!string.IsNullOrWhiteSpace(_userName))"
                                       BindValueMode="BindValueMode.OnInput"
                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto">
                                <Buttons>
                                    <DxEditorButton IconCssClass="custom-icon-eye"
                                                    Visible="@(!string.IsNullOrEmpty(_password))"
                                                    Tooltip="@(_passwordVisible ? L["Login_PasswordHide"].Value : L["Login_PasswordShow"].Value)"
                                                    Click="TogglePasswordVisibility" />
                                </Buttons>
                            </DxTextBox>
                        </div>
                    </DxFormLayoutItem>
                </DxFormLayout>

                @if (_tenantPopupVisible)
                {
                    <TenantPickerPopup Visible="_tenantPopupVisible"
                                       VisibleChanged="@OnTenantPopupVisibleChanged"
                                       Current="@_tenant"
                                       OnApplied="@OnTenantApplied" />
                }

                <div class="erp-login-toolbar" @onkeydown="OnLoginButtonKeyDown">
                    <DxButton Id="@LoginButtonId"
                              Text="@L["Login_SignIn"].Value"
                              RenderStyle="ButtonRenderStyle.Primary"
                              CssClass="erp-login-btn"
                              Enabled="@(!_busy && !string.IsNullOrWhiteSpace(_userName) && !string.IsNullOrWhiteSpace(_password))"
                              Click="@SubmitAsync" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const string LastTenantCookieName = "tx.last_tenant";
    private const int    LastTenantCookieDays = 365;
    private const string LoginButtonId        = "tx-login-submit";

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    /// <summary>Dil combosuna AÇIKÇA dokunuldu bilgisi — dil değişimi tam yeniden yükleme yaptığından
    /// reload sonrasına query ile taşınır. Girişte K1 kuralını besler: açık seçim saklı tercihi ezer
    /// ve kullanıcının yeni sunucu tercihi olarak yazılır.</summary>
    [SupplyParameterFromQuery(Name = "langChosen")]
    public string? LangChosen { get; set; }

    private string     _userName          = string.Empty;
    private string     _password          = string.Empty;
    private string     _tenant            = string.Empty;
    private string?    _error;
    private bool       _busy;
    private string     _selectedCulture   = "tr";
    private DxComboBox<LangItem, string>? _langCombo;   // ESC ile firmadan geri dönülen ilk odak
    private bool _langDropDownOpen;                     // liste açıkken Enter dil SEÇER, odak taşımaz
    private DxTextBox? _tenantBox;
    private DxTextBox? _userBox;
    private DxTextBox? _passwordBox;
    private bool       _tenantPopupVisible;
    private bool       _passwordVisible;
    private int        _credentialsResetKey;

    private readonly List<LangItem> _languages =
    [
        new("tr", "Türkçe"),
        new("en", "English"),
    ];

    private string TenantDisplay =>
        string.IsNullOrEmpty(_tenant) ? string.Empty : _tenant.ToUpperInvariant();

    private void TogglePasswordVisibility() => _passwordVisible = !_passwordVisible;

    protected override void OnInitialized()
    {
        _selectedCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        if (_selectedCulture != "en") _selectedCulture = "tr";

#if DEBUG
        // Development kolaylığı: dev admin kimliği ön-dolu (giriş her seferinde elle yazılmasın). YALNIZ DEBUG
        // derlemede derlenir → Release'e (WASM publish) GİRMEZ. Değerler ABP seed admin'i (host):
        // kullanıcı adı "admin", şifre TradeXpressConsts.AdminPasswordDefaultValue. Tenant boş = host.
        _userName = "admin";
        _password = "1q2w3E*";
#endif
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var saved = await Js.InvokeAsync<string?>("erpUx.readCookie", LastTenantCookieName);
            if (!string.IsNullOrEmpty(saved) && saved != _tenant)
            {
                _tenant = saved;
                StateHasChanged();
            }
        }
        catch { /* JS disconnected */ }

        if (_userBox is not null)
        {
            try { await _userBox.FocusAsync(); }
            catch { /* JS not ready */ }
        }
    }

    // ── Klavye navigasyonu ──────────────────────────────────────────────
    // ESC zinciri GERİYE gider: şifre → kullanıcı → firma → DİL. Firma ilk alan olduğundan ESC odağı
    // kartın başındaki dil seçicisine taşır (2026-07-25 Hakan) — zincirin başı boşta kalmasın.
    private async Task OnTenantKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "F4")           await OpenTenantPickerAsync();
        else if (e.Key == "Enter")   await FocusBoxAsync(_userBox);
        else if (e.Key == "Escape")  await FocusLanguageAsync();
    }

    private async Task FocusLanguageAsync()
    {
        if (_langCombo is null) return;
        try { await _langCombo.FocusAsync(); }
        catch { /* JS not ready */ }
    }

    private async Task OnUserNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_userName))
            await FocusBoxAsync(_passwordBox);
        else if (e.Key == "Escape")
            await FocusBoxAsync(_tenantBox);
    }

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Js.InvokeVoidAsync("erpUx.focusById", LoginButtonId);
        else if (e.Key == "Escape")
            await FocusBoxAsync(_userBox);
        // F4 = alanın ÖZEL eylemi (firmada popup açar, şifrede göster/gizle) — formda tutarlı kısayol.
        // Göz butonuyla AYNI metodu çağırır; şifre boşken buton görünmez ama F4 yine zararsızca çalışır.
        else if (e.Key == "F4")
            TogglePasswordVisibility();
    }

    // Dil combosu zincirin BAŞI: Enter ileri (firmaya) götürür — firma→kullanıcı→şifre→giriş akışıyla simetrik.
    // Açılır liste AÇIKKEN Enter'a karışmayız: orada Enter dil SEÇER (ve dil değişimi sayfayı yeniler).
    private async Task OnLanguageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_langDropDownOpen)
            await FocusBoxAsync(_tenantBox);
    }

    private async Task OnLoginButtonKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await FocusBoxAsync(_passwordBox);
    }

    private static async Task FocusBoxAsync(DxTextBox? box)
    {
        if (box is null) return;
        try { await box.FocusAsync(); }
        catch { /* JS not ready */ }
    }

    private void OnUserNameChanged()
    {
        if (string.IsNullOrWhiteSpace(_userName))
        {
            _password            = string.Empty;
            _passwordVisible     = false;
            _credentialsResetKey++;
        }
    }

    // ── Tenant popup ────────────────────────────────────────────────────
    private async Task OpenTenantPickerAsync()
    {
        _tenantPopupVisible = true;
        await InvokeAsync(StateHasChanged);
    }

    private void OnTenantPopupVisibleChanged(bool v) => _tenantPopupVisible = v;

    private void OnTenantApplied(string applied) => _tenant = applied ?? string.Empty;

    // ── Dil değiştirme ──────────────────────────────────────────────────
    private async Task OnLanguageChangedAsync(string code)
    {
        _selectedCulture = code;
        // langChosen: açık dil seçimi bilgisi reload sonrası sayfaya taşınır (K1 — girişte bu dil kazanır).
        var ret = "/account/login?langChosen=" + Uri.EscapeDataString(code)
                + (string.IsNullOrEmpty(ReturnUrl) ? string.Empty : "&returnUrl=" + Uri.EscapeDataString(ReturnUrl));
        // ABP'nin hazır kültür endpoint'i: .AspNetCore.Culture cookie'sini sunucuda yazar ve returnUrl'e
        // döner (eski /_ux/culture hedefi hiç var olmadığından 404'e gidiyordu — dil değişimi kırıktı).
        // uiCulture parametresi ZORUNLU (yoksa yalnız "c" kısmı set olur). location.replace (href DEĞİL):
        // dil değişimi geçmişe kayıt bırakmaz — "geri" tuşu önceki dildeki login'e döndürmesin.
        await Js.InvokeVoidAsync(
            "eval",
            $"window.location.replace('/Abp/Languages/Switch?culture={Uri.EscapeDataString(code)}&uiCulture={Uri.EscapeDataString(code)}&returnUrl={Uri.EscapeDataString(ret)}')");
    }

    // ── Giriş ───────────────────────────────────────────────────────────
    private async Task SubmitAsync()
    {
        if (_busy) return;

        if (string.IsNullOrWhiteSpace(_userName) || string.IsNullOrWhiteSpace(_password))
        {
            _error           = L["Login_CredentialsRequired"].Value;
            _passwordVisible = true;
            return;
        }

        _busy  = true;
        _error = null;
        try
        {
            // Browser-side fetch: Set-Cookie must reach the browser's cookie jar,
            // not a server-side HttpClient container.
            var result = await Js.InvokeAsync<SignInResponse>(
                "erpFetchSignIn", _userName, _password, _tenant, LangChosen);

            if (result is { Success: true })
            {
                try
                {
                    await Js.InvokeVoidAsync(
                        "erpUx.writeCookie", LastTenantCookieName, _tenant, LastTenantCookieDays);
                }
                catch { /* best-effort */ }

                // Oturum açan KULLANICININ tercihleri yansıma cookie'lerine yazılır — forceLoad sonrası
                // App.razor SSR'ı doğrudan bu kullanıcının temasında/dilinde boyar (ara flaş yok).
                // Boş tema/boyut → cookie SİLİNİR (önceki kullanıcının görünümü tercihi olmayan yeni
                // kullanıcıya sızmasın); boş kültür → dokunulmaz (mevcut ekran dili sürer).
                await ApplyPreferenceCookiesAsync(result.Prefs);

                // replace:true → login geçmişe KAYIT BIRAKMAZ: giriş sonrası tarayıcı "geri"si login'e dönmez
                // (2026-07-25 Hakan kararı: login ayrı gezinilebilir sayfa gibi davranmasın).
                // forceLoad KALIR ve zorunludur — auth cookie'sini uygulamaya ancak tam yükleme taşır.
                Nav.NavigateTo(SanitizeReturnUrl(ReturnUrl), forceLoad: true, replace: true);
                return;
            }
            _error = L["Login_InvalidCredentials"].Value;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }

        // Giriş başarısız — kimlik bilgilerini temizle.
        _password            = string.Empty;
        _passwordVisible     = true;
        _credentialsResetKey++;
        await InvokeAsync(StateHasChanged);

        _userName = string.Empty;
        await InvokeAsync(StateHasChanged);
        if (_userBox is not null)
        {
            try { await _userBox.FocusAsync(); }
            catch { /* JS not ready */ }
        }
    }

    // Önceden var olan açık-yönlendirme (open redirect) açığı: "//evil.example" ve "/\evil.example" de
    // StartsWith('/') koşulunu sağlıyordu ve tarayıcı bunları protokol-göreli mutlak URL olarak çözüp
    // forceLoad navigasyonunu (satır 330) başka bir origin'e taşıyordu (2026-07-26 adversarial review
    // ile bulunan, bu sekme değişikliğiyle İLGİSİZ ama gerçek önceden var olan bir güvenlik açığı).
    private static string SanitizeReturnUrl(string? url)
        => string.IsNullOrEmpty(url) || !url.StartsWith('/') || url.StartsWith("//") || url.StartsWith("/\\")
            ? "/"
            : url;

    /// <summary>Girişte dönen kullanıcı tercihlerini yansıma cookie'lerine yazar (best-effort — hata girişi bozmaz).
    /// Tema JSON'u ENCODE'lu (erpUx.writeCookie), kültür RAW (erpUx.writeRawCookie — ASP.NET decode yapmaz!).</summary>
    private async Task ApplyPreferenceCookiesAsync(SignInPrefs? prefs)
    {
        try
        {
            if (!string.IsNullOrEmpty(prefs?.Theme))
                await Js.InvokeVoidAsync("erpUx.writeCookie", "tx.last_theme", prefs.Theme, 365);
            else
                await Js.InvokeVoidAsync("erpUx.deleteCookie", "tx.last_theme");

            if (!string.IsNullOrEmpty(prefs?.Size))
                await Js.InvokeVoidAsync("erpUx.writeRawCookie", "tx.last_size", prefs.Size, 365);
            else
                await Js.InvokeVoidAsync("erpUx.deleteCookie", "tx.last_size");

            if (!string.IsNullOrEmpty(prefs?.Culture))
                await Js.InvokeVoidAsync("erpUx.writeRawCookie", ".AspNetCore.Culture", $"c={prefs.Culture}|uic={prefs.Culture}", 365);
        }
        catch { /* best-effort: cookie yazılamazsa yalnız ilk boyama görünümü etkilenir */ }
    }

    public sealed record LangItem(string Code, string Label);
    public sealed record SignInPrefs(string? Theme, string? Size, string? Culture);
    public sealed record SignInResponse(bool Success, string? Error, SignInPrefs? Prefs = null);
}

