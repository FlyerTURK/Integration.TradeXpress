@page "/assay-offices/new"
@page "/assay-offices/{Id:guid}"
@using System
@using Integration.TradeXpress.AssayOffices
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IAssayOfficeAppService AssayOfficeAppService
@inject IObjectMapper Mapper

@*
   AssayOffice edit host = İNCE HOST: coordinator + sunum. Commit/save/delete/close generic CrudEditHost'ta.
   Agnostic CrudEditHost + dumb AssayOfficeLayout. Company-scoped (sunucu CompanyId zorlar).
*@

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="AssayOfficeGetDto" TListDto="AssayOfficeListDto" TKey="Guid" TListRequestDto="AssayOfficeListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["AssayOffice"].Value" IconCssClass="custom-icon-bullion"
                  EntityValue="@(m => m.Code)"
                  ApplyNewDefaults="@(m => { m.IsActive = true; m.DisplayOrder = 1; })">
        <AssayOfficeLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private ICommitCoordinator<AssayOfficeGetDto, AssayOfficeListDto, Guid, AssayOfficeListRequestDto>? _coordinator;
    private bool _ready;

    protected override Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<AssayOfficeGetDto, AssayOfficeListDto, Guid, AssayOfficeListRequestDto, AssayOfficeCreateDto, AssayOfficeUpdateDto>(
            AssayOfficeAppService, Mapper);
        _ready = true;
        return Task.CompletedTask;
    }
}
