@page "/sales-channels/etsy/new"
@page "/sales-channels/etsy/{Id:guid}"
@using Integration.TradeXpress.SalesChannels
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Etsy satış kanalı edit host = ince sarmal: coordinator (Etsy DTO'ları + ISalesChannelEtsyAppService) + OAuth köprüsü.
   Company-owned. SharedSecret update'te BOŞ gelir (redaksiyon); Keystring public client_id → görünür. "Etsy'ye Bağlan"
   StartOAuthAsync ile Etsy onay URL'ini alıp TAM yönlendirme yapar; Etsy /etsy/oauth-callback'e döner, endpoint bu
   sayfaya ?oauth=ok|err ile geri yönlendirir (toast burada gösterilir).
*@

@if (_coordinator != null)
{
    <CrudEditHost TGetDto="SalesChannelEtsyGetDto" TListDto="SalesChannelListDto" TKey="Guid" TListRequestDto="SalesChannelListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["SalesChannelType:Etsy"].Value" IconCssClass="@TradeXpressIcons.SalesChannel"
                  EntityValue="@(m => m.Code)"
                  ApplyNewDefaults="@(m => { m.IsActive = true; })"
                  OnAfterCreate="@OnChannelCreatedAsync">
        <SalesChannelEtsyLayout Model="@context" IsNew="@(context.Id == Guid.Empty)"
                                AutoImportProducts="@_autoImportProducts"
                                OnConnectClick="@(async () => await StartOAuthAsync(context))" />
    </CrudEditHost>
}
