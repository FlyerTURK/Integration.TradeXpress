@using Integration.TradeXpress.Services
@using Integration.TradeXpress.Permissions
@using Integration.TradeXpress.Blazor.Client.Pages.CurrentTransactions
@inherits Integration.Framework.Blazor.Client.Components.Crud.EntryPanelBase<SideCostItemDto>

@*
   Kanal "Giderler" grubu — 3 kanal formunun (N11/Trendyol/Etsy) ORTAK gider satırları editörü
   (2026-07-10 yeniden şekillendirme: sabit-alanlı form yerine ÜRÜN REÇETESİ PANELİ deseni — EntryPanelBase
   buffered draft + toolbar + grid; ProductRecipePanel paritesi). Her satır: Aktif · Tür · Ad · Hesaplama ·
   Değer · Birim · Hizmet (popup ekle/düzelt) · Fişleme (cari/gider + hesap cascade) · Sıra.
   Liste BOŞSA kanal tipine göre varsayılan tohum önerilir (SideCostItemDefaults).
   FİŞ HİZALAMASI: hizmet/cari bağları ileride sipariş→fiş akışında VoucherLine'a dönüşür — bu dilimde fiş yazılmaz.
*@

<DxLayoutBreakpoint MaxWidth="768" @bind-IsActive="@_isMobile" />

<div class="mt-3">
    <div style="font-weight:600; margin-bottom:4px;">@L["SideCosts"]</div>

    @if (!IsPanelOpen)
    {
        @* Gider toolbar'ı — "Yeni" dropdown'ı tür seçtirir; Düzenle/Sil seçili satıra. *@
        <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Plain"
                   AdaptivityAutoCollapseItemsToIcons="false" AdaptivityAutoHideRootItems="false">
            <DxToolbarItem Text="@L["New"]" IconCssClass="@TradeXpressIcons.Add" Tooltip="@L["New"].Value">
                <Items>
                    <DxToolbarItem Text="@KindLabel(SideCostKind.Packaging)"
                                   Click="@((ToolbarItemClickEventArgs e) => OpenItemDraft(SideCostKind.Packaging))" />
                    <DxToolbarItem Text="@KindLabel(SideCostKind.Cargo)"
                                   Click="@((ToolbarItemClickEventArgs e) => OpenItemDraft(SideCostKind.Cargo))" />
                    <DxToolbarItem Text="@KindLabel(SideCostKind.InsuredShipping)"
                                   Click="@((ToolbarItemClickEventArgs e) => OpenItemDraft(SideCostKind.InsuredShipping))" />
                    <DxToolbarItem Text="@KindLabel(SideCostKind.Commission)"
                                   Click="@((ToolbarItemClickEventArgs e) => OpenItemDraft(SideCostKind.Commission))" />
                    <DxToolbarItem Text="@KindLabel(SideCostKind.ChannelFixed)"
                                   Click="@((ToolbarItemClickEventArgs e) => OpenItemDraft(SideCostKind.ChannelFixed))" />
                </Items>
            </DxToolbarItem>
            <DxToolbarItem Text="@L["Edit"]" IconCssClass="@TradeXpressIcons.Edit" BeginGroup="true"
                           Enabled="@(_selectedItem is not null)"
                           Click="@((ToolbarItemClickEventArgs e) => EditSelectedItem())" />
            <DxToolbarItem Text="@L["Delete"]" IconCssClass="@TradeXpressIcons.Delete"
                           Enabled="@(_selectedItem is not null)"
                           Click="@(async (ToolbarItemClickEventArgs e) => await DeleteSelectedItemAsync())" />
        </DxToolbar>
    }
    else if (Draft is { } d)
    {
        <EntryPanelShell Title="@EditorTitle(d)"
                         SaveEnabled="true"
                         OnSave="@(async () => await SaveAndCloseAsync())"
                         OnBack="@(() => CloseDraft())">
            <div style="padding:8px; @(_isMobile ? "" : "overflow-x:auto;")">
                <div style="display:flex; @(_isMobile ? "flex-direction:column;" : "width:max-content;") gap:4px; align-items:flex-start;">

                    <div style="@GroupStyle(150)">
                        <small style="@ProcessPanelStyles.Label">@L["SideCost:Kind"]</small>
                        <DxComboBox TData="SideCostKindItem" TValue="SideCostKind"
                                    Data="@_kindItems" Value="@d.Kind"
                                    ValueChanged="@((SideCostKind v) => OnKindChanged(v))"
                                    ValueFieldName="@nameof(SideCostKindItem.Value)" TextFieldName="@nameof(SideCostKindItem.Label)"
                                    DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                    ValidationEnabled="false" CssClass="w-100" />
                    </div>

                    <div style="@GroupStyle(180)">
                        <small style="@ProcessPanelStyles.Label">@L["Name"]</small>
                        <DxTextBox Text="@d.DisplayName" TextChanged="@((string v) => OnDisplayNameChanged(v))"
                                   TextExpression="@(() => d.DisplayName)"
                                   NullText="@KindLabel(d.Kind)" CssClass="w-100" />
                    </div>

                    @* Hesaplama — komisyon kaleminde ZORUNLU GrossUp (sabit giderler komisyona tabi; kilitli). *@
                    <div style="@GroupStyle(170)">
                        <small style="@ProcessPanelStyles.Label">@L["SideCost:CalcMode"]</small>
                        <DxComboBox TData="SideCostCalcModeItem" TValue="SideCostCalcMode"
                                    Data="@_calcModeItems" Value="@d.CalcMode"
                                    ValueChanged="@((SideCostCalcMode v) => OnCalcModeChanged(v))"
                                    ValueFieldName="@nameof(SideCostCalcModeItem.Value)" TextFieldName="@nameof(SideCostCalcModeItem.Label)"
                                    Enabled="@(d.Kind != SideCostKind.Commission)"
                                    DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                    ValidationEnabled="false" CssClass="w-100" />
                    </div>

                    <div style="@GroupStyle()">
                        <small style="@ProcessPanelStyles.Label">@L["SideCost:Value"]</small>
                        <NumericSpinEdit TValue="decimal" Value="@d.Value" ValueChanged="@((decimal v) => d.Value = v)" ValueExpression="@(() => d.Value)"
                                         BindValueMode="BindValueMode.OnInput" ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
                    </div>

                    @* Birim — yalnız sabit tutarda (mutlak tutarın para birimi; boş = kanal yereli). *@
                    @if (d.CalcMode == SideCostCalcMode.FixedAmount)
                    {
                        <div style="@GroupStyle(140)">
                            <small style="@ProcessPanelStyles.Label">@L["Unit"]</small>
                            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?" Data="@_currencyUnits"
                                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)" TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                                            Value="@d.CurrencyUnitId"
                                            ValueChanged="@((Guid? v) => d.CurrencyUnitId = v)"
                                            NullText="@L["SideCost:LocalCurrency"].Value" AllowClear="true" />
                        </div>
                    }

                    <div style="@GroupStyle(170)">
                        <small style="@ProcessPanelStyles.Label">@L["SideCost:Service"]</small>
                        <LookupComboBox TItem="ServiceListDto" TValue="Guid?" Data="@_services"
                                        ValueFieldName="@nameof(ServiceListDto.Id)" TextFieldName="@nameof(ServiceListDto.Code)"
                                        Value="@d.ServiceId"
                                        ValueChanged="@((Guid? v) => d.ServiceId = v)"
                                        NullText="@L["Select"].Value" AllowClear="true"
                                        OnAddRequested="@OnServiceAddAsync"
                                        OnEditRequested="@OnServiceEditAsync"
                                        CreatePolicy="@TradeXpressPermissions.Services.Create"
                                        UpdatePolicy="@TradeXpressPermissions.Services.Update" />
                    </div>

                    <div style="@GroupStyle(140)">
                        <small style="@ProcessPanelStyles.Label">@L["SideCost:PostingMode"]</small>
                        <DxComboBox TData="SideCostPostingModeItem" TValue="SideCostPostingMode"
                                    Data="@_postingModeItems" Value="@d.PostingMode"
                                    ValueChanged="@((SideCostPostingMode v) => OnPostingModeChanged(v))"
                                    ValueFieldName="@nameof(SideCostPostingModeItem.Value)" TextFieldName="@nameof(SideCostPostingModeItem.Label)"
                                    DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                    ValidationEnabled="false" CssClass="w-100" />
                    </div>

                    @if (d.PostingMode == SideCostPostingMode.CounterpartyAccount)
                    {
                        <div style="@GroupStyle(150)">
                            <small style="@ProcessPanelStyles.Label">@L["Account"]</small>
                            <LookupComboBox TItem="AccountListDto" TValue="Guid?" Data="@_accounts"
                                            ValueFieldName="@nameof(AccountListDto.Id)" TextFieldName="@nameof(AccountListDto.Code)"
                                            Value="@d.AccountId"
                                            ValueChanged="@((Guid? v) => OnAccountChanged(v))"
                                            NullText="@L["Select"].Value" AllowClear="true"
                                            OnAddRequested="@OnAccountAddAsync"
                                            OnEditRequested="@OnAccountEditAsync"
                                            CreatePolicy="@TradeXpressPermissions.Accounts.Create"
                                            UpdatePolicy="@TradeXpressPermissions.Accounts.Update">
                                <Columns>
                                    <DxListEditorColumn FieldName="@nameof(AccountListDto.Code)" Caption="@L["Code"]" Width="40%" />
                                    <DxListEditorColumn FieldName="@nameof(AccountListDto.Name)" Caption="@L["Name"]" />
                                </Columns>
                            </LookupComboBox>
                        </div>

                        @if (d.AccountId.HasValue)
                        {
                            <div style="@GroupStyle(150)">
                                <small style="@ProcessPanelStyles.Label">@L["SubAccount"]</small>
                                <LookupComboBox TItem="SubAccountListDto" TValue="Guid?" Data="@FilteredSubAccounts(d)"
                                                ValueFieldName="@nameof(SubAccountListDto.Id)" TextFieldName="@nameof(SubAccountListDto.Code)"
                                                Value="@d.SubAccountId"
                                                ValueChanged="@((Guid? v) => d.SubAccountId = v)"
                                                NullText="@L["Select"].Value" AllowClear="true" />
                            </div>
                        }
                    }

                    <div style="@GroupStyle(60)">
                        <small style="@ProcessPanelStyles.Label">@L["DisplayOrder"]</small>
                        <NumericSpinEdit TValue="int" Value="@d.DisplayOrder" ValueChanged="@((int v) => d.DisplayOrder = v)" ValueExpression="@(() => d.DisplayOrder)"
                                         BindValueMode="BindValueMode.OnInput" ShowSpinButtons="false" DisplayFormat="N0" Mask="N0" />
                    </div>

                </div>

                @* İkinci satır: anahtarlar — Aktif; komisyonda AutoRate; opt-in genellemesi (Loomis deseni). *@
                <div style="display:flex; @(_isMobile ? "flex-direction:column;" : "") gap:16px; margin-top:8px; align-items:flex-start;">
                    <DxCheckBox @bind-Checked="@d.IsEnabled" CheckType="CheckType.Switch">@L["Status"]</DxCheckBox>
                    @if (d.Kind == SideCostKind.Commission)
                    {
                        <DxCheckBox @bind-Checked="@d.AutoRate" CheckType="CheckType.Switch">@L["SideCost:AutoRate"]</DxCheckBox>
                    }
                    <DxCheckBox @bind-Checked="@d.RequiresVariantOptIn" CheckType="CheckType.Switch">@L["SideCost:RequiresVariantOptIn"]</DxCheckBox>
                </div>
            </div>
        </EntryPanelShell>
    }

    @* Gider satırı grid'i — reçete grid dizilimi (pager yok); satıra tıkla → seç (Düzenle draft'a kopyalar). *@
    <DxGrid Data="@OrderedItems" SelectionMode="GridSelectionMode.Single"
            AllowSelectRowByClick="true"
            SelectedDataItem="@_selectedItem" SelectedDataItemChanged="@((object item) => OnSelectedItemChanged(item))"
            PagerVisible="false" PageSize="1000" CssClass="mt-2">
        <Columns>
            <DxGridDataColumn AllowSort="false" Caption="@L["Status"]" Width="90px">
                <CellDisplayTemplate><StatusCell Active="@(((SideCostItemDto)context.DataItem).IsEnabled)" /></CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn AllowSort="false" Caption="@L["SideCost:Kind"]" Width="130px">
                <CellDisplayTemplate>@KindLabel(((SideCostItemDto)context.DataItem).Kind)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn AllowSort="false" Caption="@L["Name"]" Width="150px">
                <CellDisplayTemplate>@DisplayNameOf((SideCostItemDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn AllowSort="false" Caption="@L["SideCost:CalcMode"]" Width="140px">
                <CellDisplayTemplate>@CalcModeLabel((SideCostItemDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn AllowSort="false" FieldName="@nameof(SideCostItemDto.Value)" Caption="@L["SideCost:Value"]"
                              DisplayFormat="N2" TextAlignment="GridTextAlignment.Right" Width="90px" />
            <DxGridDataColumn AllowSort="false" Caption="@L["Unit"]" Width="80px">
                <CellDisplayTemplate>@UnitLabelOf((SideCostItemDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn AllowSort="false" Caption="@L["SideCost:Service"]" Width="110px">
                <CellDisplayTemplate>@ServiceCodeOf((SideCostItemDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn AllowSort="false" Caption="@L["SideCost:PostingMode"]" Width="160px">
                <CellDisplayTemplate>@PostingLabelOf((SideCostItemDto)context.DataItem)</CellDisplayTemplate>
            </DxGridDataColumn>
            <DxGridDataColumn AllowSort="false" FieldName="@nameof(SideCostItemDto.DisplayOrder)" Caption="@L["Nr"]"
                              TextAlignment="GridTextAlignment.Right" Width="50px" />
        </Columns>
    </DxGrid>

    @* Kanala-özgü ipuçları — komisyon sıra kuralı + Loomis/opt-in + fiş bağlama önerisi. *@
    <div style="display:flex; flex-direction:column; gap:2px; margin-top:6px;">
        <span style="color:#6c757d; font-size:0.85rem;">@CommissionHint</span>
        <span style="color:#6c757d; font-size:0.85rem;">@L["SideCost:InsuredShippingHint"]</span>
        <span style="color:#6c757d; font-size:0.85rem;">@L["SideCost:LinkHint"]</span>
    </div>

    @* N11: kategori komisyonlarını gömülü TSV'den içe aktar — uç tenant'tan çağrılabilir (yazım host-global
       kataloğa Change(null) ile; 2026-07-10 kararı: host'ta kanal menüsü yok, katalog beslemesi tenant'tan). *@
    @if (IsN11)
    {
        <div style="margin-top:8px;">
            <DxButton Text="@L["SideCost:ImportN11Commissions"]" IconCssClass="@TradeXpressIcons.SalesChannel"
                      RenderStyle="ButtonRenderStyle.Secondary" Enabled="@(!_importing)"
                      Click="@(async () => await ImportCommissionsAsync())" />
        </div>
        @if (_importResult is { } r)
        {
            <div style="font-size:0.85rem; display:flex; flex-direction:column; gap:2px; margin-top:6px;">
                <span>@L["SideCost:ImportResultSummary", r.MatchedCount, r.TotalRowCount, r.UpdatedCategoryCount, r.LeafCount]</span>
                @if (r.UnmatchedRows.Count > 0)
                {
                    <span style="color:#b45309;">@L["SideCost:ImportUnmatched", r.UnmatchedRows.Count]</span>
                }
                @if (r.ConflictRows.Count > 0)
                {
                    <span style="color:#b45309;">@L["SideCost:ImportConflicts", r.ConflictRows.Count]</span>
                }
                @if (r.InvalidRows.Count > 0)
                {
                    <span style="color:#b45309;">@L["SideCost:ImportInvalid", r.InvalidRows.Count]</span>
                }
                @if (ImportIssueLines.Count > 0)
                {
                    @* Tek yönlü Text bağı → ValidationEnabled=false ŞART (TextExpression yok — tekrarlayan DevExpress tuzağı). *@
                    <DxMemo Text="@string.Join('\n', ImportIssueLines)" ReadOnly="true" Rows="6"
                            ValidationEnabled="false" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
                }
            </div>
        }
    }
</div>
