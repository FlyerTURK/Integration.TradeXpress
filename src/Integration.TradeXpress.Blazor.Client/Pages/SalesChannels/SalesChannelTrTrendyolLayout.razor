@using Integration.TradeXpress.SalesChannels
@using Integration.Framework.Blazor.Client.Components.Inputs
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Trendyol satış kanalı DUMB Layout — yalnız SalesChannelTrTrendyolGetDto'yu forma yansıtır (I/O yok).
   Sıra (ui-blazor): Kod → Ad → SellerId → Token (birincil) → ApiKey/ApiSecret (alternatif) → Description → Status.
   SellerId kimliktir (sır değil) → görünür; UI regex (yalnız rakam) DTO'daki [RegularExpression] ile doğrulanır.
   Token = base64(apiKey:apiSecret): yapıştırılınca sunucu ApiKey/ApiSecret'a ayırır (elle yazım I/l/1/O/0 karışıklığını atlatır).
   ApiKey/ApiSecret sır → düzenlemede BOŞ gelir (redaksiyon), "boş = korunur"; Token'ın ALTERNATİFİ (biri yeter → * yok).
*@

<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["SalesChannel:SellerId"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.SellerId" />
        </DxFormLayoutItem>
        <DxFormLayoutItem ColSpanMd="12">
            <CaptionTemplate>
                <InfoCaption Text="@L["SalesChannel:Trendyol:Token"].Value" HintText="@L["SalesChannel:Trendyol:TokenHint"].Value" />
            </CaptionTemplate>
            <Template>
                <DxTextBox @bind-Text="@Model.Token" NullText="@L["SalesChannel:Trendyol:TokenPlaceholder"].Value" CssClass="w-100" />
            </Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["SalesChannel:ApiKey"].Value" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.ApiKey" NullText="@SecretPlaceholder" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["SalesChannel:ApiSecret"].Value" ColSpanMd="6">
            <PasswordTextEdit @bind-Text="@Model.ApiSecret" NullText="@SecretPlaceholder" Tooltip="@L["ShowPassword"]" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        @* Muhasebe hedefi: bu kanalın hareketleri hangi cari alt hesaba yazılır.
           Cari ayrıca seçilmez — alt hesap listede "CARİ / ALT" olarak görünür. *@
        <SalesChannelSubAccountField @bind-Value="@Model.SubAccountId" />
        @* VARSAYILAN KARGO FİRMASI (2026-08-10 Hakan): kanal ürünleri kendi firması seçilmediğinde bunu
           devralır. Kargo KANALIN özelliğidir, ürünün değil — aynı ürün her pazaryerinde farklı firmayla
           gider (CLAUDE.md kargo kararı). Liste host-global seed'den gelir (TrendyolCargoProviderSeeder):
           Trendyol hesabı olsun olmasın doludur, çünkü Trendyol'un firmaları döndüren bir HTTP ucu YOKTUR.
           Yeni kanalda seçim ÖN-DOLU gelir; kararı sunucu verir (TrendyolDefaultCargoProviderResolver). *@
        <DxFormLayoutItem Caption="@L["SalesChannel:Trendyol:DefaultCargoProvider"]" ColSpanMd="6">
            <DxComboBox Data="@_cargoProviders"
                        @bind-Value="@Model.DefaultCargoProviderId"
                        ValueFieldName="@nameof(TrendyolCargoProviderDto.Id)"
                        TextFieldName="@nameof(TrendyolCargoProviderDto.Name)"
                        NullText="@L["SalesChannel:Trendyol:CargoNotChosen"]"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6" BeginRow="true">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
                @(Model.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@* Giderler — kanal yan-maliyet ayarları (ortak editör; Etsy alanları/N11 import düğmesi bu kanalda gizli). *@

@* İŞLEM DÜĞMELERİ KALDIRILDI (2026-08-10 Hakan kararı): kurulum sihirbazı · kategori senkronu · ürün içe
   aktarma · fiyatlandırma tahtası. Dördü de DÜZENLEME değil İŞLEM'di; edit formunun işi kanalın alanlarını
   düzenlemektir. Üstelik dördü de başka bir yerden zaten erişilebilir durumda:
     · kategori ağacı kanal oluşturulurken app service hook'uyla ZATEN senkronlanıyor
     · ürün içe aktarımı sihirbazın kendi adımında (RunImportAsync) + create-anı otomatik tetikleme
     · fiyatlandırma tahtası sihirbazın içe aktarım adımında
   Aynı iş üç ayrı yerden tetiklenebiliyordu; sadeleşti. Hakan bu yüzeye farklı bir tasarım planlıyor. *@

@* KANALA ÖZGÜ SEKMELER — yalnız kaydedilmiş kanalda (persistent drill'ler kanal Id'sine bağlıdır).
   Sekme yapısı BİLEREK tek sekmeyle başlıyor: bu kanala özgü başka tanımlar (kargo firmaları, kanal
   soruları, gider ayarları...) yanına EKLENECEK. Yeni sekme eklerken @if ile SARMA — DxTabPage bir
   nested-settings öğesidir, sonradan eklenince listenin sonuna düşer; koşul için Visible kullan. *@
@if (!IsNew)
{
    @* İŞLEM DÜĞMELERİ ARAÇ ÇUBUĞUNDA (2026-08-10 Hakan uyarısı: "form altı toolbar eklemeyi alışkanlık
       haline getirme, bir toolbarımız varken buna gerek yok"). Sihirbaz ve içe aktarım artık edit host'un
       BuildCustomActions uzatma noktasından geçip MEVCUT araç çubuğuna giriyor. Formun altına ikinci bir
       düğme şeridi koymak hem yer israfıydı hem de aynı işlemlerin uygulamanın geri kalanında araç
       çubuğunda durmasıyla çelişiyordu. *@
    <DrillTabs CssClass="mt-3">
        <DxTabPage Text="@L["SalesChannelProducts"]" TabIconCssClass="@TradeXpressIcons.Product">
            @* Bu kanala bağlı TÜM kayıtlar (pazaryerine gitmiş/gitmemiş AYRIMI YOK; gitmemiş olan zaten
               aranan satırdır). Standalone "Kanal Ürünleri" sayfasıyla AYNI bileşen — tek fark daraltma. *@
            <ChannelProductsPanel SalesChannelId="@Model.Id" StateKey="sales-channel-products:trendyol-form:v5" />
        </DxTabPage>
    </DrillTabs>
}
