@using Integration.TradeXpress.SalesChannels
@using Integration.Framework.Blazor.Client.Components.Inputs
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Trendyol satış kanalı DUMB Layout — yalnız SalesChannelTrTrendyolGetDto'yu forma yansıtır (I/O yok).
   Sıra (ui-blazor): Kod → Ad → SellerId → Token (birincil) → ApiKey/ApiSecret (alternatif) → Description → Status.
   SellerId kimliktir (sır değil) → görünür; UI regex (yalnız rakam) DTO'daki [RegularExpression] ile doğrulanır.
   Token = base64(apiKey:apiSecret): yapıştırılınca sunucu ApiKey/ApiSecret'a ayırır (elle yazım I/l/1/O/0 karışıklığını atlatır).
   ApiKey/ApiSecret sır → düzenlemede BOŞ gelir (redaksiyon), "boş = korunur"; Token'ın ALTERNATİFİ (biri yeter → * yok).
*@

<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["SalesChannel:SellerId"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.SellerId" />
        </DxFormLayoutItem>
        <DxFormLayoutItem ColSpanMd="12">
            <CaptionTemplate>
                <InfoCaption Text="@L["SalesChannel:Trendyol:Token"].Value" HintText="@L["SalesChannel:Trendyol:TokenHint"].Value" />
            </CaptionTemplate>
            <Template>
                <DxTextBox @bind-Text="@Model.Token" NullText="@L["SalesChannel:Trendyol:TokenPlaceholder"].Value" CssClass="w-100" />
            </Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["SalesChannel:ApiKey"].Value" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.ApiKey" NullText="@SecretPlaceholder" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["SalesChannel:ApiSecret"].Value" ColSpanMd="6">
            <PasswordTextEdit @bind-Text="@Model.ApiSecret" NullText="@SecretPlaceholder" Tooltip="@L["ShowPassword"]" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        @* Muhasebe hedefi: bu kanalın hareketleri hangi cari alt hesaba yazılır.
           Cari ayrıca seçilmez — alt hesap listede "CARİ / ALT" olarak görünür. *@
        <SalesChannelSubAccountField @bind-Value="@Model.SubAccountId" />
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6" BeginRow="true">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
                @(Model.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@* Giderler — kanal yan-maliyet ayarları (ortak editör; Etsy alanları/N11 import düğmesi bu kanalda gizli). *@

@* Kategori senkronizasyonu — yalnız kaydedilmiş kanalda (host-global ağaç kanal kimliğiyle çekilir). Kategori
   picker'ının dolu gelmesi için tetikleyici; kanal ilk oluşturulduğunda otomatik de senkronlanır (AppService hook). *@
@if (!IsNew)
{
    @* Kurulum sihirbazı — MEVCUT kanal için. Sihirbaz yalnız "Yeni kanal" yolundan açılsaydı ulaşılamaz olurdu:
       her türden en fazla bir kanal var, dolayısıyla kanalını kuran kullanıcı "Yeni"yi ebediyen kapalı görür. *@
    <div class="mt-3">
        <DxButton Text="@L["SalesChannel:OpenSetupWizard"]"
                  IconCssClass="@TradeXpressIcons.SalesChannel"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Click="@(() => Navigation.NavigateTo($"/sales-channels/trendyol/wizard/{Model.Id}"))" />
    </div>

    <TrendyolCategorySyncPanel />

    @* Pazaryerinden ürün içe aktarma — mevcut Trendyol listelemeleri şablon ürün + varyant + kanal grafı olarak
       içeri alınır (salt GET; idempotent). Sonuç raporu panelin altında gösterilir. Kanal bu oturumda YENİ
       oluşturulduysa (AutoImport) panel ilk görünümünde importu otomatik başlatır. *@
    <TrendyolMarketplaceImportPanel SalesChannelId="@Model.Id" AutoImport="@AutoImportProducts" />
}
