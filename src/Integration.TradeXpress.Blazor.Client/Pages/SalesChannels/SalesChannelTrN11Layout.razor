@using Integration.TradeXpress.SalesChannels
@using Integration.Framework.Blazor.Client.Components.Inputs
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   N11 satış kanalı DUMB Layout — yalnız SalesChannelTrN11GetDto'yu forma yansıtır (I/O yok).
   Sıra (ui-blazor): Kod → Ad → AppKey/AppSecret → Description → Status.
   Sızıntı önleme: düzenlemede (IsNew=false) AppKey/AppSecret BOŞ gelir (sunucu redakte eder) → "boş = korunur".
*@

@* SAHTE SUNUCU UYARISI — bu kanalın N11 istekleri gerçek N11'e DEĞİL yerel taklide gidiyor. Gizlenirse
   kullanıcı "push başarılı" görüp ürünün N11'de olduğunu sanır; sessiz yanlış kararların en kolay yolu budur. *@
@if (Model.IsMockEndpoint)
{
    <div style="display:flex; align-items:center; gap:8px; padding:8px 12px; margin-bottom:10px;
                border:1px solid #f0ad4e; border-radius:6px; background:#fff8e6; font-size:0.9rem;">
        <span style="font-weight:700; color:#8a6100;">MOCK</span>
        <span>@L["SalesChannelTrN11:MockEndpointWarning"]</span>
    </div>
}

<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@(IsNew ? $"{L["SalesChannel:AppKey"]} *" : L["SalesChannel:AppKey"].Value)" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.AppKey" NullText="@SecretPlaceholder" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@(IsNew ? $"{L["SalesChannel:AppSecret"]} *" : L["SalesChannel:AppSecret"].Value)" ColSpanMd="6">
            <PasswordTextEdit @bind-Text="@Model.AppSecret" NullText="@SecretPlaceholder" Tooltip="@L["ShowPassword"]" CssClass="w-100" />
        </DxFormLayoutItem>

        @* Kanal düzeyi varsayılan N11 bilgi metinleri — yeni kargo şablonu formunu ön-doldurur (kullanıcı ezebilir). Opsiyonel. *@
        <DxFormLayoutGroup Caption="@L["SalesChannelTrN11:DefaultInfos"]" ColSpanMd="12">
            <DxFormLayoutItem Caption="@L["SalesChannelTrN11:DefaultShippingInfo"]" ColSpanMd="12">
                <DxMemo @bind-Text="@Model.DefaultShippingInfo" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["SalesChannelTrN11:DefaultExchangeInfo"]" ColSpanMd="12">
                <DxMemo @bind-Text="@Model.DefaultExchangeInfo" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["SalesChannelTrN11:DefaultInstallmentInfo"]" ColSpanMd="12">
                <DxMemo @bind-Text="@Model.DefaultInstallmentInfo" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
            </DxFormLayoutItem>
        </DxFormLayoutGroup>

        <DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
        </DxFormLayoutItem>
        @* Muhasebe hedefi: bu kanalın hareketleri hangi cari alt hesaba yazılır.
           Cari ayrıca seçilmez — alt hesap listede "CARİ / ALT" olarak görünür. *@
        <SalesChannelSubAccountField @bind-Value="@Model.SubAccountId" />
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6" BeginRow="true">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
                @(Model.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@* Giderler — kanal yan-maliyet ayarları (paketleme/kargo/sigortalı gönderim/komisyon) + N11 komisyon importu.
   Ortak editör (3 kanal formu aynı bileşeni tüketir); ilgisiz alanlar kanala göre gizli. *@

@* Kargo şablonları + kanala ait N11 ürün listelemeleri — yalnız kaydedilmiş kanalda (persistent drill'ler
   kanal Id'sine bağlıdır). Sekmeler: Kargo Şablonları · N11 Ürünleri (o kanala ait listelemeler). *@
@if (!IsNew)
{
    @* SİHİRBAZ DÜĞMESİ KALDIRILDI (2026-08-10 Hakan kararı): "bu yüzeyde farklı bir şey planlıyorum".
       Trendyol tahtasındaki ikizi de aynı gün kalktı. ⚠ Bilinen sonuç: sihirbaz artık YALNIZ "Yeni ▾ → N11"
       yolundan açılıyor; o yol da tek-kanal kuralıyla kapalı olduğundan MEVCUT kanalın sihirbazına UI'dan
       ulaşılmıyor (rota — /sales-channels/n11/wizard/{id} — duruyor). Yeni giriş noktası tasarlanacak. *@

    @* Mağazadan ürün içe aktarma — mevcut N11 listelemeleri şablon ürün + varyant + kanal kaydı olarak içeri
       alınır (salt GET; idempotent). Kanal bu oturumda YENİ oluşturulduysa (AutoImportProducts) panel ilk
       görünümünde çekimi kendiliğinden başlatır; rapor yine ekranda kalır (KDV uyarısı görünür olsun diye). *@
    <N11MarketplaceImportPanel SalesChannelId="@Model.Id" AutoImport="@AutoImportProducts" />

    @* N11 ÇALIŞMA TAHTASI — Trendyol tahtasının ikizi; içe aktarımın BIRAKTIĞI işi gösterir.
       İçe aktarım panelinin hemen ALTINDA: akış sıralı — önce çek, sonra "şimdi ne yapmam gerekiyor"u gör. *@
    <N11PricingBoardPanel SalesChannelId="@Model.Id" />

    <DrillTabs CssClass="mt-3">
        <DxTabPage Text="@L["N11ShipmentTemplates"]" TabIconCssClass="@TradeXpressIcons.SalesChannel">
            <N11ShipmentTemplateDrill Channel="@Model" />
        </DxTabPage>
        <DxTabPage Text="@L["N11Products"]" TabIconCssClass="@TradeXpressIcons.Product">
            <SalesChannelTrN11ProductsDrill Channel="@Model" />
        </DxTabPage>
    </DrillTabs>
}
else
{
    <div class="mt-3">@L["N11ShipmentTemplate:SaveChannelFirst"]</div>
}
