@page "/services/new"
@page "/services/{Id:guid}"
@using System
@using Integration.TradeXpress.Services
@using Integration.Framework.Blazor.Client.Components.Crud
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IServiceAppService ServiceAppService
@inject Volo.Abp.ObjectMapping.IObjectMapper Mapper

@*
   Service edit host = ince host: coordinator + config. Global Service tenant'ta salt-okunur.

   HAZIRLIK KAPISI (_ready) BURADA BİLİNÇLİ OLARAK YOK — sapma DEĞİL (2026-08-20 denetim notu):
   kardeş emtia host'ları (Metal · Scrap · Future · Jewelry · Stone · Good) OnInitializedAsync'te GERÇEK I/O
   bekliyor (para birimi lookup'ı, Working.EnsureLoadedAsync, yerel para birimi) ve Blazor ilk render'ı o
   await'te yaptığı için `_ready` olmasa form BOŞ lookup listeleriyle çizilir, veri gelince yeniden çizilirdi;
   `_ready` tam bunu önlüyor. Hizmette beklenecek bir şey yok: ServiceLayout saf DUMB form (yalnız Model + IsNew;
   lookup yok, servis çağrısı yok) ve coordinator kurulumu SENKRON → OnInitialized ilk render'dan ÖNCE bitiyor,
   yani `_ready` eklemek davranışı değiştirmez (form bir tık geç çizilmez, ilk render'da boş kalmaz) ama
   OLMAYAN bir async hazırlığı varmış gibi gösterirdi. Aynı sebeple `_ready`siz kardeşler: SubAccountEditHost ·
   RoleEditHost · UserEditHost · SalesChannel{Etsy,TrN11,TrTrendyol}EditHost.
   ⚠ Buraya bir gün await'li hazırlık girerse (lookup / working context) hazırlık bayrağı DA gerekir — `_ready` o zaman eklenir.
*@

@if (_coordinator != null)
{
    <CrudEditHost TGetDto="ServiceGetDto" TListDto="ServiceListDto" TKey="Guid" TListRequestDto="ServiceListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  SupportsSaveAndNew="@SupportsSaveAndNew" SupportsDelete="@SupportsDelete"
                  FormCaption="@L["Service"].Value" IconCssClass="@TradeXpressIcons.Service"
                  EntityValue="@(m => m.Code)"
                  IsReadOnly="@(m => m.IsGlobal && CurrentTenant?.Id != null)"
                  ApplyNewDefaults="@ApplyNewDefaults">
        <ServiceLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" />
    </CrudEditHost>
}

@* C# tarafı ServiceEditHost.razor.cs'te (code-behind kuralı — 2026-08-07 taşıması). *@
