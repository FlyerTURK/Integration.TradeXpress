@page "/services/new"
@page "/services/{Id:guid}"
@using System
@using Integration.TradeXpress.Services
@using Integration.Framework.Blazor.Client.Components.Crud
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject IServiceAppService ServiceAppService
@inject Volo.Abp.ObjectMapping.IObjectMapper Mapper

@*
   Service edit host = ince sarmal: coordinator + config. Global Service tenant'ta salt-okunur.
*@

@if (_coordinator != null)
{
    <CrudEditHost TGetDto="ServiceGetDto" TListDto="ServiceListDto" TKey="Guid" TListRequestDto="ServiceListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  SupportsSaveAndNew="@SupportsSaveAndNew" SupportsDelete="@SupportsDelete"
                  FormCaption="@L["Service"].Value" IconCssClass="@TradeXpressIcons.Service"
                  EntityValue="@(m => m.Code)"
                  IsReadOnly="@(m => m.IsGlobal && CurrentTenant?.Id != null)"
                  ApplyNewDefaults="@ApplyNewDefaults">
        <ServiceLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" />
    </CrudEditHost>
}

