@page "/countries"
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.TradeXpress.Blazor.Client.Pages.Countries.Models
@using Integration.TradeXpress.Countries
@using DevExpress.Blazor
@inherits CrudPageBase<CountryGetDto, CountryListDto, Guid, CountryListRequestDto, CountryCreateDto, CountryUpdateDto>

<CrudLayout TGetDto="CountryGetDto"
            TListDto="CountryListDto"
            TViewModel="CountryViewModel"
            TKey="Guid"
            StateService="StateService"
            DataSource="@GridDataSource"
            EntityName="@L["Entity:Country"]"
            EntityIcon="@TradeXpressIcons.Country"
            PrimaryTextSelector="@(m => m.Code)"
            PageTitle="@L["Menu:Countries"]"
            OnNewClick="BeforeCreateAsync"
            OnUpdateClick="BeforeUpdateAsync"
            OnDeleteClick="DeleteAsync"
            OnRefreshClick="GetListAsync"
            OnSearchChanged="OnSearchAsync">

    <GridColumns>
        <GridLinkColumn FieldName="Code" Caption="@L["Code"]" Width="90px" VisibleIndex="0"
                        OnClick="@(o => BeforeUpdateAsync((CountryListDto)o))" />
        <DxGridDataColumn FieldName="Name" Caption="@L["Name"]" VisibleIndex="1" />
        <GridLinkColumn FieldName="DefaultCurrencyCode" Caption="@L["BaseCurrency"]" Width="140px" VisibleIndex="2"
                        OnClick="@(o => OpenUnitAsync(((CountryListDto)o).DefaultCurrencyUnitId, ((CountryListDto)o).DefaultCurrencyCode))" />
        <DxGridDataColumn FieldName="IsGlobal" Caption="@L["Kind"]" Width="100px" VisibleIndex="3" TextAlignment="GridTextAlignment.Left">
            <CellDisplayTemplate>@(((CountryListDto)context.DataItem).IsGlobal ? L["CurrencyKind:Global"] : L["CurrencyKind:Company"])</CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="90px" VisibleIndex="4" />
    </GridColumns>

    

</CrudLayout>





