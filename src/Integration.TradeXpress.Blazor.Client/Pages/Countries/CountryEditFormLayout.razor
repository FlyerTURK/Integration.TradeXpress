@using Integration.TradeXpress.Blazor.Client.Pages.Countries.Models
@using Integration.TradeXpress.Countries
@using Microsoft.Extensions.Localization
@using DevExpress.Blazor
@inject Integration.TradeXpress.Currencies.ICurrencyUnitAppService CurrencyAppService

<DxFormLayout Data="@Model" CssClass="w-100">
    <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
        <DxTextBox @bind-Text="@Model.Code" @ref="_codeBox" NullText="TR / US ..."
                   Enabled="@(Model.Id == Guid.Empty)" />
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="6">
        <DxTextBox @bind-Text="@Model.Name" />
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="@L["BaseCurrency"]" ColSpanMd="6">
        <DxComboBox Data="@_currencyCodes"
                    @bind-Value="@Model.DefaultCurrencyCode"
                    SearchMode="ListSearchMode.AutoSearch"
                    SearchFilterCondition="ListSearchFilterCondition.Contains"
                    NullText="@L["Select"]" />
        <div class="form-text text-muted small">@L["DefaultCurrencyHint"]</div>
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
        <DxSpinEdit @bind-Value="@Model.DisplayOrder" />
    </DxFormLayoutItem>
    <DxFormLayoutItem Caption="@L["IsActive"]" ColSpanMd="6">
        <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
            @(Model.IsActive ? L["Active"] : L["Passive"])
        </DxCheckBox>
    </DxFormLayoutItem>
</DxFormLayout>

@code {
    [Parameter, EditorRequired] public CountryViewModel Model { get; set; } = default!;
    [Parameter, EditorRequired] public IStringLocalizer L { get; set; } = default!;

    private DxTextBox? _codeBox;
    private List<string> _currencyCodes = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await CurrencyAppService.GetListAsync(
                new Integration.TradeXpress.Currencies.CurrencyUnitListRequestDto { MaxResultCount = 1000 });
            _currencyCodes = result.Items.Select(x => x.Code).ToList();
        }
        catch
        {
            _currencyCodes = ["TRY", "USD", "EUR", "GBP"];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Model.Id == Guid.Empty && _codeBox != null)
            await _codeBox.FocusAsync();
    }
}
