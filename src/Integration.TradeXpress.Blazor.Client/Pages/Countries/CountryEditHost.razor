@page "/countries/new"
@page "/countries/{Id:guid}"
@using System
@using System.Linq
@using System.Collections.Generic
@using Integration.TradeXpress.Countries
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject ICountryAppService CountryAppService
@inject ICurrencyUnitAppService CurrencyAppService
@inject IObjectMapper Mapper

@*
   Country edit host = İNCE SARMAL: concrete AppService inject + coordinator kur + referans (döviz) çek + config.
   commit/save/delete/close TEK yerde (generic CrudEditHost). CountryListPage'in EditComponentType'ı (popup).
*@

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="CountryGetDto" TListDto="CountryListDto" TKey="Guid" TListRequestDto="CountryListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["Entity:Country"].Value" IconCssClass="fas fa-globe"
                  EntityValue="@(m => m.Code)"
                  ApplyNewDefaults="@(m => { m.IsActive = true; m.DisplayOrder = 1; })">
        <CountryLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" CurrencyCodes="@_currencyCodes" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private List<string> _currencyCodes = new();
    private ICommitCoordinator<CountryGetDto, CountryListDto, Guid, CountryListRequestDto>? _coordinator;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<CountryGetDto, CountryListDto, Guid, CountryListRequestDto, CountryCreateDto, CountryUpdateDto>(
            CountryAppService, Mapper);

        try
        {
            var cur = await CurrencyAppService.GetListAsync(new CurrencyUnitListRequestDto { MaxResultCount = 1000 });
            _currencyCodes = cur.Items.Select(x => x.Code).ToList();
        }
        catch
        {
            _currencyCodes = new() { "TRY", "USD", "EUR", "GBP" };   // feed yoksa makul varsayılan
        }

        _ready = true;
    }
}
