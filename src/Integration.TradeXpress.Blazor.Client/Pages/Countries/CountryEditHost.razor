@page "/countries/new"
@page "/countries/{Id:guid}"
@using System
@using System.Collections.Generic
@using System.Linq
@using Integration.TradeXpress.Countries
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.TradeXpress.Blazor.Client.Pages.Financials.CurrencyUnits
@using Integration.Framework.Blazor.Client.Components.Crud
@using Integration.Framework.Blazor.Client.Services.Base
@using Volo.Abp.ObjectMapping
@using Microsoft.Extensions.Localization
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase
@inject ICountryAppService CountryAppService
@inject ILookupCache<CurrencyUnitListDto> CurrencyLookup
@inject IViewOpener ViewOpener
@inject IPopupService PopupService
@inject IObjectMapper Mapper

@*
   Country edit host = İNCE SARMAL: concrete AppService inject + coordinator kur + referans (döviz) read-koordinatörden
   çek + config. commit/save/delete/close TEK yerde (generic CrudEditHost). CountryListPage'in EditComponentType'ı (tab).
   Döviz listesi ILookupCache'ten (5dk TTL + EntityChange auto-invalidate). Quick-add: combo "+" → yeni döviz POPUP.
*@

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="CountryGetDto" TListDto="CountryListDto" TKey="Guid" TListRequestDto="CountryListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed"
                  FormCaption="@L["Entity:Country"].Value" IconCssClass="custom-icon-country"
                  EntityValue="@(m => m.Code)"
                  ApplyNewDefaults="@(m => { m.IsActive = true; m.DisplayOrder = 1; })">
        <CountryLayout Model="@context" IsNew="@(context.Id == Guid.Empty)" Currencies="@_currencies"
                       OnAddCurrency="@OnAddCurrencyAsync" OnEditCurrency="@OnEditCurrencyAsync" />
    </CrudEditHost>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public bool IsPopupMode { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private IReadOnlyList<CurrencyUnitListDto> _currencies = Array.Empty<CurrencyUnitListDto>();
    private ICommitCoordinator<CountryGetDto, CountryListDto, Guid, CountryListRequestDto>? _coordinator;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        _coordinator = new PersistentCoordinator<CountryGetDto, CountryListDto, Guid, CountryListRequestDto, CountryCreateDto, CountryUpdateDto>(
            CountryAppService, Mapper);

        try { _currencies = await CurrencyLookup.GetAsync(); }
        catch { _currencies = Array.Empty<CurrencyUnitListDto>(); }   // feed yoksa boş combo (cache hatasını yutma sınırı)

        _ready = true;
    }

    // Quick-add: yeni döviz formunu POPUP aç (Country edit tab'da → popup host serbest; CrudPageBase kalıbı:
    // OnClosed→PopupService.Close). Kaydedilince CurrencyUnitEditHost commit → EntityChange → lookup cache
    // invalidate; popup kapanınca taze çek → yeni döviz combo'da görünür.
    private async Task<string?> OnAddCurrencyAsync()
    {
        var before = new HashSet<string>(_currencies.Select(c => c.Code));   // mevcut kodlar (auto-select diff'i)
        var extra = new Dictionary<string, object>
        {
            { "OnClosed", EventCallback.Factory.Create(this, () => PopupService.Close()) },
        };
        await ViewOpener.OpenAsync(typeof(CurrencyUnitEditHost), null, L["CurrencyUnit"].Value, null, extra);

        // Popup kapandı → cache (save olduysa) invalidate olmuştur; taze çek + combo'yu güncelle.
        _currencies = await CurrencyLookup.GetAsync();
        StateHasChanged();

        // Yeni eklenen kod (öncekinde olmayan) → combo'da auto-select için döndür (yoksa null → seçim değişmez).
        return _currencies.Select(c => c.Code).FirstOrDefault(c => !before.Contains(c));
    }

    // Edit (✎): seçili dövizi (kod → Id) POPUP'ta düzenle; kapanınca cache (değiştiyse) invalidate → taze çek.
    private async Task OnEditCurrencyAsync(string code)
    {
        var cur = _currencies.FirstOrDefault(c => c.Code == code);
        if (cur is null) return;

        var extra = new Dictionary<string, object>
        {
            { "OnClosed", EventCallback.Factory.Create(this, () => PopupService.Close()) },
        };
        await ViewOpener.OpenAsync(typeof(CurrencyUnitEditHost), cur.Id, L["CurrencyUnit"].Value, null, extra);

        _currencies = await CurrencyLookup.GetAsync();
        StateHasChanged();
    }
}

