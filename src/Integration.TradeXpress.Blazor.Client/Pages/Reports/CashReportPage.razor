@page "/reports/cash"
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Companies
@using Integration.TradeXpress.Reports
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Vouchers
@using DevExpress.Blazor
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

<PageTitle>Nakit Raporu</PageTitle>

<div style="padding:12px; display:flex; flex-direction:column; gap:12px; height:100%;">

    @* ── Kapsam + tarih filtresi ── *@
    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:flex-end;">

        <div style="display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:11px; color:var(--dxbl-text-secondary);">Şirket</label>
            <DxComboBox Data="@_companies"
                        TextFieldName="@nameof(CompanyListDto.Name)"
                        ValueFieldName="@nameof(CompanyListDto.Id)"
                        Value="_filter.CompanyId"
                        ValueChanged="@((Guid? v) => OnCompanyChanged(v))"
                        NullText="(Tümü)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        style="min-width:160px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:11px; color:var(--dxbl-text-secondary);">Şube</label>
            <DxComboBox Data="@_branches"
                        TextFieldName="@nameof(BranchListDto.Name)"
                        ValueFieldName="@nameof(BranchListDto.Id)"
                        Value="_filter.BranchId"
                        ValueChanged="@((Guid? v) => OnBranchChanged(v))"
                        NullText="(Tümü)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        Enabled="@(_filter.CompanyId != null)"
                        style="min-width:160px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:11px; color:var(--dxbl-text-secondary);">Kasa</label>
            <DxComboBox Data="@_vaults"
                        TextFieldName="@nameof(VaultListDto.Name)"
                        ValueFieldName="@nameof(VaultListDto.Id)"
                        @bind-Value="_filter.VaultId"
                        NullText="(Tümü)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        Enabled="@(_filter.BranchId != null)"
                        style="min-width:140px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:11px; color:var(--dxbl-text-secondary);">Başlangıç</label>
            <DxDateEdit @bind-Date="_filter.Start" style="min-width:130px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:11px; color:var(--dxbl-text-secondary);">Bitiş</label>
            <DxDateEdit @bind-Date="_filter.End" style="min-width:130px;" />
        </div>

        <DxButton Text="Getir" Click="@LoadAsync" RenderStyleMode="ButtonRenderStyleMode.Contained" RenderStyle="ButtonRenderStyle.Primary" />
    </div>

    @* ── Sekmeler ── *@
    <DxTabs @bind-ActiveTabIndex="_tabIndex" style="flex:1; min-height:0;">

        <DxTabPage Text="Nakit Stoğu">
            @if (_stockRows != null)
            {
                <DxGrid Data="@_stockRows" ShowFilterRow="false" style="height:100%;">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(CashStockRowDto.UnitCode)"  Caption="Birim"  Width="100" />
                        <DxGridDataColumn FieldName="@nameof(CashStockRowDto.InTotal)"   Caption="Giriş"  DisplayFormat="n2" Width="130" />
                        <DxGridDataColumn FieldName="@nameof(CashStockRowDto.OutTotal)"  Caption="Çıkış"  DisplayFormat="n2" Width="130" />
                        <DxGridDataColumn FieldName="@nameof(CashStockRowDto.Net)"       Caption="Net"    DisplayFormat="n2" Width="130" />
                    </Columns>
                    <TotalSummary>
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(CashStockRowDto.InTotal)"  DisplayFormat="n2" />
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(CashStockRowDto.OutTotal)" DisplayFormat="n2" />
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(CashStockRowDto.Net)"      DisplayFormat="n2" />
                    </TotalSummary>
                </DxGrid>
            }
        </DxTabPage>

        <DxTabPage Text="Nakit Hareketleri">
            @if (_movementRows != null)
            {
                <DxGrid Data="@_movementRows" ShowFilterRow="true" style="height:100%;">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(CashMovementRowDto.VoucherDate)"    Caption="Tarih"   DisplayFormat="d"  Width="100" />
                        <DxGridDataColumn FieldName="@nameof(CashMovementRowDto.VoucherNumber)"  Caption="No"                         Width="70"  />
                        <DxGridDataColumn FieldName="@nameof(CashMovementRowDto.ProcessType)"    Caption="İşlem"                      Width="90"  />
                        <DxGridDataColumn FieldName="@nameof(CashMovementRowDto.Source)"         Caption="Bacak"                      Width="70"  />
                        <DxGridDataColumn FieldName="@nameof(CashMovementRowDto.VaultCode)"      Caption="Kasa"                       Width="90"  />
                        <DxGridDataColumn FieldName="@nameof(CashMovementRowDto.SubAccountCode)" Caption="Hesap"                      Width="110" />
                        <DxGridDataColumn FieldName="@nameof(CashMovementRowDto.CashCode)"       Caption="Nakit"                      Width="90"  />
                        <DxGridDataColumn FieldName="@nameof(CashMovementRowDto.UnitCode)"       Caption="Birim"                      Width="80"  />
                        <DxGridDataColumn FieldName="@nameof(CashMovementRowDto.CashAmount)"     Caption="Tutar"  DisplayFormat="n2"  Width="120" />
                        <DxGridDataColumn FieldName="@nameof(CashMovementRowDto.Description)"    Caption="Açıklama" />
                    </Columns>
                    <TotalSummary>
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="@nameof(CashMovementRowDto.VoucherNumber)" Caption="Kayıt:" />
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"   FieldName="@nameof(CashMovementRowDto.CashAmount)"    DisplayFormat="n2" />
                    </TotalSummary>
                </DxGrid>
            }
        </DxTabPage>

    </DxTabs>

</div>
