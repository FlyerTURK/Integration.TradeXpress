@page "/reports/good-stock"
@using Integration.TradeXpress.Branches
@using Integration.TradeXpress.Goods
@using Integration.TradeXpress.Reports
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Variants
@using DevExpress.Blazor
@using Integration.Framework.Blazor.Client.Components.Crud
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

<PageTitle>Mamül Stok Raporu</PageTitle>

<div style="padding:12px; display:flex; flex-direction:column; gap:12px; height:100%;">

    @* ── Kapsam + tarih + mamül/varyant filtresi ── *@
    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:flex-end;">

        <div style="display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:11px; color:var(--dxbl-text-secondary);">Şube</label>
            <DxComboBox Data="@_branches"
                        TextFieldName="@nameof(BranchListDto.Name)"
                        ValueFieldName="@nameof(BranchListDto.Id)"
                        Value="_filter.BranchId"
                        ValueChanged="@((Guid? v) => OnBranchChanged(v))"
                        NullText="(Tümü)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        Enabled="@(_filter.CompanyId != null)"
                        style="min-width:160px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:11px; color:var(--dxbl-text-secondary);">Kasa</label>
            <DxComboBox Data="@_vaults"
                        TextFieldName="@nameof(VaultListDto.Name)"
                        ValueFieldName="@nameof(VaultListDto.Id)"
                        @bind-Value="_filter.VaultId"
                        NullText="(Tümü)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        Enabled="@(_filter.BranchId != null)"
                        style="min-width:140px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:11px; color:var(--dxbl-text-secondary);">Başlangıç</label>
            <DxDateEdit @bind-Date="_filter.Start" style="min-width:130px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:11px; color:var(--dxbl-text-secondary);">Bitiş</label>
            <DxDateEdit @bind-Date="_filter.End" style="min-width:130px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:11px; color:var(--dxbl-text-secondary);">Mamül</label>
            <DxComboBox Data="@_goods"
                        TextFieldName="@nameof(GoodListDto.Name)"
                        ValueFieldName="@nameof(GoodListDto.Id)"
                        Value="_filter.GoodId"
                        ValueChanged="@((Guid? v) => OnGoodChanged(v))"
                        NullText="(Tümü)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        style="min-width:180px;" />
        </div>

        <div style="display:flex; flex-direction:column; gap:2px;">
            <label style="font-size:11px; color:var(--dxbl-text-secondary);">Varyant</label>
            <DxComboBox Data="@_variants"
                        TextFieldName="@nameof(CommodityVariantOptionDto.Code)"
                        ValueFieldName="@nameof(CommodityVariantOptionDto.Id)"
                        @bind-Value="_filter.VariantId"
                        NullText="(Tümü)"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        Enabled="@(_filter.GoodId != null)"
                        style="min-width:160px;" />
        </div>

        <DxButton Text="Getir" Click="@LoadAsync" RenderStyleMode="ButtonRenderStyleMode.Contained" RenderStyle="ButtonRenderStyle.Primary" />
    </div>

    @* ── Sadece stok grid'i (sekme YOK) ── *@
    @if (_stockRows != null)
    {
        <TxGrid Data="@_stockRows" StateKey="report:good-stock" ShowFilterRow="false" style="height:100%;">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(GoodStockRowDto.GoodCode)"    Caption="Mamül Kodu"     Width="120" />
                <DxGridDataColumn FieldName="@nameof(GoodStockRowDto.GoodName)"    Caption="Mamül Adı"      Width="200" />
                <DxGridDataColumn FieldName="@nameof(GoodStockRowDto.VariantCode)" Caption="Varyant"        Width="120" />
                <DxGridDataColumn FieldName="@nameof(GoodStockRowDto.UnitCode)"    Caption="Birim"          Width="80" />
                <DxGridDataColumn FieldName="@nameof(GoodStockRowDto.InQuantity)"  Caption="Giriş (Adet)"   DisplayFormat="n2" Width="120" />
                <DxGridDataColumn FieldName="@nameof(GoodStockRowDto.OutQuantity)" Caption="Çıkış (Adet)"   DisplayFormat="n2" Width="120" />
                <DxGridDataColumn FieldName="@nameof(GoodStockRowDto.NetQuantity)" Caption="Net (Adet)"     DisplayFormat="n2" Width="120" />
                <DxGridDataColumn FieldName="@nameof(GoodStockRowDto.InAmount)"    Caption="Giriş (Miktar)" DisplayFormat="n2" Width="130" />
                <DxGridDataColumn FieldName="@nameof(GoodStockRowDto.OutAmount)"   Caption="Çıkış (Miktar)" DisplayFormat="n2" Width="130" />
                <DxGridDataColumn FieldName="@nameof(GoodStockRowDto.NetAmount)"   Caption="Net (Miktar)"   DisplayFormat="n2" Width="130" />
            </Columns>
            <TotalSummary>
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(GoodStockRowDto.InQuantity)"  DisplayFormat="n2" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(GoodStockRowDto.OutQuantity)" DisplayFormat="n2" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(GoodStockRowDto.NetQuantity)" DisplayFormat="n2" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(GoodStockRowDto.InAmount)"    DisplayFormat="n2" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(GoodStockRowDto.OutAmount)"   DisplayFormat="n2" />
                <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@nameof(GoodStockRowDto.NetAmount)"   DisplayFormat="n2" />
            </TotalSummary>
        </TxGrid>
    }

</div>
