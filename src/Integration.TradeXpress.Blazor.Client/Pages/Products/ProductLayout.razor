@using System
@using System.Linq
@using Integration.TradeXpress.Countries
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.TradeXpress.Blazor.Client.Pages.Financials.CurrencyUnits
@using Integration.TradeXpress.Blazor.Client.Pages.AddOns
@using Integration.TradeXpress.Blazor.Client.Pages.ProductCategories
@using Integration.TradeXpress.Blazor.Client.Pages.RecipeTemplates
@using Integration.TradeXpress.Blazor.Client.Pages.VariantTemplates
@using Integration.TradeXpress.Permissions
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Product DUMB Layout — ProductGetDto'yu forma yansıtır. I/O yok, karar yok, persistence yok.
   Standart alan sırası (ui-blazor): Kod → Ad → Description → Status → varyant DrillList (en son).
*@

@* ISSUE ENDEKSİ FORMUN TAMAMINI SARAR — yalnız sekmeleri değil. Endeksi okuyan üç ayrı bileşen var: ürün
   genelindeki bant (hemen aşağıda), sekme başlıkları/varyant grid satırı (DrillTabs içinde) ve kanal panelleri.
   2026-08-20 REGRESYONU: CascadingValue yalnız DrillTabs'i sarıyordu, bant ise formun EN ÜSTÜNDE — yani cascade'in
   DIŞINDA — duruyordu. ReadinessNotice endeksi bulamayınca (CascadingParameter null) hiç markup üretmez ve hata
   da vermez: bant SESSİZCE ÖLÜYDÜ; "her üründe şablon seçilmedi uyarısı" yalnız satışa hazırlık paneli sekmesinde görünüyordu.
   Bu yüzden CascadingValue artık formun tepesindedir — endeksi okuyan yeni bir bileşen eklenirse kendiliğinden
   kapsanır. Endeks her tazelendiğinde REFERANSI değişir → cascade tüketicileri kendiliğinden yeniden çizilir
   (değişmez nesne olmasının sebebi de bu). *@
<CascadingValue Value="@_readinessIndex" Name="SaleReadinessIndex">

@* ÜRÜN GENELİ BANDI — yalnız "general" kapsamı: kategori, KDV, ürün durumu gibi bu formun ÜSTÜNDEKİ alanlara
   ait issue'lar. 2026-08-20 Hakan düzeltmesi: bant eskiden TÜM issue'ları sayıyordu ve kanal ürünü eksikliği
   "ürün hatası" gibi okunuyordu — oysa o issue kanal panelinin bandına aittir. Artık her bileşen kendi
   kapsamının bandını taşır (ReadinessNotice); sekme başlıklarındaki renk + rozet zaten "hangi sekmede sorun
   var"ı söylüyor, satışa hazırlık paneli sekmesi de tamamını listeliyor. Issue yoksa çizilmez; Info bandı açmaz. *@
<ReadinessNotice Scope="@SaleReadinessScope.General"
                 DetailsText="@L["Product:SaleReadinessOpenCockpit"].Value"
                 OnOpenDetails="@OpenReadinessCockpit" />

@* KADEMELİ KİLİT — YALNIZ YENİ ÜRÜNDE (2026-08-20 Hakan): kategori → kod → ad → geri kalan her şey. Sırayı
   dayatmanın sebebi kategorinin sonradan değiştirilmesinin PAHALI olması: ürün nitelikleri, kanal kategori
   eşleşmesi ve zorunlu alanlar ondan türer; kullanıcı önce onlarca alanı doldurup sonra kategoriyi değiştirince
   emeğinin bir kısmı boşa gidiyordu. Kod/ad ise kaydın kimliğidir — form standardında da ilk iki alandır.
   Sıradaki adım YAZIYLA söylenir: kilitli bir alan neden kilitli olduğunu söylemezse kullanıcı formu bozuk sanar.

   ⚠ KİLİT EDİTÖRÜN KENDİ "Enabled"INDA DURUR — DxFormLayoutItem/DxFormLayoutGroup üzerinde DEĞİL. DevExpress'te
   FormLayoutItemBase.Enabled yalnız OTOMATİK ÜRETİLEN editörleri (DxFormLayout Data= + item Field= bağlaması)
   kapsar; bu formdaki editörlerin hepsi ChildContent'te ELLE bildirildiği için item/grup seviyesindeki Enabled
   hiçbir şey yapmaz — hata da vermez. İlk sürümde kilit tam bu yüzden KOZMETİKTİ: alanlar kilitli görünmüyordu
   ve kullanıcı sıra dışına çıkabiliyordu. Yeni alan eklerken Enabled'ı EDİTÖRE ver — kod tabanının geri
   kalanındaki yerleşik desen de budur (CashLayout, VaultLayout, BranchEditFields…). *@
@if (NewProductStepHint is { Length: > 0 } stepHint)
{
    <InfoNotice Text="@stepHint" IconCssClass="@TradeXpressIcons.Lightbulb" />
}

<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        @* KATEGORİ İLK ALAN (2026-07-28 Hakan): ürünün nasıl fiyatlanacağı, hangi özelliklerin sorulacağı ve
           kanal karşılığı bu seçime bağlı — kod/ad girmeden önce belirlenmeli.
           LookupEdit (LookupComboBox DEĞİL): salt-okunur alan + popup'ta aranabilir liste — N11 kategori
           seçimiyle aynı desen. Uzun kategori YOLLARI ("Takı › Yüzük › Alyans") dar bir combo'ya sığmıyordu. *@
        <DxFormLayoutItem Caption="@($"{L["Product:ProductCategory"]} *")" ColSpanMd="12">
            <LookupEdit TItem="ProductCategoryListDto" TValue="Guid?"
                        Data="@ProductCategories"
                        ValueFieldName="@nameof(ProductCategoryListDto.Id)"
                        TextFieldName="@nameof(ProductCategoryListDto.Path)"
                        Value="@Model.ProductCategoryId"
                        ValueChanged="@OnProductCategoryChanged"
                        ValueExpression="@(() => Model.ProductCategoryId)"
                        Title="@L["Product:ProductCategory"].Value"
                        NullText="@L["Product:ProductCategoryPlaceholder"].Value"
                        SearchPlaceholder="@L["Product:ProductCategoryPlaceholder"].Value"
                        ListComponentType="typeof(ProductCategoryListPage)"
                        ListItemValueSelector="@(item => ((ProductCategoryListDto)item).Id)"
                        OnAddRequested="@OnAddProductCategoryRequested"
                        OnEditRequested="@OnEditProductCategoryRequested"
                        OnRefreshRequested="@(() => OnReloadProductCategories.InvokeAsync())"
                        AllowClear="false" />
        </DxFormLayoutItem>
        @* BindValueMode=OnDelayedInput (yeni üründeki kademeli kilit için): DevExpress varsayılanı OnLostFocus'tur,
           yani model ancak alandan ÇIKINCA güncellenir — bir sonraki alan hâlâ kilitli olduğundan Tab onu ATLAR ve
           kullanıcı geri tıklamak zorunda kalırdı. Gecikmeli bağlamada yazma durunca (300 ms) sonraki alanın kilidi açılır, Tab doğal
           akar. Her tuşta değil (OnInput), duraklamada bir kez — Blazor Server'da her tuş bir tur demektir. *@
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" Enabled="@CanEditCode"
                       BindValueMode="BindValueMode.OnDelayedInput" InputDelay="300" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" Enabled="@CanEditName"
                       BindValueMode="BindValueMode.OnDelayedInput" InputDelay="300" />
        </DxFormLayoutItem>
        @if (ShowMissingChannelMappingWarning)
        {
            <DxFormLayoutItem ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                <InlineWarning>@L["Product:CategoryHasNoChannelMapping"]</InlineWarning>
            </DxFormLayoutItem>
        }
        @* Varyant modu Durum'dan ÖNCE: Status form standardında EN SONDA gelir (ui-blazor edit form sırası);
           varyant modu ise ürünün nasıl kurulacağını belirleyen bir seçim, durumdan önce okunmalı.
           Manuel bağlama — MultiVariant'tan çıkış host onayından geçer (veri-kaybı uyarısı);
           ValueExpression açık verilir ([validation-expr]). *@
        <DxFormLayoutItem Caption="@L["Product:VariantMode"]" ColSpanMd="6">
            <ComboBoxEnumEdit TEnum="ProductVariantMode" L="@L"
                              Enabled="@CanEditRest"
                              Value="@Model.VariantMode"
                              ValueChanged="@(async (ProductVariantMode v) => await HandleVariantModeChangedAsync(v))"
                              ValueExpression="@(() => Model.VariantMode)" />
        </DxFormLayoutItem>
        @* Şablon seçimi modun HEMEN YANINDA (ayrı grup açılmaz): "Katalogdan Uygula" seçildiği anda kaynağın
           da orada seçilmesi bekleniyor. LookupComboBox → ekle/düzelt butonları: eksik şablon için forma ara
           vermeden katalog açılabilsin (2026-07-27 Hakan). Seçim uygulanınca combo boşalır — şablon bir
           KAYNAK, ürünle kalıcı bağ kurmaz. *@
        @if (Model.VariantMode == ProductVariantMode.FromCatalog)
        {
            <DxFormLayoutItem Caption="@L["Product:TemplateSelection"]" ColSpanMd="6">
                <LookupComboBox TItem="VariantTemplateListDto" TValue="Guid?"
                                Enabled="@CanEditRest"
                                Data="@VariantTemplates"
                                ValueFieldName="@nameof(VariantTemplateListDto.Id)"
                                TextFieldName="@nameof(VariantTemplateListDto.Name)"
                                Value="@_selectedVariantTemplateId"
                                ValueChanged="@(async (Guid? id) => await ApplyVariantTemplateAsync(id))"
                                EditComponentType="typeof(VariantTemplateEditHost)"
                                OnLookupReloadRequested="@OnReloadVariantTemplates"
                                CreatePolicy="@TradeXpressPermissions.VariantTemplates.Create"
                                UpdatePolicy="@TradeXpressPermissions.VariantTemplates.Update"
                                AllowClear="false" />
            </DxFormLayoutItem>
        }
        @* Reçete şablonu ("orta reçete") — satırlar ürünün TÜM varyantlarına, muadillikten gelen emtiaların
           ARDINA eklenir. Seçim ÜRÜNE KAYITLIDIR ama KENDİLİĞİNDEN uygulanmaz: combo'yu değiştirmek reçeteye
           dokunmaz, uygulamayı yalnız "Uygula" düğmesi yapar (2026-08-20 Hakan: "Uygula butonu olsun ki
           yanlışlıkla kullanıcı değiştirirse mevcuttaki kayıtlar değer değişince kolayca silinmesin").
           2026-08-20: blok YENİ üründe de çizilir. Eskiden IsNew koşuluyla gizleniyordu (gerekçe: uygulanacak
           varyant yok) — ama şablon seçimi artık HER üründen bekleniyor (satışa hazırlık paneli "şablon seçilmedi" uyarısı) ve
           gizli combo, kullanıcıyı ürünü kaydedip forma geri dönmeye zorluyordu. Kaydedilmemiş üründe yalnız
           UYGULAMA ertelenir: ilk kayıttan sonra host şablonu bir kez uygular (ProductEditHost.OnAfterCreate). *@
        @* Seçim KALICI durur (uygulandıktan sonra sıfırlanmaz): lookup'ın DÜZELT butonu ancak seçili bir
           değer varken görünür — boşaltmak onu erişilemez kılıyordu. Uygulama ayrı butonda olduğu için
           aynı şablon istendiği kadar tekrar uygulanabilir (combo değişmeden).
           Kademeli kilit: şablon combo'su Ad girildikten sonra açılır (CanEditRest) — yeni üründe kategori →
           kod → ad sırası dayatılır, kayıtlı üründe kilit yoktur. *@
        <DxFormLayoutItem Caption="@L["RecipeTemplate"]" ColSpanMd="9">
            <LookupComboBox TItem="RecipeTemplateListDto" TValue="Guid?"
                            Enabled="@CanEditRest"
                            Data="@RecipeTemplates"
                            ValueFieldName="@nameof(RecipeTemplateListDto.Id)"
                            TextFieldName="@nameof(RecipeTemplateListDto.Name)"
                            Value="@_selectedRecipeTemplateId"
                            ValueChanged="@OnRecipeTemplateSelected"
                            ValueExpression="@(() => _selectedRecipeTemplateId)"
                            NullText="@L["RecipeTemplate:ApplySelect"].Value"
                            EditComponentType="typeof(RecipeTemplateEditHost)"
                            OnLookupReloadRequested="@OnReloadRecipeTemplates"
                            CreatePolicy="@TradeXpressPermissions.RecipeTemplates.Create"
                            UpdatePolicy="@TradeXpressPermissions.RecipeTemplates.Update" />
        </DxFormLayoutItem>
        @* Düğme YENİ üründe GİZLİ: kaydedilmemiş üründe uygulanacak varyant yoktur, basılabilir bir düğme
           sessizce hiçbir şey yapardı. Gizleme koşullu blokla DEĞİL "Visible" ile (ui-blazor): nested settings
           öğeleri toplayıcıya KAYIT SIRASINDA girer, sonradan eklenen öğe listenin sonuna düşer. *@
        <DxFormLayoutItem ColSpanMd="3" Visible="@(!IsNew)">
            <DxButton Text="@L["RecipeTemplate:ApplyButton"]"
                      IconCssClass="@TradeXpressIcons.RecipeTemplate"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Enabled="@(_selectedRecipeTemplateId is not null)"
                      Click="@(async () => await ApplySelectedRecipeTemplateAsync())" />
        </DxFormLayoutItem>
        <DxFormLayoutItem ColSpanMd="12">
            <span style="color:#6c757d; font-size:0.85rem;">@RecipeTemplateHint</span>
        </DxFormLayoutItem>
        @* İndirim TİPİ şablon seçimlerinden SONRA (2026-07-28 Hakan): varyant modu → şablonlar → indirim
           sırası ürünün nasıl kurulacağından nasıl fiyatlanacağına doğru ilerler. "İndirim yok" halinde ayrı
           bir grup açmak boş başlık bırakıyordu — detay alanları yalnız tip seçilince belirir. *@
        <DxFormLayoutItem Caption="@L["Product:DiscountType"]" ColSpanMd="6" BeginRow="true">
            <ComboBoxEnumEdit TEnum="ProductDiscountType" L="@L"
                              Value="@Model.DiscountType"
                              ValueChanged="@OnDiscountTypeChanged"
                              ValueExpression="@(() => Model.DiscountType)" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    @* Pazaryeri-genel varsayılanlar — kanal-ürünü boş bıraktığı alanlarda bunu devralır. KATLANMIŞ açılır
       (2026-07-28 Hakan): çoğu üründe varsayılanlar olduğu gibi kullanılıyor, açık durması formun başını
       yoruyordu. Genel grubun HEMEN ARDINDA: ürünün temel tanımından sonra gelen ikinci halka. *@
    <DxFormLayoutGroup Caption="@L["Product:MarketplaceDefaults"]" ColSpanMd="12"
                       Expanded="false" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">
        @* Menşei ülke — "Yurtiçi" true/false bayrağının YERİNE (2026-07-28 Hakan). N11'in beklediği yerli-ürün
           bayrağı bundan türetilir (menşei == şirketin ülkesi); kullanıcı bayrağı elle işaretlemez. *@
        <DxFormLayoutItem Caption="@L["Product:OriginCountry"]" ColSpanMd="6" BeginRow="true">
            <LookupComboBox TItem="CountryListDto" TValue="Guid?"
                            Enabled="@CanEditRest"
                            Data="@Countries"
                            ValueFieldName="@nameof(CountryListDto.Id)"
                            TextFieldName="@nameof(CountryListDto.Name)"
                            @bind-Value="@Model.OriginCountryId"
                            NullText="@L["Optional"]"
                            AllowClear="false" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Product:Condition"]" ColSpanMd="6">
            <ComboBoxEnumEdit TEnum="ProductCondition" L="@L" Enabled="@CanEditRest" @bind-Value="@Model.Condition" />
        </DxFormLayoutItem>
        @* Hazırlık süresi EN AZ 1 gün: 0 gün "aynı saniye kargoda" demek olur, pazaryerleri kabul etmez. *@
        <DxFormLayoutItem Caption="@L["Product:PreparingDay"]" ColSpanMd="6" BeginRow="true">
            <NumericSpinEdit TValue="int" Enabled="@CanEditRest" @bind-Value="@Model.PreparingDay" MinValue="1" />
        </DxFormLayoutItem>
        @* KDV oranı ÜRÜNÜN özelliğidir (vergi mevzuatı mala bakar, kanala değil) → kanal kayıtları bunu devralır.
           Varsayılan ATANMAZ: kıymetli maden teslimi %0 (istisna faturası), işçilik %20, kitap %1, gıda/tekstil %10 —
           sessiz bir varsayılan yanlış fatura demektir. Boşken pazaryeri push'u fail-fast reddeder. *@
        <DxFormLayoutItem Caption="@L["Product:VatRate"]" ColSpanMd="6">
            <DxComboBox TData="VatRateOption" TValue="int?"
                        Enabled="@CanEditRest"
                        Data="@VatRateOptions"
                        ValueFieldName="@nameof(VatRateOption.Rate)"
                        TextFieldName="@nameof(VatRateOption.DisplayText)"
                        @bind-Value="@Model.VatRate"
                        NullText="@L["Product:VatRateNotSet"]"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        @* Paket desisi — kargo tarifesinin girdisi. 0 GEÇERLİDİR (desisiz/ağırlıksız kalem); negatif taşıma
           hacmi diye bir şey yok. Boş bırakılırsa varyantın, o da yoksa kanalın desisi kullanılır. *@
        <DxFormLayoutItem Caption="@L["Product:PackageDesi"]" ColSpanMd="6">
            @* Temizle butonu YOK: desi 0 varsayılanıyla geliyor ve boşaltmak "kanalın desisini kullan"
               anlamına geliyor — kullanıcının kazara boşaltıp farkında olmadan başka bir desiye düşmesi
               yerine değeri elle 0 yapması daha açık (2026-07-28 Hakan). *@
            <NumericSpinEdit TValue="int?" Enabled="@CanEditRest" @bind-Value="@Model.PackageDesi" MinValue="0" />
        </DxFormLayoutItem>
        @* Varsayılan para birimi — yeni üründe şirketin yerel (bilanço) birimi seçili gelir; inline ekle/düzelt. *@
        <DxFormLayoutItem Caption="@L["Product:CurrencyUnit"]" ColSpanMd="6" BeginRow="true">
            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?"
                            Enabled="@CanEditRest"
                            Data="@CurrencyUnits"
                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)"
                            TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                            @bind-Value="@Model.CurrencyUnitId"
                            EditComponentType="typeof(CurrencyUnitEditHost)"
                            OnLookupReloadRequested="@OnReloadCurrencyUnits"
                            CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                            UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update"
                            AllowClear="false" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    @* Muadil (paket) konfigürasyonu — yalnız Substitution modunda: grup + hedef miktar + tolerans override'ı
       (boş = grubun tolerans politikası) + varyant override ağacı (boş = gruptan devral). Kombinasyon hesabı
       ayrı sekmede (Muadil Kombinasyonları). *@
    @if (Model.VariantMode == ProductVariantMode.Substitution)
    {
        <DxFormLayoutGroup Caption="@L["Product:SubstitutionConfig"]" ColSpanMd="12">
            @* Grup ZORUNLU — clear yok (muadil modunda mutlaka bir grup seçili olmalı; boşaltma anlamsız). *@
            <DxFormLayoutItem Caption="@($"{L["SubstitutionGroup"]} *")" ColSpanMd="6" BeginRow="true">
                <LookupComboBox TItem="SubstitutionGroupListDto" TValue="Guid?"
                                Enabled="@CanEditRest"
                                Data="@SubstitutionGroups"
                                ValueFieldName="@nameof(SubstitutionGroupListDto.Id)"
                                TextFieldName="@nameof(SubstitutionGroupListDto.Name)"
                                Value="@Model.SubstitutionGroupId"
                                ValueChanged="@(async (Guid? v) => await HandleSubstitutionGroupChangedAsync(v))"
                                EditComponentType="typeof(SubstitutionGroupEditHost)"
                                OnLookupReloadRequested="@OnReloadSubstitutionGroups"
                                CreatePolicy="@TradeXpressPermissions.Substitutions.Create"
                                UpdatePolicy="@TradeXpressPermissions.Substitutions.Update"
                                AllowClear="false" />
            </DxFormLayoutItem>
            @* Grup seçili değilse alt kontroller GÖRÜNMEZ (hiç grup yoksa) — boş grupla hedef/tolerans/kapsam anlamsız. *@
            @if (Model.SubstitutionGroupId is not null)
            {
                <DxFormLayoutItem Caption="@($"{L["Substitution:TargetQuantity"]}{SubstitutionUnitSuffix} *")" ColSpanMd="6">
                    @* Miktar değişimi kombinasyonları doğrudan etkiler → otomatik yeniden hesap (debounce'lu). *@
                    @* ValueExpression AÇIKÇA verilir: @bind yerine manuel bağlama kullanıldığında DevExpress
                       editörü ifadeyi kendisi türetemez ve EditContext altında çöker ([validation-expr]).
                       NumericSpinEdit, DxSpinEdit'in üzerine kurulu kendi bileşenimizdir — DxSpinEdit'in ValidationEnabled parametresini taşımaz. *@
                    <NumericSpinEdit TValue="decimal?" Enabled="@CanEditRest"
                                     Value="@Model.SubstitutionTargetQuantity"
                                     ValueChanged="@(async (decimal? v) => await OnSubstitutionTargetQuantityChangedAsync(Model, v))"
                                     ValueExpression="@(() => Model.SubstitutionTargetQuantity)"
                                     DisplayFormat="N5" />
                </DxFormLayoutItem>
                @* Varyant Oluşturma Modu (2026-07-25 Hakan): Tek = yalnız en iyi kombinasyon ana varyant;
                   Çoklu = adaylar ayrı varyant (Rank 1 ana, diğerleri müşteriye seçenek). Üretim OTOMATİK. *@
                <DxFormLayoutItem Caption="@L["Product:SubstitutionVariantMode"]" ColSpanMd="6">
                    <ComboBoxEnumEdit TEnum="SubstitutionVariantMode" L="@L" Enabled="@CanEditRest"
                                      @bind-Value="@Model.SubstitutionVariantMode" />
                </DxFormLayoutItem>
                @* Tolerans türü hep açık (default Miktar; clear yok — devral kaldırıldı). Değer YALNIZ Binde'de görünür;
                   Miktar (tam eşleşme) türünde giriş beklenmez → tür değişince değer sıfırlanır (OnToleranceTypeChanged). *@
                <DxFormLayoutItem Caption="@L["ToleranceType"]" ColSpanMd="6" BeginRow="true">
                    <ComboBoxEnumEdit TEnum="ToleranceType?" L="@L"
                                      Enabled="@CanEditRest"
                                      Value="@Model.SubstitutionToleranceType"
                                      ValueChanged="@((ToleranceType? t) => OnToleranceTypeChanged(t))"
                                      ValueExpression="@(() => Model.SubstitutionToleranceType)"
                                      ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" />
                </DxFormLayoutItem>
                @if (Model.SubstitutionToleranceType == ToleranceType.PerMille)
                {
                    <DxFormLayoutItem Caption="@L["ToleranceValue"]" ColSpanMd="6">
                        <NumericSpinEdit TValue="decimal?" Enabled="@CanEditRest"
                                         @bind-Value="@Model.SubstitutionToleranceValue" DisplayFormat="N5" />
                    </DxFormLayoutItem>
                }
                @* Override ağacı — grup kalemleri devralınan referans; boş seçim = gruptan devral (resolver zinciri). *@
                @* Başlık + eylem TEK SATIRDA (HeaderContentTemplate). Grup içeriği <Items> slotuna girer — <ChildContent>
                   İLE ÇALIŞMAZ: grup şablonlu kullanımda alanları yalnız Items'tan çiziyor, ChildContent'e
                   konan ağaç sessizce kayboluyordu (2026-07-28: bir kez canlıda "emtiaları göremiyorum" olarak
                   döndü). Regresyonu SubstitutionVariantScopeRenderTests sabitler. *@
                @* Kapsam grubu YALNIZ hedef miktar > 0 iken görünür (2026-07-28 Hakan): miktar 0'ken hiçbir
                   emtia kombinasyona giremez ama ağaç yine de hepsini listeliyordu — kullanıcı seçim yapılabilir
                   sanıyordu. Görünürlük Visible ile (sekme/kolon kuralıyla aynı): grup ağaçtan çıkıp girince
                   HeaderContentTemplate/Items yeniden kurulup panel referansı kopardı. *@
                <DxFormLayoutGroup ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical"
                                   Visible="@(Model.SubstitutionTargetQuantity > 0m)">
                    <HeaderContentTemplate>
                        @* Başlık solda, eylem SAĞA DAYALI: flex + auto margin (aradaki boşluğu buton iter). *@
                        <div style="display:flex; align-items:center; gap:0.5rem; width:100%;">
                            <span>@L["VariantScope"]</span>
                            @if (_variantScopePanel?.HasUnselected == true)
                            {
                                <DxButton RenderStyle="ButtonRenderStyle.Secondary" SizeMode="SizeMode.Small"
                                          CssClass="ms-auto" Text="@L["SelectAll"]"
                                          Click="@(async () => await _variantScopePanel.SelectAllAsync())" />
                            }
                        </div>
                    </HeaderContentTemplate>
                    <Items>
                        <DxFormLayoutItem ColSpanMd="12">
                            @* Kapsam değişince kombinasyonlar bayatlar → otomatik yeniden hesap (debounce'lu). *@
                            <SubstitutionVariantTreePanel @ref="_variantScopePanel"
                                                          Items="@SubstitutionGroupItems"
                                                          Variants="@MetalVariants"
                                                          Metals="@Metals"
                                                          TargetQuantity="@Model.SubstitutionTargetQuantity"
                                                          OverrideVariantIds="@Model.SubstitutionOverrideVariantIds"
                                                          OnChanged="@(async () => await OnSubstitutionScopeChangedAsync())" />
                        </DxFormLayoutItem>
                    </Items>
                </DxFormLayoutGroup>
            }
        </DxFormLayoutGroup>
    }

    @* Marketplace indirimi (ürün-seviyesi; tüm varyant + kanallara aynı gider). Grup YALNIZ bir indirim tipi
       seçiliyken görünür — "İndirim yok" halinde boş bir başlık ve dört boş alan duruyordu. Tip seçimi yukarıda,
       varyant modunun yanında. *@
    @if (Model.DiscountType != ProductDiscountType.None)
    {
        <DxFormLayoutGroup Caption="@L["Product:Discount"]" ColSpanMd="12">
            @* Tutar tipinde ürünün para birimi caption'da parantez içinde: "500" değerinin hangi birimde
               olduğunu göstermek için ayrı bir alan açmak gereksiz; yüzde tipinde birim anlamsız. *@
            <DxFormLayoutItem Caption="@($"{L["Product:DiscountValue"]}{DiscountValueUnitSuffix} *")" ColSpanMd="6" BeginRow="true">
                <NumericSpinEdit TValue="decimal?" Enabled="@CanEditRest"
                                 @bind-Value="@Model.DiscountValue" DisplayFormat="N2"
                                 ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Product:DiscountStartDate"]" ColSpanMd="6" BeginRow="true">
                <DxDateEdit @bind-Date="@Model.DiscountStartDate" Enabled="@CanEditRest"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Product:DiscountEndDate"]" ColSpanMd="6">
                <DxDateEdit @bind-Date="@Model.DiscountEndDate" Enabled="@CanEditRest"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
        </DxFormLayoutGroup>
    }

    @* Pazaryeri-genel varsayılanlar — tüm pazaryerleri için ortak; kanal-ürünü boş bıraktığı alanlarda bunu devralır. *@

    @* "Kişiselleştirme" grubu 2026-07-28'de KALDIRILDI: Etsy'nin tek-kutulu kişiselleştirme modeli 2026-04-09'da
       kapandı, N11'de zaten karşılığı yoktu. Aynı işi "Ürün Özelleştirme" sekmesi yapıyor — orada her satır bir
       adlandırılmış alan ve Etsy'ye 1:1 bir kişiselleştirme sorusu olarak gidiyor. *@

    @* Opsiyonel tanımlar — az kullanılan/detay alanlar; drill'den hemen önce KATLANMIŞ grupta (form başını yormasın).
       N11 formundaki "OptionalFields" deseniyle hizalı. *@
    <DxFormLayoutGroup Caption="@L["Product:OptionalFields"]" ColSpanMd="12"
                        Expanded="false" ExpandButtonDisplayMode="GroupExpandButtonDisplayMode.Start">
        @* Üretim / son kullanma tarihi (opsiyonel; N11 productionDate/expirationDate). İş tarihi (date-only). *@
        <DxFormLayoutItem Caption="@L["Product:ProductionDate"]" ColSpanMd="6" BeginRow="true">
            <DxDateEdit @bind-Date="@Model.ProductionDate" Enabled="@CanEditRest"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Product:ExpirationDate"]" ColSpanMd="6">
            <DxDateEdit @bind-Date="@Model.ExpirationDate" Enabled="@CanEditRest"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        @* Alıcı başına azami adet + satıcı notu: nadiren doldurulan alanlar — pazaryeri varsayılanları
           grubunu şişirmek yerine burada (2026-07-28 Hakan). *@
        <DxFormLayoutItem Caption="@L["Product:MaxPurchaseQuantity"]" ColSpanMd="6" BeginRow="true">
            <NumericSpinEdit TValue="int?" Enabled="@CanEditRest"
                             @bind-Value="@Model.MaxPurchaseQuantity" MinValue="1"
                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Product:SellerNote"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.SellerNote" Enabled="@CanEditRest"
                    Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100"
                    NullText="@L["Optional"]" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    @* Durum EN SONDA (ui-blazor form standardı) — grupların hepsinden sonra. *@
    <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6" BeginRow="true">
        <DxCheckBox @bind-Checked="@Model.IsActive" Enabled="@CanEditRest" CheckType="CheckType.Switch">
            @(Model.IsActive ? L["Active"] : L["Passive"])
        </DxCheckBox>
    </DxFormLayoutItem>
</DxFormLayout>

@* Nitelikler + Varyantlar. Nitelik×değer kartezyeni varyantları SUNUCUDA üretir (ProductVariantSynchronizer);
   varyant drill'i bu yüzden ekleme/silmeye KAPALI (AllowAdd/AllowDelete=false) — yalnız mevcut satır düzenlenir. *@
@* Aktif sekme koddan yönetilir (satışa hazırlık paneli "Düzelt →" sekme açar). Sekme SIRASI code-behind'daki *TabIndex sabitleriyle
   eşleşmek ZORUNDA — araya sekme eklenirse sabitler güncellenir. *@
@* RenderMode=OnDemand ZORUNLU (2026-08-19): endeksi ÜRETEN satışa hazırlık paneli 0 numaralı sekmenin içeriğidir.
   DxTabs'in varsayılan kipinde kullanıcı başka bir sekmeye geçtiği anda o içerik YIKILIR; parametreleri artık
   koşmaz, ReloadToken değişimini göremez ve kayıt sonrası endeks BAYAT kalır — kullanıcı Varyantlar sekmesinde
   eksik emtiayı ekleyip kaydettiğinde sekme başlığı hâlâ kırmızı görünürdü. OnDemand ziyaret edilen sekmeyi
   ayakta tutar: satışa hazırlık paneli ilk sekme olduğu için form açılışında kurulur ve bir daha yıkılmaz, taze modelde
   kendiliğinden yeniden yükleyip endeksi tazeler. *@
<DrillTabs CssClass="mt-3" RenderMode="TabsRenderMode.OnDemand" @bind-ActiveTabIndex="_activeTabIndex">
    @* ÜRÜNÜN SATIŞA HAZIRLIK PANELİ — İLK sekme (2026-08-19): "neden satışta değil, sıradaki adım ne". Veri sunucudan
       (GetSaleReadinessAsync); panel kural türetmez. Yeni (kaydedilmemiş) üründe yalnız "önce kaydet" metni. *@
    @* Satışa hazırlık paneli başlığı KÖK kapsamı taşır (Scope verilmez) — ürünün TÜM issue'ları burada sayılır. *@
    <DxTabPage Text="@L["Product:SaleReadiness"]" TabIconCssClass="@TradeXpressIcons.CheckCircle">
        <TextTemplate>
            <SaleReadinessCaption Text="@L["Product:SaleReadiness"].Value" />
        </TextTemplate>
        <ChildContent>
            @* ReloadToken=Model: kayıt sonrası host TAZE model örneği bağlar (Id aynı kalır) → satışa hazırlık paneli kendiliğinden yenilenir. *@
            @* OnIndexChanged: panelin çektiği issue'lar layout'un alanına akar ve oradan cascade edilir. *@
            <ProductSaleReadinessPanel ProductId="@Model.Id"
                                       ReloadToken="@Model"
                                       IsDirty="@IsFormDirty"
                                       OnNavigate="@((SaleReadinessNavigation n) => HandleSaleReadinessNavigate(n))"
                                       OnIndexChanged="@((SaleReadinessIssueIndex ix) => HandleReadinessIndexChanged(ix))"
                                       OnVerifyRequested="@HandleVerifyForSaleAsync" />
        </ChildContent>
    </DxTabPage>
    @* Açıklama — zengin metin (DxHtmlEditor). Marketplace açıklaması HTML kabul eder. *@
    <DxTabPage Text="@L["Description"]" TabIconCssClass="@TradeXpressIcons.Product" Enabled="@CanEditRest">
        <DxHtmlEditor @bind-Markup="@Model.Description" CssClass="w-100" Height="360px" />
    </DxTabPage>
    @* Nitelikler ayrı sekmede DEĞİL → varyant panelinin "Özellikleri Düzenle" toolbar butonundan popup'ta yönetilir
       (OnAttributesChanged bağlı). Nitelik/değer değişimi host varyant regen'ini (OTOMATİK senkron) tetikler. *@
    <DxTabPage Text="@L["Variants"]" TabIconCssClass="@TradeXpressIcons.ProductVariant" Enabled="@CanEditRest">
        <TextTemplate>
            <SaleReadinessCaption Text="@L["Variants"].Value" Scope="@SaleReadinessScope.Variants" />
        </TextTemplate>
        <ChildContent>
        @* JENERİK agnostik varyant paneli — kartezyenden üretilen varyantlar (ekleme/silme KAPALI; synchronizer üretir).
           Panelin kendi alanları (Kod/Barkod/GTIN/Stok/Durum) panelde; Product-ÖZEL satış fiyatı + reçete ExtraFields slot'unda
           (GoodLayout deseni). Kod/Ad AGNOSTİK-üretilir (elle düzenlenmez).
           SingleVariant/Substitution modunda OnAttributesChanged BAĞLANMAZ (HasDelegate koşulu) →
           "Özellikleri Düzenle" butonu kendiliğinden kaybolur — nitelik-tabanlı üretim BYPASS (sunucu guard'ı da var). *@
        @* Maliyet kolonu ürün varyantında anlamlı (NetCost) — muadilde kombinasyonun maliyeti doğrudan
           görünsün; fiyatlama kararı ondan çıkıyor. *@
        @* Kimlik alanları (Kod + Kombinasyon) yalnız ÇOK varyantlı üretimde anlamlı; tek varyantlı üründe
           kombinasyon yok ve kod otomatik. Ana varyantın kodu ("ANAVARYANT" iç sabiti) yerine ÜRÜNÜN kodu
           gösterilir — kullanıcı için anlamlı olan o (2026-07-28 Hakan); 2026-08-15'ten beri panel bunu formun
           cascade ettiği modelden KENDİLİĞİNDEN alır (tüm varyantlı emtialarda tek yol — parametre gerekmez). *@
        <EntityVariantsPanel TVariant="ProductVariantGraphDto" @ref="_variantsPanel"
                             Variants="@Model.Variants" Attributes="@Model.Attributes" ShowImages="true"
                             ShowNetCost="true"
                             ShowIdentity="@(Model.VariantMode is ProductVariantMode.MultiVariant or ProductVariantMode.FromCatalog or ProductVariantMode.Substitution)"
                             OnAttributesChanged="@(Model.VariantMode is ProductVariantMode.MultiVariant or ProductVariantMode.FromCatalog ? OnGenerateVariants : default)">
            <ExtraFields Context="v">
                @* SATIŞ STATÜSÜ — SALT-OKUNUR. Push guard'ı yalnız "Hazır" varyantı geçirir; statüyü form değil
                   "Satışa Doğrula" aksiyonu değiştirir. Rozet olmasaydı kullanıcı ürünün neden pazaryerine
                   çıkmadığını hiçbir ekranda göremezdi (canlıda 165/165 varyant Taslak'tı). *@
                <DxFormLayoutItem Caption="@L["Product:SaleStatus"]" ColSpanMd="6" BeginRow="true">
                    <span class="@SaleStatusCssClass(v.SaleStatus)">@L[$"Enum:ProductSaleStatus:{v.SaleStatus}"]</span>
                    @if (v.VerifiedAt is { } verifiedAt)
                    {
                        <span class="ms-2 text-muted"><UtcLocalText Value="@verifiedAt" /></span>
                    }
                </DxFormLayoutItem>
                @* Satılabilir veri (marketplace) — satış fiyatı + para birimi. N11/Trendyol listeleme push'u bunları kullanır;
                   fiyat null = fiyatlanmamış (temizle butonuyla boşaltılabilir). Stok/barkod/GTIN panelin kendi alanlarında. *@
                <DxFormLayoutItem Caption="@L["SalePrice"]" ColSpanMd="6" BeginRow="true">
                    <NumericSpinEdit TValue="decimal?" @bind-Value="@v.SalePrice" DisplayFormat="N2"
                                     ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Currency"]" ColSpanMd="6">
                    <LookupComboBox TItem="CurrentPriceDto" TValue="Guid?" Data="@Units"
                                    ValueFieldName="@nameof(CurrentPriceDto.Id)" TextFieldName="@nameof(CurrentPriceDto.CurrencyUnitCode)"
                                    @bind-Value="@v.SalePriceCurrencyUnitId" AllowClear="true" />
                </DxFormLayoutItem>
                @* Reçete (design-time maliyet) — INLINE panel (VoucherLine giriş paneli deseni; popup YOK). *@
                @* Başlık, O VARYANTIN reçete kapsamındaki issue'larla renklenir (scope: variants/{id}/recipe) —
                   "kanal ürünü var ama varyantın temel emtiası eklenmemiş" senaryosunun EN DERİN durağı burasıdır.
                   CaptionTemplate kullanıldığı için grup içeriği <Items> altına taşınmak ZORUNDA (DevExpress
                   sözleşmesi); Context adı verilmezse dıştaki ExtraFields'ın "v" bağlamıyla çakışır. *@
                <DxFormLayoutGroup ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                    <CaptionTemplate Context="__recipeGroup">
                        <SaleReadinessCaption Text="@L["Recipe"].Value"
                                              Scope="@SaleReadinessScope.VariantRecipe(v.Id)" />
                    </CaptionTemplate>
                    <Items>
                    @* "Üründen" anahtarı: burada satır panelin draft'ıyla doğrudan core grafına girer;
                       kanal formlarında (N11/Trendyol) aynı anahtar ProvisionCommoditiesAsync ile core'a
                       yazar (yayılım adımı 2026-08-14). Etsy kapalı — kanal bilinçli dondurmada. *@
                    @* OnChanged BAĞLANMAMIŞTI ve bu SESSİZ bir veri kaybı kapısıydı (2026-08-11 Hakan bulgusu):
                       EntryPanelBase satırı ekledikten sonra OnChanged'i tetikler; bağlı değilse form DIRTY
                       OLMUYOR → Kaydet pasif kalıyor ve eklenen reçete satırı kaydedilemiyordu. Canlı net
                       maliyet de yenilenmiyordu. OnVariantRecipeChanged bunu KAPATMIYOR: o yalnız "tüm
                       varyantlara uygula" yolunda tetikleniyor, tek varyantlı üründe hiç çalışmıyor. Aynı
                       dosyadaki nitelik/varyant panelleri OnChanged'i zaten bağlıyor — reçete paneli atlanmış.

                       DİKKAT: bu yorum bileşen etiketinin DIŞINDA durur; attribute'ların arasına konursa
                       Blazor onu parametre adı sanar ve circuit'i düşürür (ui-blazor razor-comment kuralı). *@
                    <ProductRecipePanel Lines="v.RecipeLines"
                                        ProductId="@Model.Id" AllowCreateFromProduct="true"
                                        OnCreateCommodityFromProduct="@OnCreateCommodityFromProduct"
                                        OnCatalogReloadRequested="@OnReloadRecipeCatalogs"
                                        Metals="Metals" MetalVariants="MetalVariants" Scraps="Scraps" Futures="Futures"
                                        Jewelries="Jewelries" Stones="Stones" Goods="Goods" Services="Services" Units="Units"
                                        GoodVariants="GoodVariants" JewelryVariants="JewelryVariants"
                                        AllVariants="@Model.Variants"
                                        OnChanged="@(async () => await HandleRecipeChangedAsync(v))"
                                        OnVariantRecipeChanged="@(async (ProductVariantGraphDto variant) => await HandleRecipeChangedAsync(variant))"
                                        NetCost="@v.NetCost" NetCostCurrency="@v.NetCostCurrency" NetCostMissingRate="@v.NetCostMissingRate" />
                    </Items>
                </DxFormLayoutGroup>
            </ExtraFields>
        </EntityVariantsPanel>
        </ChildContent>
    </DxTabPage>
    @* Medya / Video — merkezi kütüphane (görsel + video birlikte; yükle / URL-import / kütüphaneden reuse; video 100MB,
       poster yakala). Pazaryeri push görselleri de BURADAN gider (legacy Images drill'i 2026-07-31'de emekli — K2).
       Varyanta özel görseller Varyantlar sekmesinde (EntityVariantsPanel ShowImages). Panel kendi servisini çağırır (DUMB layout). *@
    <DxTabPage Text="@L["Product:Media"]" TabIconCssClass="@TradeXpressIcons.Product" Enabled="@CanEditRest">
        <TextTemplate>
            <SaleReadinessCaption Text="@L["Product:Media"].Value" Scope="@SaleReadinessScope.Media" />
        </TextTemplate>
        <ChildContent>
            <span style="color:#6c757d; font-size:0.85rem;">@L["Product:MediaHint"]</span>
            <EntityMediaPanel Media="@Model.Media" />
        </ChildContent>
    </DxTabPage>
    @* Ürünün GENEL ÖZELLİKLERİ — nitelik ADLARI kategoriden gelir (kalıtım dahil), DEĞERLERİ burada girilir.
       Satır EKLENMEZ/SİLİNMEZ: liste kategorinin tanımıdır. Yeni özellik gerekiyorsa kategoriye eklenir —
       ürüne serbest satır açtırmak, aynı özelliğin her üründe farklı adla yazılmasına ve pazaryeri
       eşleştirmesinin tutmamasına yol açardı. *@
    @* Kategori seçilmeden sekme GİZLİ — ama @if ile DEĞİL, Visible ile: sekmeyi ağaçtan çıkarmak
       diğerlerinin sırasını (ve seçili sekme indeksini) kaydırıyordu (2026-07-28 Hakan). *@
    <DxTabPage Text="@L["Product:Specifications"]" TabIconCssClass="@TradeXpressIcons.Sliders"
               Enabled="@CanEditRest"
               Visible="@(Model.ProductCategoryId is not null)">
        @if (SpecificationRows.Count == 0)
        {
            <InlineWarning>@L["Product:SpecificationsEmpty"]</InlineWarning>
        }
        else
        {
            <span style="color:#6c757d; font-size:0.85rem;">@L["Product:SpecificationsHint"]</span>
            @* HÜCRE-İÇİ düzenleme (N11 "Kategori Nitelikleri" grid'iyle AYNI desen): satır = kategoriden gelen
               özellik tanımı (SABİT — eklenmez/silinmez), değer hücresine tıklanınca anında düzenlenir.
               Değer-listeli özellik → combo (liste dışı değer de yazılabilir); serbest özellik → metin kutusu.
               Paging YOK: kategori nitelikleri onlarca satırı geçmez, sayfalama aramayı zorlaştırırdı. *@
            <DxGrid Data="@SpecificationRows" KeyFieldName="AttributeId"
                    EditMode="GridEditMode.EditCell"
                    EditModelSaving="@OnSpecificationRowSaving"
                    PageSize="200" PagerVisible="false"
                    CssClass="w-100 mt-2">
                <Columns>
                    <DxGridDataColumn FieldName="Name" Caption="@L["ProductAttribute"]" Width="35%" ReadOnly="true" />
                    @* FieldName ŞART: EditCell modunda FieldName'siz kolon düzenlenebilir hücre sayılmaz. *@
                    <DxGridDataColumn FieldName="Value" Caption="@L["AttributeValues"]">
                        <CellDisplayTemplate Context="cell">
                            @{ var r = (SpecificationRow)cell.DataItem; }
                            <span>@(string.IsNullOrEmpty(r.Value) ? "-" : r.Value)</span>
                        </CellDisplayTemplate>
                        <CellEditTemplate Context="cell">
                            @{ var row = (SpecificationRow)cell.EditModel; }
                            @if (row.HasOptions)
                            {
                                @* Tek-yönlü Text bağı → TextExpression ŞART ([validation-expr]). *@
                                <DxComboBox Data="@row.Options"
                                            TData="string"
                                            TValue="string"
                                            AllowUserInput="true"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            Text="@row.Value"
                                            TextChanged="@((string v) => row.Value = v)"
                                            TextExpression="@(() => row.Value)"
                                            ValidationEnabled="false"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            CssClass="w-100" />
                            }
                            else
                            {
                                <DxTextBox Text="@row.Value"
                                           TextChanged="@((string v) => row.Value = v)"
                                           TextExpression="@(() => row.Value)" />
                            }
                        </CellEditTemplate>
                    </DxGridDataColumn>
                </Columns>
            </DxGrid>
        }
    </DxTabPage>
    @* Ürün özelleştirme alanları — pazaryeri-genel varsayılan (key zorunlu / value opsiyonel). Kanal-ürünü boşsa devralır. *@
    <DxTabPage Text="@L["Product:SpecialInfo"]" TabIconCssClass="@TradeXpressIcons.Sliders" Enabled="@CanEditRest">
        <span style="color:#6c757d; font-size:0.85rem;">@L["Product:SpecialInfoHint"]</span>
        <DrillList TItem="ProductSpecialInfoDto"
                   Title="@L["Product:SpecialInfo"]"
                   EntityName="@L["Product:SpecialInfo"]"
                   EntityIcon="@TradeXpressIcons.Sliders"
                   Items="@Model.SpecialInfo"
                   PrimaryTextSelector="@(s => s.Key)"
                   NewItemFactory="@(() => new ProductSpecialInfoDto())"
                   SaveGuard="@SpecialInfoSaveGuard"
                   ShowActiveFilter="false"
                   ShowExport="false"
                   ShowSearch="false"
                   OnChanged="@(() => EditChanged?.Invoke())">
            <GridColumns>
                <DxGridDataColumn FieldName="Key" Caption="@L["Product:SpecialInfoKey"]" Width="30%" />
                <DxGridDataColumn FieldName="Value" Caption="@L["Product:SpecialInfoValue"]" />
            </GridColumns>
            <EditContent Context="s">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem Caption="@($"{L["Product:SpecialInfoKey"]} *")" ColSpanMd="12">
                        <DxTextBox @bind-Text="@s.Key" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["Product:SpecialInfoValue"]" ColSpanMd="12">
                        <DxMemo @bind-Text="@s.Value" Rows="4" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
                    </DxFormLayoutItem>
                </DxFormLayout>
            </EditContent>
        </DrillList>
    </DxTabPage>
    @* Seçenekler — sipariş anı eklentileri (katalogdan seç + satır override: fiyat/para birimi/zorunluluk/not).
       Pazaryerine push'ta native "seçenek" olmadığından VARYANT olarak yansıtılır (Faz 2 projeksiyonu). *@
    <DxTabPage Text="@L["Product:AddOns"]" TabIconCssClass="@TradeXpressIcons.AddOn" Enabled="@CanEditRest">
        <span style="color:#6c757d; font-size:0.85rem;">@L["Product:AddOnsHint"]</span>
        <DrillList TItem="ProductAddOnDto"
                   Title="@L["Product:AddOns"]"
                   EntityName="@L["AddOn"]"
                   EntityIcon="@TradeXpressIcons.AddOn"
                   Items="@Model.AddOns"
                   PrimaryTextSelector="@(a => AddOnName(a.AddOnId))"
                   NewItemFactory="@(() => new ProductAddOnDto { DisplayOrder = NextAddOnOrder() })"
                   SaveGuard="@AddOnSaveGuard"
                   ShowActiveFilter="false"
                   ShowExport="false"
                   OnChanged="@(() => EditChanged?.Invoke())">
            <GridColumns>
                <DxGridDataColumn Caption="@L["AddOn"]" FieldName="AddOnId" MinWidth="180">
                    <CellDisplayTemplate>@AddOnName((context.DataItem as ProductAddOnDto)!.AddOnId)</CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="PriceOverride" Caption="@L["AddOn:PriceOverride"]" Width="140px" />
                <DxGridDataColumn FieldName="IsRequired" Caption="@L["AddOn:IsRequired"]" Width="110px" />
                <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="100px" />
            </GridColumns>
            <EditContent Context="a">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem Caption="@($"{L["AddOn"]} *")" ColSpanMd="12">
                        <LookupComboBox TItem="AddOnListDto" TValue="Guid?"
                                        Data="@AddOnCatalog"
                                        ValueFieldName="@nameof(AddOnListDto.Id)"
                                        TextFieldName="@nameof(AddOnListDto.Name)"
                                        Value="@(a.AddOnId == Guid.Empty ? (Guid?)null : a.AddOnId)"
                                        ValueChanged="@((Guid? v) => a.AddOnId = v ?? Guid.Empty)"
                                        EditComponentType="typeof(AddOnEditHost)"
                                        OnLookupReloadRequested="@OnReloadAddOns"
                                        CreatePolicy="@TradeXpressPermissions.AddOns.Create"
                                        UpdatePolicy="@TradeXpressPermissions.AddOns.Update"
                                        AllowClear="false" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["AddOn:PriceOverride"]" ColSpanMd="6">
                        <DxSpinEdit @bind-Value="@a.PriceOverride" MinValue="0m" DisplayFormat="N2"
                                    NullText="@L["AddOn:CatalogDefault"]" CssClass="w-100" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["AddOn:CurrencyOverride"]" ColSpanMd="6">
                        <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?"
                                        Data="@CurrencyUnits"
                                        ValueFieldName="@nameof(CurrencyUnitListDto.Id)"
                                        TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                                        @bind-Value="@a.CurrencyUnitOverrideId"
                                        NullText="@L["AddOn:CatalogDefault"]"
                                        AllowClear="true" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["AddOn:IsRequired"]" ColSpanMd="6">
                        <DxCheckBox @bind-Checked="@a.IsRequired" CheckType="CheckType.Switch" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
                        <NumericSpinEdit @bind-Value="@a.DisplayOrder" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["AddOn:Note"]" ColSpanMd="12">
                        <DxMemo @bind-Text="@a.Note" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
                    </DxFormLayoutItem>
                </DxFormLayout>
            </EditContent>
        </DrillList>
    </DxTabPage>
    @* Muadil kombinasyon tablosu KALDIRILDI (2026-07-27 Hakan kararı): kombinasyonlar artık kapsam/miktar
       değişir değişmez Varyantlar sekmesinde doğrudan görünüyor (kaydetmeden), ayrı bir inceleme tablosuna
       gerek kalmadı. Hesap İŞİ duruyor — varyant önizlemesini o besliyor; kalkan yalnız görüntü. *@

    @* Satış kanalı ürünleri — N11 + Trendyol TEK grid'de (Kanal kolonu); edit formları tipe göre AYRI. IN-MEMORY GRAF:
       ürün 'Kaydet'inde birlikte kaydedilir (yeni üründe de eklenebilir). Push/Stok-Fiyat yalnız kaydedilmiş satırda. *@
    <DxTabPage Text="@L["SalesChannelProducts"]" TabIconCssClass="@TradeXpressIcons.SalesChannel" Enabled="@CanEditRest">
        <TextTemplate>
            <SaleReadinessCaption Text="@L["SalesChannelProducts"].Value" Scope="@SaleReadinessScope.Channels" />
