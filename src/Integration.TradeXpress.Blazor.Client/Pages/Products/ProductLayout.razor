@using System
@using System.Linq
@using Integration.TradeXpress.Financials.CurrencyUnits
@using Integration.TradeXpress.Blazor.Client.Pages.Financials.CurrencyUnits
@using Integration.TradeXpress.Permissions
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Product DUMB Layout — ProductGetDto'yu forma yansıtır. I/O yok, karar yok, persistence yok.
   Standart alan sırası (ui-blazor): Kod → Ad → Description → Status → varyant DrillList (en son).
*@

<DxFormLayout CssClass="w-100">
    <DxFormLayoutGroup Caption="@L["General"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6">
            <DxTextBox @bind-Text="@Model.Code" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
            <DxTextBox @bind-Text="@Model.Name" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
                @(Model.IsActive ? L["Active"] : L["Passive"])
            </DxCheckBox>
        </DxFormLayoutItem>
        @* Üretim / son kullanma tarihi (opsiyonel; N11 productionDate/expirationDate). İş tarihi (date-only). *@
        <DxFormLayoutItem Caption="@L["Product:ProductionDate"]" ColSpanMd="6" BeginRow="true">
            <DxDateEdit @bind-Date="@Model.ProductionDate" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Product:ExpirationDate"]" ColSpanMd="6">
            <DxDateEdit @bind-Date="@Model.ExpirationDate" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>

    @* Marketplace indirimi (ürün-seviyesi; tüm varyant + kanallara aynı gider). None dışında değer + tarih görünür. *@
    <DxFormLayoutGroup Caption="@L["Product:Discount"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@L["Product:DiscountType"]" ColSpanMd="4" BeginRow="true">
            <ComboBoxEnumEdit TEnum="ProductDiscountType" L="@L" @bind-Value="@Model.DiscountType" />
        </DxFormLayoutItem>
        @if (Model.DiscountType != ProductDiscountType.None)
        {
            <DxFormLayoutItem Caption="@L["Product:DiscountValue"]" ColSpanMd="4">
                <NumericSpinEdit TValue="decimal?" @bind-Value="@Model.DiscountValue" DisplayFormat="N2"
                                 ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Product:DiscountStartDate"]" ColSpanMd="4">
                <DxDateEdit @bind-Date="@Model.DiscountStartDate" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="@L["Product:DiscountEndDate"]" ColSpanMd="4">
                <DxDateEdit @bind-Date="@Model.DiscountEndDate" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
        }
    </DxFormLayoutGroup>

    @* Pazaryeri-genel varsayılanlar — tüm pazaryerleri için ortak; kanal-ürünü boş bıraktığı alanlarda bunu devralır. *@
    <DxFormLayoutGroup Caption="@L["Product:MarketplaceDefaults"]" ColSpanMd="12">
        <DxFormLayoutItem Caption="@L["Product:Domestic"]" ColSpanMd="6" BeginRow="true">
            <DxCheckBox @bind-Checked="@Model.Domestic" CheckType="CheckType.Switch">
                @(Model.Domestic ? L["Yes"] : L["No"])
            </DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Product:Condition"]" ColSpanMd="6">
            <ComboBoxEnumEdit TEnum="ProductCondition" L="@L" @bind-Value="@Model.Condition" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Product:PreparingDay"]" ColSpanMd="6" BeginRow="true">
            <NumericSpinEdit TValue="int" @bind-Value="@Model.PreparingDay" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Product:MaxPurchaseQuantity"]" ColSpanMd="6">
            <NumericSpinEdit TValue="int?" @bind-Value="@Model.MaxPurchaseQuantity"
                             ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Product:ShipmentTemplate"]" ColSpanMd="6" BeginRow="true">
            <DxTextBox @bind-Text="@Model.ShipmentTemplateName" NullText="@L["Optional"]" />
        </DxFormLayoutItem>
        @* Varsayılan para birimi — opsiyonel; inline ekle/düzelt (popup + refresh standardı). *@
        <DxFormLayoutItem Caption="@L["Product:CurrencyUnit"]" ColSpanMd="6">
            <LookupComboBox TItem="CurrencyUnitListDto" TValue="Guid?"
                            Data="@CurrencyUnits"
                            ValueFieldName="@nameof(CurrencyUnitListDto.Id)"
                            TextFieldName="@nameof(CurrencyUnitListDto.Code)"
                            @bind-Value="@Model.CurrencyUnitId"
                            EditComponentType="typeof(CurrencyUnitEditHost)"
                            OnLookupReloadRequested="@OnReloadCurrencyUnits"
                            CreatePolicy="@TradeXpressPermissions.CurrencyUnits.Create"
                            UpdatePolicy="@TradeXpressPermissions.CurrencyUnits.Update"
                            AllowClear="true" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["Product:SellerNote"]" ColSpanMd="12">
            <DxMemo @bind-Text="@Model.SellerNote" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100"
                    NullText="@L["Optional"]" />
        </DxFormLayoutItem>
    </DxFormLayoutGroup>
</DxFormLayout>

@* Nitelikler + Varyantlar. Nitelik×değer kartezyeni varyantları SUNUCUDA üretir (ProductVariantSynchronizer);
   varyant drill'i bu yüzden ekleme/silmeye KAPALI (AllowAdd/AllowDelete=false) — yalnız mevcut satır düzenlenir. *@
<DrillTabs CssClass="mt-3">
    @* Açıklama — zengin metin (DxHtmlEditor). Marketplace açıklaması HTML kabul eder. *@
    <DxTabPage Text="@L["Description"]" TabIconCssClass="@TradeXpressIcons.Product">
        <DxHtmlEditor @bind-Markup="@Model.Description" CssClass="w-100" Height="360px" />
    </DxTabPage>
    @* Nitelikler — JENERİK agnostik nitelik paneli (EntityName="Product" AppService'te). Panel DxTabPage ÜRETMEZ,
       içeriği üretir. Nitelik/değer değişimi OnAttributesChanged → host varyant regen'ini (OTOMATİK senkron) tetikler. *@
    <DxTabPage Text="@L["Attributes"]" TabIconCssClass="@TradeXpressIcons.Sliders">
        <EntityAttributesPanel Attributes="@Model.Attributes" OnAttributesChanged="@OnGenerateVariants" />
    </DxTabPage>
    <DxTabPage Text="@L["Variants"]" TabIconCssClass="@TradeXpressIcons.ProductVariant">
        @* JENERİK agnostik varyant paneli — kartezyenden üretilen varyantlar (ekleme/silme KAPALI; synchronizer üretir).
           Çekirdek alanlar (Kod/Barkod/GTIN/Stok/Durum) panelde; Product-ÖZEL satış fiyatı + reçete ExtraFields slot'unda
           (GoodLayout deseni). Kod/Ad AGNOSTİK-üretilir (elle düzenlenmez). *@
        <EntityVariantsPanel TVariant="ProductVariantGraphDto" Variants="@Model.Variants" Attributes="@Model.Attributes">
            <ExtraFields Context="v">
                @* Satılabilir veri (marketplace) — satış fiyatı + para birimi. N11/Trendyol listeleme push'u bunları kullanır;
                   fiyat null = fiyatlanmamış (temizle butonuyla boşaltılabilir). Stok/barkod/GTIN panel çekirdeğinde. *@
                <DxFormLayoutItem Caption="@L["SalePrice"]" ColSpanMd="6" BeginRow="true">
                    <NumericSpinEdit TValue="decimal?" @bind-Value="@v.SalePrice" DisplayFormat="N2"
                                     ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="@L["Currency"]" ColSpanMd="6">
                    <LookupComboBox TItem="CurrentPriceDto" TValue="Guid?" Data="@Units"
                                    ValueFieldName="@nameof(CurrentPriceDto.Id)" TextFieldName="@nameof(CurrentPriceDto.CurrencyUnitCode)"
                                    @bind-Value="@v.SalePriceCurrencyUnitId" AllowClear="true" />
                </DxFormLayoutItem>
                @* Reçete (design-time maliyet) — INLINE panel (VoucherLine giriş paneli deseni; popup YOK). *@
                <DxFormLayoutGroup Caption="@L["Recipe"]" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                    <ProductRecipePanel Lines="v.RecipeLines"
                                        Metals="Metals" MetalVariants="MetalVariants" Scraps="Scraps" Futures="Futures"
                                        Jewelries="Jewelries" Stones="Stones" Services="Services" Units="Units"
                                        NetCost="@v.NetCost" NetCostCurrency="@v.NetCostCurrency" NetCostMissingRate="@v.NetCostMissingRate"
                                        OnChanged="@(async () => await HandleRecipeChangedAsync(v))" />
                </DxFormLayoutGroup>
            </ExtraFields>
        </EntityVariantsPanel>
    </DxTabPage>
    @* Görseller — URL ya da yüklenen dosya (blob); DisplayOrder sıralı (ilk = ana). In-memory drill; Product save'i persist eder. *@
    <DxTabPage Text="@L["Images"]" TabIconCssClass="@TradeXpressIcons.Product">
        <DrillList TItem="ProductImageGraphDto"
                   @ref="_imageDrill"
                   Title="@L["Images"]"
                   EntityName="@L["ProductImage"]"
                   EntityIcon="@TradeXpressIcons.Product"
                   Items="Model.Images"
                   KeyFieldName="ClientKey"
                   PrimaryTextSelector="@(i => i.FileName ?? i.Url)"
                   NewItemFactory="@(() => new ProductImageGraphDto { DisplayOrder = NextOrder(Model.Images) })"
                   CloneFactory="@CloneImage"
                   SaveGuard="@ImageSaveGuard"
                   OnItemSaved="@((ProductImageGraphDto saved) => TransferDefaultImage(saved))"
                   MaxItems="ProductConsts.MaxImageCount"
                   OnChanged="@(() => EditChanged?.Invoke())">
            <GridColumns>
                <DxGridDataColumn Caption="@L["Preview"]" Width="110px" TextAlignment="GridTextAlignment.Center">
                    <CellDisplayTemplate Context="cell">
                        @{ var img = (ProductImageGraphDto)cell.DataItem; }
                        @if (!string.IsNullOrEmpty(PreviewSrcOf(img)))
                        {
                            @* ham img: Dx görsel bileşeni yok — küçük, sınırlı önizleme *@
                            <img src="@PreviewSrcOf(img)" alt="" style="max-height:48px; max-width:90px; object-fit:contain;" />
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="SourceType" Caption="@L["ImageSource"]" Width="110px">
                    <CellDisplayTemplate Context="cell">
                        @L[$"Enum:{nameof(ProductImageSourceType)}:{((ProductImageGraphDto)cell.DataItem).SourceType}"]
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                @* TextSelector: URL satırında FileName null → link boş kalmasın (FileName ?? Url). *@
                <GridLinkColumn FieldName="FileName" Caption="@L["Name"]"
                                TextSelector="@(item => ((ProductImageGraphDto)item).FileName ?? ((ProductImageGraphDto)item).Url)"
                                OnClick="@(item => _imageDrill?.EditItem((ProductImageGraphDto)item))" />
                <DxGridDataColumn FieldName="IsDefault" Caption="@L["Default"]" Width="100px">
                    <CellDisplayTemplate Context="cell">
                        @if (cell.Value is bool isDefault && isDefault)
                        {
                            <span style="display:flex; align-items:center; gap:0.35rem;">
                                <i class="custom-icon-check-circle" aria-hidden="true" style="color:#16a34a;"></i>@L["Default"]
                            </span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="DisplayOrder" Caption="@L["DisplayOrder"]" Width="90px" />
            </GridColumns>
            <EditContent Context="img">
                <DxFormLayout CssClass="w-100">
                    <ProductImageEditFields Model="img"
                                            IsDuplicateFileName="@(name => Model.Images.Any(x => x.ClientKey != img.ClientKey && string.Equals(x.FileName, name, StringComparison.OrdinalIgnoreCase)))" />
                </DxFormLayout>
            </EditContent>
        </DrillList>
    </DxTabPage>
    @* Ürün özelleştirme alanları — pazaryeri-genel varsayılan (key zorunlu / value opsiyonel). Kanal-ürünü boşsa devralır. *@
    <DxTabPage Text="@L["Product:SpecialInfo"]" TabIconCssClass="@TradeXpressIcons.Sliders">
        <span style="color:#6c757d; font-size:0.85rem;">@L["Product:SpecialInfoHint"]</span>
        <DrillList TItem="ProductSpecialInfoDto"
                   Title="@L["Product:SpecialInfo"]"
                   EntityName="@L["Product:SpecialInfo"]"
                   EntityIcon="@TradeXpressIcons.Sliders"
                   Items="@Model.SpecialInfo"
                   PrimaryTextSelector="@(s => s.Key)"
                   NewItemFactory="@(() => new ProductSpecialInfoDto())"
                   SaveGuard="@SpecialInfoSaveGuard"
                   ShowActiveFilter="false"
                   ShowExport="false"
                   ShowSearch="false"
                   OnChanged="@(() => EditChanged?.Invoke())">
            <GridColumns>
                <DxGridDataColumn FieldName="Key" Caption="@L["Product:SpecialInfoKey"]" Width="30%" />
                <DxGridDataColumn FieldName="Value" Caption="@L["Product:SpecialInfoValue"]" />
            </GridColumns>
            <EditContent Context="s">
                <DxFormLayout CssClass="w-100">
                    <DxFormLayoutItem Caption="@($"{L["Product:SpecialInfoKey"]} *")" ColSpanMd="12">
                        <DxTextBox @bind-Text="@s.Key" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@L["Product:SpecialInfoValue"]" ColSpanMd="12">
                        <DxMemo @bind-Text="@s.Value" Rows="4" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
                    </DxFormLayoutItem>
                </DxFormLayout>
            </EditContent>
        </DrillList>
    </DxTabPage>
    @* Satış kanalı ürünleri — N11 + Trendyol TEK grid'de (Kanal kolonu); edit formları tipe göre AYRI. IN-MEMORY GRAF:
       ürün 'Kaydet'inde birlikte kaydedilir (yeni üründe de eklenebilir). Push/Stok-Fiyat yalnız kaydedilmiş satırda. *@
    <DxTabPage Text="@L["SalesChannelProducts"]" TabIconCssClass="@TradeXpressIcons.SalesChannel">
        <ProductSalesChannelsPanel N11Items="Model.SalesChannelProducts"
                                   TrendyolItems="Model.SalesChannelTrendyolProducts"
                                   ProductId="@Model.Id"
                                   ProductDefaults="Model"
                                   OnChanged="@(() => EditChanged?.Invoke())" />
    </DxTabPage>
</DrillTabs>
