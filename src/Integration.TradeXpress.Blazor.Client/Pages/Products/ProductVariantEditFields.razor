@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Ürün varyantı edit formunun alanları (Code/Name/Description/Status). TEK yüzey (yalnız Product drill'i) →
   ortak arayüz gerekmez (YAGNI). Çağıran DxFormLayout'u SAĞLAR. Code BeginRow ile yeni satırda başlar. *@

@* Kombinasyon (Nitelik: Değer) — SALT-OKUNUR; hangi kombinasyonun düzenlendiğini gösterir. Base varyantta boş → gizle. *@
@if (!string.IsNullOrEmpty(Model.AttributeSummary))
{
    <DxFormLayoutItem Caption="@L["AttributeSummary"]" ColSpanMd="12" BeginRow="true">
        <span>@Model.AttributeSummary</span>
    </DxFormLayoutItem>
}
<DxFormLayoutItem Caption="@($"{L["Code"]} *")" ColSpanMd="6" BeginRow="true">
    <DxTextBox @bind-Text="@Model.Code" />
</DxFormLayoutItem>
<DxFormLayoutItem Caption="@($"{L["Name"]} *")" ColSpanMd="12">
    <DxTextBox @bind-Text="@Model.Name" />
</DxFormLayoutItem>
<DxFormLayoutItem Caption="@L["Description"]" ColSpanMd="12">
    <DxMemo @bind-Text="@Model.Description" Rows="2" ResizeMode="MemoResizeMode.Disabled" CssClass="w-100" />
</DxFormLayoutItem>
<DxFormLayoutItem Caption="@L["Status"]" ColSpanMd="6">
    <DxCheckBox @bind-Checked="@Model.IsActive" CheckType="CheckType.Switch">
        @(Model.IsActive ? L["Active"] : L["Passive"])
    </DxCheckBox>
</DxFormLayoutItem>
@* Satılabilir veri (marketplace) — satış fiyatı + para birimi + stok. N11/Trendyol listeleme push'u bunları kullanır.
   Fiyat null = fiyatlanmamış (temizle butonuyla boşaltılabilir). Para birimi ValueExpression'sız → dirty code-behind'da. *@
<DxFormLayoutItem Caption="@L["SalePrice"]" ColSpanMd="4" BeginRow="true">
    <NumericSpinEdit TValue="decimal?" @bind-Value="@Model.SalePrice" DisplayFormat="N2"
                     ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
</DxFormLayoutItem>
<DxFormLayoutItem Caption="@L["Currency"]" ColSpanMd="4">
    <LookupComboBox TItem="CurrentPriceDto" TValue="Guid?" Data="@Units"
                    ValueFieldName="@nameof(CurrentPriceDto.Id)" TextFieldName="@nameof(CurrentPriceDto.CurrencyUnitCode)"
                    Value="@Model.SalePriceCurrencyUnitId" ValueChanged="@OnSalePriceCurrencyChanged" AllowClear="true" />
</DxFormLayoutItem>
<DxFormLayoutItem Caption="@L["StockQuantity"]" ColSpanMd="4">
    <NumericSpinEdit TValue="int" @bind-Value="@Model.StockQuantity" />
</DxFormLayoutItem>
