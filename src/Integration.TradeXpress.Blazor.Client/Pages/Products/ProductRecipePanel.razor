@using Integration.TradeXpress.Metals
@using Integration.TradeXpress.Scraps
@using Integration.TradeXpress.Futures
@using Integration.TradeXpress.Jewelries
@using Integration.TradeXpress.Stones
@using Integration.TradeXpress.Goods
@using Integration.TradeXpress.Services
@using Integration.TradeXpress.Blazor.Client.Pages.CurrentTransactions
@inherits Integration.Framework.Blazor.Client.Components.Crud.EntryPanelBase<ProductRecipeLineGraphDto>
@implements Integration.Framework.Blazor.Client.Services.Base.ISplitEditActions

@* Reçete paneli — EntryPanelBase (Framework buffered giriş tabanı) türevi, süreç paneli görünümü:
   toolbar tip seçtirir → EntryPanelShell (kırmızı gradyan başlık + Kaydet/Geri) toolbar'ın yerine açılır;
   DRAFT üzerinde çalışılır. Kaydet = uygula + aynı tipte yeni draft (seri giriş); Geri = draft'ı at. *@

<DxLayoutBreakpoint MaxWidth="768" @bind-IsActive="@_isMobile" />

    @* Reçete toolbar — HEP görünür (draft popup'ı arkada açılır); ekleme "Yeni" dropdown'ında; Düzenle/Sil; net maliyet sağda. *@
    <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Plain"
               AdaptivityAutoCollapseItemsToIcons="false" AdaptivityAutoHideRootItems="false">
        <DxToolbarItem Text="@L["New"]" IconCssClass="@TradeXpressIcons.Add" Tooltip="@L["New"].Value">
            <Items>
                <DxToolbarItem Text="@L["Metal"]" IconCssClass="@TradeXpressIcons.Metal"
                               Click="@((ToolbarItemClickEventArgs e) => OpenCatalogDraft(ProcessType.Metal))" />
                <DxToolbarItem Text="@L["Scrap"]" IconCssClass="@TradeXpressIcons.Scrap"
                               Click="@((ToolbarItemClickEventArgs e) => OpenCatalogDraft(ProcessType.Scrap))" />
                <DxToolbarItem Text="@L["Future"]" IconCssClass="@TradeXpressIcons.Future"
                               Click="@((ToolbarItemClickEventArgs e) => OpenCatalogDraft(ProcessType.Future))" />
                <DxToolbarItem Text="@L["Jewelry"]" IconCssClass="@TradeXpressIcons.Jewelry"
                               Click="@((ToolbarItemClickEventArgs e) => OpenCatalogDraft(ProcessType.Jewelry))" />
                <DxToolbarItem Text="@L["Stone"]" IconCssClass="@TradeXpressIcons.Stone"
                               Click="@((ToolbarItemClickEventArgs e) => OpenCatalogDraft(ProcessType.Stone))" />
                <DxToolbarItem Text="@L["Good"]" IconCssClass="@TradeXpressIcons.Good"
                               Click="@((ToolbarItemClickEventArgs e) => OpenCatalogDraft(ProcessType.Good))" />
                <DxToolbarItem Text="@L["Service"]" IconCssClass="@TradeXpressIcons.Service"
                               Click="@((ToolbarItemClickEventArgs e) => OpenServiceDraft())" />
            </Items>
        </DxToolbarItem>
        <DxToolbarItem Text="@L["Edit"]" IconCssClass="@TradeXpressIcons.Edit" BeginGroup="true"
                       Enabled="@(_selectedLine is not null)"
                       Click="@((ToolbarItemClickEventArgs e) => EditSelectedLine())" />
        <DxToolbarItem Text="@L["Delete"]" IconCssClass="@TradeXpressIcons.Delete"
                       Enabled="@(_selectedLine is not null)"
                       Click="@(async (ToolbarItemClickEventArgs e) => await DeleteSelectedLineAsync())" />
        <DxToolbarItem Alignment="ToolbarItemAlignment.Right">
            <Template>
                @if (NetCost.HasValue)
                {
                    <span style="font-weight:600; padding:0 0.35rem; white-space:nowrap;">
                        @L["NetCost"]: @NetCost.Value.ToString("N2") @NetCostCurrency
                        @if (NetCostMissingRate)
                        {
                            <span style="color:#b45309; font-weight:400;"> (@L["MissingRate"])</span>
                        }
                    </span>
                }
            </Template>
        </DxToolbarItem>
    </DxToolbar>

@* Reçete draft — POPUP (EntryPanelShell Popup modu; kırmızı gradyan + seri-giriş korunur). X/Geri = draft iptal. *@
@if (Draft is { } d)
{
    <EntryPanelShell Popup="true"
                     Visible="true"
                     Title="@EditorTitle(d)"
                     Icon="@EditorIcon(d)"
                     EditController="@this"
                     SaveEnabled="true"
                     OnSave="@(async () => await SaveDraftDispatchAsync())"
                     OnBack="@(() => CloseDraft())">
        @* Kaydet'ten ÖNCE "Tüm varyantlara uygula" checkbox'ı (footer, solda) — açıkken Kaydet satırı TÜM varyantlara upsert eder. *@
        <FooterLeading>
            @* Yalnız YENİ satır eklerken (düzenlemede gizli — tüm-varyant yalnız eklemeye özel). *@
            @if (HasAllVariants && EditingItem is null)
            {
                <DxCheckBox Checked="@_applyToAllVariants" CheckedChanged="@((bool v) => _applyToAllVariants = v)" ValidationEnabled="false">
                    @L["ApplyToAllVariants"]
                </DxCheckBox>
            }
        </FooterLeading>
        <ChildContent>
        <div style="padding:8px; @(_isMobile ? "" : "overflow-x:auto;")">
            <div style="display:flex; @(_isMobile ? "flex-direction:column;" : "width:max-content;") gap:4px; align-items:flex-start;">

                @if (d.ComponentType == RecipeComponentType.CatalogCommodity)
                {
                    @if (IsMetalLegged(d.CommodityProcessType))
                    {
                        @* Ödeme tipi — reçetede YALNIZ Normal + Bedelli; DxComboBox EditContext içinde
                           ValidationEnabled=false ile render eder (LookupComboBox deseni). *@
                        <div style="@GroupStyle()">
                            <small style="@ProcessPanelStyles.Label">@L["PaymentType"]</small>
                            <DxComboBox TData="PaymentItem" TValue="ProcessPaymentType"
                                        Data="@_paymentItems" Value="@d.PaymentType"
                                        ValueChanged="@((ProcessPaymentType v) => OnPaymentTypeChanged(v))"
                                        ValueFieldName="@nameof(PaymentItem.Value)" TextFieldName="@nameof(PaymentItem.Label)"
                                        DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                        ValidationEnabled="false" CssClass="w-100" />
                        </div>
                    }

                    <div style="@GroupStyle(240)">
                        <small style="@ProcessPanelStyles.Label">@ComponentLabel(d)</small>
                        @if (d.CommodityProcessType == ProcessType.Metal)
                        {
                            <LookupComboBox TItem="MetalVariantLookupDto" TValue="Guid?" Data="@MetalVariants"
                                            ValueFieldName="@nameof(MetalVariantLookupDto.VariantId)" TextFieldName="@nameof(MetalVariantLookupDto.DisplayText)"
                                            Value="@d.CommodityVariantId" ValueChanged="@((Guid? v) => OnMetalSelected(v))" AllowClear="false">
                                <Columns>
                                    <DxListEditorColumn FieldName="@nameof(MetalVariantLookupDto.MetalCode)" Caption="@L["MetalCode"]" />
                                    <DxListEditorColumn FieldName="@nameof(MetalVariantLookupDto.MetalName)" Caption="@L["MetalName"]" />
                                    <DxListEditorColumn FieldName="@nameof(MetalVariantLookupDto.VariantCode)" Caption="@L["VariantCode"]" />
                                    <DxListEditorColumn FieldName="@nameof(MetalVariantLookupDto.VariantName)" Caption="@L["VariantName"]" />
                                </Columns>
                            </LookupComboBox>
                        }
                        else if (d.CommodityProcessType == ProcessType.Scrap)
                        {
                            <LookupComboBox TItem="ScrapListDto" TValue="Guid?" Data="@Scraps"
                                            ValueFieldName="@nameof(ScrapListDto.Id)" TextFieldName="@nameof(ScrapListDto.Code)"
                                            Value="@d.CommodityId" ValueChanged="@((Guid? v) => OnScrapSelected(v))" AllowClear="false" />
                        }
                        else if (d.CommodityProcessType == ProcessType.Future)
                        {
                            <LookupComboBox TItem="FutureListDto" TValue="Guid?" Data="@Futures"
                                            ValueFieldName="@nameof(FutureListDto.Id)" TextFieldName="@nameof(FutureListDto.Code)"
                                            Value="@d.CommodityId" ValueChanged="@((Guid? v) => OnFutureSelected(v))" AllowClear="false" />
                        }
                        else if (d.CommodityProcessType == ProcessType.Jewelry)
                        {
                            <LookupComboBox TItem="JewelryListDto" TValue="Guid?" Data="@Jewelries"
                                            ValueFieldName="@nameof(JewelryListDto.Id)" TextFieldName="@nameof(JewelryListDto.Code)"
                                            Value="@d.CommodityId" ValueChanged="@((Guid? v) => OnJewelrySelected(v))" AllowClear="false" />
                        }
                        else if (d.CommodityProcessType == ProcessType.Stone)
                        {
                            <LookupComboBox TItem="StoneListDto" TValue="Guid?" Data="@Stones"
                                            ValueFieldName="@nameof(StoneListDto.Id)" TextFieldName="@nameof(StoneListDto.Code)"
                                            Value="@d.CommodityId" ValueChanged="@((Guid? v) => OnStoneSelected(v))" AllowClear="false" />
                        }
                        else if (d.CommodityProcessType == ProcessType.Good)
                        {
                            <LookupComboBox TItem="GoodListDto" TValue="Guid?" Data="@Goods"
                                            ValueFieldName="@nameof(GoodListDto.Id)" TextFieldName="@nameof(GoodListDto.Code)"
                                            Value="@d.CommodityId" ValueChanged="@((Guid? v) => OnGoodSelected(v))" AllowClear="false" />
                        }
                    </div>

                    @if (IsMetalLegged(d.CommodityProcessType))
                    {
                        @if (ShowAdet(d))
                        {
                            <div style="@GroupStyle(60)">
                                <small style="@ProcessPanelStyles.Label">@L["Count"]</small>
                                <NumericSpinEdit TValue="decimal" Value="@d.Quantity" ValueChanged="@((decimal v) => OnQuantityChanged(v))" ValueExpression="@(() => d.Quantity)"
                                                 BindValueMode="BindValueMode.OnInput" ShowSpinButtons="false" DisplayFormat="N0" Mask="N0" />
                            </div>
                        }
                        <div style="@GroupStyle()">
                            <small style="@ProcessPanelStyles.Label">@L["LineAmount"]</small>
                            <NumericSpinEdit TValue="decimal" Value="@d.Amount" ValueChanged="@((decimal v) => OnAmountChanged(v))" ValueExpression="@(() => d.Amount)"
                                             Enabled="@(!AmountReadOnly(d))" BindValueMode="BindValueMode.OnInput" ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
                        </div>
                        <div style="@GroupStyle()">
                            <small style="@ProcessPanelStyles.Label">@L["Factor"]</small>
                            <NumericSpinEdit TValue="decimal" Value="@d.Factor" ValueChanged="@((decimal v) => OnFactorChanged(v))" ValueExpression="@(() => d.Factor)"
                                             BindValueMode="BindValueMode.OnInput" ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                        </div>
                        <div style="@GroupStyle()">
                            <small style="@ProcessPanelStyles.Label">@L["Total"] (@MainUnitCodeOf(d))</small>
                            <NumericSpinEdit TValue="decimal" Value="@d.Total" ValueChanged="@((decimal v) => OnTotalChanged(v))" ValueExpression="@(() => d.Total)"
                                             ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                        </div>
                        <div style="@GroupStyle()">
                            <small style="@ProcessPanelStyles.Label">@(d.PaymentType == ProcessPaymentType.WithCurrency ? L["PayFactor"].Value : LaborCaption(d))</small>
                            <NumericSpinEdit TValue="decimal" Value="@d.PayFactor" ValueChanged="@((decimal v) => OnPayFactorChanged(v))" ValueExpression="@(() => d.PayFactor)"
                                             BindValueMode="BindValueMode.OnInput" ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                        </div>
                        <div style="@GroupStyle()">
                            <small style="@ProcessPanelStyles.Label">@L["PayTotal"] (@PayUnitCodeOf(d))</small>
                            <NumericSpinEdit TValue="decimal" Value="@d.PayTotal" ValueChanged="@((decimal v) => OnPayTotalChanged(v))" ValueExpression="@(() => d.PayTotal)"
                                             ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
                        </div>
                        <div style="@GroupStyle(140)">
                            <small style="@ProcessPanelStyles.Label">@L["Unit"]</small>
                            <LookupComboBox TItem="CurrentPriceDto" TValue="Guid?" Data="@Units"
                                            ValueFieldName="@nameof(CurrentPriceDto.Id)" TextFieldName="@nameof(CurrentPriceDto.CurrencyUnitCode)"
                                            Value="@d.PayUnitId" ValueChanged="@((Guid? v) => OnPayUnitChanged(v))" AllowClear="false" />
                        </div>
                    }
                    else
                    {
                        @if (PriceByQuantity(d))
                        {
                            <div style="@GroupStyle(60)">
                                <small style="@ProcessPanelStyles.Label">@L["Count"]</small>
                                <NumericSpinEdit TValue="decimal" Value="@d.Quantity" ValueChanged="@((decimal v) => OnQuantityChanged(v))" ValueExpression="@(() => d.Quantity)"
                                                 BindValueMode="BindValueMode.OnInput" ShowSpinButtons="false" DisplayFormat="N0" Mask="N0" />
                            </div>
                        }
                        else
                        {
                            <div style="@GroupStyle()">
                                <small style="@ProcessPanelStyles.Label">@L["LineAmount"]</small>
                                <NumericSpinEdit TValue="decimal" Value="@d.Amount" ValueChanged="@((decimal v) => OnAmountChanged(v))" ValueExpression="@(() => d.Amount)"
                                                 BindValueMode="BindValueMode.OnInput" ShowSpinButtons="false" DisplayFormat="N2" Mask="N2" />
                            </div>
                        }
                    }
                }
                else
                {
                    @* Hizmet — seçici (etiket; Service katalog entity'sine dokunulmaz) + türevsel bedel kuralı. *@
                    <div style="@GroupStyle(180)">
                        <small style="@ProcessPanelStyles.Label">@L["Service"]</small>
                        <LookupComboBox TItem="ServiceListDto" TValue="Guid?" Data="@Services"
                                        ValueFieldName="@nameof(ServiceListDto.Id)" TextFieldName="@nameof(ServiceListDto.Code)"
                                        Value="@d.CommodityId" ValueChanged="@((Guid? v) => OnServiceSelected(v))" AllowClear="false" />
                    </div>

                    <div style="@GroupStyle(190)">
                        <small style="@ProcessPanelStyles.Label">@L["DerivedBaseMode"]</small>
                        <DxComboBox TData="DerivedBaseItem" TValue="RecipeDerivedBaseMode"
                                    Data="@_baseModeItems" Value="@(d.DerivedBaseMode ?? RecipeDerivedBaseMode.AllAbove)"
                                    ValueChanged="@((RecipeDerivedBaseMode v) => OnDerivedBaseModeChanged(v))"
                                    ValueFieldName="@nameof(DerivedBaseItem.Value)" TextFieldName="@nameof(DerivedBaseItem.Label)"
                                    DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                    ValidationEnabled="false" CssClass="w-100" />
                    </div>

                    @if (d.DerivedBaseMode == RecipeDerivedBaseMode.SelectedLines)
                    {
                        <div style="@GroupStyle(280)">
                            <small style="@ProcessPanelStyles.Label">@L["RecipeLines"]</small>
                            <DxTagBox TData="DerivedSourceItem" TValue="Guid"
                                      Data="@UpstreamLines(d)" Values="@d.DerivedSourceKeys"
                                      ValuesChanged="@((IEnumerable<Guid> v) => OnDerivedSourcesChanged(v))"
                                      ValueFieldName="@nameof(DerivedSourceItem.ClientKey)" TextFieldName="@nameof(DerivedSourceItem.Code)"
                                      ValidationEnabled="false" CssClass="w-100">
                                <Columns>
                                    <DxListEditorColumn FieldName="@nameof(DerivedSourceItem.Nr)" Caption="@L["Nr"].Value" Width="48px" />
                                    <DxListEditorColumn FieldName="@nameof(DerivedSourceItem.Code)" Caption="@L["Code"].Value" />
                                    <DxListEditorColumn FieldName="@nameof(DerivedSourceItem.Cost)" Caption="@L["LineCost"].Value" />
                                </Columns>
                            </DxTagBox>
                        </div>
                    }

                    <div style="@GroupStyle(150)">
                        <small style="@ProcessPanelStyles.Label">@L["DerivedOperation"]</small>
                        <DxComboBox TData="DerivedOperationItem" TValue="RecipeDerivedOperation"
                                    Data="@_operationItems" Value="@(d.DerivedOperation ?? RecipeDerivedOperation.Percent)"
                                    ValueChanged="@((RecipeDerivedOperation v) => OnDerivedOperationChanged(v))"
                                    ValueFieldName="@nameof(DerivedOperationItem.Value)" TextFieldName="@nameof(DerivedOperationItem.Label)"
                                    DropDownTriggerMode="DropDownTriggerMode.Click" ShowDropDownButton="true"
                                    ValidationEnabled="false" CssClass="w-100" />
                    </div>

                    <div style="@GroupStyle(120)">
                        <small style="@ProcessPanelStyles.Label">@L["DerivedOperand"]</small>
                        <NumericSpinEdit TValue="decimal" Value="@d.DerivedOperand" ValueChanged="@((decimal v) => OnDerivedOperandChanged(v))" ValueExpression="@(() => d.DerivedOperand)"
                                         BindValueMode="BindValueMode.OnInput" ShowSpinButtons="false" DisplayFormat="N5" Mask="N5" />
                    </div>

                    @* Ekle işleminde operand mutlak tutar → yanında birim (yabancı para dahil; boş = ülke birimi). *@
                    @if (d.DerivedOperation == RecipeDerivedOperation.Add)
                    {
                        <div style="@GroupStyle(140)">
                            <small style="@ProcessPanelStyles.Label">@L["Unit"]</small>
                            <LookupComboBox TItem="CurrentPriceDto" TValue="Guid?" Data="@Units"
                                            ValueFieldName="@nameof(CurrentPriceDto.Id)" TextFieldName="@nameof(CurrentPriceDto.CurrencyUnitCode)"
                                            Value="@d.PayUnitId" ValueChanged="@((Guid? v) => OnPayUnitChanged(v))" AllowClear="true" />
                        </div>
                    }
                }

            </div>

            @* Açıklama — satır sonuna kadar genişler (MetalProcessPanel ikinci satır paritesi). *@
            <div style="display:flex; flex-direction:column; gap:4px; margin-top:4px;">
                @if (_isMobile)
                {
                    <small style="@ProcessPanelStyles.Label">@L["Description"]</small>
                }
                <DxTextBox Text="@d.Description" TextChanged="@((string v) => OnDescriptionChanged(v))" TextExpression="@(() => d.Description)" CssClass="w-100" />
            </div>
        </div>
        </ChildContent>
    </EntryPanelShell>
}

@* Satır grid'i — voucher satır grid'i dizilimi (pager YOK); satıra tıkla → draft'a kopyala (buffered edit). *@
<DxGrid Data="@VisibleLines" KeyFieldName="ClientKey" SelectionMode="GridSelectionMode.Single"
        AllowSelectRowByClick="true"
        SelectedDataItem="@_selectedLine" SelectedDataItemChanged="@((object item) => OnSelectedLineChanged(item))"
        PagerVisible="false" PageSize="1000" CssClass="mt-2">
    <Columns>
        <DxGridDataColumn AllowSort="false" FieldName="@nameof(ProductRecipeLineGraphDto.LineOrder)" Caption="@L["Nr"]" Width="50px" TextAlignment="GridTextAlignment.Right" />
        <DxGridDataColumn AllowSort="false" Caption="@L["ComponentType"]" Width="90px">
            <CellDisplayTemplate><span style="@DerivedCellStyle((ProductRecipeLineGraphDto)context.DataItem)">@ComponentLabel((ProductRecipeLineGraphDto)context.DataItem)</span></CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn AllowSort="false" Caption="@L["Commodity"]" Width="100px">
            <CellDisplayTemplate>@CommodityCodeOf((ProductRecipeLineGraphDto)context.DataItem)</CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn AllowSort="false" Caption="@L["PaymentType"]" Width="90px">
            <CellDisplayTemplate>@PaymentLabelOf((ProductRecipeLineGraphDto)context.DataItem)</CellDisplayTemplate>
        </DxGridDataColumn>
        @* Adet — hizmet satırında BOŞ (hizmetin adedi yoktur); alana doğrudan bağlanınca "0" basıyordu. *@
        <DxGridDataColumn AllowSort="false" Caption="@L["Count"]" TextAlignment="GridTextAlignment.Right" Width="70px">
            <CellDisplayTemplate>@GridQuantityText((ProductRecipeLineGraphDto)context.DataItem)</CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn AllowSort="false" Caption="@L["LineAmount"]" TextAlignment="GridTextAlignment.Right" Width="90px">
            <CellDisplayTemplate>@GridAmountText((ProductRecipeLineGraphDto)context.DataItem)</CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn AllowSort="false" Caption="@L["Factor"]" TextAlignment="GridTextAlignment.Right" Width="90px">
            <CellDisplayTemplate>@GridFactorText((ProductRecipeLineGraphDto)context.DataItem)</CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn AllowSort="false" Caption="@L["Total"]" TextAlignment="GridTextAlignment.Right" Width="120px">
            <CellDisplayTemplate>@GridTotalText((ProductRecipeLineGraphDto)context.DataItem)</CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn AllowSort="false" Caption="@L["DerivedOperation"]" Width="90px">
            <CellDisplayTemplate><span style="@DerivedCellStyle((ProductRecipeLineGraphDto)context.DataItem)">@OperationLabel((ProductRecipeLineGraphDto)context.DataItem)</span></CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn AllowSort="false" Caption="@L["Price"]" TextAlignment="GridTextAlignment.Right" Width="90px">
            <CellDisplayTemplate>@GridPriceText((ProductRecipeLineGraphDto)context.DataItem)</CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn AllowSort="false" Caption="@L["PayTotal"]" TextAlignment="GridTextAlignment.Right" Width="120px">
            <CellDisplayTemplate>@GridPayTotalText((ProductRecipeLineGraphDto)context.DataItem)</CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn AllowSort="false" Caption="@L["InheritedBase"]" Width="120px">
            <CellDisplayTemplate><span style="@DerivedCellStyle((ProductRecipeLineGraphDto)context.DataItem)">@InheritedBaseLabel((ProductRecipeLineGraphDto)context.DataItem)</span></CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn AllowSort="false" Caption="@L["InheritedItems"]" Width="140px">
            <CellDisplayTemplate><span style="@DerivedCellStyle((ProductRecipeLineGraphDto)context.DataItem)">@InheritedItemsText((ProductRecipeLineGraphDto)context.DataItem)</span></CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn AllowSort="false" Caption="@L["RunningSubtotal"]" TextAlignment="GridTextAlignment.Right" Width="130px">
            <CellDisplayTemplate><b>@RunningSubtotalText((ProductRecipeLineGraphDto)context.DataItem)</b></CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</DxGrid>

@* Seçili satırın açıklaması — grid ALTINDA read-only (kolon değil; satır seçilince dolar). *@
<div style="margin-top:6px; display:flex; flex-direction:column; gap:2px;">
    <small style="@ProcessPanelStyles.Label">@L["Description"]</small>
    <DxTextBox Text="@(_selectedLine?.Description ?? string.Empty)" ReadOnly="true" ValidationEnabled="false" CssClass="w-100" />
</div>
