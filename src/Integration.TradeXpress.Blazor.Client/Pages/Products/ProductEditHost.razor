@page "/products/new"
@page "/products/{Id:guid}"
@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@*
   Product edit host = CrudEditHost üzerinde İNCE bir katman: coordinator + sunum. Commit/save/delete/close generic CrudEditHost'ta.
   Agnostic CrudEditHost + dumb ProductLayout. Company-owned (sunucu CompanyId zorlar).
*@

@if (_coordinator != null && _ready)
{
    <CrudEditHost TGetDto="ProductGetDto" TListDto="ProductListDto" TKey="Guid" TListRequestDto="ProductListRequestDto"
                  Coordinator="@_coordinator" Id="@(Id ?? Guid.Empty)" IsPopupMode="@IsPopupMode" OnSaved="@OnSaved" OnClosed="@OnClosed" OnAfterCommit="@RefreshDerivedGraphAsync"
                  OnAfterCreate="@ApplyRecipeTemplateOnCreateAsync"
                  FormCaption="@L["Product"].Value" IconCssClass="@TradeXpressIcons.Product"
                  EntityValue="@(m => m.Code)"
                  BuildCustomActions="@BuildProductActions"
                  ApplyNewDefaults="@(m => ApplyNew(m))">
        <ProductLayout Model="@context" IsNew="@(context.Id == Guid.Empty)"
                       Metals="Metals" MetalVariants="MetalVariants" Scraps="Scraps" Futures="Futures"
                       Jewelries="Jewelries" Stones="Stones" Goods="Goods" Services="Services" Units="Units"
                       GoodVariants="GoodVariants" JewelryVariants="JewelryVariants"
                       CurrencyUnits="CurrencyUnits" OnReloadCurrencyUnits="@ReloadCurrencyUnitsAsync"
                       Countries="Countries"
                       AddOnCatalog="AddOns" OnReloadAddOns="@ReloadAddOnsAsync"
                       OnGenerateVariants="@(async () => await GenerateVariantsAsync(context))"
                       OnRecipeChanged="@RecalcVariantCostAsync"
                       OnCreateCommodityFromProduct="@((ProcessType f) => CreateCommodityFromProductAsync(f, context))"
                       OnReloadRecipeCatalogs="@ReloadRecipeCatalogsAsync"
                       OnVariantModeChangeRequested="@(async (ProductVariantMode m) => await HandleVariantModeChangeAsync(context, m))"
                       ProductCategories="ProductCategories" OnReloadProductCategories="@ReloadProductCategoriesAsync"
                       OnAddProductCategory="@AddProductCategoryAsync"
                       OnEditProductCategory="@EditProductCategoryAsync"
                       CategorySpecificationAttributes="CategorySpecificationAttributes"
                       OnProductCategorySelected="@OnProductCategoryChangedAsync"
                       RecipeTemplates="RecipeTemplates" OnReloadRecipeTemplates="@ReloadRecipeTemplatesAsync"
                       OnApplyRecipeTemplate="@(async (Guid id) => await ApplyRecipeTemplateAsync(context, id))"
                       VariantTemplates="VariantTemplates" OnReloadVariantTemplates="@ReloadVariantTemplatesAsync"
                       OnApplyVariantTemplate="@(async (Guid id) => await ApplyVariantTemplateAsync(context, id))"
                       SubstitutionGroups="SubstitutionGroups" OnReloadSubstitutionGroups="@ReloadSubstitutionGroupsAsync"
                       SubstitutionGroupItems="SubstitutionGroupItems" OnSubstitutionGroupChanged="@OnSubstitutionGroupChangedAsync"
                       SubstitutionResult="SubstitutionResult" SubstitutionBusy="SubstitutionBusy"
                       OnCalculateSubstitution="@(async () => await CalculateSubstitutionAsync(context))"
                       OnApplySubstitutionTrial="@(async (SubstitutionTrialDto t) => await ApplySubstitutionTrialAsync(context, t))"
                       OnVerifyForSale="@(() => VerifyForSaleClickedAsync(context))" />
    </CrudEditHost>
}
