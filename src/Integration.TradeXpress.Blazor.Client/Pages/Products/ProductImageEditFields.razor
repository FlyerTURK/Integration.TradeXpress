@inherits Integration.Framework.Blazor.Client.Components.Crud.CrudComponentBase

@* Ürün görseli edit alanları — TEK-görsel çekirdeği paylaşılan SingleImageEditFields'te (DRY);
   ürün-özel sıra + varsayılan alanları kaynak combo'sunun ardına slot'la girer. *@

<SingleImageEditFields Model="@Model"
                       UploadAsync="@UploadCoreAsync"
                       MaxImageSizeBytes="@ProductConsts.MaxImageSizeBytes"
                       TooLargeErrorKey="TradeXpress:Product:ImageTooLarge">
    <AfterSourceContent>
        @* Görseli bir varyanta bağla — boş seçim (temizle) = ürün-geneli görsel. EditContext altında manuel
           bağlı Dx editör → ValidationEnabled="false" (ui-blazor [validation-expr] tuzağı). *@
        <DxFormLayoutItem Caption="@L["Variant"]" ColSpanMd="6" BeginRow="true">
            <DxComboBox TData="ProductVariantGraphDto" TValue="ProductVariantGraphDto"
                        Data="@Variants"
                        Value="@SelectedVariant"
                        ValueChanged="@((ProductVariantGraphDto? v) => OnVariantChanged(v))"
                        TextFieldName="@nameof(ProductVariantGraphDto.Code)"
                        NullText="@L["ProductImage:ProductWide"].Value"
                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                        ValidationEnabled="false" CssClass="w-100" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="@L["DisplayOrder"]" ColSpanMd="6">
            <NumericSpinEdit @bind-Value="@Model.DisplayOrder" />
        </DxFormLayoutItem>
        @* Varsayılan (ana) görsel — push'ta ilk sıraya alınır; tekil garanti sunucuda (birden fazlaysa ilki kalır). *@
        <DxFormLayoutItem Caption="@L["Default"]" ColSpanMd="6">
            <DxCheckBox @bind-Checked="@Model.IsDefault" CheckType="CheckType.Switch">
                @(Model.IsDefault ? L["Yes"] : L["No"])
            </DxCheckBox>
        </DxFormLayoutItem>
    </AfterSourceContent>
</SingleImageEditFields>
