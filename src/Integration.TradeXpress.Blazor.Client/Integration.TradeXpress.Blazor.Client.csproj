<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- net8+ varsayılan trim mode "full" DevExpress kütüphanelerini runtime'da bozar; DX dokümanı
         "partial" öneriyor (Release/publish'te trimming + Brotli ile transfer ~58MB→~16MB). -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <!-- Export'a özel ağır DevExpress assembly'leri (Pdf/Printing/Drawing ≈ 10MB ham) açılışta inmez;
       yalnızca ilk Excel/PDF export tıklamasında LazyAssemblyLoader ile yüklenir
       (CrudLayout.EnsureExportAssembliesAsync). Dosya adları publish çıktısındaki assembly adlarıyla
       birebir eşleşmeli. -->
  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="DevExpress.Printing.v25.2.Core.wasm" />
    <BlazorWebAssemblyLazyLoad Include="DevExpress.Pdf.v25.2.Core.wasm" />
    <BlazorWebAssemblyLazyLoad Include="DevExpress.Pdf.v25.2.Drawing.wasm" />
    <BlazorWebAssemblyLazyLoad Include="DevExpress.Drawing.v25.2.wasm" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Blazor" />
    <PackageReference Include="DevExpress.Blazor.Themes" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" />
    <PackageReference Include="Volo.Abp.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Volo.Abp.Http.Client.IdentityModel.WebAssembly" />
    <PackageReference Include="Volo.Abp.Mapperly" />
    <PackageReference Include="Volo.Abp.UI.Navigation" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Autofac.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Integration.TradeXpress.HttpApi.Client\Integration.TradeXpress.HttpApi.Client.csproj" />
    <ProjectReference Include="..\Integration.Framework.Blazor.Client\Integration.Framework.Blazor.Client.csproj" />
    <ProjectReference Include="..\Integration.Framework.Application.Contracts\Integration.Framework.Application.Contracts.csproj" />
  </ItemGroup>

</Project>
