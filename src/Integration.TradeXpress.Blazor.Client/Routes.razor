@using Integration.TradeXpress.Blazor.Client.Layout
@using Integration.TradeXpress.Blazor.Client.Theming
@using Volo.Abp.AspNetCore.Components.Web.Security
@inject ISizeModeService SizeModeService
@implements IDisposable

@* Seçili SizeMode tüm DevExpress bileşenlerine cascading değer olarak akar.
   Bileşenler [CascadingParameter(Name="ParentSizeMode")] ile bunu okur. *@
<CascadingValue Value="SizeModeService.CurrentSizeMode" Name="ParentSizeMode">
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <p>Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingValue>

@code {
    protected override void OnInitialized()
    {
        SizeModeService.SizeModeChanged += OnSizeModeChanged;
    }

    private void OnSizeModeChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SizeModeService.SizeModeChanged -= OnSizeModeChanged;
    }
}
