@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject NavigationManager Navigation

@*
   Kimliği olmayan kullanıcı için: hiçbir layout/chrome render etmeden doğrudan
   WASM login akışına (RemoteAuthenticatorView → /authentication/login) yönlendirir.
   NavigateToLogin returnUrl'i auth state üzerinden taşır; kullanıcı giriş sonrası
   bulunduğu sayfaya döner.
*@

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateToLogin("authentication/login");
    }
}
