@using System
@using DevExpress.Blazor
@using Integration.TradeXpress.Vaults
@using Integration.TradeXpress.Blazor.Client.Services.Working
@implements IDisposable
@inject IWorkingContextService Working
@inject Microsoft.Extensions.Localization.IStringLocalizer<Integration.TradeXpress.Localization.TradeXpressResource> L
@inject Integration.TradeXpress.Blazor.Client.Services.Mdi.ITabManager TabManager
@inject IUiInteractionService Ui

@*
   Çalışma bağlamı (working context) seçici — sol menü drawer'ının FooterTemplate'inde.
   KASA HASSASİYETİ: satırlar KASA'dır, üç kolon Şirket + Şube + Kasa. Seçim kasanın şubesini ve şirketini
   de set eder (çalışma bağlamı = şirket + şube + kasa). Değer WorkingContextService'te tutulur; ilk
   yüklemede son seçim ya da çalışma şubesinin varsayılan kasası otomatik seçilir (combo boş kalmaz).
   Kasa yoksa (host / yetkili kasa yok) hiç render edilmez — fail-safe.
*@

@if (Working.Vaults.Count > 0)
{
    <div style="display:flex; flex-direction:column; gap:0.2rem;">
        <span style="font-size:0.75rem; opacity:0.7;">@L["WorkingVaultCaption"]</span>
        <DxComboBox TData="MyVaultDto" TValue="Guid?"
                    Data="@Working.Vaults"
                    Value="@Working.CurrentVaultId"
                    ValueChanged="@OnVaultChanged"
                    ValueFieldName="@nameof(MyVaultDto.Id)"
                    TextFieldName="@nameof(MyVaultDto.CompanyBranchVaultCode)"
                    NullText="@L["WorkingVaultCaption"].Value"
                    CssClass="w-100">
            <Columns>
                <DxListEditorColumn FieldName="@nameof(MyVaultDto.CompanyDisplay)" Caption="@L["Company"].Value" Width="34%" />
                <DxListEditorColumn FieldName="@nameof(MyVaultDto.BranchDisplay)" Caption="@L["Branch"].Value" Width="33%" />
                <DxListEditorColumn FieldName="@nameof(MyVaultDto.VaultDisplay)" Caption="@L["Vault"].Value" />
            </Columns>
        </DxComboBox>
    </div>
}

@code {
    protected override void OnInitialized() => Working.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Working.EnsureLoadedAsync(); // kasa/şube listesi + saklı seçim (server ayarı)
    }

    // Combo boş kalmamalı → null seçim yok sayılır (mevcut seçim korunur).
    private async Task OnVaultChanged(Guid? vaultId)
    {
        if (vaultId is null || vaultId == Working.CurrentVaultId) return;

        if (TabManager.HasDirtyTabs)
        {
            var result = await Ui.ConfirmAsync("Değişiklik yapılmış ancak kaydedilmemiş sekmeler var. Kasa değiştirirseniz bu değişiklikler kaybolacak. Devam etmek istediğinize emin misiniz?", "Uyarı", "Yine de Değiştir", "İptal", false, false);
            if (result != Integration.Framework.Blazor.Client.Services.Base.ConfirmDialogResult.Yes)
            {
                // Combo seçimini geri almak için UI'ı zorla güncelliyoruz.
                _ = InvokeAsync(StateHasChanged);
                return;
            }
        }

        await Working.SetVaultAsync(vaultId);
        await TabManager.ReloadTabsAsync();
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Working.Changed -= OnChanged;
}
