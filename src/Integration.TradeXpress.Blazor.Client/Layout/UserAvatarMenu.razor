@using System
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Volo.Abp.Users
@using Volo.Abp.MultiTenancy
@using DevExpress.Blazor
@inject ICurrentUser CurrentUser
@inject ICurrentTenant CurrentTenant
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject Integration.TradeXpress.Blazor.Client.Services.Mdi.ITabManager TabManager
@inject IUiInteractionService Ui
@inject IStringLocalizer<Integration.TradeXpress.Localization.TradeXpressResource> L

@*
   Top panel kullanıcı avatarı: baş harfler temaya uygun renkli dairede. Tıklayınca DxFlyout açılır;
   içinde kullanıcı adı, kiracı (tenant) adı ve çıkış butonu yer alır. Eski top panel "Çıkış" butonunun
   yerini alır.
*@

<button type="button"
        id="@_avatarId"
        class="user-avatar-btn"
        @onclick="Toggle"
        title="@_tooltip"
        aria-label="@_tooltip">
    <span class="erp-avatar-initials" aria-hidden="true">@_initials</span>
</button>

<DxFlyout @bind-IsOpen="_isOpen"
          PositionTarget="@_avatarSelector"
          Position="FlyoutPosition.BottomEnd"
          Width="260"
          CloseOnOutsideClick="true"
          CssClass="user-avatar-flyout">
    <BodyContentTemplate Context="flyout">
        @* HİZALAMA — kritik olan `align-self:stretch` (2026-07-25, DOM + tema CSS ile doğrulandı):
           DevExpress `.dxbl-flyout-body` bir flex sütundur ve `align-items:flex-start` taşır → içindeki
           `.user-avatar-flyout-body` div'imiz İÇERİĞİ KADAR DARALIR. O yüzden `text-align:center` metin genişliğinde bir kutuda
           ortalama yapıyor (görünür etki yok), `margin:0 auto` ortalayacak boşluk bulamıyor ve buton dar
           kalıyordu. `align-self:stretch` parent'ın flex-start'ını ezip kabuğu tam genişliğe açar; ancak
           ondan SONRA ortalama anlam kazanır.
           Stiller sınıf yerine INLINE: bu div flyout portalına taşındığından torun seçiciler
           (`.user-avatar-flyout-body .erp-avatar-lg`) ve utility sınıfları oraya ulaşmıyor.
           Çıkış butonu grid içinde: grid öğesi varsayılan olarak tam genişliğe uzar (w-100 gerekmez). *@
        <div class="user-avatar-flyout-body" style="align-self:stretch; text-align:center;">
            <span class="erp-avatar-initials erp-avatar-lg" aria-hidden="true"
                  style="display:flex; margin:0 auto 0.5rem;">@_initials</span>
            <div title="@_userName"
                 style="font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@_userName</div>
            @if (!string.IsNullOrEmpty(_tenantName))
            {
                <div title="@_tenantName"
                     style="font-size:0.85rem; opacity:0.65; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-bottom:0.75rem;">@_tenantName</div>
            }
            else
            {
                <div style="margin-bottom:0.75rem;"></div>
            }
            <div style="display:grid;">
                <DxButton Text="@L["Logout"]"
                          IconCssClass="custom-icon-sign-out"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          Click="OnLogout" />
            </div>
        </div>
    </BodyContentTemplate>
</DxFlyout>

@code {
    private readonly string _avatarId = $"user-avatar-{Guid.NewGuid():N}";
    private string _avatarSelector = string.Empty;

    private bool _isOpen;
    private string _userName   = string.Empty;
    private string _tenantName = string.Empty;
    private string _tooltip    = string.Empty;
    private string _initials   = "U";

    protected override void OnInitialized()
    {
        _avatarSelector = $"#{_avatarId}";
        _userName   = CurrentUser.UserName ?? "User";
        // Host (kiracısız) oturumda tenant id null olur; o durumda "Host" gösterilir.
        _tenantName = CurrentTenant.Id is null
            ? "Host"
            : (CurrentTenant.Name ?? string.Empty);
        _tooltip    = string.IsNullOrEmpty(_tenantName) ? _userName : $"{_userName} / {_tenantName}";
        _initials   = BuildInitials(CurrentUser.Name, _userName);
    }

    private void Toggle() => _isOpen = !_isOpen;

    private async Task OnLogout()
    {
        if (TabManager.HasDirtyTabs)
        {
            var result = await Ui.ConfirmAsync("Değişiklik yapılmış ancak kaydedilmemiş sekmeler var. Çıkış yaparsanız bu değişiklikler kaybolacak. Çıkış yapmak istediğinize emin misiniz?", "Uyarı", "Yine de Çık", "İptal", false, false);
            if (result != Integration.Framework.Blazor.Client.Services.Base.ConfirmDialogResult.Yes) return;
        }

        _isOpen = false;
        // /api/account/logout bir REST endpoint'tir (204 döner, redirect ETMEZ). Sayfa olarak
        // gidersek boş ekranda kalırız. Login ile simetrik: same-origin fetch ile cookie'yi
        // temizle, SONRA login'e forceLoad ile git (WASM baştan yüklenir → auth state sıfırlanır).
        try
        {
            await Js.InvokeVoidAsync("fetch", "/api/account/logout",
                new { method = "GET", credentials = "include" });
        }
        catch { /* ağ hatası olsa bile login'e yönlendir */ }

        // replace:true → çıkış sonrası tarayıcı "geri"si uygulamaya (yetkisiz sayfaya) dönmez; login tek
        // kayıt olarak geçmişi devralır. forceLoad zorunlu: WASM baştan yüklenip auth state sıfırlansın.
        Navigation.NavigateTo("/account/login", forceLoad: true, replace: true);
    }

    private static string BuildInitials(string? fullName, string userName)
    {
        if (!string.IsNullOrWhiteSpace(fullName))
        {
            var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
                return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
            if (parts[0].Length >= 2)
                return parts[0][..2].ToUpperInvariant();
            return parts[0][..1].ToUpperInvariant();
        }
        return userName.Length >= 2
            ? userName[..2].ToUpperInvariant()
            : userName.ToUpperInvariant();
    }
}

