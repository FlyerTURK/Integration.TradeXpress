@using Volo.Abp.Users
@using Volo.Abp.MultiTenancy
@using Integration.TradeXpress.Blazor.Client.Extensions
@using DevExpress.Blazor
@inject ICurrentUser CurrentUser
@inject ICurrentTenant CurrentTenant
@inject Microsoft.Extensions.Localization.IStringLocalizer<Integration.TradeXpress.Localization.TradeXpressResource> L

<div class="p-3">
    @if (CurrentUser.IsAuthenticated)
    {
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle shadow-sm" style="width: 70px; height: 70px; font-size: 28px; font-weight: bold;">
                @CurrentUser.GetInitial()
            </div>
            <h5 class="mt-3 mb-1 fw-bold text-dark">@CurrentUser.Name</h5>
            <p class="text-muted small mb-0">@CurrentUser.Email</p>
        </div>

        <hr class="text-muted" />

        <div class="mb-4">
            <label class="text-muted small uppercase fw-bold mb-2 d-block">@L["SessionType"]</label>
            @if (CurrentTenant.IsAvailable)
            {
                <div class="p-2 border rounded bg-light d-flex align-items-center">
                    <i class="custom-icon-company text-info me-2 custom-lg"></i>
                    <div>
                        <span class="d-block fw-bold text-dark small">@CurrentTenant.Name</span>
                        <span class="text-muted" style="font-size: 10px;">ID: @CurrentTenant.Id</span>
                    </div>
                </div>
            }
            else
            {
                <div class="p-2 border rounded bg-light d-flex align-items-center">
                    <i class="custom-icon-server text-secondary me-2 custom-lg"></i>
                    <div>
                        <span class="d-block fw-bold text-dark small">@L["HostAdmin"]</span>
                    </div>
                </div>
            }
        </div>

        <div class="mb-4">
            <label class="text-muted small uppercase fw-bold mb-2 d-block">@L["ActiveRoles"]</label>
            <div class="d-flex flex-wrap gap-1">
                @if (CurrentUser.Roles != null && CurrentUser.Roles.Any())
                {
                    foreach (var role in CurrentUser.Roles)
                    {
                        <span class="badge bg-secondary">@role</span>
                    }
                }
                else
                {
                    <span class="badge bg-light text-muted border">@L["NoRoles"]</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="custom-icon-permission text-muted custom-3x mb-3"></i>
            <p class="text-muted small">@L["LoginToSeeProfile"]</p>
            <DxButton Text="@L["Login"]"
                      RenderStyle="ButtonRenderStyle.Primary"
                      Click="OnLoginClick"
                      CssClass="w-100 mt-2" />
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback OnLoginClick { get; set; }
}


